#!/usr/bin/env bash
# Brings this copy of SaneUI up to date with GitHub, builds it and puts it into the game, in one go:
# the quick way to try in the game what a Claude cloud session pushed.
#
#   1. Fetches from GitHub (origin), and forgets the branches deleted there.
#   2. Pulls main forward to GitHub's. main is the only branch (a session never makes another), so this
#      copy must stand on main; any other branch stops it. Nothing is merged and nothing is lost: if
#      this copy and GitHub both have commits the other lacks, it stops and says so. Changes not
#      committed stop it before anything is touched.
#   3. Runs dev/installdev (dev/build --install): the tests, BUILD, and the copy into Forever's and
#      Retail's AddOns folders at once (WOW_FOREVER and WOW_RETAIL set where they are, as for dev/build).
#
# Usage:  Scripts/update                pull main, build, install
#         Scripts/update --list         the branches on GitHub, newest first; changes nothing
#         --no-install or --check with any of these goes to dev/build: build only, or show only
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$here"

list="" mode="" bad=""
for arg in "$@"; do
    case "$arg" in
        --list) list=1 ;;
        --no-install|--check) [ -z "$mode" ] || bad=1; mode="$arg" ;;
        *) bad=1 ;;
    esac
done
if [ -n "$bad" ]; then
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

echo "Fetching from GitHub..."
git fetch --prune origin || { echo "Could not fetch from GitHub. Nothing was changed." >&2; exit 1; }

current="$(git symbolic-ref --short -q HEAD || true)"

if [ -n "$list" ]; then
    git for-each-ref --sort=-committerdate \
        --format='%(refname:lstrip=3)%09%(committerdate:relative)%09%(subject)' refs/remotes/origin |
        while IFS=$'\t' read -r name when subject; do
            [ "$name" = HEAD ] && continue
            mark=" "
            [ "$name" = "$current" ] && mark="*"
            printf '%s %-40s %-16s %s\n' "$mark" "$name" "$when" "$subject"
        done
    exit 0
fi

if [ "$current" != main ]; then
    echo "This copy stands on ${current:-no branch}, not on main, and main is the only branch of SaneUI." >&2
    echo "git switch main (its commits, if any, kept with git merge), then run this again. Nothing was changed." >&2
    exit 1
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "This copy has changes not committed. Commit them or put them aside (git stash), then run this again:" >&2
    git status --short --untracked-files=no >&2
    exit 1
fi

upstream="origin/main"
if ! git show-ref --verify --quiet "refs/remotes/$upstream"; then
    echo "GitHub has no main: nothing to pull. Nothing was changed." >&2
    exit 1
fi
before="$(git rev-parse HEAD)"
if [ "$before" = "$(git rev-parse "$upstream")" ]; then
    echo "Up to date with GitHub."
elif git merge-base --is-ancestor HEAD "$upstream"; then
    git merge --ff-only --quiet "$upstream"
elif git merge-base --is-ancestor "$upstream" HEAD; then
    echo "Nothing to pull: this copy's main is ahead of GitHub's (commits not pushed yet)."
else
    echo "This copy's main and GitHub's have gone apart. These commits are only here:" >&2
    git log --oneline --no-decorate "$upstream..HEAD" >&2
    echo "Take GitHub's in with git pull --no-rebase origin main (a merge, never a rebase), then run this again. Nothing was changed." >&2
    exit 1
fi

if [ "$(git rev-parse HEAD)" != "$before" ]; then
    echo "Pulled from GitHub, the newest first:"
    git log --oneline --no-decorate -n 15 "$before..HEAD"
fi
echo "Building main at $(git log -1 --format='%h, %s (%cr)')."
echo

exec "$here/dev/build" ${mode:-"--install"}
