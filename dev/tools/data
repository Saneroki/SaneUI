#!/usr/bin/env python3
"""The tool of Core's data framework: the master in assets/data, staging, Core's set files (Doc/guides/data.md).

Usage:  dev/tools/data check                              check the master (dev/tests/run runs it)
        dev/tools/data import <staging> [--apply] [--take]  staging into the master: the report, then --apply
        dev/tools/data compile <folder> [--game <version>]  the set files of a game version (forever) into Core's
                                                            built addon (BUILD/SaneUI): Sets/, listed in its TOC
        dev/tools/data game <game folder>                   the game version a game folder holds (.flavor.info)
        dev/tools/data show <set> <key> [--game <version>]  an entry with every version and source
        dev/tools/data diff <set> [--patch 1.60.2] [--game <version>]  what a patch changed (the newest one)
        dev/tools/data stats                                counts and sizes per set
        dev/tools/data harvest [--wow <folder>] [--from <path> ...] [--ledger <file>] [--out <file>]
                                                            what Core learned, confirmed and counted in play, from the
                                                            game's saved files (the WoW folder's, or any WTF folders or
                                                            saved files players sent: --from), into staging (then:
                                                            import); the counts added up in the ledger; new builds into
                                                            builds.toml
        --master <folder>                                   another master than assets/data (tests)
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "data"))

import check as checks  # noqa: E402
import harvest as harvests  # noqa: E402
import compile as compiler  # noqa: E402
import importer  # noqa: E402
import master as masters  # noqa: E402
import play as plays  # noqa: E402
import views  # noqa: E402


def load(folder):
    master = masters.Master(Path(folder) if folder else masters.MASTER).load()
    checks.check(master)
    return master


def say_problems(master):
    for text in master.warnings:
        print(f"warning: {text}", file=sys.stderr)
    for text in master.errors:
        print(text, file=sys.stderr)


def run_check(args):
    master = load(args.master)
    say_problems(master)
    if master.errors:
        print(f"Data: {len(master.errors)} problems in the master.", file=sys.stderr)
        return 1
    lines = sum(len(lines) for lines in master.lines.values())
    print(f"Data: {len(master.schemas)} sets, {lines} lines, {len(master.games)} game versions, all fit"
          + (f" ({len(master.warnings)} warnings)." if master.warnings else "."))
    return 0


def run_import(args):
    master = load(args.master)
    if master.errors:
        say_problems(master)
        print("Data: the master has problems; mend them before an import.", file=sys.stderr)
        return 1
    report = importer.run(master, importer.read_staging(Path(args.file)), take=args.take)
    for line in report.lines():
        print(line)
    if not report.counts:
        print("Nothing staged.")
    if args.apply:
        importer.apply(master, report)
        after = load(args.master)
        say_problems(after)
        if after.errors:
            print("Data: the master has problems after the import.", file=sys.stderr)
            return 1
        print(f"Applied: {len(report.changed)} set files written." if report.changed else "Applied: nothing to write.")
    elif report.changed:
        print("Nothing written: --apply takes it in.")
    return 0


def run_compile(args):
    master = load(args.master)
    if master.errors:
        say_problems(master)
        print("Data: the master has problems; no set file is made from it.", file=sys.stderr)
        return 1
    if args.game not in master.games:
        print(f"Data: '{args.game}' is no game version of builds.toml ({', '.join(master.games)}).", file=sys.stderr)
        return 1
    folder = Path(args.folder)
    folder.mkdir(parents=True, exist_ok=True)
    made = compiler.compile_sets(master, folder, args.game)
    entries = sum(count for _, count in made)
    print(f"Built: {folder / compiler.SETS} ({args.game}: {len(made)} sets, {entries} entries)")
    return 0


def checked(args):
    """The master, or None after saying its problems."""
    master = load(args.master)
    if master.errors:
        say_problems(master)
        print("Data: the master has problems; mend them first (dev/tools/data check).", file=sys.stderr)
        return None
    return master


def known_game(master, game):
    if game in master.games:
        return True
    print(f"Data: '{game}' is no game version of builds.toml ({', '.join(master.games)}).", file=sys.stderr)
    return False


def run_show(args):
    master = checked(args)
    if master is None or not known_game(master, args.game):
        return 1
    print("\n".join(views.show(master, args.set, args.key, args.game)))
    return 0


def run_diff(args):
    master = checked(args)
    if master is None or not known_game(master, args.game):
        return 1
    print("\n".join(views.diff(master, args.set, args.game, args.patch)))
    return 0


def run_stats(args):
    master = checked(args)
    if master is None:
        return 1
    print("\n".join(views.stats(master)))
    return 0


WOW = Path.home() / ".local/share/Steam/steamapps/compatdata/3133853286/pfx/drive_c/Program Files (x86)/World of Warcraft"


PRIVATE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "saneui" / "private.json"


def ledger_path(given):
    """The ledger's file: as given, else in the private folder (~/.config/saneui/private.json), else in staging."""
    if given:
        return Path(given)
    if PRIVATE.is_file():
        folder = Path(json.loads(PRIVATE.read_text())["folder"]).expanduser()
        if folder.is_dir():
            return folder / "play" / "ledger.json"
    return harvests.STAGING / "ledger.json"


def run_harvest(args):
    master = checked(args)
    if master is None:
        return 1
    files = harvests.saved_files(Path(args.wow)) if not args.sent else []
    for path in args.sent or []:
        files += harvests.sent_files(Path(path))
    if not files:
        where = ", ".join(args.sent) if args.sent else f"{args.wow} (its game folders' WTF)"
        print(f"Data: no saved file of SaneUI under {where}.", file=sys.stderr)
        return 1
    ledger = plays.Ledger(ledger_path(args.ledger))
    lines, report = harvests.harvest(master, files, ledger)
    out = Path(args.out) if args.out else harvests.STAGING / "harvest.jsonl"
    harvests.write(lines, out)
    ledger.save()
    added = harvests.add_builds(master, report["builds"]) if report["builds"] else 0
    said = [f"{report['learned']} rows learned", f"{report['confirmed']} entries confirmed"]
    if added:
        said.append(f"{added} new builds in builds.toml")
    if report["parts"]:
        said.append(f"{report['parts']} confirmed in parts only (the rest still to be seen)")
    if report["counted"]:
        said.append(f"{report['counted']} counts added up")
    if report["broken"]:
        said.append(f"{report['broken']} unreadable")
    print(f"Harvest: {len(files)} saved files: {', '.join(said)}.")
    staged = ", ".join(f"{n} {name}" for name, n in sorted(report["staged"].items()))
    waiting = ", ".join(f"{n} {name}" for name, n in sorted(report["waiting"].items()))
    if staged:
        print(f"From the counts: {staged}.")
    if waiting:
        print(f"Still too few seen: {waiting}.")
    if report["dropped"]:
        print(f"Items our data lists that play would have seen by now, left out: {report['dropped']}.")
    for key, build, item, before, after in report["changes"]:
        print(f"Changed with build {build}: item {item} from {key}, {before} % -> {after} %.")
    listed, withheld = report.get("offers", (0, 0))
    if listed or withheld:
        share = 100 * listed / (listed + withheld)
        print(f"Quest offers checked in play: of {listed + withheld} the map's data offered at givers players talked to, "
              f"the game listed {listed} ({share:.1f} %), withheld {withheld}.")
    for key, quest, times in report.get("early", [])[:40]:
        print(f"Offered against the data's rules: quest {quest} at {key}, {times} times (a rule of the data is wrong).")
    print(f"Ledger: {ledger.path}.")
    print(f"Staged: {out} (dev/tools/data import {out} --apply takes it in).")
    return 0


def run_game(args):
    game = compiler.product_game(Path(args.folder))
    if game is None:
        return 1
    print(game)
    return 0


def main():
    parser = argparse.ArgumentParser(prog="dev/tools/data", description=__doc__.split("\n")[0])
    parser.add_argument("--master", help="the master's folder (assets/data)")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("check", help="check the master")
    taking = commands.add_parser("import", help="staging into the master")
    taking.add_argument("file")
    taking.add_argument("--apply", action="store_true", help="write the master")
    taking.add_argument("--take", action="store_true", help="write conflicts into their versions as corrections")
    making = commands.add_parser("compile", help="the set files into Core's built addon")
    making.add_argument("folder")
    making.add_argument("--game", default=masters.LIVE, help="the game version (forever)")
    telling = commands.add_parser("game", help="the game version of a game folder")
    telling.add_argument("folder")
    showing = commands.add_parser("show", help="an entry with every version and source")
    showing.add_argument("set")
    showing.add_argument("key")
    showing.add_argument("--game", default=masters.LIVE, help="the game version (forever)")
    comparing = commands.add_parser("diff", help="what a patch changed")
    comparing.add_argument("set")
    comparing.add_argument("--patch", help="the patch (1.60.2); the game version's newest when left out")
    comparing.add_argument("--game", default=masters.LIVE, help="the game version (forever)")
    commands.add_parser("stats", help="counts and sizes per set")
    reaping = commands.add_parser("harvest", help="what Core learned and confirmed in play, into staging")
    reaping.add_argument("--wow", default=str(WOW), help="the World of Warcraft folder (its game folders _*_)")
    reaping.add_argument("--out", help="the staging file (dev/data/staging/harvest.jsonl)")
    reaping.add_argument("--from", dest="sent", nargs="+", metavar="PATH",
                         help="WTF folders or saved files (SaneUI.lua) players sent, in place of --wow's")
    reaping.add_argument("--ledger", help="the ledger (in the private folder, else dev/data/staging/ledger.json)")
    args = parser.parse_args()
    return {"check": run_check, "import": run_import, "compile": run_compile, "game": run_game, "show": run_show,
            "diff": run_diff, "stats": run_stats, "harvest": run_harvest}[args.command](args)


sys.exit(main())
