#!/usr/bin/env python3
"""Paints the far zoom of Navigation's dungeon and raid maps (Doc/ideas/Navigation.md, *Dungeon, instance and raid
maps in three zooms*): one free, realistic painting of each instance as a whole, its mood and how its rooms lie, from
its layout and its brief (dev/imagegen/maps/dungeons.toml), by the local image model in ComfyUI.

The layout is image 1: every floor of the instance side by side in the game's order, from the game's own map art of
it (Core's set Dungeons: its floors' tiles, read from a folder of the game's map art, <file ID>.blp) or, for an
instance the game has no map art of, the pictures given in --layouts (<map ID>-<floor>.png). It is blurred until only
the shapes of halls, rooms, corridors and water are left (BLUR), so no line, drawing style or writing carries over:
the game's art is cut free of its frame and the title banner at its top (CUT), and the faint drawing made stronger.
Each instance is painted with SEEDS seeds, the first seed of every instance before the second of any, so a run that
stops early has some of each. A painting already made is not made again: the GPU runner can stop and start it.

Usage:
  dev/tools/dungeon-paint paint [--mapart DIR] [--layouts DIR] [--only KEYS] [--limit N] [--out DIR] [--dry]
  dev/tools/dungeon-paint status [--out DIR]
  dev/tools/dungeon-paint contact [--out DIR]
  dev/tools/dungeon-paint rebuild [--out DIR]

  paint      paints what is missing; --mapart and --layouts are needed the first time, then remembered in the run's
             state.json; --only 33,36 those instances only; --limit N stops after N paintings; --dry makes the
             layouts and prints the words, without ComfyUI
  status     its first line: "<made> of <all> paintings made"; then what has no layout or no brief, and whether the
             plan (dungeons.toml, the workflow) changed since the run began
  contact    contact.jpg: a row per instance, its layout and its paintings, to choose from
  rebuild    the run so far put aside whole in <out>-runs/<date>, a new run with the plans as they are

It writes, in the run's folder (default assets/generated/dungeons, never committed):
  layout/<key>.png          image 1 as the model gets it
  <key>-<seed>.png          a painting
  paintings.jsonl           a line per painting: key, seed, words, workflow, settings, time
  state.json                the paths given, the plan's fingerprint at the run's first painting
Needs Python with Pillow and ComfyUI (comfyui start; the GPU runner starts it for its job).
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import math
import os
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.request
from pathlib import Path

from PIL import Image, ImageFilter, ImageOps

ROOT = Path(__file__).resolve().parents[2]


def module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    found = importlib.util.module_from_spec(spec)
    loader.exec_module(found)
    return found


ig = module("imagegen", ROOT / "dev" / "tools" / "imagegen")   # ComfyUI and its workflows

PLAN = ROOT / "dev" / "imagegen" / "maps" / "dungeons.toml"
SET = ROOT / "assets" / "data" / "Dungeons" / "Dungeons.jsonl"
OUT = ROOT / "assets" / "generated" / "dungeons"
COMFY = Path(os.environ.get("IMAGEGEN_HOME", "/data/Projects/ImageGen"))   # ComfyUI's folders (input, output)
ADDRESS = "127.0.0.1:8188"

WORKFLOW = "qwen21-edit-1ref"   # the full model, as the Atlas: these are finished paintings, not drafts
WIDTH, HEIGHT = 2048, 1360      # the game's map art is 3:2
SETTINGS = {"width": WIDTH, "height": HEIGHT, "resolution": WIDTH}
SEEDS = 3                       # paintings of an instance, seeds 1 to 3: one is chosen
BLUR = 10                       # pixels of blur at WIDTH: the shapes stay, lines and writing go
GAP = 24                        # pixels between floors in the layout
CUT = (0.05, 0.09, 0.95, 0.95)  # the part of a floor's map art kept: its frame and the title banner at its top cut off
START = 120                     # seconds ComfyUI may take to start


# --- The plan and the layouts --------------------------------------------------------------------

def plan():
    with PLAN.open("rb") as handle:
        data = tomllib.load(handle)
    words = data.pop("words")
    return words, {int(key): brief for key, brief in data.items()}


def floors_of_set():
    """{key: [(floor, width, height, tile, [(row, column, file)])]} of Core's set Dungeons, in the game's order."""
    found = {}
    for line in SET.open(encoding="utf-8"):
        entry = json.loads(line)
        tiles = entry.get("tiles", [])
        found[int(entry["key"])] = [
            (f["floor"], f["width"], f["height"], f["tile"],
             [(t["row"], t["column"], t["file"]) for t in tiles if t["floor"] == f["floor"]])
            for f in sorted(entry.get("floors", []), key=lambda f: f["floor"])]
    return found


def floor_picture(floor, mapart):
    """A floor's map art: its tiles laid row by row at its size, then CUT; None when a tile is missing."""
    _, width, height, tile, tiles = floor
    picture = Image.new("RGBA", (width, height))
    for row, column, file in tiles:
        path = mapart / f"{file}.blp"
        if not path.is_file():
            return None
        with Image.open(path) as texture:
            picture.paste(texture.convert("RGBA").resize((tile, tile)), (column * tile, row * tile))
    return picture.crop(tuple(round(f * (width, height)[i % 2]) for i, f in enumerate(CUT)))


def levels_of(key, sets, paths):
    """How many floors the instance's layout has from what is on disk (no picture read); 0 when it has none."""
    if key in sets and paths.get("mapart"):
        mapart = Path(paths["mapart"])
        if sets[key] and all((mapart / f"{file}.blp").is_file() for floor in sets[key] for _, _, file in floor[4]):
            return len(sets[key])
    if paths.get("layouts"):
        return len(list(Path(paths["layouts"]).glob(f"{key}-*.png")))
    return 0


def floor_pictures(key, sets, paths):
    """The instance's floors as pictures, from the set's map art or else the given layouts; [] when it has none."""
    if key in sets and paths.get("mapart"):
        pictures = [floor_picture(floor, Path(paths["mapart"])) for floor in sets[key]]
        if pictures and all(pictures):
            return pictures
    if paths.get("layouts"):
        given = sorted(Path(paths["layouts"]).glob(f"{key}-*.png"), key=lambda p: int(p.stem.split("-")[-1]))
        return [Image.open(p).convert("RGBA") for p in given]
    return []


def ground_of(pictures):
    """The colour under the floors: the median of their opaque pixels, channel by channel."""
    histograms = [[0] * 256 for _ in range(3)]
    for picture in pictures:
        small = picture.copy()
        small.thumbnail((256, 256))
        alpha = small.getchannel("A").point(lambda a: 255 if a > 128 else 0)
        for i, channel in enumerate(small.convert("RGB").split()):
            for value, count in enumerate(channel.histogram(alpha)):
                histograms[i][value] += count
    ground = []
    for counts in histograms:
        half, seen = sum(counts) / 2, 0
        for value, count in enumerate(counts):
            seen += count
            if seen >= half:
                ground.append(value)
                break
    return tuple(ground) if len(ground) == 3 else (128, 110, 80)


def layout(pictures):
    """Image 1: the floors in a grid from the top left on their ground colour, at WIDTH x HEIGHT, blurred."""
    ground = ground_of(pictures)
    columns = math.ceil(math.sqrt(len(pictures)))
    rows = math.ceil(len(pictures) / columns)
    cell_w = (WIDTH - GAP * (columns + 1)) / columns
    cell_h = (HEIGHT - GAP * (rows + 1)) / rows
    sheet = Image.new("RGB", (WIDTH, HEIGHT), ground)
    for i, picture in enumerate(pictures):
        scale = min(cell_w / picture.width, cell_h / picture.height)
        size = (max(1, round(picture.width * scale)), max(1, round(picture.height * scale)))
        x = GAP + (i % columns) * (cell_w + GAP) + (cell_w - size[0]) / 2
        y = GAP + (i // columns) * (cell_h + GAP) + (cell_h - size[1]) / 2
        under = Image.new("RGBA", picture.size, ground + (255,))
        under.alpha_composite(picture)
        sheet.paste(under.convert("RGB").resize(size, Image.LANCZOS), (round(x), round(y)))
    sheet = ImageOps.autocontrast(sheet, cutoff=1, preserve_tone=True)   # the game's faint drawing made stronger
    return sheet.filter(ImageFilter.GaussianBlur(BLUR))


def words(fixed, brief, levels):
    parts = [fixed["edit"], brief["setting"]]
    if levels > 1:
        parts.append(fixed["levels"].replace("{n}", str(levels)))
    parts += [brief["layout"], f"Its colours: {brief['colours']}.", brief["atmosphere"], fixed["last"]]
    return " ".join(part.strip() for part in parts)


# --- The run -------------------------------------------------------------------------------------

def load_state(out):
    path = out / "state.json"
    return json.loads(path.read_text()) if path.is_file() else {"paths": {}}


def save_state(out, state):
    out.mkdir(parents=True, exist_ok=True)
    temp = out / "state.tmp"
    temp.write_text(json.dumps(state, indent=1))
    os.replace(temp, out / "state.json")


def fingerprint():
    digest = hashlib.sha1(PLAN.read_bytes())
    digest.update(ig.find_workflow(WORKFLOW).read_bytes())
    return digest.hexdigest()[:12]


def todo(out, keys, seeds=SEEDS):
    """The paintings still to make, (key, seed), the first seed of every instance first."""
    return [(key, seed) for seed in range(1, seeds + 1) for key in keys if not (out / f"{key}-{seed}.png").is_file()]


def reachable():
    try:
        urllib.request.urlopen(ig.Server(ADDRESS).url + "/queue", timeout=3).close()
        return True
    except OSError:
        return False


def start_comfyui():
    if reachable():
        return
    if shutil.which("comfyui"):
        subprocess.run(["comfyui", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        end = time.time() + START
        while time.time() < end:
            if reachable():
                return
            time.sleep(2)
    sys.exit(f"ComfyUI is not reachable at {ADDRESS}: comfyui start")


def paint_one(server, graph, picture_path, prompt, name, seed):
    uploaded = server.upload(picture_path)
    filled = ig.fill(graph, {"prompt": prompt, "name": f"dungeons-{name}", "refs": [picture_path]}, seed, SETTINGS,
                     {picture_path: uploaded})
    entry = server.wait(server.queue(filled))
    if entry.get("status", {}).get("status_str") == "error":
        raise RuntimeError(f"ComfyUI failed on {name}: {json.dumps(entry.get('status'))[:300]}")
    data = next(server.pictures(entry), None)
    if data is None:
        raise RuntimeError(f"ComfyUI gave no picture for {name}")
    for output in entry.get("outputs", {}).values():   # ComfyUI keeps a copy of each: this run's folder has it
        for image in output.get("images", []):
            (COMFY / "output" / image.get("subfolder", "") / image.get("filename", "-")).unlink(missing_ok=True)
    (COMFY / "input" / uploaded).unlink(missing_ok=True)
    return Image.open(io.BytesIO(data)).convert("RGB")


def paint(args):
    out = Path(args.out)
    state = load_state(out)
    for name in ("mapart", "layouts"):
        given = getattr(args, name)
        if given:
            if not Path(given).is_dir():
                sys.exit(f"No folder {given}")
            state["paths"][name] = str(Path(given).resolve())
    save_state(out, state)
    fixed, briefs = plan()
    sets = floors_of_set()
    keys = [key for key in briefs if not args.only or key in args.only]
    (out / "layout").mkdir(parents=True, exist_ok=True)
    levels = {key: levels_of(key, sets, state["paths"]) for key in keys}
    keys = [key for key in keys if levels[key]]
    if not keys:
        sys.exit("No instance has a layout: give --mapart (the game's map art) and --layouts the first time.")
    for key in keys:   # every layout first: cheap, and the run can be looked at before it is painted
        target = out / "layout" / f"{key}.png"
        if not target.is_file():
            layout(floor_pictures(key, sets, state["paths"])).save(target)
    left = todo(out, keys)
    if args.limit:
        left = left[:args.limit]
    if args.dry:
        for key, seed in left[:len(keys)]:
            print(f"{key} ({briefs[key]['name']}, {levels[key]} levels):\n  {words(fixed, briefs[key], levels[key])}\n")
        print(f"{len(left)} paintings to make; the layouts are in {out / 'layout'}")
        return
    if not left:
        print("Every painting is made.")
        return
    if "plan" not in state:
        state["plan"] = {"began": time.strftime("%Y-%m-%d %H:%M"), "fingerprint": fingerprint(), "workflow": WORKFLOW}
        save_state(out, state)
    start_comfyui()
    server = ig.Server(ADDRESS)
    graph = json.loads(ig.find_workflow(WORKFLOW).read_text())
    for n, (key, seed) in enumerate(left, 1):
        prompt = words(fixed, briefs[key], levels[key])
        began = time.time()
        painting = paint_one(server, graph, out / "layout" / f"{key}.png", prompt, str(key), seed)
        temp = out / f"{key}-{seed}.tmp.png"
        painting.save(temp)
        os.replace(temp, out / f"{key}-{seed}.png")
        with (out / "paintings.jsonl").open("a", encoding="utf-8") as log:
            log.write(json.dumps({"key": key, "seed": seed, "words": prompt, "workflow": WORKFLOW,
                                  "settings": SETTINGS, "seconds": round(time.time() - began),
                                  "made": time.strftime("%Y-%m-%d %H:%M")}) + "\n")
        print(f"{n} of {len(left)}: {briefs[key]['name']}, seed {seed} ({round(time.time() - began)} s)", flush=True)


def status(args):
    out = Path(args.out)
    state = load_state(out)
    fixed, briefs = plan()
    sets = floors_of_set()
    painted = [key for key in briefs if levels_of(key, sets, state["paths"])]
    all_ = len(painted or briefs) * SEEDS   # never "0 of 0": without inputs it is not finished
    made = len(painted) * SEEDS - len(todo(out, painted))
    print(f"{made} of {all_} paintings made ({len(painted)} instances, {SEEDS} seeds each)")
    no_layout = [briefs[key]["name"] for key in briefs if key not in painted]
    if no_layout:
        print(f"No layout (the game's map art in --mapart, or pictures in --layouts): {', '.join(no_layout)}")
    no_brief = [str(key) for key in sets if key not in briefs]
    if no_brief:
        print(f"In the set Dungeons without a brief in dungeons.toml: {', '.join(no_brief)}")
    if "plan" in state and state["plan"]["fingerprint"] != fingerprint():
        print(f"The plan changed since the run began ({state['plan']['began']}): saneui rebuild dungeons paints it anew")


def contact(args):
    out = Path(args.out)
    fixed, briefs = plan()
    rows = [key for key in briefs if (out / "layout" / f"{key}.png").is_file()]
    if not rows:
        sys.exit("Nothing painted yet.")
    w, h = 384, 255
    sheet = Image.new("RGB", (w * (SEEDS + 1), h * len(rows)), (40, 40, 40))
    for r, key in enumerate(rows):
        for c, path in enumerate([out / "layout" / f"{key}.png"] + [out / f"{key}-{s}.png" for s in range(1, SEEDS + 1)]):
            if path.is_file():
                with Image.open(path) as picture:
                    sheet.paste(picture.convert("RGB").resize((w, h)), (c * w, r * h))
    sheet.save(out / "contact.jpg", quality=85)
    print(f"{out / 'contact.jpg'}: {len(rows)} instances, their layout and seeds 1 to {SEEDS}")


def rebuild(args):
    out = Path(args.out)
    state = load_state(out)
    if out.is_dir() and any(p.name != "state.json" for p in out.iterdir()):
        aside = out.parent / f"{out.name}-runs" / time.strftime("%Y-%m-%d-%H%M")
        aside.mkdir(parents=True)
        for path in out.iterdir():
            shutil.move(str(path), aside / path.name)
        print(f"The run so far is kept in {aside}.")
    save_state(out, {"paths": state["paths"]})
    print("A new run: its first painting takes the plan as it is then (dungeons.toml, the workflow).")


def main():
    parser = argparse.ArgumentParser(description="The far zoom of Navigation's dungeon and raid maps.")
    parser.add_argument("command", choices=("paint", "status", "contact", "rebuild"))
    parser.add_argument("--mapart")
    parser.add_argument("--layouts")
    parser.add_argument("--only", type=lambda text: {int(k) for k in text.split(",")})
    parser.add_argument("--limit", type=int)
    parser.add_argument("--out", default=str(OUT))
    parser.add_argument("--dry", action="store_true")
    args = parser.parse_args()
    {"paint": paint, "status": status, "contact": contact, "rebuild": rebuild}[args.command](args)


if __name__ == "__main__":
    main()
