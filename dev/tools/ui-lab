def forever_atlases():
    """Forever's own atlases, from the client tables of the newest export's build (beside the config's `client`):
    an atlas has a member per size and per sheet, and Forever draws its own sheet where it has one (the one Retail's
    build lacks), so that is the one taken, its largest picture for the texture and its smallest (or the table's
    override) for the atlas' size, as the game gives it. Rows as the config's atlas table has them; nothing when the
    tables are not on this computer."""
    found = {}
    if not CONF.get("client") or not ART.is_dir():
        return found
    tables = Path(CONF["client"]).parent / ART.parents[1].name
    retail = exports.newest("art", "retail")

    def rows(path, delimiter=","):
        with open(path, encoding="utf-8", newline="") as f:
            yield from csv.DictReader(f, delimiter=delimiter)
    try:
        paths = {int(r["fdid"]): r["path"] for r in rows(ART / "files.tsv", "\t") if r["status"] == "ok"}
        theirs = set()
        if retail:
            theirs = {int(r["fdid"]) for r in rows(retail / "files.tsv", "\t") if r["status"] in ("ok", "decrypted")}
        sheets = {int(r["ID"]): (int(r["FileDataID"]), int(r["AtlasWidth"]), int(r["AtlasHeight"]))
                  for r in rows(tables / "UiTextureAtlas.csv")}
        names = {int(r["ID"]): r["Name"].lower() for r in rows(tables / "UiTextureAtlasElement.csv")}
        cuts = {int(r["UiTextureAtlasElementID"]): r for r in rows(tables / "UiTextureAtlasElementSliceData.csv")}
        members = {}
        for r in rows(tables / "UiTextureAtlasMember.csv"):
            sheet = sheets.get(int(r["UiTextureAtlasID"]))
            if not sheet:
                continue
            fdid = sheet[0]
            file = paths.get(fdid) or (f"fileid:{fdid}" if (GAME_SHEETS / f"{fdid}.blp").is_file() else None)
            if not file:
                continue
            name = names.get(int(r["UiTextureAtlasElementID"])) or r["CommittedName"].lower()
            members.setdefault(name, []).append((fdid not in theirs, file, sheet, r))
    except (OSError, KeyError, ValueError):
        return found
    for name, group in members.items():
        own = [m for m in group if m[0]] or group
        big = max(own, key=lambda m: int(m[3]["Width"]))
        small = min(own, key=lambda m: int(m[3]["Width"]))
        _, file, (fdid, aw, ah), r = big
        w = int(small[3]["OverrideWidth"] or 0) or int(small[3]["Width"])
        h = int(small[3]["OverrideHeight"] or 0) or int(small[3]["Height"])
        flags = int(r["CommittedFlags"] or 0)
        found[name] = {"name": name, "file": file, "fileDataID": str(fdid), "width": str(w), "height": str(h),
                       "left": str(int(r["CommittedLeft"]) / aw), "right": str(int(r["CommittedRight"]) / aw),
                       "top": str(int(r["CommittedTop"]) / ah), "bottom": str(int(r["CommittedBottom"]) / ah),
                       "tileH": "1" if flags & 2 else "0", "tileV": "1" if flags & 4 else "0"}
        cut = cuts.get(int(r["UiTextureAtlasElementID"]))
        if cut:     # the game slices such an atlas by itself: its corners kept, the rest stretched (or tiled)
            found[name]["slice"] = [int(cut[k]) for k in ("Left", "Top", "Right", "Bottom")]
            found[name]["sliceMode"] = int(cut["SliceMode"] or 0)
    return found


def addon_module(addon):
    if addon.lower() == "saneui":
        return "Core"
    if addon.lower().startswith("saneui_"):
        return addon[7:]
    return None


def texture_file(path):
    """The file a texture path (or file ID) of the game's code stands for, or None."""
    if path.startswith("fileid:") or path.isdigit():
        fdid = int(path.split(":")[-1])
        p = listfile().get(fdid)
        if not p:
            sheet = GAME_SHEETS / f"{fdid}.blp"
            return sheet if sheet.is_file() else None
        path = p
    p = path.replace("\\", "/").lstrip("/")
    low = p.lower()
    if low.startswith("interface/addons/"):
        rest = p[len("interface/addons/"):]
        addon, _, inner = rest.partition("/")
        module = addon_module(addon)
        if module:
            hit = FIND.find(ROOT / "assets/optimized" / module, inner)
            if hit:
                return hit
        hit = FIND.find(ROOT / "BUILD" / addon, inner)
        if hit:
            return hit
        for prefix, folder in CONF.get("drafts", {}).items():
            pre = prefix.replace("\\", "/").lower().rstrip("/") + "/"
            if rest.lower().startswith(pre):
                hit = FIND.find(ROOT / folder, rest[len(pre):])
                if hit:
                    return hit
        return None
    if low.startswith("interface/"):
        return FIND.find(ART, p)
    return FIND.find(ROOT, p)


def font_file(path):
    p = path.replace("\\", "/").lstrip("/")
    low = p.lower()
    name = low.rsplit("/", 1)[-1]
    fonts = {**{k: v for k, v in DEFAULT_FONTS.items()}, **{k.lower(): [v] for k, v in CONF.get("fonts", {}).items()}}
    if low.startswith("fonts/"):
        own = GAME_FONTS / name
        for cand in ([str(own)] if own.is_file() else []) + fonts.get(name, []) + FALLBACK_FONT:
            if os.path.exists(cand):
                return Path(cand)
        return None
    if low.startswith("interface/addons/"):
        rest = p[len("interface/addons/"):]
        addon, _, inner = rest.partition("/")
        module = addon_module(addon)
        for base in ([ROOT / "assets/optimized" / module] if module else []) + [ROOT / "BUILD" / addon]:
            hit = FIND.find(base, inner, exts=(".ttf", ".otf"))
            if hit:
                return hit
        hits = [h for h in (ROOT / "assets/fonts").rglob("*") if h.name.lower() == name]
        if hits:
            return hits[0]
    hit = FIND.find(ROOT, p, exts=(".ttf", ".otf"))
    return hit


def font_served(p):
    """Whether /font may send the file: one font_file() gave already (FONTS), or a .ttf or .otf it could give: under
    the system's fonts, a module's Fonts in assets/optimized, the project's assets/fonts, or one of the config's
    fonts. Never a file by its path alone."""
    if p in FONTS:
        return True
    try:
        file = Path(p).resolve(strict=True)
    except OSError:
        return False
    if file.suffix.lower() not in (".ttf", ".otf") or not file.is_file():
        return False
    named = [Path(f).expanduser().resolve() for f in CONF.get("fonts", {}).values()]
    places = [SYSTEM_FONTS, ROOT / "assets/fonts"] + list((ROOT / "assets/optimized").glob("*/Fonts"))
    return file in named or any(file.is_relative_to(place) for place in places)


def blp_raw(path):
    """A BLP2 file the image library does not read right, decoded here; else None. Uncompressed pixels (encoding 3,
    BGRA) it does not read at all. A paletted file (encoding 1) it reads with the palette's own alpha byte, which is
    unused (zero) in the game's files, and never its alpha plane: the cursors and other paletted pictures came out
    transparent. The plane follows the indices at the first mip's offset: a byte a pixel at an alpha depth of 8, two
    pixels a byte at 4 (the low nibble first), eight a byte at 1 (the lowest bit first), nothing at 0 (opaque)."""
    if path.suffix.lower() != ".blp":
        return None
    import struct
    from PIL import Image
    data = path.read_bytes()
    if data[:4] != b"BLP2" or len(data) < 1172 or data[8] not in (1, 3):
        return None
    encoding, depth = data[8], data[9]
    width, height = struct.unpack_from("<II", data, 12)
    offset = struct.unpack_from("<I", data, 20)[0]
    count = width * height
    if encoding == 3:
        raw = data[offset:offset + count * 4]
        if len(raw) < count * 4:
            return None
        return Image.frombytes("RGBA", (width, height), raw, "raw", "BGRA")
    palette = data[148:148 + 1024]                    # 256 entries of BGRA
    indices = data[offset:offset + count]
    plane = data[offset + count:]
    if depth == 8:
        alpha = plane[:count]
    elif depth == 4:
        alpha = bytes(((plane[i >> 1] >> (4 * (i & 1))) & 15) * 17 for i in range(min(count, 2 * len(plane))))
    elif depth == 1:
        alpha = bytes(255 if plane[i >> 3] >> (i & 7) & 1 else 0 for i in range(min(count, 8 * len(plane))))
    else:
        alpha = b"\xff" * count
    if len(indices) < count or len(alpha) < count:
        return None
    img = Image.frombytes("P", (width, height), indices)
    img.putpalette(bytes(palette[4 * i + 2 - c] for i in range(256) for c in range(3)))   # BGR to RGB
    img = img.convert("RGB")
    img.putalpha(Image.frombytes("L", (width, height), alpha))
    return img


def png_of(path):
    """The texture as PNG bytes (BLP and TGA converted once, kept in the cache)."""
    if path.suffix.lower() == ".png":
        return path.read_bytes()
    key = hashlib.sha1(f"{path}:{path.stat().st_mtime}".encode()).hexdigest()[:20]
    out = CACHE / "tex" / (key + ".png")
    if not out.exists():
        from PIL import Image
        out.parent.mkdir(parents=True, exist_ok=True)
        img = blp_raw(path) or Image.open(path)
        img.load()
        img = img.convert("RGBA")
        img.save(out, optimize=False, compress_level=1)
    return out.read_bytes()


# The host's questions ------------------------------------------------------------------------------------------------
FONTS = {}
RANGES = [(32, 592), (0x2000, 0x2070), (0x20AC, 0x20AD), (0x2122, 0x2123), (0x2190, 0x2194), (0x25A0, 0x25D0)]


def font_answer(path):
    f = font_file(path)
    if not f:
        return {"ok": False}
    key = str(f)
    if key not in FONTS:
        from PIL import ImageFont
        try:
            font = ImageFont.truetype(key, 1000)
        except OSError:
            return {"ok": False}
        adv = {}
        for a, b in RANGES:
            for cp in range(a, b):
                try:
                    adv[str(cp)] = round(font.getlength(chr(cp)) / 1000, 4)
                except Exception:
                    pass
        FONTS[key] = {"ok": True, "adv": adv, "url": "font?p=" + urllib.parse.quote(key)}
    return FONTS[key]


def client_answer():
    folder = CONF.get("client")
    if not folder or not os.path.isdir(folder):
        return {"ok": False}
    build = Path(folder).name
    out = CACHE / "cache" / f"client-{build}.lua"
    if not out.exists():
        out.parent.mkdir(parents=True, exist_ok=True)

        def rows(name):
            try:
                with open(Path(folder) / f"{name}.csv", encoding="utf-8", errors="replace", newline="") as f:
                    return list(csv.DictReader(f))
            except OSError:
                return []

        def lua(s):
            return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "") + '"'

        lines = ["return {", "colors = {"]
        for r in rows("GlobalColor"):
            try:
                c = int(r["Color"]) & 0xFFFFFFFF
            except (KeyError, ValueError):
                continue
            a, red, g, b = (c >> 24) & 255, (c >> 16) & 255, (c >> 8) & 255, c & 255
            lines.append(f"[{lua(r['LuaConstantName'])}] = {{{red / 255:.4f}, {g / 255:.4f}, {b / 255:.4f}, {a / 255:.4f}}},")
        lines.append("}, strings = {")
        for r in rows("GlobalStrings"):
            tag = r.get("BaseTag")
            if tag:
                lines.append(f"[{lua(tag)}] = {lua(r.get('TagText_lang', ''))},")
        lines.append("}, classes = {")
        for r in rows("ChrClasses"):
            if r.get("Filename"):
                color = ""
                if r.get("ClassColorR"):
                    color = f", r = {int(r['ClassColorR']) / 255:.4f}, g = {int(r['ClassColorG']) / 255:.4f}, b = {int(r['ClassColorB']) / 255:.4f}"
                lines.append(f"{{ id = {int(r['ID'])}, file = {lua(r['Filename'])}, name = {lua(r['Name_lang'])}, "
                             f"female = {lua(r.get('Name_female_lang') or r['Name_lang'])}{color} }},")
        lines.append("}, races = {")
        for r in rows("ChrRaces"):
            if r.get("ClientFileString"):
                lines.append(f"{{ id = {int(r['ID'])}, file = {lua(r['ClientFileString'])}, name = {lua(r['Name_lang'])} }},")
        lines.append("}, itemClasses = {")
        for r in rows("ItemClass"):
            lines.append(f"[{int(r['ClassID'])}] = {lua(r['ClassName_lang'])},")
        lines.append("}, itemSubClasses = {")
        for r in rows("ItemSubClass"):
            name = r.get("VerboseName_lang") or r.get("DisplayName_lang")
            if name:
                lines.append(f"[{lua(r['ClassID'] + '.' + r['SubClassID'])}] = {lua(name)},")
        lines.append("}}")
        out.write_text("\n".join(lines))
    return {"ok": True, "file": str(out), "build": build}


DATA = {}


def master(set_name):
    if set_name not in DATA:
        table = {}
        for name in (f"{set_name}.jsonl",):
            p = ROOT / "assets/data" / set_name / name
            if p.exists():
                with open(p, encoding="utf-8") as f:
                    for line in f:
                        try:
                            row = json.loads(line)
                        except ValueError:
                            continue
                        table[row.get("key")] = row
        DATA[set_name] = table
    return DATA[set_name]


def answer(q):
    need = q.get("need")
    if need == "font":
        return font_answer(q.get("file", ""))
    if need == "client":
        return client_answer()
    if need == "item":
        row = master("Items").get(q.get("id"))
        return {"ok": bool(row), "item": row}
    if need == "spell":
        row = master("Spells").get(q.get("id"))
        return {"ok": bool(row), "spell": row}
    if need == "fileid":
        p = listfile().get(q.get("id"))
        return {"ok": bool(p), "path": p}
    if need == "atlas":
        row = atlases().get(str(q.get("name", "")).lower())
        if not row:
            return {"ok": False}
        return {"ok": True, "file": row["file"], "w": float(row["width"]), "h": float(row["height"]),
                "l": float(row["left"]), "r": float(row["right"]), "t": float(row["top"]), "b": float(row["bottom"]),
                "tileH": row.get("tileH") == "1", "tileV": row.get("tileV") == "1",
                "slice": row.get("slice"), "sliceMode": row.get("sliceMode", 0)}
    return {"ok": False}


# The host ------------------------------------------------------------------------------------------------------------
class Host:
    """One run of the lab's host: a scene with its world on a screen. Messages go one at a time."""

    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()
        self.files = {}
        self.scene = None
        self.world = "default"
        self.screen = {"pw": 3840, "ph": 2160, "scale": 0.65}
        self.saved = {}
        self.checked = 0
        self.reset = False
        self.asked = 0
        self.watched = False

    def saved_file(self):
        name = Path(self.scene or "none").stem
        return CACHE / "saved" / f"{name}.json"

    def send(self, msg):
        proc = self.proc
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()
        # A message the host never answers (while true do end, run from the console) would hold the lock for ever,
        # every later call of the page waiting behind it: after TIMEOUT seconds the host is killed and the page
        # told; the next call starts it anew.
        killed = []

        def kill():
            killed.append(True)
            proc.kill()

        timer = threading.Timer(TIMEOUT, kill)
        timer.start()
        try:
            while True:
                out = proc.stdout.readline()
                if not out:
                    err = proc.stderr.read() if proc.poll() is not None else ""
                    self.proc = None
                    why = f"no answer in {TIMEOUT} s (an endless loop?), killed" if killed else err[-2000:]
                    return {"changes": {}, "messages": [{"kind": "error", "text": "the lab's host stopped: " + why}]}
                if not out.startswith('{"changes"'):
                    q = json.loads(out)
                    proc.stdin.write(json.dumps(answer(q)) + "\n")
                    proc.stdin.flush()
                    continue
                return json.loads(out)
        finally:
            timer.cancel()

    def stop(self, keep=True):
        if self.proc:
            if keep:
                try:
                    r = self.send({"op": "logout"})
                    if r.get("saved"):
                        self.saved.update(r["saved"])
                        self.saved_file().parent.mkdir(parents=True, exist_ok=True)
                        self.saved_file().write_text(json.dumps(self.saved, indent=1))
                except Exception:
                    pass
            try:
                self.proc.kill()
            except Exception:
                pass
            self.proc = None

    def start(self, scene=None, world=None, screen=None, reload=False):
        self.stop()
        if scene is not None:
            self.scene = scene
        if world:
            self.world = world
        if screen:
            self.screen.update(screen)
        try:
            self.saved = json.loads(self.saved_file().read_text())
        except (OSError, ValueError):
            self.saved = {}
        self.proc = subprocess.Popen(["lua5.1", str(LAB / "host.lua"), str(ROOT), str(CODE or "")], stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1, cwd=ROOT)
        r = self.send({"op": "start", "scene": self.scene, "world": self.world, "screen": self.screen,
                       "saved": self.saved, "reload": reload})
        self.files = {}
        for f in (r.get("files") or []) + [str(p) for p in LAB.rglob("*.lua")]:
            try:
                self.files[f] = os.stat(f).st_mtime
            except OSError:
                pass
        r["reset"] = True
        return r

    def changed(self):
        now = time.time()
        if now - self.checked < 0.4:
            return False
        self.checked = now
        for f, m in self.files.items():
            try:
                if os.stat(f).st_mtime != m:
                    return True
            except OSError:
                return True
        return False

    def call(self, msg):
        with self.lock:
            if not self.proc:
                return self.start(reload=True)
            if msg.get("op") == "frame" and self.changed():
                return self.start(reload=True)
            r = self.send(msg)
            if r.get("reload"):
                return self.start(reload=True)
            return r


HOST = Host()
IDLE = 900      # seconds without a page asking
TIMEOUT = 30    # seconds the host may take over one message; longer is an endless loop, and it is killed
JSON = "application/json"


def scenes():
    out = []
    for p in sorted((LAB / "scenes").glob("*.lua")):
        about = ""
        for line in p.read_text(encoding="utf-8").splitlines():
            if line.startswith("--"):
                about = line[2:].strip()
                break
        out.append({"path": str(p.relative_to(ROOT)), "name": p.stem, "about": about})
    worlds = [p.stem for p in sorted((LAB / "worlds").glob("*.lua"))]
    return {"scenes": out, "worlds": worlds, "scene": HOST.scene, "world": HOST.world, "screen": HOST.screen}


def web(request):
    """The page and its calls (dev/tools/web-pages serves them). The game behind them stops when no page has asked
    for a while, and starts again at the next call."""
    if HOST.scene is None:
        first = sorted((LAB / "scenes").glob("*.lua"))
        HOST.scene = str(first[0].relative_to(ROOT)) if first else None
    if not HOST.watched:
        HOST.watched = True
        threading.Thread(target=watch, daemon=True).start()
    HOST.asked = time.time()
    if request.method == "POST":
        try:
            body = request.json()
        except ValueError:
            body = {}
        return call(request.path, body)
    path, q = request.path, request.query
    if path in ("/", "/index.html"):
        return 200, "text/html; charset=utf-8", (WEB / "index.html").read_bytes()
    if path in ("/lab.js", "/lab.css"):
        kind = "text/javascript" if path.endswith(".js") else "text/css"
        return 200, kind + "; charset=utf-8", (WEB / path[1:]).read_bytes()
    if path == "/api/scenes":
        return 200, JSON, scenes()
    if path == "/tex":
        f = texture_file(q.get("p", [""])[0])
        if not f:
            return 404, "image/png", b""
        # The picture changes only with its file: the browser keeps it and asks whether it is still the same (the
        # file's size and time as the mark), answered with 304 and nothing else.
        stat = os.stat(f)
        mark = f'"{stat.st_size:x}-{int(stat.st_mtime):x}"'
        held = {"ETag": mark, "Cache-Control": "no-cache"}
        if request.headers.get("If-None-Match") == mark:
            return 304, "image/png", b"", held
        try:
            return 200, "image/png", png_of(f), held
        except Exception as e:
            return 500, "text/plain", str(e)
    if path == "/font":
        p = q.get("p", [""])[0]
        if font_served(p):
            return 200, "font/ttf", Path(p).read_bytes()
        return 404, "font/ttf", b""
    if path == "/api/source":
        p = (ROOT / q.get("f", [""])[0]).resolve()
        if ROOT in p.parents and p.suffix == ".lua" and p.exists():
            return 200, "text/plain; charset=utf-8", p.read_text(encoding="utf-8")
        return 404, "text/plain", ""
    return 404, "text/plain", b""


def call(path, body):
    if path == "/api/start":
        with HOST.lock:
            return 200, JSON, HOST.start(scene=body.get("scene"), world=body.get("world"), screen=body.get("screen"))
    if path == "/api/frame":
        return 200, JSON, HOST.call({"op": "frame", "dt": body.get("dt", 0), "input": body.get("input", [])})
    if path == "/api/run":
        return 200, JSON, HOST.call({"op": "run", "code": body.get("code", "")})
    if path == "/api/server":
        return 200, JSON, HOST.call({"op": "server", **body})
    if path == "/api/inspect":
        return 200, JSON, HOST.call({"op": "inspect", "x": body.get("x", 0), "y": body.get("y", 0)})
    if path == "/api/screen":
        HOST.screen.update(body)
        return 200, JSON, HOST.call({"op": "screen", **HOST.screen})
    if path == "/api/redraw":
        return 200, JSON, HOST.call({"op": "redraw"})
    if path == "/api/reset":
        with HOST.lock:
            HOST.saved = {}
            try:
                HOST.saved_file().unlink()
            except OSError:
                pass
            HOST.stop(keep=False)
            return 200, JSON, HOST.start()
    return 404, JSON, {"error": "unknown"}


def watch():
    """The server runs all the time: a game no page asks for goes, its saved settings kept."""
    while True:
        time.sleep(60)
        if HOST.proc and time.time() - HOST.asked > IDLE:
            stop()


def stop():
    with HOST.lock:
        HOST.stop()


def check(scene, seconds):
    """Runs a scene without the page: starts it, steps it some seconds, prints what it told; 1 on an error."""
    if scene and not scene.endswith(".lua"):
        scene = f"dev/uilab/scenes/{scene}.lua"
    first = sorted((LAB / "scenes").glob("*.lua"))
    HOST.scene = scene or (str(first[0].relative_to(ROOT)) if first else None)
    errors = 0
    items = 0

    def show(r):
        nonlocal errors, items
        items += sum(1 for v in (r.get("changes") or {}).values() if v is not None)
        for m in r.get("messages") or []:
            if m.get("kind") in ("error",):
                errors += 1
            if m.get("kind") != "lab":
                print(f"{m.get('kind'):>8}: {m.get('text')}" + (("\n" + m["stack"]) if m.get("stack") else ""))

    t0 = time.time()
    show(HOST.start())
    steps = int(seconds * 30)
    for _ in range(steps):
        show(HOST.call({"op": "frame", "dt": 1 / 30, "input": []}))
    HOST.stop(keep=False)
    print(f"{HOST.scene}: {items} drawn items, {errors} errors, {time.time() - t0:.1f} s")
    return 1 if errors else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("serve")
    s.add_argument("--port", type=int, required=True)
    c = sub.add_parser("check")
    c.add_argument("scene", nargs="?")
    c.add_argument("--seconds", type=float, default=3)
    a = ap.parse_args()
    if a.cmd == "check":
        sys.exit(check(a.scene, a.seconds))
    if a.cmd != "serve":
        ap.exit(2, ap.format_help())
    pages = str(ROOT / "dev" / "tools" / "web-pages")
    os.execv(pages, [pages, "run", "--port", str(a.port)])


if __name__ == "__main__":
    main()
