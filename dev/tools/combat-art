#!/usr/bin/env python3
"""Draws the pictures of the combat text (Nameplates, CombatText.lua) for what a hit did not do: a miss, a dodge,
a parry, a block, an evade, an immunity. assets/CombatText/<name>.png, 1024 x 1024.

Pencil line drawings (Doc/guides/interface-style.md, *Pencil pieces*: clean lines, firm strokes running a little
past their ends, a light second pass; nothing filled or shaded), in white on transparency, so the game can tint
them, with thick lines and a dark edge round them, so they read over any ground as the combat text's outlined
letters do:
    miss     an arrow flying high over a target
    dodge    a figure bending far back, an arrow flying over it
    parry    two swords crossed, sparks where they meet
    block    a shield, an arrow's strike glancing off its edge
    evade    a figure leaning hard to its side, the arrow at its face flying past where the head was
    immune   a bubble with its shine, an "i" in its middle
(the drawings in code; picked ones take their place, below)
A drawing picked from the image model's (dev/imagegen/sets/combat-text/) is kept as assets/interface/combat-text/<name>.png
and traced in place of the one in code: its dark lines, thickened, in white with the dark edge. The immunity's "i" is
Kalam Bold, written in by code over either.
dev/tools/art makes the game's textures of them (assets/optimized/Nameplates/Art/<name>.blp, drawn 30 x 30, made for 48). A
drawing by hand can take a picture's place in assets/CombatText/ under the same name.

Needs Python with Pillow and NumPy.

Usage:  dev/tools/combat-art          writes assets/CombatText/*.png, then run dev/tools/art
        dev/tools/combat-art <name>   that picture alone
        dev/tools/combat-art --try    other ideas to choose from, into assets/generated/CombatText/
"""
import math
import random
import sys
from pathlib import Path

import numpy as np
from PIL import Image, ImageChops, ImageDraw, ImageFilter, ImageFont

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "assets" / "CombatText"
# Drawings picked from the image model's (dev/imagegen/sets/combat-text/), one a name: where there is one, it is traced
# in place of the drawing in code below.
PICKED = ROOT / "assets" / "interface" / "combat-text"
KALAM = ROOT / "assets" / "optimized" / "Core" / "Fonts" / "Kalam-Bold.ttf"
THICK = 17           # a traced drawing's lines made thicker by a max filter this wide (in N), so they hold at their size
THICKS = {"parry": 9, "block": 9, "immune": 27}  # Saneroki, 2026-10-23: parry and block thinner, the bubble thicker
LETTER = 0.50        # the immunity's "i": its height, a share of the picture
LETTER_TRACED = 0.66 # the same in a traced bubble (Saneroki, 2026-10-23: a bigger "i")
N = 1024
WIDTH = 0.058        # a stroke's width, a share of the picture
SECOND = 0.5         # the second pass: its strength and its width, shares of the first
WOBBLE = 0.004       # how far a hand's line strays, a share of the picture
PAST = 0.035         # how far a straight stroke runs past its ends, a share of its length
EDGE = 0.022         # the dark edge round the lines, a share of the picture
EDGE_ALPHA = 0.75    # its strength
FAINT = 0.45         # a see-through stroke's strength (a figure that is not there)
FAINT_EDGE = 0.45    # the dark edge round it, a share of the lines' edge


def bend(points, steps=24):
    """A smooth curve through the points (Catmull-Rom), as many points."""
    if len(points) < 3:
        return points
    pts = [points[0]] + points + [points[-1]]
    out = []
    for i in range(1, len(pts) - 2):
        p0, p1, p2, p3 = pts[i - 1], pts[i], pts[i + 1], pts[i + 2]
        for s in range(steps):
            t = s / steps
            out.append(tuple(0.5 * ((2 * p1[k]) + (-p0[k] + p2[k]) * t + (2 * p0[k] - 5 * p1[k] + 4 * p2[k] - p3[k]) * t * t
                                    + (-p0[k] + 3 * p1[k] - 3 * p2[k] + p3[k]) * t ** 3) for k in (0, 1)))
    out.append(points[-1])
    return out


def arc(cx, cy, r, start, stop, steps=48):
    """Points on a circle, from start to stop (degrees, clockwise on the screen)."""
    return [(cx + r * math.cos(math.radians(a)), cy + r * math.sin(math.radians(a)))
            for a in np.linspace(start, stop, steps)]


def past(points, share=PAST):
    """A straight stroke run a little past both its ends, as a quick hand draws it."""
    (x0, y0), (x1, y1) = points[0], points[-1]
    dx, dy = (x1 - x0) * share, (y1 - y0) * share
    return [(x0 - dx, y0 - dy)] + points[1:-1] + [(x1 + dx, y1 + dy)]


class Sheet:
    def __init__(self, seed):
        self.lines = Image.new("L", (N, N), 0)
        self.faint = Image.new("L", (N, N), 0)  # see-through strokes: white at FAINT, no dark edge, under the rest
        self.rand = random.Random(seed)

    def stroke(self, points, width=1.0, curve=False, faint=False):
        """One stroke of the pencil through points (shares of the picture): tapered at its ends, its line a little
        unsteady; a lighter, thinner second pass beside it."""
        pts = bend(points) if curve else points
        for alpha, wide, shift in ((1.0, width, 0.0), (SECOND, width * SECOND, 1.0)):
            layer = Image.new("L", (N, N), 0)
            draw = ImageDraw.Draw(layer)
            dx, dy = (self.rand.uniform(-1, 1) * WOBBLE * 1.5 * shift for _ in range(2))
            dense = []
            for a, b in zip(pts, pts[1:]):
                n = max(2, int(math.hypot(b[0] - a[0], b[1] - a[1]) * N / 2))
                dense += [(a[0] + (b[0] - a[0]) * i / n, a[1] + (b[1] - a[1]) * i / n) for i in range(n)]
            dense.append(pts[-1])
            phase = self.rand.uniform(0, math.tau)
            for i, (x, y) in enumerate(dense):
                t = i / max(1, len(dense) - 1)
                taper = 0.6 + 0.4 * math.sin(math.pi * t)
                r = WIDTH * N * wide * taper / 2
                wob = WOBBLE * N * math.sin(t * 9 + phase)
                cx, cy = (x + dx) * N + wob * 0.6, (y + dy) * N + wob
                level = int(255 * alpha)
                draw.ellipse([cx - r, cy - r, cx + r, cy + r], fill=level)
            if faint:
                self.faint = ImageChops.lighter(self.faint, layer)
            else:
                self.lines = ImageChops.lighter(self.lines, layer)  # where strokes cross, the stronger stays

    def picture(self):
        """White lines with a soft grain, on a dark edge, on transparency. Bottom up: the see-through strokes' light
        edge, those strokes in faint white, the lines' edge, the lines."""
        grain = np.asarray(Image.effect_noise((N, N), 40).filter(ImageFilter.GaussianBlur(1.2)), dtype=np.float32) / 255
        line = np.clip(np.asarray(self.lines, dtype=np.float32) / 255 * (0.82 + 0.3 * grain), 0, 1)
        shape = np.asarray(self.faint, dtype=np.float32) / 255
        k = int(EDGE * N) | 1

        def around(layer):
            spread = layer.filter(ImageFilter.MaxFilter(k)).filter(ImageFilter.GaussianBlur(k / 4))
            return np.clip(np.asarray(spread, dtype=np.float32) / 255 * 1.4, 0, 1) * EDGE_ALPHA

        # (value, alpha) laid over each other, "over" each time
        value, alpha = np.zeros((N, N)), np.zeros((N, N))
        for v, a in ((0.0, around(self.faint) * FAINT_EDGE * (1 - shape)), (1.0, shape * FAINT),
                     (0.0, around(self.lines)), (1.0, line)):
            out = a + alpha * (1 - a)
            value = np.where(out > 0, (v * a + value * alpha * (1 - a)) / np.maximum(out, 1e-6), 0)
            alpha = out
        rgba = np.zeros((N, N, 4), dtype=np.uint8)
        rgba[..., 0] = rgba[..., 1] = rgba[..., 2] = np.clip(value * 255, 0, 255).astype(np.uint8)
        rgba[..., 3] = np.clip(alpha * 255, 0, 255).astype(np.uint8)
        return Image.fromarray(rgba, "RGBA")


def arrow_head(s, tip, back, size=0.11, spread=28, width=1.0):
    """An arrow's head at tip, pointing away from back: two strokes."""
    angle = math.atan2(tip[1] - back[1], tip[0] - back[0])
    for side in (-1, 1):
        a = angle + math.pi - math.radians(spread) * side
        s.stroke(past([tip, (tip[0] + size * math.cos(a), tip[1] + size * math.sin(a))], 0.02), width)


def miss(s):
    # The target, low and left; the arrow high over it, away to the right, two swishes under its flight.
    s.stroke(arc(0.38, 0.64, 0.25, -80, 285, 64), curve=False)
    s.stroke(arc(0.38, 0.64, 0.11, 100, 465, 40), 0.85)
    s.stroke(past([(0.08, 0.30), (0.88, 0.14)]), 1.0)
    arrow_head(s, (0.90, 0.135), (0.08, 0.30), 0.12)
    for off in (0.0, 0.05):  # the fletching
        s.stroke([(0.11 + off, 0.295 - off * 0.2), (0.05 + off, 0.21 - off * 0.2)], 0.7)
        s.stroke([(0.11 + off, 0.295 - off * 0.2), (0.08 + off, 0.38 - off * 0.2)], 0.7)
    s.stroke([(0.52, 0.31), (0.76, 0.26)], 0.55)
    s.stroke([(0.60, 0.37), (0.80, 0.33)], 0.45)


def sword(s, hilt, tip, width=1.0):
    """A sword from the end of its grip to its point: its blade (two edges), the guard, the grip."""
    ang = math.atan2(tip[1] - hilt[1], tip[0] - hilt[0])
    ux, uy = math.cos(ang), math.sin(ang)
    px, py = -uy, ux
    grip = 0.13
    guard = (hilt[0] + ux * grip, hilt[1] + uy * grip)
    half = 0.03
    s.stroke(past([(guard[0] + px * half, guard[1] + py * half), (tip[0] - ux * 0.05 + px * half * 0.6, tip[1] - uy * 0.05 + py * half * 0.6)], 0.01), width * 0.75)
    s.stroke(past([(guard[0] - px * half, guard[1] - py * half), (tip[0] - ux * 0.05 - px * half * 0.6, tip[1] - uy * 0.05 - py * half * 0.6)], 0.01), width * 0.75)
    s.stroke([(tip[0] - ux * 0.05 + px * half * 0.6, tip[1] - uy * 0.05 + py * half * 0.6), tip,
              (tip[0] - ux * 0.05 - px * half * 0.6, tip[1] - uy * 0.05 - py * half * 0.6)], width * 0.75)
    s.stroke(past([(guard[0] + px * 0.10, guard[1] + py * 0.10), (guard[0] - px * 0.10, guard[1] - py * 0.10)]), width)
    s.stroke(past([hilt, guard], 0.0), width)


def parry(s):
    sword(s, (0.14, 0.88), (0.80, 0.16))
    sword(s, (0.86, 0.88), (0.20, 0.16))
    for a in (-120, -90, -60):  # sparks over the crossing
        r0, r1 = 0.07, 0.17
        c = (0.50, 0.42)
        s.stroke([(c[0] + r0 * math.cos(math.radians(a)), c[1] + r0 * math.sin(math.radians(a))),
                  (c[0] + r1 * math.cos(math.radians(a)), c[1] + r1 * math.sin(math.radians(a)))], 0.55)


def block(s):
    # A heater shield, its rim drawn once round, a band across; a strike glancing off its upper left.
    rim = [(0.30, 0.22), (0.50, 0.17), (0.70, 0.22), (0.70, 0.50), (0.62, 0.70), (0.50, 0.84), (0.38, 0.70),
           (0.30, 0.50), (0.30, 0.22)]
    s.stroke(rim, 1.0, curve=True)
    s.stroke(past([(0.50, 0.24), (0.50, 0.76)]), 0.7)
    s.stroke(past([(0.34, 0.42), (0.66, 0.42)]), 0.7)
    for (x0, y0), (x1, y1) in (((0.25, 0.22), (0.12, 0.12)), ((0.23, 0.30), (0.08, 0.30)), ((0.29, 0.16), (0.24, 0.04))):
        s.stroke(past([(x0, y0), (x1, y1)]), 0.55)


def immune(s):
    # A bubble with its shine on the upper left; the "i" in it is Kalam's (letter()).
    s.stroke(arc(0.50, 0.52, 0.38, 0, 362, 96), 1.0)
    s.stroke(arc(0.50, 0.52, 0.28, 195, 255, 24), 0.6)


def letter(s, text="i", centre=(0.50, 0.52), size=LETTER):
    """A letter in Kalam Bold into the lines, centred: the immunity's "i" (Saneroki, 2026-10-23: our own font)."""
    font = ImageFont.truetype(str(KALAM), int(N * size))
    layer = Image.new("L", (N, N), 0)
    ImageDraw.Draw(layer).text((centre[0] * N, centre[1] * N), text, fill=255, font=font, anchor="mm")
    s.lines = ImageChops.lighter(s.lines, layer)


def trace(path, thick=THICK):
    """A picked drawing's lines (dark and solid: the pencil), cropped into a square with a little room, at N, made a
    little thicker."""
    im = Image.open(path).convert("RGBA")
    shape = np.asarray(im.getchannel("A"), dtype=np.float32) / 255
    lum = np.asarray(im.convert("L"), dtype=np.float32) / 255
    ink = Image.fromarray((np.clip(shape * (1 - lum) * 2.2, 0, 1) * 255).astype(np.uint8))
    box = ink.point(lambda v: 255 if v > 40 else 0).getbbox()
    ink = ink.crop(box)
    w, h = ink.size
    side = int(max(w, h) * 1.12)
    square = Image.new("L", (side, side), 0)
    square.paste(ink, ((side - w) // 2, (side - h) // 2))
    return square.resize((N, N), Image.LANCZOS).filter(ImageFilter.MaxFilter(thick))


def figure(s, head, neck, hips, hands, feet, width=1.0):
    """A stick figure: its head round, its body from neck to hips, arms from the neck to each hand, legs from the
    hips to each foot (each a point, or a list of points through a knee or an elbow)."""
    s.stroke(arc(head[0], head[1], 0.065, 0, 362, 40), width)
    s.stroke([neck, hips], width)
    for limb in hands:
        s.stroke([neck] + (limb if isinstance(limb, list) else [limb]), width * 0.9)
    for limb in feet:
        s.stroke([hips] + (limb if isinstance(limb, list) else [limb]), width * 0.9)


def arrow(s, tail, tip, head=0.11, width=1.0):
    """An arrow in flight: its shaft, its head, its fletching."""
    s.stroke(past([tail, tip], 0.0), width)
    arrow_head(s, tip, tail, head, 28, width)
    ang = math.atan2(tip[1] - tail[1], tip[0] - tail[0])
    for side in (-1, 1):
        a = ang + math.pi - math.radians(40) * side
        s.stroke([tail, (tail[0] + 0.07 * math.cos(a), tail[1] + 0.07 * math.sin(a))], width * 0.7)


def dodge(s):
    # Bent far back, the arrow flying over: dodged.
    figure(s, head=(0.86, 0.50), neck=(0.78, 0.56), hips=(0.60, 0.70),
           hands=[[(0.80, 0.70), (0.90, 0.78)], [(0.70, 0.46), (0.66, 0.36)]],
           feet=[[(0.52, 0.80), (0.42, 0.92)], [(0.66, 0.82), (0.66, 0.94)]])
    arrow(s, (0.12, 0.28), (0.90, 0.28))
    s.stroke(arc(0.70, 0.52, 0.20, 200, 245, 16), 0.5)  # the swing of the lean


def ghost(s, x=0.50):
    """A see-through figure, standing, arms a little out."""
    s.stroke(arc(x, 0.19, 0.085, 0, 362, 48), 1.2, faint=True)
    s.stroke([(x, 0.29), (x, 0.62)], 1.4, faint=True)
    s.stroke([(x, 0.36), (x - 0.18, 0.56)], 1.2, faint=True)
    s.stroke([(x, 0.36), (x + 0.18, 0.56)], 1.2, faint=True)
    s.stroke([(x, 0.62), (x - 0.12, 0.92)], 1.2, faint=True)
    s.stroke([(x, 0.62), (x + 0.12, 0.92)], 1.2, faint=True)


def evade(s):
    # Facing you, leaning hard to its side: the arrow that flew at its face flies on through where the head was.
    hips = (0.40, 0.68)
    figure(s, head=(0.76, 0.44), neck=(0.65, 0.50), hips=hips,
           hands=[[(0.50, 0.54), (0.36, 0.62)], [(0.76, 0.62), (0.82, 0.74)]],
           feet=[[(0.32, 0.81), (0.28, 0.94)], [(0.50, 0.81), (0.54, 0.94)]])
    arrow(s, (0.11, 0.27), (0.94, 0.27))
    for radius in (0.30, 0.23):  # the swing of the head out of its way, from upright
        s.stroke(arc(hips[0], hips[1], radius, -84, -56, 16), 0.45)


def evade_swing(s):
    # The same with a sword's swing cutting through it, from its upper right to its lower left.
    ghost(s)
    s.stroke(arc(0.98, 0.98, 0.76, 188, 266, 48), 1.1)
    s.stroke(arc(0.98, 0.98, 0.66, 196, 250, 32), 0.5)
    s.stroke(arc(0.98, 0.98, 0.56, 205, 238, 20), 0.4)


DRAWINGS = {"miss": miss, "dodge": dodge, "parry": parry, "block": block, "evade": evade, "immune": immune}
# Other ideas to choose from (--try): written to assets/generated/CombatText/, not shipped.
TRIES = {"evade-swing": evade_swing}


def main(names):
    drawings, out = DRAWINGS, OUT
    if names and names[0] == "--try":
        drawings, out, names = TRIES, ROOT / "assets" / "generated" / "CombatText", names[1:]
    out.mkdir(parents=True, exist_ok=True)
    for index, name in enumerate(drawings):
        if names and name not in names:
            continue
        sheet = Sheet(index + 1)
        picked = PICKED / f"{name}.png"
        traced = drawings is DRAWINGS and picked.exists()
        if traced:
            sheet.lines = trace(picked, THICKS.get(name, THICK))
        else:
            drawings[name](sheet)
        if name == "immune":
            letter(sheet, centre=(0.50, 0.50) if traced else (0.50, 0.52), size=LETTER_TRACED if traced else LETTER)
        path = out / f"{name}.png"
        sheet.picture().save(path)
        print(f"{name}: {path.relative_to(ROOT)}")


if __name__ == "__main__":
    main(sys.argv[1:])
