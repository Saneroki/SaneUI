def rows_of(path, delimiter=","):
    with open(path, encoding="utf-8", newline="") as f:
        yield from csv.DictReader(f, delimiter=delimiter)


class Art:
    """The newest export's art with the tables of its build: the sheets, cut as the game cuts them."""

    def __init__(self):
        self.folder = export.required("art")
        conf = json.loads((Path.home() / ".config" / "saneui" / "uilab.json").read_text())
        self.tables = Path(conf["client"]).parent / self.folder.parents[1].name
        self.paths = {}
        for row in rows_of(self.folder / "files.tsv", "\t"):
            if row["status"] == "ok":
                self.paths[int(row["fdid"])] = row["path"]
        sheets = {}
        for row in rows_of(self.tables / "UiTextureAtlas.csv"):
            sheets[int(row["ID"])] = int(row["FileDataID"])
        names = {int(r["ID"]): r["Name"] for r in rows_of(self.tables / "UiTextureAtlasElement.csv")}
        self.pieces = {}
        for row in rows_of(self.tables / "UiTextureAtlasMember.csv"):
            sheet = sheets.get(int(row["UiTextureAtlasID"]))
            if sheet is None:
                continue
            # the elements hold the names Blizzard's code uses; a member's own may be an older one
            name = names.get(int(row["UiTextureAtlasElementID"])) or row["CommittedName"]
            self.pieces[name.lower()] = {
                "name": name, "sheet": sheet,
                "box": (int(row["CommittedLeft"]), int(row["CommittedTop"]), int(row["CommittedRight"]),
                        int(row["CommittedBottom"])),
                "element": int(row["UiTextureAtlasElementID"]),
            }
        self.slices = {}
        for row in rows_of(self.tables / "UiTextureAtlasElementSliceData.csv"):
            self.slices[int(row["UiTextureAtlasElementID"])] = tuple(int(row[k]) for k in ("Left", "Top", "Right", "Bottom"))
        # files.tsv also lists what a build does not hold: only these statuses are really there
        retail = export.newest("art", "retail")
        self.retail = {int(r["fdid"]) for r in rows_of(retail / "files.tsv", "\t") if r["status"] in ("ok", "decrypted")}
        self.retail_names = set()
        for row in rows_of(Path(conf["client"]).parent / retail.parents[1].name / "UiTextureAtlasElement.csv"):
            self.retail_names.add(row["Name"].lower().replace("-2x", ""))
        self.loaded = {}

    def sheet_file(self, fdid):
        extra = SHEETS / f"{fdid}.blp"
        if extra.is_file():
            return extra
        path = self.paths.get(fdid)
        return self.folder / path if path else None

    @staticmethod
    def read(path):
        data = path.read_bytes()
        if data[:4] == b"BLP2" and data[8] == 3:    # uncompressed pixels, which the image library does not read
            width = int.from_bytes(data[12:16], "little")
            height = int.from_bytes(data[16:20], "little")
            offset = int.from_bytes(data[20:24], "little")
            return Image.frombytes("RGBA", (width, height), data[offset:offset + width * height * 4], "raw", "BGRA")
        image = Image.open(path)
        image.load()
        return image.convert("RGBA")

    def sheet(self, fdid):
        if fdid not in self.loaded:
            path = self.sheet_file(fdid)
            try:
                self.loaded[fdid] = self.read(path) if path and path.is_file() else None
            except Exception as err:
                print(f"  cannot read {path}: {err}")
                self.loaded[fdid] = None
        return self.loaded[fdid]

    def cut(self, piece):
        sheet = self.sheet(piece["sheet"])
        return sheet.crop(piece["box"]) if sheet else None

    def best(self, name):
        """The piece Forever draws for a name of Blizzard's code: its own, the larger size, and how many times too
        large that is for the screen."""
        name = name.lower()
        for suffix, scale in (("-c60-2x", 2), ("-c60", 1), ("-2x", 2), ("", 1)):
            found = self.pieces.get(name + suffix)
            if found and self.sheet_file(found["sheet"]):
                return found, scale
        return None, 1


def retail_says(art, item):
    """What a card says of Retail: nothing where it draws the same file."""
    if "file" in item:
        return "" if item["file"] in art.retail else "Forever only"
    piece = item["states"][0][1][1]
    if piece["sheet"] in art.retail:
        return ""
    return "Retail: own look" if item["key"][len("atlas:"):] in art.retail_names else "Forever only"


def root_of(name):
    """A piece's name without the size, Forever's mark and its state, and the state: the states of one thing share a
    number."""
    base = name.lower().replace("-c60", "").replace("-2x", "")
    state = []
    while True:
        found = STATE.search(base)
        if not found or found.start() == 0:
            break
        state.insert(0, found.group(1))
        base = base[:found.start()]
    return base, "-".join(state)


def strip(pictures, gap=12, width=LARGEST):
    """Pictures side by side, in rows no wider than width."""
    rows, row, used = [], [], 0
    for picture in pictures:
        if row and used + gap + picture.width > width:
            rows.append(row)
            row, used = [], 0
        row.append(picture)
        used += picture.width + gap
    rows.append(row)
    total = max(sum(p.width for p in r) + gap * (len(r) - 1) for r in rows)
    high = sum(max(p.height for p in r) for r in rows) + gap * (len(rows) - 1)
    out = Image.new("RGBA", (total, high), (0, 0, 0, 0))
    y = 0
    for r in rows:
        x, tall = 0, max(p.height for p in r)
        for p in r:
            out.alpha_composite(p, (x, y + (tall - p.height) // 2))
            x += p.width + gap
        y += tall + gap
    return out


def fitted(picture):
    if max(picture.size) > LARGEST:
        k = LARGEST / max(picture.size)
        picture = picture.resize((max(1, round(picture.width * k)), max(1, round(picture.height * k))), Image.LANCZOS)
    return picture


def empty(picture):
    return picture is None or min(picture.size) < 1 or picture.getchannel("A").getextrema()[1] < 16


# Whole windows ------------------------------------------------------------------------------------------------------
def layouts(code):
    """Blizzard's nine-slice layouts: name -> piece -> what its entry says."""
    text = (code / "Interface/AddOns/Blizzard_SharedXML/Mainline/NineSliceLayouts.lua").read_text(encoding="utf-8")
    found = {}
    name = None
    for line in text.splitlines():
        head = re.match(r"\t([A-Za-z0-9_]+) *=\s*$", line)
        if head:
            name = head.group(1)
            found[name] = {"mirror": False}
            continue
        if name is None:
            continue
        if re.match(r"\t\tmirrorLayout = true", line):
            found[name]["mirror"] = True
        piece = re.match(r'\t\t\[?"?(\w+)"?\]?\s*=\s*\{(.*)\}', line)
        if piece and 'atlas' in piece.group(2):
            fields = dict(re.findall(r'(\w+)\s*=\s*"?(-?[\w!_%-]+)"?', piece.group(2)))
            found[name][piece.group(1)] = fields
    return found


def fill(canvas, tile, box, across):
    """A tile repeated over a box of the canvas (across: along its width, else along its height)."""
    x0, y0, x1, y1 = [int(v) for v in box]
    if x1 <= x0 or y1 <= y0:
        return
    if across:
        tile = tile.resize((tile.width, y1 - y0)) if tile.height != y1 - y0 else tile
        for x in range(x0, x1, tile.width):
            canvas.alpha_composite(tile.crop((0, 0, min(tile.width, x1 - x), tile.height)), (x, y0))
    else:
        tile = tile.resize((x1 - x0, tile.height)) if tile.width != x1 - x0 else tile
        for y in range(y0, y1, tile.height):
            canvas.alpha_composite(tile.crop((0, 0, tile.width, min(tile.height, y1 - y))), (x0, y))


def window(art, layout, width=620, height=420, margin=44):
    """A layout put together at twice the screen's size, as the -2x pieces are drawn, over a plain dark page."""
    canvas = Image.new("RGBA", (width + margin * 2, height + margin * 2), (0, 0, 0, 0))
    canvas.paste((20, 16, 13, 255), (margin + 8, margin + 8, margin + width - 8, margin + height - 8))
    part = {}
    for key in ("TopLeftCorner", "TopRightCorner", "BottomLeftCorner", "BottomRightCorner", "TopEdge", "BottomEdge",
                "LeftEdge", "RightEdge", "Center"):
        entry = layout.get(key)
        if not entry or "%" in entry.get("atlas", ""):
            continue
        piece, scale = art.best(entry["atlas"])
        picture = art.cut(piece) if piece else None
        if empty(picture):
            continue
        if scale == 1:
            picture = picture.resize((picture.width * 2, picture.height * 2), Image.LANCZOS)
        mirror = layout["mirror"] or entry.get("mirrorLayout") == "true"
        if mirror and key in ("TopRightCorner", "BottomRightCorner"):
            picture = picture.transpose(Image.FLIP_LEFT_RIGHT)
        if mirror and key in ("BottomLeftCorner", "BottomRightCorner"):
            picture = picture.transpose(Image.FLIP_TOP_BOTTOM)
        if mirror and key == "BottomEdge" and entry.get("mirrorLayout") != "false":
            picture = picture.transpose(Image.FLIP_TOP_BOTTOM)
        if mirror and key == "RightEdge" and entry.get("mirrorLayout") != "false":
            picture = picture.transpose(Image.FLIP_LEFT_RIGHT)
        part[key] = (picture, int(float(entry.get("x", 0))) * 2, int(float(entry.get("y", 0))) * 2)
    if not {"TopLeftCorner", "TopEdge"} <= set(part):
        return None
    l, t, r, b = margin, margin, margin + width, margin + height
    tl, tr, bl, br = (part.get(k, (Image.new("RGBA", (1, 1)), 0, 0)) for k in
                      ("TopLeftCorner", "TopRightCorner", "BottomLeftCorner", "BottomRightCorner"))
    if "Center" in part:
        fill(canvas, part["Center"][0], (l, t, r, b), True)
    if "TopEdge" in part:
        fill(canvas, part["TopEdge"][0], (l + tl[1] + tl[0].width, t - tl[2], r + tr[1] - tr[0].width,
                                          t - tl[2] + part["TopEdge"][0].height), True)
    if "BottomEdge" in part:
        fill(canvas, part["BottomEdge"][0], (l + bl[1] + bl[0].width, b - bl[2] - part["BottomEdge"][0].height,
                                             r + br[1] - br[0].width, b - bl[2]), True)
    if "LeftEdge" in part:
        fill(canvas, part["LeftEdge"][0], (l + tl[1], t - tl[2] + tl[0].height, l + tl[1] + part["LeftEdge"][0].width,
                                           b - bl[2] - bl[0].height), False)
    if "RightEdge" in part:
        fill(canvas, part["RightEdge"][0], (r + tr[1] - part["RightEdge"][0].width, t - tr[2] + tr[0].height,
                                            r + tr[1], b - br[2] - br[0].height), False)
    canvas.alpha_composite(tl[0], (max(0, l + tl[1]), max(0, t - tl[2])))
    canvas.alpha_composite(tr[0], (max(0, r + tr[1] - tr[0].width), max(0, t - tr[2])))
    canvas.alpha_composite(bl[0], (max(0, l + bl[1]), max(0, b - bl[2] - bl[0].height)))
    canvas.alpha_composite(br[0], (max(0, r + br[1] - br[0].width), max(0, b - br[2] - br[0].height)))
    return canvas.crop(canvas.getbbox())


def stretched(picture, sides, width, height):
    """A nine-slice piece at any size: its corners whole, its sides and middle stretched."""
    left, top, right, bottom = sides
    w, h = picture.size
    out = Image.new("RGBA", (width, height), (0, 0, 0, 0))
    xs = [(0, left, 0, left), (left, w - right, left, width - right), (w - right, w, width - right, width)]
    ys = [(0, top, 0, top), (top, h - bottom, top, height - bottom), (h - bottom, h, height - bottom, height)]
    for sy0, sy1, dy0, dy1 in ys:
        for sx0, sx1, dx0, dx1 in xs:
            if sx1 > sx0 and sy1 > sy0 and dx1 > dx0 and dy1 > dy0:
                part = picture.crop((sx0, sy0, sx1, sy1)).resize((dx1 - dx0, dy1 - dy0), Image.LANCZOS)
                out.alpha_composite(part, (dx0, dy0))
    return out


def bronze_window(art):
    """The character list's frame as Forever's XML lays it: the bronze rim over the dark plate, its brackets at the
    right corners."""
    rim, _ = art.best("heavybronze-frame-basic")
    back, _ = art.best("heavybronze-frame-background")
    if not rim or not back or empty(art.cut(rim)):
        return None
    width, height, reach = 300, 400, 30         # 2x: the rim stands 9 by 15 outside the plate
    out = Image.new("RGBA", (width + 2 * 18, height + 2 * reach), (0, 0, 0, 0))
    out.alpha_composite(art.cut(back).resize((width, height), Image.LANCZOS), (18, reach))
    sides = art.slices.get(rim["element"], (50, 50, 50, 50))
    out.alpha_composite(stretched(art.cut(rim), sides, out.width, out.height), (0, 0))
    for name, corner in (("heavybronze-vert-cornerbracket-TR", "tr"), ("heavybronze-vert-cornerbracket-BR", "br")):
        piece, _ = art.best(name)
        picture = art.cut(piece)
        out.alpha_composite(picture, (out.width - picture.width, 0 if corner == "tr" else out.height - picture.height))
    return out


def top_bar(art):
    """The top bar of the character screen, three buttons, as the game joins them."""
    parts = []
    for name in ("glues-characterselect-tophud-left-bg", "glues-characterselect-tophud-middle-bg",
                 "glues-characterselect-tophud-right-bg"):
        piece, _ = art.best(name)
        parts.append(art.cut(piece))
    if any(empty(p) for p in parts):
        return None
    out = Image.new("RGBA", (sum(p.width for p in parts), max(p.height for p in parts)), (0, 0, 0, 0))
    x = 0
    for p in parts:
        out.alpha_composite(p, (x, 0))
        x += p.width
    return out


# The list -----------------------------------------------------------------------------------------------------------
def section_of(root):
    for key, _, _, rule in SECTIONS:
        if rule and re.search(rule, root):
            return key
    return "marks"


def atlas_items(art):
    """Every piece worth a number: one per root, its states together; Forever's own before the rest."""
    groups = {}
    for lower, piece in art.pieces.items():
        path = (art.paths.get(piece["sheet"]) or "").lower()
        own = "c60" in lower or "c60" in path or (SHEETS / f"{piece['sheet']}.blp").is_file()
        if SKIP.search(lower) or SKIP.search(path) or not art.sheet_file(piece["sheet"]):
            continue
        root, state = root_of(lower)
        double = lower.endswith("-2x") or "2x" in path
        entry = groups.setdefault(root, {"own": False, "states": {}})
        entry["own"] = entry["own"] or own
        known = entry["states"].get(state)
        rank = (own, double, piece["box"][2] - piece["box"][0])
        if known is None or rank > known[0]:
            entry["states"][state] = (rank, piece, double)
    items = []
    for root, entry in sorted(groups.items()):
        if entry["own"]:
            section = section_of(root)
        else:
            if not KEEP_ELSEWHERE.search(root) or SKIP_ELSEWHERE.search(root):
                continue
            section = "elsewhere"
        states = sorted(entry["states"].items(), key=lambda s: RANK.index(s[0]) if s[0] in RANK else len(RANK))
        states = [s for s in states if s[1][0][0] == entry["own"]] or states
        items.append({"key": "atlas:" + root, "section": section, "words": root.strip("!_"), "states": states})
    return items


def old_items(art):
    """The old files, the states of one thing together."""
    sheets = {art.pieces[k]["sheet"] for k in art.pieces}
    groups = {}
    for fdid, path in sorted(art.paths.items(), key=lambda p: p[1].lower()):
        lower = path.lower()
        if fdid in sheets or "c60" in lower or not OLD_ART.match(lower) or SKIP_OLD.search(Path(lower).name):
            continue
        if SKIP.search(lower) or not lower.endswith(".blp"):
            continue
        root, state = root_of(lower[:-4])
        groups.setdefault(root, {})[state] = fdid
    items = []
    for root, states in sorted(groups.items()):
        order = sorted(states, key=lambda s: RANK.index(s) if s in RANK else len(RANK))
        items.append({"key": "file:" + root, "section": "old", "words": root[len("interface/"):],
                      "files": [states[s] for s in order]})
    return items


def text(value):
    return html.escape(str(value), quote=True)


def page(sections, cards, info):
    head = []
    for key, title, about, _ in SECTIONS:
        count = len(sections.get(key, ()))
        if count:
            head.append(f'<a href="#{key}">{text(title)} <i>{count}</i></a>')
    body = []
    for key, title, about, _ in SECTIONS:
        numbers = sections.get(key)
        if not numbers:
            continue
        body.append(f'<section id="{key}"><h2>{text(title)} <i>{len(numbers)}</i></h2><p>{text(about)}</p><div class="grid">')
        body.extend(cards[n] for n in numbers)
        body.append("</div></section>")
    return (TEMPLATE.replace("/*INFO*/{}", json.dumps(info, separators=(",", ":")))
            .replace("<!--NAV-->", "".join(head)).replace("<!--BODY-->", "\n".join(body)))


def make():
    art = Art()
    OUT.mkdir(parents=True, exist_ok=True)
    pictures = OUT / "art"
    pictures.mkdir(exist_ok=True)
    numbers = json.loads(NUMBERS.read_text()) if NUMBERS.is_file() else {}
    seen = set()
    made = []

    def add(key, section, words, picture, source, scale, states=(), retail=""):
        if empty(picture):
            return
        digest = hashlib.sha1(picture.tobytes()).hexdigest()
        if digest in seen:
            return
        seen.add(digest)
        made.append({"key": key, "section": section, "words": words, "picture": picture, "source": source,
                     "scale": scale, "states": list(states), "retail": retail})

    code = export.required("code")
    bronze = bronze_window(art)
    add("window:heavybronze", "windows", "the character list's frame: heavy bronze", bronze,
        "heavybronze-frame-basic, -background, -vert-cornerbracket", 1, retail="Forever only")
    bar = top_bar(art)
    add("window:tophud", "windows", "the character screen's top bar, joined", bar, "glues-characterselect-tophud-*", 1, retail="Retail: own look")
    for name, layout in layouts(code).items():
        if name in NOT_WINDOWS:
            continue
        picture = window(art, layout)
        add("window:" + name, "windows", re.sub(r"(?<=[a-z])(?=[A-Z])", " ", name).lower(), picture,
            "NineSliceLayouts: " + name, 2)

    for item in atlas_items(art):
        cuts, names, double = [], [], False
        for state, (_, piece, wide) in item["states"]:
            picture = art.cut(piece)
            if not empty(picture) and (item["section"] != "elsewhere" or max(picture.size) >= 24):
                cuts.append(picture)
                names.append(piece["name"])
                double = double or wide
        if cuts:
            sheet = art.paths.get(item["states"][0][1][1]["sheet"]) or f"file ID {item['states'][0][1][1]['sheet']}"
            add(item["key"], item["section"], item["words"], fitted(strip(cuts[:6])), sheet, 2 if double else 1, names,
                retail_says(art, item))

    for item in old_items(art):
        cuts = [art.sheet(fdid) for fdid in item["files"]]
        for fdid in item["files"]:
            art.loaded.pop(fdid, None)
        cuts = [c for c in cuts if c is not None and min(c.size) >= 16 and not empty(c)]
        if cuts:
            add(item["key"], "old", item["words"], fitted(strip(cuts[:6])), art.paths[item["files"][0]], 1,
                [art.paths[f] for f in item["files"]], retail_says(art, {"file": item["files"][0]}))

    order = {s[0]: i for i, s in enumerate(SECTIONS)}
    made.sort(key=lambda m: (order[m["section"]], FIRST.index(m["key"]) if m["key"] in FIRST else len(FIRST), m["words"]))
    next_number = max(numbers.values(), default=0) + 1
    sections, cards, info = {}, {}, {}
    for item in made:
        number = numbers.get(item["key"])
        if number is None:
            number = numbers[item["key"]] = next_number
            next_number += 1
        target = pictures / f"{number}.png"
        item["picture"].save(target, compress_level=6)
        w, h = item["picture"].size
        scale = item["scale"]
        show = (max(1, round(w / scale)), max(1, round(h / scale)))
        if max(show) < 44:                  # too small to judge: shown larger
            k = 44 / max(show)
            show = (round(show[0] * k), round(show[1] * k))
        wide = " wide" if show[0] > 300 else ""
        sections.setdefault(item["section"], []).append(number)
        said = item["retail"]
        tag = f'<em>{said}</em>' if said else ""
        cards[number] = (f'<figure class="card{wide}" id="n{number}" data-n="{number}" '
                         f'data-w="{text(item["words"] + " " + said.lower())}">'
                         f'<div class="art"><img loading="lazy" src="art/{number}.png" width="{show[0]}" '
                         f'height="{show[1]}" alt=""></div><figcaption><b>{number}</b><span>{text(item["words"])}</span>{tag}'
                         '</figcaption><div class="marks"><button data-m="y" title="yes">✓</button>'
                         '<button data-m="m" title="maybe">?</button><button data-m="n" title="no">✕</button></div></figure>')
        info[number] = {"w": item["words"], "s": item["source"], "z": [w, h], "a": item["states"], "r": said}
        item["number"] = number
    new = NUMBERS.with_name(NUMBERS.name + ".new")   # whole or not at all: the numbers the picks refer to stay
    new.write_text(json.dumps(numbers, indent=0, sort_keys=True))
    new.replace(NUMBERS)
    (OUT / "index.html").write_text(page(sections, cards, info), encoding="utf-8")
    overview(sections, {m["number"]: m for m in made})
    for key, title, _, _ in SECTIONS:
        print(f"{len(sections.get(key, ())):5d}  {title}")
    print(f"{len(made):5d}  numbered, in {OUT.relative_to(ROOT)}")


def overview(sections, items, columns=5, rows=7, cell=(320, 250)):
    """The catalogue on paper: overview.pdf, a page per so many pieces, each under its number."""
    number_font = title_font = small = None
    for name in ("DejaVuSans-Bold.ttf", "DejaVuSans.ttf"):
        try:
            title_font = ImageFont.truetype(name, 34)
            number_font = ImageFont.truetype(name, 26)
            small = ImageFont.truetype(name, 13)
            break
        except OSError:
            continue
    if small is None:
        title_font, number_font, small = (ImageFont.load_default(size) for size in (34, 26, 13))
    width, height = columns * cell[0], rows * cell[1] + 70
    pages = []
    for key, title, _, _ in SECTIONS:
        numbers = sections.get(key, [])
        for start in range(0, len(numbers), columns * rows):
            page_ = Image.new("RGB", (width, height), (60, 52, 44))
            draw = ImageDraw.Draw(page_)
            draw.text((16, 16), title, font=title_font, fill=(240, 200, 110))
            for i, number in enumerate(numbers[start:start + columns * rows]):
                item = items[number]
                x, y = (i % columns) * cell[0] + 8, (i // columns) * cell[1] + 70
                picture = item["picture"].copy()
                picture.thumbnail((cell[0] - 16, cell[1] - 52), Image.LANCZOS)
                page_.paste(picture, (x + (cell[0] - 16 - picture.width) // 2, y), picture)
                draw.text((x, y + cell[1] - 46), f"#{number}", font=number_font, fill=(255, 225, 130))
                if item["retail"]:
                    draw.text((x + 96, y + cell[1] - 38), item["retail"], font=small, fill=(200, 185, 160))
            pages.append(page_)
    pages[0].save(OUT / "overview.pdf", save_all=True, append_images=pages[1:], quality=88, resolution=100)
    print(f"{len(pages):5d}  pages in overview.pdf")


def find(word):
    numbers = json.loads(NUMBERS.read_text()) if NUMBERS.is_file() else {}
    for key, number in sorted(numbers.items(), key=lambda kv: kv[1]):
        if word.lower() in key.lower():
            print(f"#{number}  {key}")


