<script>
const INFO = /*INFO*/{};
const KEY = "game-art-marks";
let marks = {};
try { marks = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) {}
const cards = [...document.querySelectorAll(".card")];
function save() { try { localStorage.setItem(KEY, JSON.stringify(marks)); } catch (e) {} }
function list(m) { return Object.keys(marks).filter(k => marks[k] === m).map(Number).sort((a, b) => a - b); }
function count() {
  const y = list("y").length, q = list("m").length, n = list("n").length;
