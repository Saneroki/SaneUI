#!/usr/bin/env python3
"""Module stages, the packages of a channel, and their upload to CurseForge (Saneroki, 2026-11-15; .claude's git
rules, *Module stages*, *The pipeline to CurseForge*; README.md, *Building*).

Every module goes through the stages dev, alpha, beta and release, by its developer's word alone: dev is for
development and testing only, alpha, beta and release say how ready a version of it is for the wider public. A
version reaches a stage as a tag on main's committed state, <Module>/<version>-<stage> (Navigation/0.3.1-alpha).
Core has no stage (every module needs it), nor have its data holders (Data: Auction House, Data: Auction Scans),
both from main's newest commit.

Each module is a CurseForge project of its own, and so is Core (Sane UI alone; the data holders go in Economy's,
the module that uses them, so a player without it never has Core scan the auction house): a player takes
the modules they like, and the CurseForge app brings Core with each, as a module's upload names Core's project
its required dependency (Saneroki, 2026-11-15: "for now I want to release Maps", alone).

A channel's packages (alpha, beta, release): Core's zip, and of each module its newest version at that stage or
higher in a zip of its own: a newer version of a lower stage is left out, a module that never reached the stage
stays out. They are built from git's copies only, never the working tree: main's newest commit tested whole, each
older version of a module tested with today's Core (its own tests of then). They are Forever's (the one game
supported for the public): each TOC names Forever's interface number alone, and a module's TOC the Core it was
tested with (X-SaneUI-Core: Core tells a player whose Sane UI is older). They land in BUILD/packages, the addon's
folder at the top of each zip (Economy's with the data holders beside it).

Publishing uploads what is new in the channel, Core first: Core when its code is not on CurseForge at that channel
or higher, each module whose version is not. Each upload is tagged published/<Module>/<version>-<channel> (Core's
at main's commit, a module's at its stage tag's), the players' words taken from Doc/changelog.txt, a part per
addon and version ("Navigation 0.3.1 (2026-11-16)", "Sane UI 0.3.1 (2026-11-16)"). The projects and the token
stand in ~/.config/saneui/curseforge.json, never in a repository:
  {"token": "...", "gameVersions": ["1.60.1"],
   "projects": {"Core": {"id": 123456, "slug": "sane-ui"}, "Navigation": {"id": 234567, "name": "Sane UI Maps"}}}
(gameVersions: CurseForge's names or ids of the game versions the files are for, listed by check; Core's slug is
what the modules name as their dependency; a project's name names its files, Sane UI Core and "Sane UI <its title>"
when none is given; a module
without a project there is not uploaded; "host" may name another site than https://wow.curseforge.com). Nothing
is ever pushed: the tags go out with git push origin <tag>.

  dev/tools/release stages                         every module's stage and versions     (saneui showstages)
  dev/tools/release promote <Module> <stage>       tag main's committed state of it      (saneui promote)
          [--version X.Y.Z] [--dry]
  dev/tools/release package <channel> [Module...]  the zips of that channel              (saneui makepackage)
          [--core-version X.Y.Z] [--dry]
  dev/tools/release publish <channel> [Module...]  what is new made, uploaded, tagged    (saneui publish)
          [--core-version X.Y.Z] [--dry] [--yes]
  dev/tools/release check                          the config and the token tried on CurseForge, its game
                                                   versions listed                       (saneui checkcurseforge)
"""
import argparse
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import uuid
import zipfile
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
STAGES = ("dev", "alpha", "beta", "release")   # lowest first
CHANNELS = STAGES[1:]
CORE = ("Core", "AuctionData", "AuctionScans")  # no stage, from main's newest commit
CORE_PROJECT = ("Core",)                          # Core's project: Sane UI alone
# Addons a module's project carries beside it, from main's newest commit: the auction data's files (no code; Core
# fills them) only with Economy, which uses them. In Core's download every player would have Core scan the auction
# house when it opens (Saneroki, 2026-11-15: "leave them out" of Core's until Economy ships).
CARRIED = {"Economy": ("AuctionData", "AuctionScans")}
# The tests of each module (dev/tests/<name>.lua), run for an older version of it with today's Core.
TESTS = {
    "Abilities": ["abilities"], "Combat": ["combat", "book", "meter", "talents", "reminders", "auralists", "macros"],
    "Economy": ["economy"], "Guild": ["guild"], "Inventory": ["inventory", "sheet", "bags"], "Loot": ["loot"],
    "Lore": ["lore"], "Nameplates": ["nameplates"], "Navigation": ["navigation"], "Social": ["social"],
    "SpeedLeveling": ["speedleveling", "speedguide", "classquests"], "Tooltips": ["tooltips"],
}
# What of the tests is Core's, taken from today's tree for an older module: the stand-in game and its helpers.
TEST_HELPERS = ("dev/tests/wowstub.lua",)
VERSION = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")
STAGE_TAG = re.compile(r"^(?P<module>[A-Za-z][A-Za-z0-9]*)/(?P<version>\d+\.\d+\.\d+)-(?P<stage>alpha|beta|release)$")
PUBLISHED_TAG = re.compile(
    r"^published/(?P<project>[A-Za-z][A-Za-z0-9]*)/(?P<version>\d+\.\d+\.\d+)-(?P<channel>alpha|beta|release)$")
CHANGELOG_PART = re.compile(r"^(?=(?:[A-Za-z][^\n]* )?\d+\.\d+\.\d+ \([^)\n]*\)[ \t]*$)", re.M)
TOC = re.compile(r"^src/(?P<folder>[^/]+)/(?P<name>[^/]+)\.toc$")
RETAIL_INTERFACE = 100000  # Retail's interface numbers have six digits since 10.0; Forever's (16001) fewer
LFS = b"version https://git-lfs.github.com/spec/"
CONFIG = Path.home() / ".config" / "saneui" / "curseforge.json"
HOST = "https://wow.curseforge.com"
MEMORY = 2000000  # kB of address space a Lua test may take (a test that loops fails fast)


class Refused(Exception):
    """A step that cannot be done, with the line saying why."""


def git(*args, root=ROOT, text=True, check=True, input=None):
    found = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=text, input=input)
    if check and found.returncode:
        raise Refused(f"git {' '.join(args)}: {(found.stderr if text else found.stderr.decode()).strip()}")
    return found.stdout.strip() if text else found.stdout


def key(version):
    return tuple(int(n) for n in VERSION.match(version).groups())


def bump(version):
    major, minor, patch = key(version)
    return f"{major}.{minor}.{patch + 1}"


def rank(stage):
    return STAGES.index(stage)


# --- What git holds -----------------------------------------------------------------------------------------------

def addons(commit, root=ROOT):
    """{folder: addon name} of every addon in src at a commit (a folder with its TOC)."""
    found = {}
    for path in git("ls-tree", "-r", "--name-only", commit, "--", "src", root=root).splitlines():
        match = TOC.match(path)
        if match:
            found[match["folder"]] = match["name"]
    return found


def staged(commit, root=ROOT):
    """The folders of the modules that go through the stages: every addon but Core's."""
    return sorted(folder for folder in addons(commit, root) if folder not in CORE)


def stage_tags(root=ROOT):
    """Every stage a module's version reached: [{module, version, stage, tag, commit}], oldest version first."""
    found = []
    for tag in git("tag", "--list", "*/*-*", root=root).splitlines():
        match = STAGE_TAG.match(tag)
        if match:
            found.append({**match.groupdict(), "tag": tag, "commit": git("rev-parse", f"refs/tags/{tag}^{{commit}}", root=root)})
    return sorted(found, key=lambda t: (t["module"], key(t["version"]), rank(t["stage"])))


def published_tags(root=ROOT):
    """Every upload to CurseForge: [{project, version, channel, tag, commit}], oldest version first."""
    found = []
    for tag in git("tag", "--list", "published/*", root=root).splitlines():
        match = PUBLISHED_TAG.match(tag)
        if match:
            found.append({**match.groupdict(), "tag": tag, "commit": git("rev-parse", f"refs/tags/{tag}^{{commit}}", root=root)})
    return sorted(found, key=lambda t: (t["project"], key(t["version"]), rank(t["channel"])))


def on_curseforge(project, version, channel, uploads):
    """Whether that version of a project is uploaded at the channel or higher (a beta serves the alpha players too)."""
    return any(t["project"] == project and t["version"] == version and rank(t["channel"]) >= rank(channel)
               for t in uploads)


def newest(module, channel, tags):
    """The newest version of a module at the channel's stage or higher; None: it never reached it."""
    fit = [t for t in tags if t["module"] == module and rank(t["stage"]) >= rank(channel)]
    return max(fit, key=lambda t: (key(t["version"]), rank(t["stage"])), default=None)


def stage_of(module, tags):
    """The highest stage any version of a module reached; dev while none did."""
    return max((t["stage"] for t in tags if t["module"] == module), key=rank, default="dev")


def toc_field(commit, folder, name, field, root=ROOT):
    text = git("show", f"{commit}:src/{folder}/{name}.toc", root=root)
    found = re.search(rf"^## {field}:[ \t]*(.+?)[ \t]*$", text, re.M)
    return found.group(1) if found else None


def toc_version(commit, folder, name, root=ROOT):
    found = toc_field(commit, folder, name, "Version", root)
    return found if found and VERSION.match(found) else "0.0.0"


def tree(commit, folder, root=ROOT):
    """What a module is at a commit: the git objects of its code and its art (None where it has none)."""
    def one(path):
        found = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "--quiet", f"{commit}:{path}"],
                               capture_output=True, text=True)
        return found.stdout.strip() or None
    return one(f"src/{folder}"), one(f"assets/optimized/{folder}")


def main_commit(root=ROOT):
    return git("rev-parse", "refs/heads/main", root=root)


def plan(channel, only=None, root=ROOT):
    """What a channel's packages hold: {"commit": main's, "core": [folders], "modules": {folder: stage tag},
    "left": [folders that never reached the channel]}. only: those modules alone, each one that reached it."""
    if channel not in CHANNELS:
        raise Refused(f"a channel is one of {', '.join(CHANNELS)}")
    commit = main_commit(root)
    tags = stage_tags(root)
    known = staged(commit, root)
    for module in only or ():
        if module in CORE:
            raise Refused(f"{module} is Core's: it goes with every module")
        if module not in known:
            raise Refused(f"no module {module} in src (the folder's name: {', '.join(known)})")
    modules, left = {}, []
    for module in known:
        if only is not None and module not in only:
            continue
        pick = newest(module, channel, tags)
        if pick:
            modules[module] = pick
        elif only:
            raise Refused(f"{module} never reached {channel}: it is {stage_of(module, tags)} (saneui promote)")
        else:
            left.append(module)
    core = [folder for folder in CORE_PROJECT if folder in addons(commit, root)]
    return {"commit": commit, "core": core, "modules": modules, "left": left}


def core_tree(commit, root=ROOT):
    """What Core's project is at a commit: the git objects of its addons, code and art."""
    return tuple(tree(commit, folder, root) for folder in CORE_PROJECT)


def core_version(channel, commit, wanted=None, root=ROOT):
    """Core's version in a channel's packages, and whether that is new on CurseForge: {"version", "new"}. The same
    code as an upload before keeps its number (an alpha's Core uploaded as beta); it is not new where it is up at
    this channel or higher. New code: the version asked for, or one above Core's TOC and every upload of it."""
    uploads = [t for t in published_tags(root) if t["project"] == "Core"]
    now = core_tree(commit, root)
    same = [t["version"] for t in uploads if core_tree(t["commit"], root) == now]
    if same:
        version = max(same, key=key)
        return {"version": version, "new": not on_curseforge("Core", version, channel, uploads)}
    if wanted is None:
        return {"version": bump(max([toc_version(commit, "Core", "SaneUI", root), *(t["version"] for t in uploads)],
                                    key=key)), "new": True}
    if not VERSION.match(wanted):
        raise Refused("a version is X.Y.Z: 0.4.0")
    if uploads and key(wanted) <= key(uploads[-1]["version"]):
        raise Refused(f"Core {wanted} is not newer than its upload {uploads[-1]['tag']}")
    return {"version": wanted, "new": True}


# --- Promoting a module -------------------------------------------------------------------------------------------

def promote(module, stage, wanted=None, dry=False, test=True, root=ROOT, say=print):
    """Tags main's committed state of a module as having reached a stage. Returns the tag."""
    commit = main_commit(root)
    found = addons(commit, root)
    if module in CORE:
        raise Refused(f"{module} has no stage: Core goes with every module, its data holders with Economy")
    if module not in found:
        raise Refused(f"no module {module} in src (the folder's name: {', '.join(staged(commit, root))})")
    if stage not in CHANNELS:
        raise Refused(f"a stage to reach is one of {', '.join(CHANNELS)} (dev is where every module starts)")
    tags = [t for t in stage_tags(root) if t["module"] == module]
    now = tree(commit, module, root)
    same = [t for t in tags if tree(t["commit"], module, root) == now]
    if wanted is None:
        # The same code as a version tagged before keeps its number (an alpha made beta); new code a number above all.
        version = max((t["version"] for t in same), key=key, default=None) or bump(
            max([toc_version(commit, module, found[module], root), *(t["version"] for t in tags)], key=key))
    else:
        version = wanted
        if not VERSION.match(version):
            raise Refused("a version is X.Y.Z: 0.4.0")
        older = [t for t in tags if key(t["version"]) >= key(version) and t not in same]
        if older:
            raise Refused(f"{module} {version} is not newer than its {older[-1]['tag']}")
    tag = f"{module}/{version}-{stage}"
    reached = [t for t in same if t["version"] == version and rank(t["stage"]) >= rank(stage)]
    if reached:
        raise Refused(f"{module} {version} is {reached[-1]['stage']} already ({reached[-1]['tag']})")
    if any(t["tag"] == tag for t in tags):
        raise Refused(f"{tag} is there already")
    left_out = git("status", "--porcelain", "--", f"src/{module}", f"assets/optimized/{module}", root=root).splitlines()
    say(f"{module} {version} as {stage}: main's {git('rev-parse', '--short', commit, root=root)}, tag {tag}.")
    if left_out:
        say(f"Not in it, not committed: {len(left_out)} files of {module} in the working tree.")
    if dry:
        say("Nothing changed (--dry).")
        return tag
    if test:
        with tempfile.TemporaryDirectory(dir=scratch_parent(root)) as scratch:
            copy = Path(scratch) / "main"
            extract(commit, copy, root=root)
            say("Testing it ...")
            run_tests(copy, [module], say)
    git("tag", "-a", tag, "-m", f"Sane UI's {module} {version}, {stage}", commit, root=root)
    say(f"Tagged {tag}. Not pushed: git push origin {tag}")
    return tag


# --- Building a package -------------------------------------------------------------------------------------------

def scratch_parent(root=ROOT):
    """Where git's copies are made: on the disk beside the build, not in /tmp (held in memory here)."""
    folder = root / "BUILD" / ".packaging"
    folder.mkdir(parents=True, exist_ok=True)
    return folder


def extract(commit, folder, paths=(), root=ROOT):
    """Git's copy of a commit (or of some of its paths) into a folder, its art from Git LFS."""
    folder.mkdir(parents=True, exist_ok=True)
    archive = git("archive", commit, "--", *paths, root=root, text=False)
    subprocess.run(["tar", "-x", "-C", str(folder)], input=archive, check=True)


def lua(tree_root, test):
    """One Lua test of a tree, under a memory cap."""
    return subprocess.run(["bash", "-c", f'ulimit -v {MEMORY}; exec lua5.1 "$0"', f"dev/tests/{test}.lua"],
                          cwd=tree_root, capture_output=True, text=True)


def run_tests(tree_root, modules, say):
    """The lint and the given modules' tests of a tree; Refused on the first failure."""
    linted = subprocess.run([str(tree_root / "dev/tests/lint")], cwd=tree_root, capture_output=True, text=True)
    if linted.returncode:
        raise Refused("the lint failed:\n" + (linted.stdout + linted.stderr).strip()[-2000:])
    for module in modules:
        for test in TESTS.get(module, []):
            if not (tree_root / f"dev/tests/{test}.lua").is_file():
                say(f"  {module}: no dev/tests/{test}.lua in that version, left out")
                continue
            ran = lua(tree_root, test)
            if ran.returncode:
                raise Refused(f"{module}: dev/tests/{test}.lua failed:\n" + (ran.stdout + ran.stderr).strip()[-2000:])
            say(f"  {module}: dev/tests/{test}.lua passed")


def assemble(tree_root, folder, name, into):
    """One addon of a tree, as dev/build makes it: the folder of src without what only development needs (the
    READMEs), its art from assets/optimized over it, the project's licence. Returns its folder in the package."""
    out = into / name
    if out.exists():
        shutil.rmtree(out)
    shutil.copytree(tree_root / "src" / folder, out, ignore=shutil.ignore_patterns("*.md"))
    stray = out / "LICENSE"
    if stray.is_file():
        stray.unlink()
    art = tree_root / "assets" / "optimized" / folder
    if art.is_dir():
        shutil.copytree(art, out, dirs_exist_ok=True, ignore=shutil.ignore_patterns("*.md"))
    shutil.copyfile(tree_root / "LICENSE", out / "LICENSE.txt")
    return out


def dress_toc(path, version, mark, stage=None, core=None):
    """A packaged TOC: Forever's interface number alone, the version, which package it is (and a module's stage and
    the Core it was tested with). False: the addon is made for another game only (its X-SaneUI-Games), stays out."""
    text = path.read_text(encoding="utf-8")
    games = re.search(r"^## X-SaneUI-Games:\s*(.+)$", text, re.M)
    if games and "forever" not in games.group(1).lower().replace(",", " ").split():
        return False
    def forever(match):
        numbers = [n.strip() for n in match.group(1).split(",") if n.strip().isdigit() and int(n) < RETAIL_INTERFACE]
        if not numbers:
            raise Refused(f"{path.name} names no interface number of Forever's")
        return "## Interface: " + ", ".join(numbers)
    text = re.sub(r"^## Interface:\s*(.+)$", forever, text, count=1, flags=re.M)
    lines = (f"## Version: {version}\n## X-SaneUI-Build: {mark}" + (f"\n## X-SaneUI-Stage: {stage}" if stage else "")
             + (f"\n## X-SaneUI-Core: {core}" if core else ""))
    if re.search(r"^## Version:.*$", text, re.M):
        text = re.sub(r"^## Version:.*$", lambda _: lines, text, count=1, flags=re.M)
    else:
        text = lines + "\n" + text
    path.write_text(text, encoding="utf-8")
    return True


def checked(into):
    """What must never be in a package: Git LFS pointers in place of art, READMEs, a folder made on one computer."""
    problems = []
    for file in into.rglob("*"):
        if file.is_file() and file.stat().st_size < 1024 and file.read_bytes().startswith(LFS):
            problems.append(f"a Git LFS pointer, not the art (git lfs pull): {file.relative_to(into)}")
        if file.is_file() and file.suffix == ".md":
            problems.append(f"a README: {file.relative_to(into)}")
        if file.suffix == ".toc" and re.search(r"^## X-SaneUI-(Guides|Made):", file.read_text(encoding="utf-8"), re.M):
            problems.append(f"made on one computer, never shipped: {file.parent.name}")
    if problems:
        raise Refused("not packaged:\n  " + "\n  ".join(problems))


def write_zip(into, zip_path):
    zip_path.parent.mkdir(parents=True, exist_ok=True)
    temp = zip_path.with_name(zip_path.name + ".tmp")
    with zipfile.ZipFile(temp, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as out:
        for file in sorted(into.rglob("*")):
            if file.is_file():
                out.write(file, file.relative_to(into).as_posix())
    os.replace(temp, zip_path)


def describe(found, channel, root=ROOT):
    core = found["core_release"]
    lines = [f"Packages of {channel}, main's {git('rev-parse', '--short', found['commit'], root=root)}:",
             f"  Core {core['version']} ({', '.join(found['core'])})" + ("" if core["new"] else
                                                                         f": on CurseForge as {channel} or higher already")]
    for module, pick in sorted(found["modules"].items()):
        lines.append(f"  {module} {pick['version']} ({pick['stage']}, {git('rev-parse', '--short', pick['commit'], root=root)})")
    if found["left"]:
        lines.append(f"  Left out, not {channel} yet: {', '.join(found['left'])}")
    return "\n".join(lines)


def zip_name(addon, version, channel):
    return f"{addon}-{version}-{channel}.zip"


def package(channel, only=None, core_wanted=None, dry=False, root=ROOT, out_dir=None, say=print, test=True, core=True):
    """Makes the zips of a channel: Core's (core=False: not) and each module's (only: those). Returns {"channel",
    "commit", "core": [folders], "core_release": {"version", "new", "zip"}, "modules": {folder: stage tag with its
    "addon", "title" and "zip"}, "left"}; a module made for another game only has no zip."""
    found = plan(channel, only, root)
    commit = found["commit"]
    release = found["core_release"] = core_version(channel, commit, core_wanted, root)
    out_dir = out_dir or root / "BUILD" / "packages"
    release["zip"] = out_dir / zip_name("SaneUI", release["version"], channel) if core else None
    names = addons(commit, root)
    for module, pick in found["modules"].items():
        pick["addon"] = addons(pick["commit"], root).get(module) or names[module]
        pick["title"] = toc_field(pick["commit"], module, pick["addon"], "Title", root) or module
        pick["zip"] = out_dir / zip_name(pick["addon"], pick["version"], channel)
    result = {"channel": channel, **found}
    say(describe(found, channel, root))
    if dry:
        made = [z for z in [release["zip"], *(p["zip"] for p in found["modules"].values())] if z]
        say("Would be: " + ", ".join(z.name for z in made) + f" in {out_dir} (--dry: nothing made).")
        return result
    short = git("rev-parse", "--short", commit, root=root)
    with tempfile.TemporaryDirectory(dir=scratch_parent(root)) as scratch:
        scratch = Path(scratch)
        main = scratch / "main"
        extract(commit, main, root=root)
        if test:
            # Core's sets first, where the interface lab's scenes read them (as a build before them makes them).
            made = subprocess.run([str(main / "dev/tools/data"), "compile", str(main / "BUILD" / "SaneUI")],
                                  cwd=main, capture_output=True, text=True)
            if made.returncode:
                raise Refused("Core's sets could not be compiled:\n" + (made.stdout + made.stderr).strip()[-2000:])
            say("Testing main's commit whole ...")
            ran = subprocess.run([str(main / "dev/tests/run")], cwd=main, capture_output=True, text=True)
            if ran.returncode:
                raise Refused("main's tests failed: no package.\n" + (ran.stdout + ran.stderr).strip()[-3000:])
        if core:
            into = scratch / "Core"
            for folder in found["core"]:
                addon = assemble(main, folder, names[folder], into)
                if not dress_toc(addon / f"{names[folder]}.toc", release["version"],
                                 f"{channel} {release['version']} {short}"):
                    shutil.rmtree(addon)
            made = subprocess.run([str(main / "dev/tools/data"), "compile", str(into / "SaneUI")], cwd=main,
                                  capture_output=True, text=True)
            if made.returncode:
                raise Refused("Core's sets could not be compiled:\n" + (made.stdout + made.stderr).strip()[-2000:])
            checked(into)
            write_zip(into, release["zip"])
            say(f"Made: {shown(release['zip'], root)}.")
        copies = {}
        for module, pick in sorted(found["modules"].items()):
            source = main
            if tree(pick["commit"], module, root) != tree(commit, module, root):
                # An older version than main's: its code of then, tested with today's Core.
                source = copies.get(pick["commit"])
                if source is None:
                    source = copies[pick["commit"]] = scratch / pick["commit"][:12]
                    extract(pick["commit"], source, root=root)
                    for part in CORE:
                        for base in ("src", "assets/optimized"):
                            shutil.rmtree(source / base / part, ignore_errors=True)
                            if (main / base / part).is_dir():
                                shutil.copytree(main / base / part, source / base / part)
                    for helper in TEST_HELPERS:
                        if (main / helper).is_file():
                            (source / helper).parent.mkdir(parents=True, exist_ok=True)
                            shutil.copyfile(main / helper, source / helper)
                if test:
                    say(f"Testing {module} {pick['version']} with today's Core ...")
                    run_tests(source, [module], say)
            into = scratch / module
            addon = assemble(source, module, pick["addon"], into)
            mark = f"{channel} {pick['version']} {git('rev-parse', '--short', pick['commit'], root=root)}"
            if not dress_toc(addon / f"{pick['addon']}.toc", pick["version"], mark, pick["stage"], release["version"]):
                pick["zip"] = None
                say(f"  {module}: made for another game only, left out")
                continue
            for folder in CARRIED.get(module, ()):
                if folder in names:
                    carried = assemble(main, folder, names[folder], into)
                    dress_toc(carried / f"{names[folder]}.toc", pick["version"], mark, core=release["version"])
            checked(into)
            write_zip(into, pick["zip"])
            say(f"Made: {shown(pick['zip'], root)}.")
    return result


def shown(zip_path, root=ROOT):
    where = zip_path.relative_to(root) if zip_path.is_relative_to(root) else zip_path
    return f"{where} ({zip_path.stat().st_size / 1048576:.1f} MB)"


# --- CurseForge ---------------------------------------------------------------------------------------------------

def config(path=CONFIG):
    """The CurseForge projects and the token: Core's project with its id and slug, each module's with its id."""
    found = read_config(path)
    problem = config_problem(found, path)
    if problem:
        raise Refused(problem)
    return found


def read_config(path=CONFIG):
    if not path.is_file():
        raise Refused(f"no {path}: it holds the CurseForge projects and the token, "
                      '{"token": "...", "gameVersions": ["1.60.1"], "projects": {"Core": {"id": 123456, "slug": '
                      '"sane-ui"}, "Navigation": {"id": 234567, "name": "Sane UI Maps"}}} '
                      "(the token from authors.curseforge.com, Settings, API Tokens)")
    try:
        found = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as error:
        raise Refused(f"{path} is not JSON: {error}")
    if not isinstance(found, dict):
        raise Refused(f"{path} is no JSON object")
    return found


def config_problem(found, path=CONFIG):
    """What a config still lacks for an upload, in a line; None when nothing does."""
    for field in ("token", "gameVersions", "projects"):
        if not found.get(field):
            return f"{path} lacks {field}"
    core = found["projects"].get("Core") or {}
    if not core.get("id") or not core.get("slug"):
        return f"{path}: the project Core needs its id and its slug (the modules name it as their dependency)"
    for name, project in found["projects"].items():
        if not isinstance(project, dict) or not project.get("id"):
            return f"{path}: the project of {name} lacks its id"
    return None


def check(path=CONFIG, say=print, settings=None):
    """The config read and its token tried on CurseForge (nothing uploaded): the game versions named found, and
    CurseForge's WoW game version types listed with their newest versions, to name gameVersions by. The token is
    never shown."""
    settings = settings if settings is not None else read_config(path)
    if not settings.get("token"):
        raise Refused(f"{path} lacks token (authors.curseforge.com, Settings, API Tokens)")
    host = settings.get("host", HOST).rstrip("/")
    types = ask(f"{host}/api/game/version-types", settings["token"]) or []
    versions = ask(f"{host}/api/game/versions", settings["token"]) or []
    say(f"The token works: {host} answered ({len(versions)} game versions in {len(types)} types).")
    names = {t.get("id"): t.get("name") for t in types}
    say("Game version types, each with its newest versions (gameVersions takes a version's name or id):")
    for kind in sorted(types, key=lambda t: str(t.get("name"))):
        mine = sorted((v for v in versions if v.get("gameVersionTypeID") == kind.get("id")), key=lambda v: v.get("id", 0))
        say(f"  {kind.get('name')} (type {kind.get('id')}): " + ", ".join(
            f"{v.get('name')} (id {v.get('id')})" for v in mine[-3:][::-1]))
    for want in settings.get("gameVersions") or []:
        hit = [v for v in versions if str(v.get("id")) == str(want) or v.get("name") == str(want)]
        say(f"  gameVersions {want!r}: " + (f"id {hit[0].get('id')}, {names.get(hit[0].get('gameVersionTypeID'))}"
                                           if hit else "not known to CurseForge"))
    for name, project in sorted((settings.get("projects") or {}).items()):
        project = project if isinstance(project, dict) else {}
        say(f"  project {name}: id {project.get('id', '?')}" + (f", slug {project['slug']}" if project.get("slug") else "")
            + (f", files named {project['name']}" if project.get("name") else ""))
    problem = config_problem(settings, path)
    say(f"Not ready to upload: {problem}." if problem else "Ready to upload.")
    return problem is None


def changelog(title, version, path=ROOT / "Doc" / "changelog.txt"):
    """The players' words for a version of an addon: its part of Doc/changelog.txt ("Navigation 0.3.1 (2026-12-01)"
    and what follows, up to the next such line); None while it has none (never another version's words)."""
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    mine = [p for p in CHANGELOG_PART.split(text)[1:] if p.startswith(f"{title} {version} (")]
    # CurseForge's moderation: every file has a changelog of what changed, so a heading alone counts as none.
    said = mine and [line for line in mine[0].splitlines()[1:] if line.strip() and set(line.strip()) != {"-"}]
    return mine[0].strip() if said else None


def project_name(folder, title, projects):
    """What a project's files are called on CurseForge: its name in the config, else Sane UI and the addon's title."""
    return (projects.get(folder) or {}).get("name") or ("Sane UI Core" if folder == "Core" else f"Sane UI {title}")


def metadata(name, version, channel, game_versions, words, core_slug=None):
    """An upload's metadata: the channel is its release type; a module's names Core's project its required
    dependency, so the CurseForge app installs Core with it."""
    meta = {"changelog": words, "changelogType": "text",
            "displayName": f"{name} {version}" + ("" if channel == "release" else f" ({channel})"),
            "gameVersions": game_versions, "releaseType": channel}
    if core_slug:
        meta["relations"] = {"projects": [{"slug": core_slug, "type": "requiredDependency"}]}
    return meta


def ask(url, token, data=None, headers=None):
    request = urllib.request.Request(url, data=data, headers={"X-Api-Token": token, **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=300) as answer:
            return json.loads(answer.read().decode("utf-8") or "null")
    except urllib.error.HTTPError as error:
        raise Refused(f"CurseForge answered {error.code}: {error.read().decode('utf-8', 'replace')[:500]}")
    except urllib.error.URLError as error:
        raise Refused(f"CurseForge could not be reached: {error.reason}")


def game_version_ids(wanted, known):
    """CurseForge's ids of the game versions named (by name or id) in the config; Refused for one it lacks."""
    ids = []
    for want in wanted:
        hit = [v["id"] for v in known if str(v.get("id")) == str(want) or v.get("name") == str(want)]
        if not hit:
            raise Refused(f"CurseForge knows no game version {want!r}")
        ids.append(hit[0])
    return ids


def multipart(fields, file_field, file_path):
    boundary = uuid.uuid4().hex
    body = io.BytesIO()
    for name, value in fields.items():
        body.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n"
                   f"Content-Type: application/json\r\n\r\n".encode())
        body.write(value.encode("utf-8") + b"\r\n")
    body.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{file_field}\"; filename=\"{file_path.name}\"\r\n"
               f"Content-Type: application/zip\r\n\r\n".encode())
    body.write(file_path.read_bytes() + b"\r\n")
    body.write(f"--{boundary}--\r\n".encode())
    return body.getvalue(), f"multipart/form-data; boundary={boundary}"


def publish(channel, only=None, core_wanted=None, dry=False, yes=False, root=ROOT, say=print, settings=None):
    """What is new in a channel made and uploaded to CurseForge, Core first, each upload tagged. Returns the
    CurseForge file ids, [] when nothing was new."""
    if settings is None:
        try:
            settings = config()
        except Refused as why:
            if not dry:
                raise
            say(f"({why})")
            settings = {"token": "", "gameVersions": ["?"], "projects": {}}
    projects = settings.get("projects") or {}
    host = settings.get("host", HOST).rstrip("/")
    found = plan(channel, only, root)
    uploads = published_tags(root)
    send = []
    for module, pick in sorted(found["modules"].items()):
        if on_curseforge(module, pick["version"], channel, uploads):
            say(f"  {module} {pick['version']}: on CurseForge as {channel} or higher already")
        elif module in projects or dry:
            if module not in projects:
                say(f"  {module} {pick['version']}: no CurseForge project in {CONFIG.name} yet")
            send.append(module)
        elif only:
            raise Refused(f"{module} has no CurseForge project in {CONFIG}: its id goes under projects first")
        else:
            say(f"  {module} {pick['version']}: no CurseForge project in {CONFIG.name}, not uploaded")
    core_new = core_version(channel, found["commit"], core_wanted, root)["new"]
    if not send and not core_new:
        say(f"Nothing new for {channel}: Core and every module there are on CurseForge already.")
        return []
    result = package(channel, send, core_wanted, dry, root, say=say, core=core_new)
    release, words_file = result["core_release"], root / "Doc" / "changelog.txt"
    # (folder, title, version, zip, the commit its tag goes on)
    going = ([("Core", "Sane UI", release["version"], release["zip"], result["commit"])] if release["zip"] else []) + [
        (module, pick["title"], pick["version"], pick["zip"], pick["commit"])
        for module, pick in sorted(result["modules"].items()) if pick["zip"]]
    words, missing = {}, []
    for folder, title, version, _, _ in going:
        words[folder] = changelog(title, version, words_file)
        if words[folder] is None:
            missing.append(f"\"{title} {version} (<date>)\"")
            words[folder] = ""
        # The same code up a channel (an alpha made beta): CurseForge takes no re-upload without changes, so the
        # file says first why it comes again.
        before = [t["channel"] for t in uploads if t["project"] == folder and t["version"] == version]
        if before:
            words[folder] = f"Unchanged since {version} ({before[-1]}), now {channel}.\n\n" + words[folder]
    if missing:
        why = (f"Doc/changelog.txt has no part for {', '.join(missing)} yet: the players' words go there first (that "
               "line, its line of dashes, the bigger changes), committed")
        if not dry:
            raise Refused(why)
        say(f"({why}.)")
    core_slug = (projects.get("Core") or {}).get("slug", "?")
    metas = {folder: metadata(project_name(folder, title, projects), version, channel, settings["gameVersions"],
                              words[folder], None if folder == "Core" else core_slug)
             for folder, title, version, _, _ in going}
    if dry:
        for folder, _, _, zip_path, _ in going:
            say(f"Would upload {zip_path.name} to {host}, project {(projects.get(folder) or {}).get('id', '?')}:\n"
                + json.dumps(metas[folder], indent=1))
        return []
    ids = game_version_ids(settings["gameVersions"], ask(f"{host}/api/game/versions", settings["token"]))
    if not yes:
        listed = ", ".join(f"{metas[folder]['displayName']} ({zip_path.name})" for folder, _, _, zip_path, _ in going)
        if input(f"Upload to CurseForge: {listed}? Type yes: ").strip().lower() != "yes":
            raise Refused("not uploaded")
    files, tags = [], []
    for folder, _, version, zip_path, commit in going:
        meta = {**metas[folder], "gameVersions": ids}
        body, kind = multipart({"metadata": json.dumps(meta)}, "file", zip_path)
        answer = ask(f"{host}/api/projects/{projects[folder]['id']}/upload-file", settings["token"], body,
                     {"Content-Type": kind})
        file_id = answer.get("id") if isinstance(answer, dict) else None
        tag = f"published/{folder}/{version}-{channel}"
        git("tag", "-a", tag, "-m", f"{meta['displayName']} on CurseForge, file {file_id}", commit, root=root)
        say(f"Uploaded {meta['displayName']}: CurseForge file {file_id}. Tagged {tag}.")
        files.append(file_id)
        tags.append(tag)
    say("Not pushed: git push origin " + " ".join(tags))
    return files


# --- The command line ---------------------------------------------------------------------------------------------

def show_stages(root=ROOT, say=print):
    commit = main_commit(root)
    tags = stage_tags(root)
    say("Core: no stage, its own project, with every module; Data: Auction House, Data: Auction Scans: no stage, in "
        "Economy's (main's newest commit).")
    for module in staged(commit, root):
        mine = [t for t in tags if t["module"] == module]
        line = f"  {module:14} {stage_of(module, tags)}"
        if mine:
            line += "   " + ", ".join(f"{t['version']} {t['stage']}" for t in mine)
            if tree(mine[-1]["commit"], module, root) != tree(commit, module, root):
                line += "   (main has newer code: dev)"
        say(line)
    uploads = published_tags(root)
    if uploads:
        say("On CurseForge: " + ", ".join(f"{t['project']} {t['version']} {t['channel']}" for t in uploads))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=__doc__.split("\n\n", 1)[1])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("stages", help="every module's stage and versions")
    commands.add_parser("check", help="the config and its token tried on CurseForge; its game versions listed")
    raising = commands.add_parser("promote", help="tag main's committed state of a module as reaching a stage")
    raising.add_argument("module")
    raising.add_argument("stage", choices=CHANNELS)
    raising.add_argument("--version")
    for name, what in (("package", "the zips of a channel: Core's, each module's"),
                       ("publish", "what is new in a channel made, uploaded to CurseForge, tagged")):
        one = commands.add_parser(name, help=what)
        one.add_argument("channel", choices=CHANNELS)
        one.add_argument("modules", nargs="*", metavar="Module", help="only these modules (the folder's name)")
        one.add_argument("--core-version", help="Core's version where its code is new (else one above the last)")
        if name == "publish":
            one.add_argument("--yes", action="store_true", help="upload without asking")
    for one in (raising, commands.choices["package"], commands.choices["publish"]):
        one.add_argument("--dry", action="store_true", help="show what it would do; change nothing")
    args = parser.parse_args()
    try:
        if args.command == "stages":
            show_stages()
        elif args.command == "check":
            check()
        elif args.command == "promote":
            promote(args.module, args.stage, args.version, args.dry)
        elif args.command == "package":
            package(args.channel, args.modules or None, args.core_version, args.dry)
        else:
            publish(args.channel, args.modules or None, args.core_version, args.dry, args.yes)
    except Refused as why:
        print(f"release: {why}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
