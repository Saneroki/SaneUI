#!/usr/bin/env python3
"""Every WoW account on this computer reads every account's auction data (Doc/guides/data.md, *Across accounts*).

The game keeps a saved file per WoW account, and the kind it shares between accounts is closed to addons. A link cannot
stand in for an account's file in the WTF folder either: the game writes a new file at every save, in place of whatever
stood there, and each running game would write only what it read itself, over the others' scans. So each account keeps
writing its own file, and what all accounts of a game folder share is its AddOns folder: the addon SaneUI_AuctionDatabase
there is made of links, one to each account's SaneUI_AuctionData.lua. A link there follows the file's name, so it stays
good. The game reads them as that addon's files at a login or a /reload; Core takes in what each one holds. Nothing
runs in the background, and the WTF folder is never written.

Only an account that has saved its file gets a link: a link to nothing is a file the game cannot load, a warning at
every login (an account never played with SaneUI). dev/build --install makes them anew, so an account's first save
gets its link at the next install; the addon's list of files changed, the game needs a restart.

  dev/tools/auction-database link        the addon made anew for every game folder, said only where it changed
  dev/tools/auction-database status      the accounts of each game folder, and what their files weigh
"""
import argparse
import os
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True
FOREVER = Path(os.environ.get("WOW_FOREVER", Path.home() / ".local/share/Steam/steamapps/compatdata/3133853286/pfx/drive_c"
                              "/Program Files (x86)/World of Warcraft/_forever_"))
RETAIL = Path(os.environ.get("WOW_RETAIL", FOREVER.parent / "_retail_"))
ADDON = "SaneUI_AuctionDatabase"
SAVED = "SaneUI_AuctionData.lua"
TAKE = 'SaneUI.Core.Data.Series("Prices").Account()\n'


def accounts(folder):
    """The WoW accounts of a game folder, by their folders in WTF/Account."""
    root = folder / "WTF" / "Account"
    return sorted(path.name for path in root.iterdir() if path.is_dir() and path.name != "SavedVariables") if root.is_dir() else []


def toc_file(folder, count):
    """The addon's TOC, with the game's Interface number and SaneUI's version as Core's say them: each link, and after it
    a file that hands what it left to Core. None where SaneUI is not there."""
    core = folder / "Interface" / "AddOns" / "SaneUI" / "SaneUI.toc"
    if not core.is_file():
        return None
    head = core.read_text(encoding="utf-8", errors="replace")
    interface = re.search(r"^## Interface: *(.+?)\s*$", head, re.M)
    version = re.search(r"^## Version: *(.+?)\s*$", head, re.M)
    if not interface:
        return None
    lines = [f"## Interface: {interface.group(1)}", "## Title: Data: Auction Database",
             "## Notes: Every account's auction data on this computer, read through links to each account's own Data: "
             "Auction House. Made by a tool of SaneUI's.",
             "## Author: Saneroki", f"## Version: {version.group(1) if version else '0'}", "## Category: SaneUI",
             "## Group: SaneUI", "## Dependencies: SaneUI", "## X-SaneUI-Made: 1", "## X-License: MIT", ""]
    for number in range(1, count + 1):
        lines += [f"Account{number}.lua", f"Take{number}.lua"]
    return "\n".join(lines) + "\n"


def saved(folder):
    """The accounts of a game folder that have saved their auction data: only those get a link."""
    return [name for name in accounts(folder) if (folder / "WTF" / "Account" / name / "SavedVariables" / SAVED).is_file()]


def wanted(folder, names):
    """What the addon's folder should hold: {file name: ("text", its text) or ("link", where it points)}. None where
    SaneUI is not there."""
    toc = toc_file(folder, len(names))
    if toc is None:
        return None
    files = {f"{ADDON}.toc": ("text", toc)}
    for number, name in enumerate(names, 1):
        files[f"Take{number}.lua"] = ("text", TAKE)
        files[f"Account{number}.lua"] = ("link", f"../../../WTF/Account/{name}/SavedVariables/{SAVED}")
    return files


def holds(addon):
    """What the addon's folder holds now, in the shape of wanted."""
    files = {}
    for path in addon.iterdir() if addon.is_dir() else []:
        if path.is_symlink():
            files[path.name] = ("link", os.readlink(path))
        elif path.is_file():
            files[path.name] = ("text", path.read_text(encoding="utf-8", errors="replace"))
        else:
            files[path.name] = ("other", None)
    return files


def link(folder):
    """The addon of a game folder made anew: (accounts linked, accounts left out, whether it changed); None where
    SaneUI is not there. Nothing is written where it already holds just that."""
    names = saved(folder)
    files = wanted(folder, names)
    if files is None:
        return None
    left = len(accounts(folder)) - len(names)
    addon = folder / "Interface" / "AddOns" / ADDON
    if holds(addon) == files:
        return len(names), left, False
    addon.mkdir(exist_ok=True)
    for old in addon.iterdir():
        old.unlink()
    for name, (kind, value) in files.items():
        if kind == "link":
            os.symlink(value, addon / name)
        else:
            (addon / name).write_text(value, encoding="utf-8")
    return len(names), left, True


def folders():
    return [folder for folder in (FOREVER, RETAIL) if folder.is_dir()]


def link_all(changed_only=False):
    for folder in folders():
        made = link(folder)
        if made is None:
            if not changed_only:
                print(f"{folder.name}: SaneUI is not in this game folder.")
            continue
        count, left, changed = made
        if changed_only and not changed:
            continue
        line = f"{folder.name}: auction database, links to {count} accounts' files"
        line += f" ({left} without one yet)" if left else ""
        print(line + (": made anew, restart the game." if changed else ", as before."))


def status():
    for folder in folders():
        print(f"{folder.name}:")
        for name in accounts(folder):
            parts = []
            for file in (SAVED, "SaneUI_AuctionScans.lua"):
                path = folder / "WTF" / "Account" / name / "SavedVariables" / file
                parts.append(f"{file}: {path.stat().st_size / 1048576:.1f} MB" if path.is_file() else f"{file}: none yet")
            print(f"  {name}: {', '.join(parts)}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=["link", "status"], nargs="?", default="status")
    parser.add_argument("--changed", action="store_true", help="link: say only what changed (the build's install)")
    given = parser.parse_args()
    if given.command == "link":
        link_all(given.changed)
    else:
        status()


if __name__ == "__main__":
    main()
