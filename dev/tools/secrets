#!/usr/bin/env bash
# Shows which spells the game hides from addons: the answer of /sane secrets (Core's Secrecy.lua), which asks
# the game itself about every spell (C_Secrets.GetSpellAuraSecrecy and GetSpellCastSecrecy) and keeps it in
# Sane UI's saved settings at the next /reload:
#     <game>/WTF/Account/<account>/SavedVariables/SaneUI.lua   (SaneUIDB.modules.SaneUI.secrecy)
# The game's three answers, for a spell as an aura and as a cast:
#     visible               never hidden, in a fight too (NeverSecret)
#     always hidden         hidden out of a fight too (AlwaysSecret)
#     hidden in a fight     hidden while a restriction is on: a fight, an encounter, a keystone, a rated match
#                           (ContextuallySecret): every other spell, only counted in the game
# It reads the game folder of each game that holds an answer (_forever_, _retail_; WOW_FOREVER names one).
#
# Usage:  dev/tools/secrets                     the counts, the visible and the always hidden spells, by name
#         dev/tools/secrets <SpellName.csv>     also every spell hidden in a fight: those of the client's
#                                               spell names (ID,Name_lang) that are neither of the others
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then   # saneui help showsecrets
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

set -euo pipefail

games="$HOME/.local/share/Steam/steamapps/compatdata/3133853286/pfx/drive_c/Program Files (x86)/World of Warcraft"
command -v lua5.1 >/dev/null || { echo "lua5.1 is not installed." >&2; exit 1; }
names="${1:-}"

if [ -n "${WOW_FOREVER:-}" ]; then folders=("$WOW_FOREVER"); else folders=("$games"/_*_); fi

found=0
for file in "${folders[@]/%//WTF/Account}"/*/SavedVariables/SaneUI.lua; do
    [ -f "$file" ] || continue
    grep -q 'secrecy' "$file" || continue
    found=1
    echo "== $file"
    echo "   written $(date -r "$file" '+%Y-%m-%d %H:%M:%S')"
    lua5.1 - "$file" "$names" <<'LUA'
local file, names = arg[1], arg[2]
dofile(file)
local core = SaneUIDB and SaneUIDB.modules and SaneUIDB.modules.SaneUI
local found = core and core.secrecy
if type(found) ~= "table" then print("   no answer in it: /sane secrets in the game, then /reload") return end
print(("   %s, build %s, asked %s: %d spells (numbers 1 to %d)"):format(found.game or "?", found.build or "?",
    found.day or "?", found.spells or 0, found.top or 0))
local WORDS = { [0] = "visible (never hidden)", [1] = "always hidden", [2] = "hidden in a fight" }
local function Sorted(set)
    local ids = {}
    for id in pairs(set or {}) do ids[#ids + 1] = id end
    table.sort(ids)
    return ids
end
for _, kind in ipairs({ "aura", "cast" }) do
    local counts = found.counts and found.counts[kind] or {}
    print(("\n   As %s: %d %s, %d %s, %d %s"):format(kind == "aura" and "auras" or "casts", counts[0] or 0, WORDS[0],
        counts[1] or 0, WORDS[1], counts[2] or 0, WORDS[2]))
    for _, level in ipairs({ 0, 1 }) do
        local set = found[kind] and found[kind][level] or {}
        local ids = Sorted(set)
        if #ids > 0 then
            print(("\n   %s, %s (%d):"):format(kind == "aura" and "Auras" or "Casts", WORDS[level], #ids))
            for _, id in ipairs(ids) do print(("   %8d  %s"):format(id, set[id])) end
        end
    end
end
if names == "" then return end
-- Every spell of the client's names that is neither visible nor always hidden as an aura: hidden in a fight.
local handle = io.open(names)
if not handle then print("\n   cannot read " .. names) return end
local known = {}
for level = 0, 1 do
    for id in pairs(found.aura and found.aura[level] or {}) do known[id] = true end
end
local count = 0
print("\n   Auras, hidden in a fight (the client's spell names, less the two lists above):")
for line in handle:lines() do
    local id, name = line:match("^(%d+),\"?(.-)\"?$")
    id = tonumber(id)
    if id and not known[id] then
        count = count + 1
        print(("   %8d  %s"):format(id, name))
    end
end
handle:close()
print(("   %d of them; the game counted %d"):format(count, found.counts and found.counts.aura and found.counts.aura[2] or 0))
LUA
done
[ "$found" = 1 ] || echo "No answer yet: in the game, out of a fight, /sane secrets, then /reload."
