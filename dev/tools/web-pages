#!/usr/bin/env python3
"""The tools' web pages (Saneroki, 2026-10-30): every local page of Sane UI's tools on one server, on one port,
running by default. It starts with the computer (saneui start webpages installs it as a user service), and each
page hangs under its own name:

  127.0.0.1 port 8768         the list of the pages
    /board/       task board         dev/tools/board (saneui showboard)
    /lab/         interface lab      dev/tools/ui-lab (saneui showuilab)
    /art/         game art           assets/generated/game-art (saneui showgameart)
    /pieces/      interface pieces   assets/generated/interface
    /maps/        maps compared      dev/tools/map-compare-page over its build (saneui showmaps)
    /sea/         sea compared       assets/generated/sea, made by dev/tools/sea-art (saneui showsea)
  and the pages of ~/.config/saneui/pages.json, folders kept outside the project:
    {"pages": [{"name": ..., "place": ..., "folder": ...}]}

A new page is one line in PAGES, on no port of its own:
- folders: the first that has a file answers, as it is;
- a tool: a script with a function web(request), read at its first use and read again when its file changed (its
  stop(), if it has one, called first), so a tool's new code needs no restart:
      def web(request):      # request.method, .path (under the page's place), .query, .headers, .json()
          return 200, "text/html; charset=utf-8", body     # bytes, words, or a dict or list sent as JSON
      (a fourth value, a dict, adds headers: an ETag, a Cache-Control of its own)
A page's links are relative ("api/op", never "/api/op"). Every HTML page sent gets the same menu of them all
(the ☰ button, Alt+M, dev/tools/web-nav.js). A request's body is 16 MB at most.

Usage:
  dev/tools/web-pages [list]       the pages and whether they are ready (saneui webpages)
  dev/tools/web-pages open PLACE   a page in the browser, the server started if it is down (saneui showboard, ...)
  dev/tools/web-pages start        installs or restarts the service; after a change of this file (saneui start webpages)
  dev/tools/web-pages stop         stops it and keeps it from starting by itself (saneui stop webpages)
  dev/tools/web-pages status       the pages and the service (saneui status webpages)
  dev/tools/web-pages run [--port PORT]   the server here; a session's own copy on another port (the lab's game
                                   is one for each server, so two sessions' scenes need two)
"""
import html
import http.server
import importlib.machinery
import importlib.util
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
import traceback
import urllib.parse
import webbrowser
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CONFIG = CONFIG_HOME / "saneui" / "pages.json"
UNIT = "saneui-web-pages"
SERVICE = CONFIG_HOME / "systemd" / "user" / f"{UNIT}.service"
NAV = ROOT / "dev" / "tools" / "web-nav.js"
PORT = 8768
HTML, TEXT = "text/html; charset=utf-8", "text/plain; charset=utf-8"
MENU = b'<script src="/web-nav.js" defer></script>'
LOCAL = ("127.0.0.1", "localhost")
GENERATED = ROOT / "assets" / "generated"
BODY_LIMIT = 16 << 20   # bytes a request may carry
TOLD = set()   # the config's problems printed, each once


class Tool:
    """A script with web(request), read at its first use and again when its file changed."""

    def __init__(self, path):
        self.path, self.module, self.stamp, self.lock = path, None, None, threading.Lock()

    def load(self):
        with self.lock:
            stamp = self.path.stat().st_mtime
            if stamp != self.stamp:
                self.stop()
                name = "page_" + self.path.name.replace("-", "_")
                loader = importlib.machinery.SourceFileLoader(name, str(self.path))
                module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
                sys.modules[name] = module
                loader.exec_module(module)
                self.module, self.stamp = module, stamp
            return self.module

    def stop(self):
        if self.module and hasattr(self.module, "stop"):
            self.module.stop()


class Page:
    """A page by its place: a tool's script, or folders laid over each other; needs names the file a folder page
    cannot do without (what its build makes)."""

    def __init__(self, name, place, serves, link="", needs=None):
        self.name, self.place, self.link, self.needs = name, place, link, needs
        self.tool = Tool(serves) if isinstance(serves, Path) else None
        self.folders = None if self.tool else serves

    def ready(self):
        if self.tool:
            return self.tool.path.is_file()
        return all(folder.is_dir() for folder in self.folders) and (
            not self.needs or any((folder / self.needs).is_file() for folder in self.folders))

    def href(self):
        return f"/{self.place}/{self.link}"


PAGES = [
    Page("task board", "board", ROOT / "dev" / "tools" / "board"),
    Page("interface lab", "lab", ROOT / "dev" / "tools" / "ui-lab"),
    Page("game art", "art", [GENERATED / "game-art"]),
    Page("interface pieces", "pieces", [GENERATED / "interface"]),
    Page("maps compared", "maps", [ROOT / "dev" / "tools" / "map-compare-page", GENERATED / "map-layers" / "compare"],
         needs="maps.js"),
    Page("sea compared", "sea", [GENERATED / "sea"]),
]


def pages():
    """The project's pages, then the ones of the config; a config that cannot be read (its syntax, no "pages", an entry
    without its folder) is said once, and the project's pages answer alone."""
    if not CONFIG.is_file():
        return PAGES
    try:
        outside = json.loads(CONFIG.read_text())["pages"]
        return PAGES + [Page(p["name"], p["place"], [Path(p["folder"]).expanduser()]) for p in outside]
    except (OSError, ValueError, KeyError, TypeError) as error:
        problem = f"{CONFIG}: not read, only the project's own pages are served ({type(error).__name__}: {error})"
        if problem not in TOLD:
            TOLD.add(problem)
            print(problem, file=sys.stderr, flush=True)
        return PAGES


def nav_script():
    """dev/tools/web-nav.js with every page in its list."""
    listed = [{"name": p.name, "place": p.place, "href": p.href(), "ready": p.ready()} for p in pages()]
    return NAV.read_text().replace("/*PAGES*/[]", json.dumps(listed), 1)


def home():
    rows = "".join(f'<li><a href="{html.escape(p.href())}">{html.escape(p.name.capitalize())}</a>'
                   f'{"" if p.ready() else " <small>not built yet</small>"}</li>' for p in pages())
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Sane UI pages</title><style>'
            "body { margin: 0; background: #1b1a18; color: #ece6dc; font: 16px/1.5 system-ui, sans-serif; }"
            "header { padding: 12px 16px; border-bottom: 1px solid #3b3732; } h1 { margin: 0; font-size: 20px; }"
            "ul { list-style: none; margin: 16px; padding: 0; } a { color: #d9a56b; } small { color: #a39a8c; }"
            f"</style></head><body><header><h1>Sane UI pages</h1></header><ul>{rows}</ul></body></html>")


class Request:
    """What a tool's web() is given: the path is under the page's place, the query parsed, the headers as sent."""

    def __init__(self, method, path, query, body, headers=None):
        self.method, self.path, self.body = method, path, body
        self.query = urllib.parse.parse_qs(query)
        self.headers = headers if headers is not None else {}

    def json(self):
        return json.loads(self.body or b"{}")


class Site(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, kind, body, headers=None):
        """The answer; headers (a tool's fourth value) add to or replace the usual ones."""
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False).encode()
        elif isinstance(body, str):
            body = body.encode()
        if kind == HTML:
            at = body.lower().rfind(b"</body>")
            body = body[:at] + MENU + body[at:] if at >= 0 else body + MENU
        headers = {"Cache-Control": "max-age=3600" if kind.startswith("font/") else "no-store", **(headers or {})}
        self.send_response(code)
        self.send_header("Content-Type", kind)
        if code != 304:   # "not modified" carries nothing, not even a length
            self.send_header("Content-Length", str(len(body)))
        for name, value in headers.items():
            self.send_header(name, value)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def move(self, where):
        self.send_response(302)
        self.send_header("Location", where)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def local(self):
        """Only this computer's own pages: the server is always there, and a site on the internet could otherwise reach
        it through the browser (a name pointed at this address, a form sent to the board)."""
        host = urllib.parse.urlsplit("//" + (self.headers.get("Host") or "")).hostname
        origin = self.headers.get("Origin")
        return host in LOCAL and (origin is None or urllib.parse.urlsplit(origin).hostname in LOCAL)

    def serve(self):
        url = urllib.parse.urlsplit(self.path)
        if not self.local():
            return self.reply(403, TEXT, "Only this computer's own pages.")
        if url.path == "/web-nav.js":
            return self.reply(200, "text/javascript; charset=utf-8", nav_script())
        if url.path == "/":
            return self.reply(200, HTML, home())
        place, slash, rest = url.path[1:].partition("/")
        page = next((p for p in pages() if p.place == place), None)
        if page is None:
            return self.reply(404, TEXT, "No such page.")
        if not slash:
            return self.move(f"/{place}/" + (f"?{url.query}" if url.query else ""))
        if page.tool:
            return self.ask(page.tool, "/" + rest, url.query)
        return self.folder(page, "/" + rest, url.query)

    def ask(self, tool, path, query):
        """A tool's answer; what goes wrong in it stays in that page."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if length < 0:
                raise ValueError(length)
        except ValueError:
            return self.reply(400, TEXT, "Content-Length is not a number.")
        if length > BODY_LIMIT:
            return self.reply(413, TEXT, f"A request of {length} bytes: a page takes {BODY_LIMIT >> 20} MB at most.")
        body = self.rfile.read(length)
        try:
            code, kind, content, *held = tool.load().web(Request(self.command, path, query, body, self.headers))
            answer = code, kind, content, held[0] if held else None
        except KeyboardInterrupt:
            raise
        except BaseException:   # also a sys.exit in the tool (the board without its folder): the page gets the message
            traceback.print_exc()
            answer = 500, TEXT, traceback.format_exc()
        self.reply(*answer)

    def folder(self, page, path, query):
        if self.command == "POST":
            return self.reply(405, TEXT, "A folder takes nothing.")
        self.path = path + (f"?{query}" if query else "")
        for folder in page.folders:
            self.directory = str(folder)
            target = Path(self.translate_path(self.path))
            if target.exists():
                break
        if target.is_dir():
            if not path.endswith("/"):
                return self.move(f"/{page.place}{path}/")
            target = target / "index.html"
        if target.suffix == ".html" and target.is_file():
            return self.reply(200, HTML, target.read_bytes())
        return super().do_HEAD() if self.command == "HEAD" else super().do_GET()

    do_GET = do_HEAD = do_POST = serve


def up(port):
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0


def run(port):
    if up(port):
        print(f"Already up: 127.0.0.1 port {port}", flush=True)
        return
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Site)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    print(f"Sane UI's pages on 127.0.0.1 port {port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        for page in PAGES:
            if page.tool:
                page.tool.stop()


def show():
    width = max(len(p.name) for p in pages())
    print(f"127.0.0.1 port {PORT}: {'up' if up(PORT) else 'down'}")
    for page in pages():
        print(f"  {page.name:<{width}}   /{page.place}/{'' if page.ready() else '   not built yet'}")


def service():
    return f"""# Sane UI's tool pages, one server on one port ({Path(__file__).resolve()}).
# Written by web-pages start; web-pages stop keeps it from starting by itself.
[Unit]
Description=Sane UI's tool pages (127.0.0.1 port {PORT})

[Service]
Type=simple
WorkingDirectory={ROOT}
Environment=PATH={os.environ.get("PATH", "/usr/bin")}
ExecStart={sys.executable} {Path(__file__).resolve()} run
Restart=on-failure
RestartSec=5
MemoryMax=8G

[Install]
WantedBy=default.target
"""


def systemctl(*words):
    return subprocess.run(["systemctl", "--user", *words], capture_output=True, text=True)


def start():
    SERVICE.parent.mkdir(parents=True, exist_ok=True)
    SERVICE.write_text(service())
    for step in (("daemon-reload",), ("enable", UNIT), ("restart", UNIT)):
        done = systemctl(*step)
        if done.returncode:
            sys.exit(f"systemctl {' '.join(step)}: {done.stderr.strip()}")
    for _ in range(50):
        if up(PORT):
            return print(f"Sane UI's pages run on 127.0.0.1 port {PORT}, from now on with the computer.")
        time.sleep(0.1)
    sys.exit(f"The pages did not come up: journalctl --user -u {UNIT}")


def show_page(place):
    page = next((p for p in pages() if p.place == place), None)
    if page is None:
        sys.exit(f"No page {place}: {', '.join(p.place for p in pages())}")
    if not up(PORT):
        start()
    path, _, query = page.href().partition("?")
    webbrowser.open(urllib.parse.urlunsplit(("http", f"127.0.0.1:{PORT}", path, query, "")))
    print(f"{page.name.capitalize()}: 127.0.0.1 port {PORT}, {page.href()}")


def main():
    args = sys.argv[1:]
    verb = args[0] if args else "list"
    if verb in ("list", "status"):
        show()
        if verb == "status":
            print(f"The service ({UNIT}): {systemctl('is-active', UNIT).stdout.strip()}, "
                  f"{systemctl('is-enabled', UNIT).stdout.strip() or 'not installed'}")
    elif verb == "open" and len(args) == 2:
        show_page(args[1])
    elif verb == "run":
        run(int(args[2]) if args[1:2] == ["--port"] else PORT)
    elif verb == "start":
        start()
    elif verb == "stop":
        systemctl("disable", "--now", UNIT)
        print("The pages stopped, and do not start with the computer (saneui start webpages brings them back).")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
