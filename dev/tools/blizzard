#!/usr/bin/env python3
"""Blizzard's interface code of a new game build against the one before it, and what the difference means for
Sane UI: a todo list of what broke, what is deprecated, what is called differently, what to review, and the
housekeeping (Doc/guides/blizzard-updates.md). Sane UI is built on the newest export (the highest build in the
exports' folder this computer's settings name: ~/.config/saneui/blizzard.json), never on references/.

Usage:  dev/tools/blizzard where      the newest export's code and art folders, and its build (Forever's and Retail's)
        dev/tools/blizzard check [<new>] [--old <export>|git:<revision>] [--build <version>] [--out <file.md>]
                                   the todo list, in dev/blizzard/reports/ (Markdown and JSON)
        dev/tools/blizzard show <name> [<new>] [--old ...]
                                   a symbol (C_Spell.GetSpellInfo, GameTooltip_SetDefaultAnchor, PLAYER_LOGIN,
                                   UIPanelButtonTemplate, lua:FooMixin:Bar) in both exports, with its diff
        dev/tools/blizzard uses [--list] [--unknown]
                                   what Sane UI takes from Blizzard, by kind, as the newest export has it; --unknown:
                                   the globals it reads that the export does not define (the client's own)
        dev/tools/blizzard adopt   the files made from Blizzard's code made again from the newest export
                                   (CVarLabels.lua, Pages.lua); commit them after the build
        dev/tools/blizzard games [--out <folder>]
                                   Forever's newest export against Retail's: the lookup tables of where the two
                                   games differ (symbols, files, addons, art) and what of Sane UI's uses differs

check and show take --retail: Retail's newest export against Forever's, in place of <new> and --old.

<new> is an export's code folder (BlizzardInterfaceCode, or the game folder the game exported into, or its
Interface folder); without it, the newest export. --old is the export before the newest unless given: another
export, or git:<revision> for references/ as a commit has it (the in-game export Sane UI was first built on).
The build of an export is read from its note (.build) or the game folder it is in (.build.info); --build gives the
new one's by hand.
"""
import argparse
import difflib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "dev" / "blizzard"))

import compare  # noqa: E402
import export as exports  # noqa: E402
import games  # noqa: E402
import report  # noqa: E402
import uses as sane  # noqa: E402

REPORTS = ROOT / "dev" / "blizzard" / "reports"
# The files made from Blizzard's code, with the tool that makes each.
GENERATED = (("dev/tools/cvar-labels", "src/Core/Settings/Data/CVarLabels.lua"),
             ("dev/tools/sync-pages", "src/Core/Sync/Data/Pages.lua"))


def fail(text):
    print(text, file=sys.stderr)
    sys.exit(1)


def new_export(path, build=None):
    where = Path(path) if path else exports.required("code")
    root = exports.locate(where)
    if root is None:
        fail(f"No export of Blizzard's interface code in {where}.")
    return exports.Export(root, build=build)


def old_export(spec, scratch, new_root):
    """The export to compare with: given, or the one before the newest (the build below it)."""
    if spec and spec.startswith("git:"):
        root = exports.from_git(spec[4:], ROOT, scratch)
        return exports.Export(root, label=spec[4:])
    if spec:
        root = exports.locate(spec)
        if root is None:
            fail(f"No export of Blizzard's interface code in {spec}.")
        return exports.Export(root)
    before = [e for e in exports.all_exports() if (e[2] / "BlizzardInterfaceCode").resolve() != new_root.resolve()]
    if not before:
        fail("No export before this one to compare it with: give --old (an export's folder, or git:<revision> for "
             "references/ as a commit has it).")
    return exports.Export(before[-1][2] / "BlizzardInterfaceCode")


def generated(old_root, new_root):
    """The files made from Blizzard's code that the new export would change, and whether they already would."""
    def stale(code):
        env = dict(os.environ, BLIZZARD_CODE=str(code))
        return {tool for tool, _ in GENERATED
                if subprocess.run([str(ROOT / tool), "--check"], env=env, capture_output=True).returncode}

    def run():
        before, after = stale(old_root), stale(new_root)
        return [(tool, made + (" (already out of date with the old export)" if tool in before else ""))
                for tool, made in GENERATED if tool in after]
    return run


def pair(args, scratch):
    """The two exports to compare: Forever's newest and Retail's (--retail), or the new one and the one before."""
    if getattr(args, "retail", False):
        return exports.Export(exports.required("code")), exports.Export(exports.required("code", "retail"))
    new = new_export(args.new, args.build)
    return old_export(args.old, scratch, new.root), new


def analysis(args, scratch):
    old, new = pair(args, scratch)
    found = sane.Uses(ROOT / "src", notes=[ROOT / "Doc"], root=ROOT)
    tocs = sorted((ROOT / "src").glob("*/*.toc"))
    return compare.Analysis(old, new, found, tocs, generated(old.root, new.root))


def run_check(args):
    with tempfile.TemporaryDirectory() as scratch:
        result = analysis(args, scratch)
        name = f"{result.old.build or result.old.label or 'old'}-to-{result.new.build or 'new'}"
        out = Path(args.out) if args.out else REPORTS / f"{name}.md"
        report.markdown(result, out, ROOT, args.new)
        report.as_json(result, out.with_suffix(".json"))
        try:
            shown = out.resolve().relative_to(ROOT)
        except ValueError:
            shown = out
        print("\n".join(report.summary(result, shown)))


def matches(name, *exports_):
    ids = set()
    for export in exports_:
        for id_ in export.symbols:
            if id_ == name or id_.partition(":")[2] == name or compare.tail(id_) == name:
                ids.add(id_)
    return sorted(ids)


def run_show(args):
    with tempfile.TemporaryDirectory() as scratch:
        old, new = pair(args, scratch)
        ids = matches(args.name, old, new)
        if not ids:
            fail(f"Neither export has {args.name!r}.")
        changes = compare.changes(old, new)
        for id_ in ids[:12]:
            a, b, change = old.symbols.get(id_), new.symbols.get(id_), changes.get(id_)
            print(f"{id_}: " + (change.status if change else "the same") +
                  (": " + "; ".join(change.notes) if change and change.notes else ""))
            for label, export, record in (("old", old, a), ("new", new, b)):
                if record:
                    where = record["file"] + (f":{record['line']}" if record.get("line") else "")
                    print(f"  {label}: {where}" + (" (deprecated)" if record["deprecated"] else ""))
            if a and b and a.get("line") and b.get("line"):
                text_a = old.lines(a["file"], a["line"], a["end"])
                text_b = new.lines(b["file"], b["line"], b["end"])
            else:
                text_a = json.dumps(a and a["sig"], indent=1, ensure_ascii=False).splitlines()
                text_b = json.dumps(b and b["sig"], indent=1, ensure_ascii=False).splitlines()
            for line in difflib.unified_diff(text_a, text_b, "old", "new", lineterm="", n=3):
                print("  " + line)
        if len(ids) > 12:
            print(f"... and {len(ids) - 12} more: " + ", ".join(ids[12:30]))


def run_uses(args):
    export = exports.Export(exports.required("code"))
    found = sane.Uses(ROOT / "src", notes=[ROOT / "Doc"], root=ROOT)
    result = compare.Analysis(export, export, found)
    by_kind, unknown = {}, {}
    for id_, places in result.resolved.items():
        by_kind.setdefault(id_.partition(":")[0], []).append((id_, places))
    print(f"Sane UI takes {len(result.resolved)} symbols from Blizzard's code ({export.label}):")
    for kind, items in sorted(by_kind.items(), key=lambda item: -len(item[1])):
        print(f"  {len(items):5} {compare.KIND.get(kind, kind)}")
        if args.list:
            for id_, places in sorted(items):
                print(f"          {id_.partition(':')[2]} ({len(places)})")
    hooks = found.of("hook")
    print(f"  {len(hooks):5} hooks: " + ", ".join(sorted({u.name for u in hooks})))
    if args.unknown:
        for use in found.of("global"):
            head = use.name.split(".")[0].split(":")[0]
            if not any(id_ in result.resolved for id_ in (f"lua:{head}",)) and head not in export.names:
                unknown.setdefault(head, []).append(use)
        print(f"Globals the export does not define ({len(unknown)}), the client's own or Lua's:")
        print("  " + ", ".join(sorted(unknown)))


def run_adopt(args):
    code = exports.required("code")
    print(f"The newest export: {exports.Export(code).build or code}.")
    for tool, made in GENERATED:
        subprocess.run([str(ROOT / tool)], check=True, stdout=subprocess.DEVNULL)
        changed = subprocess.run(["git", "-C", str(ROOT), "diff", "--quiet", "--", made]).returncode
        print(f"{tool}: {made} " + ("changed" if changed else "as before"))
    print("Next: dev/build, try it in the game, then commit the made files.")


def run_where(args):
    if not exports.all_exports():
        exports.required("code")
    for game in exports.GAMES:
        found = exports.all_exports(game)
        if found:
            version, product, interface = found[-1]
            print(f"{game}: {product} {version}")
            print(f"  code: {interface / 'BlizzardInterfaceCode'}")
            print(f"  art:  {interface / 'BlizzardInterfaceArt'}")


def run_games(args):
    forever, retail = pair(argparse.Namespace(retail=True), None)
    out = Path(args.out) if args.out else REPORTS / f"forever-{forever.build}-retail-{retail.build}"
    lines = games.write(forever, retail, exports.required("art"), exports.required("art", "retail"), out)
    found = sane.Uses(ROOT / "src", notes=[ROOT / "Doc"], root=ROOT)
    tocs = sorted((ROOT / "src").glob("*/*.toc"))
    result = compare.Analysis(forever, retail, found, tocs)
    report.markdown(result, out / "uses.md", ROOT, None)
    report.as_json(result, out / "uses.json")
    (out / "README.md").write_text("\n".join(lines), encoding="utf-8")
    print("\n".join(report.summary(result, out / "uses.md")))
    print(f"The lookup tables: {out}")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("check", "show"):
        command = commands.add_parser(name)
        if name == "show":
            command.add_argument("name")
        command.add_argument("new", nargs="?")
        command.add_argument("--build")
        command.add_argument("--old")
        command.add_argument("--retail", action="store_true")
        if name == "check":
            command.add_argument("--out")
    commands.add_parser("adopt")
    commands.add_parser("where")
    commands.add_parser("games").add_argument("--out")
    command = commands.add_parser("uses")
    command.add_argument("--list", action="store_true")
    command.add_argument("--unknown", action="store_true")
    args = parser.parse_args()
    {"check": run_check, "show": run_show, "uses": run_uses, "adopt": run_adopt, "where": run_where,
     "games": run_games}[args.command](args)


if __name__ == "__main__":
    main()
