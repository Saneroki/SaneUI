#!/usr/bin/env python3
"""The flights of the game's flight masters and the ways of its boats and zeppelins, from its client tables, as
staging for Core's set Travel (pack World): the ways Navigation's route planner takes (Doc/ideas/Navigation.md,
*The planner*).

  dev/data/staging/travel.jsonl   one line per way, its key the game's TaxiPath ID:

    a flight      kind flight, fromNode and toNode (the game's flight points, as C_TaxiMap names them), side
                  (alliance or horde where only that side's flight masters stand at both ends; none: both), cost
                  (copper), length (yards along the game's path) and path (its points in the world's yards, x to
                  the north and y to the west)
    the tram      the Deeprun Tram (no taxi path moves it): kind tram, name (its map's, the game's), path (its two
                  stations in its map's yards: the game's triggers there, where one leaves it, each with its map),
                  length (yards between them), time (seconds a run from one to the other takes, as its cars move
                  in the game's TransportAnimation, the same for every car within AGREE seconds), wait (seconds
                  between two trains leaving one station: its cars' motion once round, the same for every car,
                  over the trains: its cars set out from their stations together, one train each way), docks and
                  dockAreas (the cities' entrances to each station, placed as a transport's docks)
    a transport   a boat or a zeppelin, one way round as the game moves it (a path between no flight points): kind
                  (a boat when all its way lies within FLOAT yards of the sea's level, else a zeppelin), length
                  (yards it moves along its way once round, its leaps not counted) and path: its points, each with
                  map (the world's map it lies on, at its first point and wherever the way comes onto another),
                  stay (where it stops at a dock: the seconds it stands there, the game's delay) and jump (where it
                  leaps to the point from the one before, onto another map or far on the same: the game's teleport;
                  after its last point it starts again from its first), docks (its docks on the zone maps, for the
                  map's pins: one per place it stops at, in the order it first comes to them, each placed by
                  map-data's Placer; a dock on no zone map left out) and dockAreas (the game's area each of them
                  lies in, the AreaTable ID its terrain or building gives, which names it; 0 where none does)

On a path a point on a straight run, within STRAIGHT yards of the line between its neighbours, is left out (never a
dock or a leap). The game's tables hold neither a transport's speed nor its timetable: the planner estimates them
until they are learned in play (Doc/ideas/Data.md, learned data).

Left out: flights between flight points of no side (the game's own, not a flight master's); paths that stop at
fewer than two docks (a moving thing, no way between places); and a transport whose every dock is one of another
transport with more docks (or, with the same ones, a newer ID): the older way the newer one replaced. Two stops
within SAME yards on one map are one dock.

The input, of the build BUILD: a folder of the game's client tables as CSV (TaxiNodes, TaxiPath, TaxiPathNode,
AreaTrigger, Map and TransportAnimation for the tram, and
for placing the docks those map-data reads: AreaTable, UiMap, UiMapAssignment, WMOAreaTable), and its terrain files
as map-data takes them.

Usage:  dev/tools/travel-data <client tables> <terrain>
"""
import csv
import json
import math
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
STAGING = ROOT / "dev" / "data" / "staging" / "travel.jsonl"
BUILD = 70245
STRAIGHT = 2.0  # yards
FLOAT = 5.0  # yards over or under the sea's level (0) a boat's way keeps to
SAME = 20.0  # yards between two stops of one dock
AGREE = 0.005  # seconds the tram's cars' runs may differ by
ALLIANCE, HORDE = 0x1, 0x2  # the flight points' sides in TaxiNodes' Flags
TELEPORT, STOP = 0x1, 0x2  # TaxiPathNode's Flags: the transport leaps after this point; it stops here


def table(folder, name):
    return list(csv.DictReader(open(folder / f"{name}.csv", encoding="utf-8")))


def map_data():
    """dev/tools/map-data, whose Placer puts a world position on its zone map, read without running the tool."""
    loader = SourceFileLoader("map_data", str(ROOT / "dev" / "tools" / "map-data"))
    module = module_from_spec(spec_from_loader("map_data", loader))
    loader.exec_module(module)
    return module


def simplified(points):
    """The path's points (x and y first), those on a straight run left out (Douglas and Peucker)."""
    if len(points) < 3:
        return points
    a, b = points[0], points[-1]
    dx, dy = b[0] - a[0], b[1] - a[1]
    length = math.hypot(dx, dy)
    far, at = 0.0, 0
    for index in range(1, len(points) - 1):
        p = points[index]
        if length == 0:
            gap = math.hypot(p[0] - a[0], p[1] - a[1])
        else:
            gap = abs(dy * (p[0] - a[0]) - dx * (p[1] - a[1])) / length
        if gap > far:
            far, at = gap, index
    if far <= STRAIGHT:
        return [a, b]
    return simplified(points[:at + 1])[:-1] + simplified(points[at:])


def flight(key, row, a, b, path):
    """A flight's fields, or None when no flight master's side stands at both ends."""
    sides = [int(node["Flags"]) & (ALLIANCE | HORDE) for node in (a, b)]
    both = sides[0] & sides[1]
    if not all(sides) or not both:
        return None
    side = None if both == ALLIANCE | HORDE else ("alliance" if both == ALLIANCE else "horde")
    continent = int(a["ContinentID"])
    way = [(float(p["Loc[0]"]), float(p["Loc[1]"])) for p in path if int(p["ContinentID"]) == continent]
    length = sum(math.hypot(q[0] - p[0], q[1] - p[1]) for p, q in zip(way, way[1:]))
    fields = {"kind": "flight", "fromNode": int(row["FromTaxiNode"]), "toNode": int(row["ToTaxiNode"]),
              "cost": int(row["Cost"])}
    if len(way) >= 2:  # a way the game has no points for keeps no length nor path
        fields["length"] = round(length, 1)
        fields["path"] = [{"x": x, "y": y} for x, y in simplified(way)]
    if side:
        fields["side"] = side
    return fields


def docks(path):
    """A transport's docks: [(map, x, y, z)], one per place it stops at, where it first stops there."""
    found = []
    for p in path:
        if int(p["Flags"]) & STOP:
            place = (int(p["ContinentID"]), float(p["Loc[0]"]), float(p["Loc[1]"]), float(p["Loc[2]"]))
            if not any(d[0] == place[0] and math.hypot(d[1] - place[1], d[2] - place[2]) <= SAME for d in found):
                found.append(place)
    return found


def replaced(places):
    """The transports (by key: their docks) all of whose docks another one has, with more docks, or with the same
    ones and a newer ID: the older ways the newer ones replaced."""
    def within(small, large):
        return all(any(a[0] == b[0] and math.hypot(a[1] - b[1], a[2] - b[2]) <= SAME for b in large) for a in small)

    return {key for key in places for other in places if other != key and within(places[key], places[other])
            and (len(places[other]) > len(places[key]) or (len(places[other]) == len(places[key]) and other > key))}


def transport(path, placer=None):
    """A transport's fields from its path's points (in the game's order); its docks on the zone maps where a placer
    (map-data's Placer) is given."""
    points, length = [], 0.0
    for index, p in enumerate(path):
        world, x, y = int(p["ContinentID"]), float(p["Loc[0]"]), float(p["Loc[1]"])
        before = path[index - 1] if index else None
        leap = before is not None and (int(before["ContinentID"]) != world or int(before["Flags"]) & TELEPORT)
        if before is not None and not leap:
            length += math.hypot(x - float(before["Loc[0]"]), y - float(before["Loc[1]"]))
        point = {"x": x, "y": y}
        if before is None or int(before["ContinentID"]) != world:
            point["map"] = world
        if int(p["Flags"]) & STOP:
            point["stay"] = int(p["Delay"])
        if leap:
            point["jump"] = True
        points.append(point)
    # Straight runs left out between the points that must stay: the ends, the docks and the leaps (with the point
    # before each leap, where the transport leaves).
    kept = {0, len(points) - 1}
    for index, point in enumerate(points):
        if "stay" in point or "jump" in point:
            kept.add(index)
            if "jump" in point:
                kept.add(index - 1)
    marks = sorted(kept)
    out = []
    for start, end in zip(marks, marks[1:]):
        run = [(p["x"], p["y"], p) for p in points[start:end + 1]]
        if "jump" in points[end]:
            out.append(points[start])
            continue
        out += [p for _, _, p in simplified(run)][:-1]
    out.append(points[-1])
    heights = [abs(float(p["Loc[2]"])) for p in path]
    fields = {"kind": "boat" if max(heights) <= FLOAT else "zeppelin", "length": round(length, 1), "path": out}
    if placer:
        placed = [(placer.place(*dock), placer.area(*dock)) for dock in docks(path)]
        placed = [(point, area) for point, area in placed if point]
        if placed:
            fields["docks"] = [point for point, _ in placed]
            fields["dockAreas"] = [area for _, area in placed]
    return fields


# The Deeprun Tram, by the game's IDs: its map; its two stations, each the trigger in that map where one leaves
# the tram and the trigger in the city that leads to it (AreaTrigger); its cars (TransportAnimation); and our own
# number for it in the set (the game has no path for it).
TRAM_MAP = 369
TRAM_STATIONS = ((2166, 2175), (2171, 2173))
TRAM_CARS = range(176080, 176086)
TRAM_KEY = 1000369


def tram(folder, placer=None):
    """The tram's fields, or None when the tables do not have it whole (a station, a car) or its cars disagree."""
    triggers = {int(row["ID"]): row for row in table(folder, "AreaTrigger")}
    if any(a not in triggers or b not in triggers for a, b in TRAM_STATIONS):
        return None
    moves = {}
    for row in table(folder, "TransportAnimation"):
        car = int(row["TransportID"])
        if car in TRAM_CARS:
            moves.setdefault(car, set()).add((int(row["TimeIndex"]), float(row["Pos[0]"]), float(row["Pos[1]"])))
    runs, rounds, ways = [], [], set()
    for car in TRAM_CARS:
        rows = sorted(moves.get(car, ()))
        if not rows:
            return None
        far = max(math.hypot(x, y) for _, x, y in rows)
        there = [t for t, x, y in rows if far - math.hypot(x, y) < 0.01]
        home = [t for t, x, y in rows if math.hypot(x, y) < 0.01 and t < there[0]]
        if not home:
            return None
        runs.append((there[0] - max(home)) / 1000)
        # Its motion once round (its last point, where the game starts it again), and which way it sets out.
        rounds.append(rows[-1][0] / 1000)
        x, y = next((x, y) for t, x, y in rows if t == there[0])
        ways.add((round(x / far), round(y / far)))
    if max(runs) - min(runs) > AGREE or max(rounds) - min(rounds) > AGREE:
        return None
    path, places = [], []
    for station, entrance in TRAM_STATIONS:
        here, door = triggers[station], triggers[entrance]
        if int(here["ContinentID"]) != TRAM_MAP:
            return None
        point = {"x": float(here["Pos[0]"]), "y": float(here["Pos[1]"])}
        if not path:
            point["map"] = TRAM_MAP
        path.append(point)
        places.append((int(door["ContinentID"]), float(door["Pos[0]"]), float(door["Pos[1]"]), float(door["Pos[2]"])))
    name = next((row["MapName_lang"] for row in table(folder, "Map") if int(row["ID"]) == TRAM_MAP), "")
    fields = {"kind": "tram", "length": round(math.hypot(path[1]["x"] - path[0]["x"], path[1]["y"] - path[0]["y"]), 1),
              "time": sorted(runs)[len(runs) // 2], "path": path}
    # A train each way, each from its own station at the round's start: each station sees a train leave twice a round.
    if len(ways) == 2:
        fields["wait"] = round(sorted(rounds)[len(rounds) // 2] / len(ways), 3)
    if name:
        fields["name"] = name
    if placer:
        placed = [(placer.place(*door), placer.area(*door)) for door in places]
        if all(point for point, _ in placed):
            fields["docks"] = [point for point, _ in placed]
            fields["dockAreas"] = [area for _, area in placed]
    return fields


def main():
    if len(sys.argv) != 3:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        return 2
    folder = Path(sys.argv[1])
    placer = map_data().Placer(folder, Path(sys.argv[2]))
    nodes = {int(row["ID"]): row for row in table(folder, "TaxiNodes")}
    points = {}
    for row in table(folder, "TaxiPathNode"):
        points.setdefault(int(row["PathID"]), []).append(row)
    lines, left, transports = [], 0, {}
    for row in table(folder, "TaxiPath"):
        key = int(row["ID"])
        a, b = nodes.get(int(row["FromTaxiNode"])), nodes.get(int(row["ToTaxiNode"]))
        path = sorted(points.get(key, []), key=lambda p: int(p["NodeIndex"]))
        fields = flight(key, row, a, b, path) if a and b else None
        if fields:
            lines.append((key, fields))
        elif len(docks(path)) >= 2:
            transports[key] = path
        else:
            left += 1
    gone = replaced({key: docks(path) for key, path in transports.items()})
    for key, path in transports.items():
        if key in gone:
            left += 1
        else:
            lines.append((key, transport(path, placer)))
    trams = tram(folder, placer)
    if trams:
        lines.append((TRAM_KEY, trams))
    lines.sort(key=lambda line: line[0])
    STAGING.parent.mkdir(parents=True, exist_ok=True)
    with open(STAGING, "w", encoding="utf-8") as out:
        for key, fields in lines:
            line = {"set": "Travel", "key": key, "game": "forever", "build": BUILD, "src": "game", "fields": fields}
            out.write(json.dumps(line, separators=(",", ":")) + "\n")
    ships = sum(1 for _, fields in lines if fields["kind"] in ("boat", "zeppelin"))
    placed = sum(len(fields.get("docks", ())) for _, fields in lines)
    flights = sum(1 for _, fields in lines if fields["kind"] == "flight")
    print(f"Wrote {STAGING.relative_to(ROOT)}: {flights} flights, {ships} boats and zeppelins, "
          f"{'the tram' if trams else 'no tram'}, with {placed} docks on the zone maps ({left} ways left out; "
          f"replaced: {', '.join(map(str, sorted(gone))) or 'none'}).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
