    for key, row in sorted(t("ChrRaces").items(), key=lambda item: num(item[0])):
        if key not in races:
            w.leave("Races", key, "no racial abilities: no race of this game's players")
            continue
        template = templates.get(row["FactionID"])
        group = num(template["FactionGroup"]) if template else 0
        w.stage("Races", num(key), {"name": row["Name_lang"], "nameFemale": row["Name_female_lang"] or None,
                                    "file": row["ClientFileString"], "side": SIDES.get(group & 6),
                                    "description": plain(row["LoreDescription_lang"]), "bit": num(row["PlayableRaceBit"]),
