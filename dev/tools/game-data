def documentation():
    """Blizzard's API documentation of the newest export (dev/tools/blizzard where)."""
    return exports.required("code") / "Interface" / "AddOns" / "Blizzard_APIDocumentationGenerated"

TEST = re.compile(r"^(Monster - |OLD[A-Z ]|Deprecated|DEPRECATED|Unused|UNUSED|\[PH\]|\[DNT\]|zz|ZZ)"
                  r"|\b(test|NYI|DND|DNT|debug)\b|placeholder", re.IGNORECASE)
NOT_TEST = {"High Test Eternium Fishing Line"}  # a real item: high test is a kind of line
TRIGGERS = {0: "use", 1: "equip", 2: "hit", 6: "learn"}  # ItemEffect's TriggerType
CREATE_ITEM = 24                                         # SpellEffect's Effect: makes an item
AURAS = {6, 35, 65, 119, 128, 129}                       # SpellEffect's Effect: puts an aura on (self, party, raid, pet, ...)
DISPEL = {1: "magic", 2: "curse", 3: "disease", 4: "poison"}  # SpellCategories' DispelType
NODE_KINDS = {0: "single", 1: "tiered", 2: "selection"}  # TraitNode's Type, Enum.TraitNodeType
# SpellCategories' DefenseType, as the client's own spells have it: Frostbolt 1, Heroic Strike 2, Auto Shot 3
ATTACKS = {1: "magic", 2: "melee", 3: "ranged"}
TRAIT_SET = 0                                            # TraitDefinitionEffectPoints' OperationType, Enum.TraitPointsOperationType.Set
# The fields the client alone holds, staged empty (null) where it holds nothing, so that one the game takes away is
# taken out of the master too; every other empty field is left out of a line (the master keeps what it has).
CLEARED = {"Spells": ("attack", "interrupts", "auraInterrupts", "channelInterrupts", "forms", "notForms"),
           "Talents": ("values",), "Legacy": ("values",), "Professions": ("toolKinds",), "Items": ("statTypes",)}
CONSUMABLE = 0                                           # Item's ClassID
AURA_SOURCES = {5: "food", 1: "potion", 2: "elixir", 3: "elixir"}  # a consumable's SubclassID
WEAPON = 2
NEVER_LEARNED = 3                                        # SkillLineAbility's AcquireMethod: another form of a spell, not one a player learns
LEGACY_RANK = 48                                        # RenownRewards' CovenantID of the Legacy rank (Covenant: 1.60 Legacy Rank)
# SkillLine's CategoryID to the set's kind; 7 (class) and 9 (secondary) are told apart line by line
KINDS = {6: "weapon", 8: "armor", 10: "language", 11: "profession"}
SECONDARY_RECIPES = {"First Aid", "Cooking", "Poisons"}  # secondary lines with recipes


class Tables:
    """The client's tables of one build, with the hotfixes laid on: rows by their ID, as text."""

    def __init__(self, folder, hotfixes=None):
        self.folder, self.hotfixes, self.cache = Path(folder), Path(hotfixes) if hotfixes else None, {}

    def __call__(self, name):
        if name not in self.cache:
            with open(self.folder / f"{name}.csv", encoding="utf-8", newline="") as file:
                rows = {row["ID"]: row for row in csv.DictReader(file)}
            columns = list(next(iter(rows.values())).keys()) if rows else []
            fixes = self.hotfixes / f"{name}.csv" if self.hotfixes else None
            if fixes and fixes.exists():
                latest = {}
                with open(fixes, encoding="utf-8", newline="") as file:
                    for row in csv.DictReader(file):
                        if row["decode"] != "ok" and row["status_name"] != "removed":
                            continue
                        push = int(row["push_id"])
                        if row["record_id"] not in latest or push >= latest[row["record_id"]][0]:
                            latest[row["record_id"]] = (push, row)
                for record, (_, row) in latest.items():
                    if row["status_name"] == "valid":
                        rows[record] = {column: row.get(column, "") for column in columns or row}
                    elif row["status_name"] == "removed":
                        rows.pop(record, None)
            self.cache[name] = rows
        return self.cache[name]

    def by(self, name, column):
        """A table's rows grouped by one column."""
        out = defaultdict(list)
        for row in self(name).values():
            out[row[column]].append(row)
        return out


def num(value):
    try:
        return int(value)
    except ValueError:
        return int(float(value))


def flags(value):
    """A mask of the client's (a signed 32-bit number in its tables) as a whole number from 0."""
    return num(value) & 0xFFFFFFFF


def words(row, column):
    """A mask of two words (column[0], column[1]): the words as the client holds them, trailing empty ones left out."""
    found = [flags(row[f"{column}[{i}]"]) for i in (0, 1)] if row else []
    while found and not found[-1]:
        found.pop()
    return found


def forms(row, column):
    """The forms a mask of two words names (bit n-1 of the first word is form n, of the second form n+32)."""
    if not row:
        return []
    return [word * 32 + bit + 1 for word in (0, 1) for bit in range(32) if flags(row[f"{column}[{word}]"]) >> bit & 1]


def test(name):
    return name not in NOT_TEST and bool(TEST.search(name))


def plain(text):
    """A text of the client's as it shows it, or None: empty, or a template with $ the game fills in."""
    text = (text or "").strip()
    return text if text and "$" not in text and "\t" not in text else None


def enum_values(file, name):
    """{value: name} of one of Blizzard's enums in the generated API documentation."""
    text = (documentation() / file).read_text(encoding="utf-8")
    block = text[text.index(f'Name = "{name}"'):]
    block = block[:block.index("\t\t},")]
    return {int(value): field for field, value in re.findall(r'Name = "(\w+)", Type = "\w+", EnumValue = (-?\d+)', block)}


class Writer:
    def __init__(self, game, build, day):
        self.game, self.build, self.day = game, build, day
        self.lines, self.left, self.kept = [], [], defaultdict(int)

    def stage(self, set_name, key, fields):
        """A line of staging: empty fields left out, but those of CLEARED, which are staged as null (empty)."""
        cleared = CLEARED.get(set_name, ())
        fields = {name: (None if value in (None, [], {}) else value) for name, value in fields.items()
                  if value not in (None, [], {}) or name in cleared}
        line = {"set": set_name, "key": key, "game": self.game, "build": self.build}
        if self.day:
            line["day"] = self.day
        line.update({"src": "game", "fields": fields})
        self.lines.append(line)
        self.kept[set_name] += 1

    def leave(self, set_name, key, why):
        self.left.append((set_name, key, why))


class Spells:
    """What the client says of a spell."""

    def __init__(self, t):
        self.t = t
        self.names = {key: row["Name_lang"].strip() for key, row in t("SpellName").items()}
        self.text = t("Spell")
        self.misc = {row["SpellID"]: row for row in t("SpellMisc").values() if row["DifficultyID"] == "0"}
        self.effects = t.by("SpellEffect", "SpellID")
        self.cooldowns = {row["SpellID"]: row for row in t("SpellCooldowns").values() if row["DifficultyID"] == "0"}
        self.power = t.by("SpellPower", "SpellID")
        self.categories = {row["SpellID"]: row for row in t("SpellCategories").values() if row["DifficultyID"] == "0"}
        self.interrupts = {row["SpellID"]: row for row in t("SpellInterrupts").values() if row["DifficultyID"] == "0"}
        self.shapes = {row["SpellID"]: row for row in t("SpellShapeshift").values()}
        self.cast, self.ranges, self.durations = t("SpellCastTimes"), t("SpellRange"), t("SpellDuration")

    def name(self, spell):
        name = self.names.get(str(spell))
        return name if name and not test(name) else None

    def description(self, spell):
        row = self.text.get(str(spell))
        return plain(row["Description_lang"]) if row else None

    def cast_time(self, misc):
        row = self.cast.get(misc["CastingTimeIndex"]) if misc else None
        return num(row["Base"]) if row and num(row["Base"]) > 0 else None

    def duration(self, misc):
        row = self.durations.get(misc["DurationIndex"]) if misc else None
        return num(row["Duration"]) if row and num(row["Duration"]) > 0 else None

    def facts(self, spell):
        key, misc = str(spell), self.misc.get(str(spell))
        row = self.text.get(key)
        cost = self.cost_list(key)
        cooldown = self.cooldowns.get(key)
        cooldown = max(num(cooldown["RecoveryTime"]), num(cooldown["CategoryRecoveryTime"])) if cooldown else 0
        span = self.ranges.get(misc["RangeIndex"]) if misc else None
        low, high = (float(span["RangeMin[0]"]), float(span["RangeMax[0]"])) if span else (0, 0)
        return {
            "name": self.names[key],
            "rank": (row["NameSubtext_lang"].strip() or None) if row else None,
            "description": self.description(spell),
            "icon": num(misc["SpellIconFileDataID"]) or None if misc else None,
            "cost": cost,
            "castTime": self.cast_time(misc),
            "cooldown": cooldown or None,
            "minRange": round(low, 2) or None,
            "maxRange": round(high, 2) or None,
            "effects": self.effect_list(key),
            **self.how(key),
        }

    def how(self, key):
        """How the spell is cast: an attack of which kind (SpellCategories' DefenseType), what ends its cast, takes its
        aura away or ends its channel (SpellInterrupts' masks, as the client holds them: InterruptFlags 1 is moving,
        which every spell with a cast time has), and the forms it may be cast in or cannot be cast in (SpellShapeshift's
        masks: bit n-1 is form n of SpellShapeshiftForm: Charge's 17 Battle Stance, Fear Ward's 28 Shadowform)."""
        kind, stop, shape = self.categories.get(key), self.interrupts.get(key), self.shapes.get(key)
        return {
            "attack": ATTACKS.get(num(kind["DefenseType"])) if kind else None,
            "interrupts": flags(stop["InterruptFlags"]) or None if stop else None,
            "auraInterrupts": words(stop, "AuraInterruptFlags"),
            "channelInterrupts": words(stop, "ChannelInterruptFlags"),
            "forms": forms(shape, "ShapeshiftMask"),
            "notForms": forms(shape, "ShapeshiftExclude"),
        }

    def cost_list(self, key):
        """What the spell costs, power by power: an amount, or a share of the caster's base mana (PowerCostPct: Forever's
        Arcane Shot, 11%), or both."""
        found = []
        for row in sorted(self.power.get(key, []), key=lambda p: num(p["OrderIndex"])):
            amount, percent = num(row["ManaCost"]), round(float(row["PowerCostPct"] or 0), 3)
            if amount > 0 or percent > 0:
                part = {"power": num(row["PowerType"])}
                if amount > 0:
                    part["amount"] = amount
                if percent > 0:
                    part["percent"] = int(percent) if percent == int(percent) else percent
                found.append(part)
        return found

    def effect_list(self, key):
        """What the spell does, effect by effect: the numbers a patch changes. Only what an effect holds: 0 is no value."""
        found = []
        for row in sorted(self.effects.get(key, []), key=lambda e: num(e["EffectIndex"])):
            if row["DifficultyID"] != "0":
                continue
            effect = {"index": num(row["EffectIndex"]), "effect": num(row["Effect"]), "aura": num(row["EffectAura"]),
                      "points": round(float(row["EffectBasePointsF"]), 3), "perLevel": round(float(row["EffectRealPointsPerLevel"]), 3),
                      "period": num(row["EffectAuraPeriod"]), "targets": num(row["EffectChainTargets"]),
                      "misc": num(row["EffectMiscValue[0]"]), "trigger": num(row["EffectTriggerSpell"]),
                      "coefficient": round(float(row.get("EffectBonusCoefficient") or 0), 4),
                      "apCoefficient": round(float(row.get("BonusCoefficientFromAP") or 0), 4)}
            found.append({part: value for part, value in effect.items() if value or part == "index"})
        return found

    def puts_aura(self, spell):
        return any(num(e["Effect"]) in AURAS for e in self.effects.get(str(spell), []))


def slot_names(t):
    """{InventoryType: the game's INVTYPE_ name}, each checked against the client's global strings."""
    known = {row["BaseTag"] for row in t("GlobalStrings").values() if row["BaseTag"].startswith("INVTYPE_")}
    out = {}
    for value, field in enum_values("ItemConstantsDocumentation.lua", "InventoryType").items():
        if value == 0:
            continue  # IndexNonEquipType: an item that is not worn has no slot
        word = field[len("Index"):-len("Type")]
        for token in ("INVTYPE_" + word.upper(), "INVTYPE_" + re.sub(r"(?<=[a-z])(?=[A-Z])", "_", word).upper()):
            if token in known:
                out[value] = token
                break
    return out


def items(t, spells, w):
    """Items and ItemSets."""
    sparse, base = t("ItemSparse"), t("Item")
    slots = slot_names(t)
    playable = sorted(num(key) for key in t("ChrClasses"))
    toys = {row["ItemID"] for row in t("Toy").values()}
    effects = defaultdict(list)
    item_effects = t("ItemEffect")
    for link in t("ItemXItemEffect").values():
        effect = item_effects.get(link["ItemEffectID"])
        if effect:
            effects[link["ItemID"]].append(effect)
    kept = {}
    for key, row in sparse.items():
        name, item = row["Display_lang"].strip(), base.get(key)
        if not name or test(name):
            w.leave("Items", key, "test or placeholder" if name else "no name")
            continue
        if not item:
            w.leave("Items", key, "no row in Item")
            continue
        made = []
        for effect in sorted(effects.get(key, []), key=lambda e: num(e["LegacySlotIndex"])):
            trigger, spell = TRIGGERS.get(num(effect["TriggerType"])), num(effect["SpellID"])
            if trigger and spell > 0:
                made.append({"trigger": trigger, "spell": spell, "text": spells.description(spell) if trigger != "learn" else None})
        made = [{part: value for part, value in effect.items() if value is not None} for effect in made]
        delay = num(row["ItemDelay"])
        mask = num(row["AllowableClass"])
        allowed = sorted(c for c in playable if mask >> (c - 1) & 1) if mask not in (-1, 0) else []
        kept[num(key)] = {
            "name": name,
            "quality": num(row["OverallQualityID"]),
            "itemLevel": num(row["ItemLevel"]) or None,
            "minLevel": num(row["RequiredLevel"]) or None,
            "class": num(item["ClassID"]),
            "subclass": num(item["SubclassID"]),
            "slot": slots.get(num(row["InventoryType"])),
            "stack": max(num(row["Stackable"]), 1),
            "bind": num(row["Bonding"]) or None,
            "icon": num(item["IconFileDataID"]) or None,
            "sell": num(row["SellPrice"]) or None,
            "speed": delay / 1000 if delay > 0 and num(item["ClassID"]) == WEAPON else None,
            "effects": made,
            "set": num(row["ItemSet"]) or None,
            "description": plain(row["Description_lang"]),
            "classes": allowed if len(allowed) < len(playable) else [],
            "unique": num(row["MaxCount"]) if num(row["MaxCount"]) > 0 else None,
            "toy": True if key in toys else None,
            "statTypes": [num(row[f"StatModifier_bonusStat[{i}]"]) for i in range(10)
                          if num(row[f"StatModifier_bonusStat[{i}]"]) >= 0 and num(row[f"StatPercentEditor[{i}]"]) != 0],
        }
    sets = {}
    bonuses = t.by("ItemSetSpell", "ItemSetID")
    for key, row in t("ItemSet").items():
        name = row["Name_lang"].strip()
        members = sorted({num(row[f"ItemID[{i}]"]) for i in range(17)} & set(kept))
        if not name or test(name) or not members:
            w.leave("ItemSets", key, "test or placeholder" if name and test(name) else "no items kept")
            continue
        sets[num(key)] = {
            "name": name,
            "items": members,
            "bonuses": [{part: value for part, value in (("count", num(b["Threshold"])), ("spell", num(b["SpellID"])),
                                                          ("text", spells.description(b["SpellID"]))) if value is not None}
                        for b in sorted(bonuses.get(key, []), key=lambda b: (num(b["Threshold"]), num(b["SpellID"])))
                        if num(b["ChrSpecID"]) == 0 and num(b["SpellID"]) > 0 and num(b["Threshold"]) > 0],
        }
    for key, fields in sorted(kept.items()):
        if fields["set"] and fields["set"] not in sets:
            fields["set"] = None
        w.stage("Items", key, fields)
    for key, fields in sorted(sets.items()):
        w.stage("ItemSets", key, fields)
    return kept


def classes_of(t):
    """{skill line: the classes it is for} (SkillRaceClassInfo's ClassMask: bit n-1 is class n)."""
    out = defaultdict(set)
    for row in t("SkillRaceClassInfo").values():
        mask = num(row["ClassMask"])
        out[row["SkillID"]] |= {bit + 1 for bit in range(32) if mask >> bit & 1}
    return out


def skill_lines(t, spells, w):
    """SkillLines; gives {line: (kind, name)} and {spell: [lines]} of what was kept."""
    abilities = t.by("SkillLineAbility", "SkillLine")
    classes = classes_of(t)
    candidates = {key: {num(a["Spell"]) for a in rows if num(a["AcquireMethod"]) != NEVER_LEARNED and spells.name(a["Spell"])}
                  for key, rows in abilities.items()}
    every = set().union(*candidates.values())
    parts = {num(e["EffectTriggerSpell"]) for spell in every for e in spells.effects.get(str(spell), [])} & every
    for spell, why in [(s, "set off by another spell: a part of it") for s in sorted(parts)]:
        w.leave("Spells", spell, why)
    kept, of_spell = {}, defaultdict(list)
    for key, row in t("SkillLine").items():
        name, category = row["DisplayName_lang"].strip(), num(row["CategoryID"])
        if not name or test(name) or category not in (6, 7, 8, 9, 10, 11):
            w.leave("SkillLines", key, "test or placeholder" if name and test(name) else "not a player's skill")
            continue
        found = sorted(candidates.get(key, set()) - parts)
        if not found:
            w.leave("SkillLines", key, "no spell")
            continue
        own, kind = None, KINDS.get(category)
        if category == 7:
            mine = classes.get(key, set())
            own = next(iter(mine)) if len(mine) == 1 and not name.startswith("Pet - ") else None
            kind = "class" if own else "other"
        elif category == 9:
            kind = "riding" if "Riding" in name else "other" if "Racial" in name else "secondary"
        kept[key] = (kind, name)
        for spell in found:
            of_spell[spell].append(key)
        w.stage("SkillLines", num(key), {"name": name, "kind": kind, "class": own, "spells": found})
    return kept, of_spell


def professions(t, spells, lines, item_keys, w):
    """Professions: the recipes of the profession lines and of First Aid, Cooking and Poisons."""
    reagents = {row["SpellID"]: row for row in t("SpellReagents").values()}
    totems = {row["SpellID"]: row for row in t("SpellTotems").values()}
    teachers = defaultdict(set)
    item_effects = t("ItemEffect")
    for link in t("ItemXItemEffect").values():
        effect = item_effects.get(link["ItemEffectID"])
        if effect and num(effect["TriggerType"]) == 6 and num(link["ItemID"]) in item_keys:
            teachers[effect["SpellID"]].add(num(link["ItemID"]))
    recipes = defaultdict(list)
    for row in t("SkillLineAbility").values():
        if num(row["AcquireMethod"]) == NEVER_LEARNED:
            continue
        kind, name = lines.get(row["SkillLine"], (None, None))
        if kind == "profession" or (kind == "secondary" and name in SECONDARY_RECIPES):
            recipes[row["Spell"]].append(row)
    for spell, rows in sorted(recipes.items(), key=lambda item: num(item[0])):
        if not spells.name(spell):
            continue
        if len({row["SkillLine"] for row in rows}) > 1:
            w.leave("Professions", spell, "in more than one profession")
            continue
        row = rows[0]
        made = [e for e in spells.effects.get(spell, []) if num(e["Effect"]) == CREATE_ITEM and num(e["EffectItemType"]) > 0]
        given = reagents.get(spell)
        needs = [{"item": num(given[f"Reagent[{i}]"]), "count": num(given[f"ReagentCount[{i}]"])}
                 for i in range(8) if given and num(given[f"Reagent[{i}]"]) > 0 and num(given[f"ReagentCount[{i}]"]) > 0]
        if not made and not needs:
            w.leave("Professions", spell, "makes nothing and needs nothing (a rank or a skill)")
            continue
        tools = totems.get(spell)
        cooldown = spells.cooldowns.get(spell)
        cooldown = max(num(cooldown["RecoveryTime"]), num(cooldown["CategoryRecoveryTime"])) // 1000 if cooldown else 0
        teacher = teachers.get(spell, set())
        w.stage("Professions", num(spell), {
            "skill": num(row["SkillLine"]),
            "creates": num(made[0]["EffectItemType"]) if len(made) == 1 else None,
            "count": num(made[0]["EffectBasePointsF"]) if len(made) == 1 and num(made[0]["EffectBasePointsF"]) >= 1 else None,
            "reagents": needs,
            "learnAt": num(row["MinSkillLineRank"]) or None,
            "yellow": num(row["TrivialSkillLineRankLow"]) or None,
            "grey": num(row["TrivialSkillLineRankHigh"]) or None,
            "tools": [num(tools[f"Totem[{i}]"]) for i in (0, 1) if tools and num(tools[f"Totem[{i}]"]) > 0],
            "cooldown": cooldown or None,
            "recipe": next(iter(teacher)) if len(teacher) == 1 else None,
            "toolKinds": [num(tools[f"RequiredTotemCategoryID[{i}]"]) for i in (0, 1)
                          if tools and num(tools[f"RequiredTotemCategoryID[{i}]"]) > 0],
        })


def rank_values(entry, entries, points, curves):
    """A node entry's numbers per rank (TraitDefinitionEffectPoints: the effect of its spell a curve sets, CurvePoint: the
    rank and its value), one tuple a rank: entry, the effect's index, rank, value. Only the operation Set (all the
    client has); a rank the curve gives twice is left out."""
    row = entries.get(str(entry["entry"]))
    found = []
    for effect in sorted(points.get(row["TraitDefinitionID"], []) if row else [], key=lambda e: num(e["EffectIndex"])):
        if num(effect["OperationType"]) != TRAIT_SET:
            continue
        ranks = defaultdict(list)
        for point in curves.get(effect["CurveID"], []):
            ranks[float(point["Pos[0]"])].append(round(float(point["Pos[1]"]), 3))
        for rank, value in sorted(ranks.items()):
            if rank == int(rank) and 1 <= rank <= entry["ranks"] and len(value) == 1:
                found.append({"entry": entry["entry"], "index": num(effect["EffectIndex"]), "rank": int(rank),
                              "value": int(value[0]) if value[0] == int(value[0]) else value[0]})
    return found


def trees(t, spells, w):
    """Talents and Legacy; gives the spells of their nodes."""
    legacy = {value: name for name, value in re.findall(
        r'Name = "(LEGACY_TREE_\w+_ID)", Type = "number", Value = (\d+)',
        (documentation() / "LegacyConstantsDocumentation.lua").read_text(encoding="utf-8"))}
    legacy = {tree for tree, name in legacy.items() if name.count("_") == 3}  # LEGACY_TREE_<NAME>_ID: the trees
    classes = classes_of(t)
    class_of = {}
    for row in t("SkillLineXTraitTree").values():
        mine = classes.get(row["SkillLineID"], set())
        if len(mine) == 1:
            class_of[row["TraitTreeID"]] = next(iter(mine))
    definitions, entries = t("TraitDefinition"), t("TraitNodeEntry")
    of_node = t.by("TraitNodeXTraitNodeEntry", "TraitNodeID")
    points, curves = t.by("TraitDefinitionEffectPoints", "TraitDefinitionID"), t.by("CurvePoint", "CurveID")
    edges = t.by("TraitEdge", "LeftTraitNodeID")
    cost = {}
    costs = t("TraitCost")
    currencies = {row["ID"]: num(row["CurrencyTypesID"]) or num(row["ID"]) for row in t("TraitCurrency").values()}
    for row in t("TraitTreeXTraitCost").values():
        price = costs.get(row["TraitCostID"])
        if price and row["TraitTreeID"] in legacy:
            cost[row["TraitTreeID"]] = (num(price["Amount"]), currencies.get(price["TraitCurrencyID"]))
    nodes = {key: row for key, row in t("TraitNode").items() if row["TraitTreeID"] in class_of or row["TraitTreeID"] in legacy}
    used = set()
    staged = {}
    for key, node in nodes.items():
        made, name = [], None
        for link in sorted(of_node.get(key, []), key=lambda link: num(link["Index"])):
            entry = entries.get(link["TraitNodeEntryID"])
            definition = definitions.get(entry["TraitDefinitionID"]) if entry else None
            if not definition:
                continue
            spell = num(definition["SpellID"])
            label = definition["OverrideName_lang"].strip() or (spells.name(spell) if spell else None)
            if not label or test(label):
                continue
            name = name or label
            made.append({"entry": num(entry["ID"]), "spell": spell or None, "ranks": max(num(entry["MaxRanks"]), 1)})
        kind = NODE_KINDS.get(num(node["Type"]))
        values = [value for entry in made for value in rank_values(entry, entries, points, curves)]
        if not made or not kind:
            w.leave("Talents", key, "no entry with a name" if not made else f"node type {node['Type']}")
            continue
        made = [{part: value for part, value in entry.items() if value is not None} for entry in made]
        used |= {entry["spell"] for entry in made if "spell" in entry}
        staged[key] = (node, kind, name, made, values)
    for key, (node, kind, name, made, values) in sorted(staged.items(), key=lambda item: num(item[0])):
        tree = node["TraitTreeID"]
        links = sorted({num(e["RightTraitNodeID"]) for e in edges.get(key, []) if e["RightTraitNodeID"] in staged
                        and staged[e["RightTraitNodeID"]][0]["TraitTreeID"] == tree})
        if tree in legacy:
            first = made[0]
            definition = definitions[entries[str(first["entry"])]["TraitDefinitionID"]]
            w.stage("Legacy", f"node:{key}", {
                "kind": "node", "tree": num(tree), "name": name,
                "description": plain(definition["OverrideDescription_lang"]) or spells.description(first.get("spell", 0)),
                "x": num(node["PosX"]), "y": num(node["PosY"]),
                "links": [f"node:{link}" for link in links], "entries": made,
                "cost": cost[tree][0] if tree in cost else None, "values": values,
            })
        else:
            w.stage("Talents", num(key), {
                "class": class_of[tree], "tree": num(tree), "name": name, "x": num(node["PosX"]), "y": num(node["PosY"]),
                "kind": kind, "links": links, "entries": made, "values": values,
            })
    points = {currency for amount, currency in cost.values()}
    challenges = {}
    for key, row in sorted(t("TraitCurrencySource").items(), key=lambda item: num(item[0])):
        currency = currencies.get(row["TraitCurrencyID"])
        name = row["Requirement_lang"].strip()
        if currency not in points or not name:
            continue
        fields = {"kind": "challenge", "name": name,
                  "rewards": [{"kind": "currency", "id": currency, "count": max(num(row["Amount"]), 1)}]}
        same = json.dumps(fields, sort_keys=True)
        if same in challenges:  # the same challenge again, for another set of realms (its SuperDistrictSetID)
            w.leave("Legacy", f"challenge:{key}", f"the same as challenge:{challenges[same]}, for another set of realms")
            continue
        challenges[same] = key
        w.stage("Legacy", f"challenge:{key}", fields)
    track = defaultdict(list)
    for row in t("RenownRewards").values():
        if num(row["CovenantID"]) == LEGACY_RANK:
            track[num(row["Level"])].append(row)
    for level, rows in sorted(track.items()):
        rewards = []
        for row in rows:
            for kind, column in (("item", "ItemID"), ("spell", "SpellID"), ("mount", "MountID"), ("title", "CharTitlesID")):
                if num(row[column]) > 0:
                    rewards.append({"kind": kind, "id": num(row[column]), "count": 1})
        if len(rows) > 1:
            w.leave("Legacy", f"reward:{level}", "more than one reward row at this level")
            continue
        row = rows[0]
        w.stage("Legacy", f"reward:{level}", {
            "kind": "reward", "name": row["Name_lang"].strip() or row["ToastDescription_lang"].strip() or None,
            "description": plain(row["Description_lang"]), "level": level, "rewards": rewards,
        })
    return used


def auras(t, spells, player, kept_items, w):
    """Auras: what an item's use casts or sets off, where it puts an aura with a duration on."""
    base, item_effects = t("Item"), t("ItemEffect")
    sources = defaultdict(set)
    for link in t("ItemXItemEffect").values():
        effect = item_effects.get(link["ItemEffectID"])
        if not effect or num(effect["TriggerType"]) != 0 or num(link["ItemID"]) not in kept_items:
            continue
        item = base[link["ItemID"]]
        source = AURA_SOURCES.get(num(item["SubclassID"]), "item") if num(item["ClassID"]) == CONSUMABLE else "item"
        spell = effect["SpellID"]
        for one in [spell] + [e["EffectTriggerSpell"] for e in spells.effects.get(spell, []) if num(e["EffectTriggerSpell"]) > 0]:
            sources[one].add(source)
    for spell, found in sorted(sources.items(), key=lambda item: num(item[0])):
        misc = spells.misc.get(spell)
        if num(spell) in player or not spells.name(spell) or not spells.puts_aura(spell) or not spells.duration(misc):
            continue
        category = spells.categories.get(spell)
        w.stage("Auras", num(spell), {
            "name": spells.names[spell],
            "description": spells.description(spell),
            "icon": num(misc["SpellIconFileDataID"]) or None,
            "school": num(misc["SchoolMask"]) or None,
            "source": next(iter(found)) if len(found) == 1 else None,
            "kind": DISPEL.get(num(category["DispelType"])) if category else None,
            "castTime": spells.cast_time(misc),
            "duration": spells.duration(misc),
        })


def map_data():
    """dev/tools/map-data, whose Placer knows the zone maps' boxes, read without running the tool."""
    loader = SourceFileLoader("map_data", str(ROOT / "dev" / "tools" / "map-data"))
    module = module_from_spec(spec_from_loader("map_data", loader))
    loader.exec_module(module)
    return module


def quest_keys(game):
    """The quests the master has in a game version's files (live's, and the game version's own)."""
    keys = set()
    for name in ("Quests.jsonl", f"Quests.{game}.jsonl"):
        path = ROOT / "assets" / "data" / "Quests" / name
        if path.exists():
            keys |= {json.loads(line)["key"] for line in open(path, encoding="utf-8")}
    return keys


def inside(x, y, polygon):
    """Whether a point lies inside a polygon (even-odd rule)."""
    found, last = False, polygon[-1]
    for point in polygon:
        if (point[1] > y) != (last[1] > y) and x < (last[0] - point[0]) * (y - point[1]) / (last[1] - point[1]) + point[0]:
            found = not found
        last = point
    return found


def quest_areas(t, folder, w):
    placer = map_data().Placer(folder)
    known = quest_keys(w.game)
    points = t.by("QuestPOIPoint", "QuestPOIBlobID")
    cells = defaultdict(set)
    for key, blob in sorted(t("QuestPOIBlob").items(), key=lambda item: num(item[0])):
        index, quest, uimap, map_id = num(blob["ObjectiveIndex"]), num(blob["QuestID"]), num(blob["UiMapID"]), num(blob["MapID"])
        if not 0 <= index < 32:
            w.leave("QuestAreas", key, "the place to hand the quest in" if index == -1 else f"objective index {index}")
            continue
        if quest not in known:
            w.leave("QuestAreas", key, f"quest {quest} is not in the master")
            continue
        found = placer.regions.get((uimap, map_id))
        corners = [row for row in sorted(points.get(key, []), key=lambda row: num(row["ID"]))]
        if not found or not corners:
            w.leave("QuestAreas", key, "no zone map box" if not found else "no points")
            continue
        region, ui = found
        polygon = [(min(max(100 * (ui[0] + (region[4] - float(c["Y"])) / (region[4] - region[1]) * (ui[2] - ui[0])), 0), 99.999),
                    min(max(100 * (ui[1] + (region[3] - float(c["X"])) / (region[3] - region[0]) * (ui[3] - ui[1])), 0), 99.999))
                   for c in corners]
        mine = cells[(quest, index + 1, uimap)]
        if len(polygon) < 3:
            mine |= {(int(y), int(x)) for x, y in polygon}
        else:
            mine |= {(row, column) for row in range(100) for column in range(100) if inside(column + 0.5, row + 0.5, polygon)}
    for (quest, objective, uimap), found in sorted(cells.items()):
        if not found:
            continue
        runs = []
        for row, column in sorted(found):
            if runs and runs[-1]["row"] == row and runs[-1]["last"] == column - 1:
                runs[-1]["last"] = column
            else:
                runs.append({"row": row, "first": column, "last": column})
        w.stage("QuestAreas", f"{quest}/{objective}/1/{uimap}", {
            "quest": quest, "objective": objective, "stage": 1, "map": uimap, "runs": runs,
            "x": round(sum(column + 0.5 for _, column in found) / len(found), 1),
            "y": round(sum(row + 0.5 for row, _ in found) / len(found), 1),
            "size": round(math.sqrt(len(found) / math.pi), 1), "from": "game",
        })


def collections(t, spells, kept_items, w):
    """Achievements, Mounts, Toys, TransmogSets, Enchantments, Holidays, Factions, Encounters."""
    hidden = {key for key, row in t("Achievement_Category").items() if row["Name_lang"].strip() == "Do Not Display"}
    seen = {}
    for key, row in sorted(t("Achievement").items(), key=lambda item: num(item[0])):
        name = row["Title_lang"].strip()
        if not name or test(name) or num(row["Flags"]) & 1 or row["Category"] in hidden:
            w.leave("Achievements", key, "a statistic" if num(row["Flags"]) & 1 else "hidden or test")
            continue
        fields = {
            "name": name, "description": plain(row["Description_lang"]), "points": num(row["Points"]),
            "category": num(row["Category"]), "icon": num(row["IconFileID"]) or None,
            "side": {0: "horde", 1: "alliance"}.get(num(row["Faction"])), "reward": plain(row["Reward_lang"]),
            "rewardItem": num(row["RewardItemID"]) or None, "previous": num(row["Supercedes"]) or None,
        }
        same = json.dumps(fields, sort_keys=True)
        if same in seen:  # the same achievement again, for another set of realms
            w.leave("Achievements", key, f"the same as achievement {seen[same]}, for another set of realms")
            continue
        seen[same] = key
        w.stage("Achievements", num(key), fields)
    teachers = defaultdict(set)
    item_effects = t("ItemEffect")
    for link in t("ItemXItemEffect").values():
        effect = item_effects.get(link["ItemEffectID"])
        if effect and num(effect["TriggerType"]) == 6 and num(link["ItemID"]) in kept_items:
            teachers[num(effect["SpellID"])].add(num(link["ItemID"]))
    for key, row in sorted(t("Mount").items(), key=lambda item: num(item[0])):
        spell = num(row["SourceSpellID"])
        if test(row["Name_lang"]) or not spells.name(spell):
            w.leave("Mounts", key, "test, or its spell is not in the client")
            continue
        teacher = teachers.get(spell, set())
        w.stage("Mounts", num(key), {"spell": spell, "sourceType": num(row["SourceTypeEnum"]) if num(row["SourceTypeEnum"]) >= 0 else None,
                                     "source": plain(row["SourceText_lang"]), "item": next(iter(teacher)) if len(teacher) == 1 else None})
    playable = sorted(num(key) for key in t("ChrClasses"))
    looks = t("ItemModifiedAppearance")
    members = defaultdict(set)
    for row in t("TransmogSetItem").values():
        look = looks.get(row["ItemModifiedAppearanceID"])
        if look and num(look["ItemID"]) in kept_items:
            members[row["TransmogSetID"]].add(num(look["ItemID"]))
    for key, row in sorted(t("TransmogSet").items(), key=lambda item: num(item[0])):
        name, mask = row["Name_lang"].strip(), num(row["ClassMask"])
        if not name or test(name) or not members.get(key):
            w.leave("TransmogSets", key, "test, or no item kept")
            continue
        allowed = sorted(c for c in playable if mask >> (c - 1) & 1) if mask not in (-1, 0) else []
        w.stage("TransmogSets", num(key), {"name": name, "classes": allowed if len(allowed) < len(playable) else [],
                                           "items": sorted(members[key])})
    for key, row in sorted(t("SpellItemEnchantment").items(), key=lambda item: num(item[0])):
        name = plain(row["Name_lang"])
        if not name or test(name):
            w.leave("Enchantments", key, "no plain name" if not name else "test")
            continue
        w.stage("Enchantments", num(key), {"name": name, "skill": num(row["RequiredSkillID"]) or None,
                                           "skillLevel": num(row["RequiredSkillRank"]) or None, "minLevel": num(row["MinLevel"]) or None})
    names, texts = t("HolidayNames"), t("HolidayDescriptions")
    for key, row in sorted(t("Holidays").items(), key=lambda item: num(item[0])):
        name = names.get(row["HolidayNameID"], {}).get("Name_lang", "").strip()
        if not name or test(name):
            w.leave("Holidays", key, "no name")
            continue
        hours = sum(num(row[f"Duration[{i}]"]) for i in range(10))
        dates = []
        for i in range(26):
            packed = num(row.get(f"Date[{i}]", "0") or 0)
            if packed <= 0:
                continue
            # the game's packed time: minute, hour, weekday, day, month, year since 2000; all bits set: any
            year, month, day = packed >> 24 & 0x1F, packed >> 20 & 0xF, packed >> 14 & 0x3F
            if month == 0xF or day == 0x3F:
                w.leave("Holidays", key, f"a start for any month or day ({packed})")
                continue
            dates.append({"year": 2000 + year if year != 0x1F else None, "month": month + 1, "day": day + 1,
                          "hour": packed >> 6 & 0x1F, "minute": packed & 0x3F, "hours": hours or None})
        w.stage("Holidays", num(key), {"name": name, "description": plain(texts.get(row["HolidayDescriptionID"], {}).get("Description_lang")),
                                       "dates": [{part: value for part, value in date.items() if value is not None} for date in dates]})
    factions = t("Faction")
    shown = {key for key, row in factions.items() if num(row["ReputationIndex"]) >= 0 and row["Name_lang"].strip() and not test(row["Name_lang"])}
    shown |= {factions[key]["ParentFactionID"] for key in shown if factions[key]["ParentFactionID"] in factions}
    for key in sorted(shown, key=num):
        row = factions[key]
        if not row["Name_lang"].strip():
            continue
        parent = row["ParentFactionID"]
        w.stage("Factions", num(key), {"name": row["Name_lang"].strip(), "description": plain(row["Description_lang"]),
                                       "parent": num(parent) if parent in shown and factions[parent]["Name_lang"].strip() else None})
    maps = t("Map")
    for key, row in sorted(t("DungeonEncounter").items(), key=lambda item: num(item[0])):
        name = row["Name_lang"].strip()
        if not name or test(name) or row["MapID"] not in maps:
            w.leave("Encounters", key, "test, or its instance is not in the client")
            continue
        w.stage("Encounters", num(key), {"name": name, "instance": num(row["MapID"]), "order": num(row["OrderIndex"]) if num(row["OrderIndex"]) >= 0 else None,
                                         "difficulty": num(row["DifficultyID"]) or None})


