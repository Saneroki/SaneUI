                                      "icon": num(row["IconFileDataID"]) or None, "power": num(row["DisplayPower"]),
                                      "color": "%02X%02X%02X" % (num(row["ClassColorR"]), num(row["ClassColorG"]), num(row["ClassColorB"])),
                                      "armor": num(row["ArmorTypeMask"]) or None})


def named(row, column):
    """The factions a template's list names (Enemies[0..7], Friend[0..7]), without the empty ones."""
    return {num(row.get(f"{column}[{index}]") or 0) for index in range(8)} - {0}


def reaction(creature, player):
    """How a creature of one faction template meets a player of another, by the game's rule: a faction its enemies or
    friends name first; else hostile where its enemy groups hold the player's group, friendly where its friend groups
    do (or the player's friend groups hold its own), else neutral."""
    faction, group = num(player["Faction"]), num(player["FactionGroup"])
    if faction and faction in named(creature, "Enemies"):
        return "hostile"
    if faction and faction in named(creature, "Friend"):
        return "friendly"
    if num(creature["EnemyGroup"]) & group:
        return "hostile"
    if num(creature["FriendGroup"]) & group or num(creature["FactionGroup"]) & num(player["FriendGroup"]):
        return "friendly"
    return "neutral"


def reactions(t, w):
    """FactionTemplates: each template's reaction to each side's players, worked out against the templates of that side's
    races (those Races holds: with racial abilities); where its races disagree, none for that side."""
    templates = t("FactionTemplate")
    races = {row["ChrRacesID"] for row in t("ChrRaceRacialAbility").values()}
    sides = defaultdict(list)
    for key, row in t("ChrRaces").items():
        template = templates.get(row["FactionID"]) if key in races else None
        side = SIDES.get(num(template["FactionGroup"]) & 6) if template else None
        if side in ("alliance", "horde"):
            sides[side].append(template)
    for key, row in sorted(templates.items(), key=lambda item: num(item[0])):
        fields = {"faction": num(row["Faction"]) or None}
        for side, players in sorted(sides.items()):
            found = {reaction(row, player) for player in players}
            fields[side] = found.pop() if len(found) == 1 else None
        w.stage("FactionTemplates", num(key), fields)


def places(t, w):
    """Maps and Areas: the game's own lists, which zone maps alone do not hold."""
    for key, row in sorted(t("Map").items(), key=lambda item: num(item[0])):
        if test(row["MapName_lang"]):
            w.leave("Maps", key, "a test's")
            continue
        w.stage("Maps", num(key), {"name": row["MapName_lang"], "directory": row["Directory"],
                                   "kind": MAP_KINDS.get(num(row["InstanceType"]), "other"), "parent": num(row["ParentMapID"]),
                                   "area": num(row["AreaTableID"]) or None, "maxPlayers": num(row["MaxPlayers"]) or None})
    for key, row in sorted(t("AreaTable").items(), key=lambda item: num(item[0])):
        if not row["AreaName_lang"].strip() or test(row["AreaName_lang"]):
            w.leave("Areas", key, "no name, or a test's")
            continue
        w.stage("Areas", num(key), {"name": row["AreaName_lang"].strip(), "parent": num(row["ParentAreaID"]) or None,
                                    "map": num(row["ContinentID"]), "side": SIDES.get(num(row["FactionGroupMask"]) & 6),
                                    "level": max(num(row["ExplorationLevel"]), 0) or None, "mounts": num(row["MountFlags"]) or None})


def currencies(t, w):
    for key, row in sorted(t("CurrencyTypes").items(), key=lambda item: num(item[0])):
        name = row["Name_lang"].strip()
        if not name or test(name):
            w.leave("Currencies", key, "test or placeholder")
            continue
        w.stage("Currencies", num(key), {
            "name": name, "description": plain(row["Description_lang"]),
            "icon": num(row["InventoryIconFileID"]) or None, "quality": num(row["Quality"]),
            "cap": num(row["MaxQty"]) or None, "weeklyCap": num(row["MaxEarnablePerWeek"]) or None,
        })


def base(batch):
    """Live's base: what the beta's staging has and live's lacks, as a batch of live's."""
    def read(game):
        with open(STAGING / f"game-{game}.jsonl", encoding="utf-8") as file:
            return [json.loads(line) for line in file]
    live = {(line["set"], line["key"]) for line in read("forever")}
    out, counts = STAGING / "game-base.jsonl", defaultdict(int)
    with open(out, "w", encoding="utf-8") as file:
        for line in read("forever-beta"):
            if (line["set"], line["key"]) in live:
                continue
            counts[line["set"]] += 1
            line = {"set": line["set"], "key": line["key"], "game": "forever", "build": 0, "src": batch, "fields": line["fields"]}
            file.write(json.dumps(line, ensure_ascii=False, separators=(",", ":")) + "\n")
    print(f"{out.relative_to(ROOT)}: " + ", ".join(f"{name} {count}" for name, count in sorted(counts.items())))


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "base":
        return base(int(sys.argv[2]))
    if len(sys.argv) not in (4, 6):
        sys.exit(__doc__.split("Usage:")[1])
    game, build, folder = sys.argv[1], int(sys.argv[2]), sys.argv[3]
    hotfixes, day = (sys.argv[4], sys.argv[5]) if len(sys.argv) == 6 else (None, None)
    t = Tables(folder, hotfixes)
    w = Writer(game, build, day)
    spells = Spells(t)
    kept_items = items(t, spells, w)
    lines, of_spell = skill_lines(t, spells, w)
    tree_spells = trees(t, spells, w)
    player = set(of_spell) | {spell for spell in tree_spells if spells.name(spell)}
    for spell in sorted(player):
        w.stage("Spells", spell, spells.facts(spell))
    professions(t, spells, lines, kept_items, w)
    auras(t, spells, player, kept_items, w)
    currencies(t, w)
    characters(t, w)
    reactions(t, w)
    places(t, w)
    collections(t, spells, kept_items, w)
    quest_areas(t, folder, w)
    STAGING.mkdir(parents=True, exist_ok=True)
    out = STAGING / f"game-{game}.jsonl"
    with open(out, "w", encoding="utf-8") as file:
        for line in w.lines:
            file.write(json.dumps(line, ensure_ascii=False, separators=(",", ":")) + "\n")
    with open(STAGING / f"game-{game}-left.csv", "w", encoding="utf-8", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(["set", "key", "why"])
        writer.writerows(w.left)
    left = defaultdict(int)
    for set_name, _, _ in w.left:
        left[set_name] += 1
    print(f"{out.relative_to(ROOT)}: {len(w.lines)} lines")
    for set_name in sorted(set(w.kept) | set(left)):
        print(f"  {set_name}: {w.kept[set_name]} kept, {left[set_name]} left out")


if __name__ == "__main__":
    main()
