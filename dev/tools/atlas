class Quit(Exception):
    pass


class Painter:
    """Paints a square's picture in ComfyUI, or with --dry hands the picture back as it is."""

    def __init__(self, shared, dry):
        self.shared, self.dry = shared, dry
        self.server = ig.Server(ADDRESS)
        self.graph = json.loads(ig.find_workflow(WORKFLOW).read_text())
        self.prompt_id = None

    def reachable(self):
        try:
            with urllib.request.urlopen(f"http://{ADDRESS}/queue", timeout=3):
                return True
        except OSError:
            return False

    def paint(self, picture, prompt, name, seed, work):
        if self.dry:
            for step in range(1, 6):
                self.wait_a_moment(0.4)
                self.shared.set(step=(step, 5))
            return Image.fromarray(picture)
        path = work / f"{name}.png"
        Image.fromarray(picture).save(path)
        uploaded = {path: self.server.upload(path)}
        graph = ig.fill(self.graph, {"prompt": prompt, "name": f"atlas-{name}", "refs": [path]}, seed, SETTINGS, uploaded)
        self.prompt_id = self.server.queue(graph)
        try:
            while True:
                if self.shared.quit:
                    raise Quit
                entry = json.loads(self.server.call(f"/history/{self.prompt_id}")).get(self.prompt_id)
                if entry:
                    break
                time.sleep(0.5)
        finally:
            self.prompt_id = None
        if entry.get("status", {}).get("status_str") == "error":
            raise RuntimeError(f"ComfyUI failed on {name}: {json.dumps(entry.get('status'))[:300]}")
        data = next(self.server.pictures(entry), None)
        if data is None:
            raise RuntimeError(f"ComfyUI gave no picture for {name}")
        self.tidy(entry, uploaded[path])
        path.unlink(missing_ok=True)
        return Image.open(io.BytesIO(data)).convert("RGB")

    def wait_a_moment(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            if self.shared.quit:
                raise Quit
            time.sleep(0.05)

    def tidy(self, entry, uploaded):
        """ComfyUI keeps every input and output: these are kept in the run's folder, so they go there."""
        for output in entry.get("outputs", {}).values():
            for image in output.get("images", []):
                (COMFY / "output" / image.get("subfolder", "") / image.get("filename", "-")).unlink(missing_ok=True)
        (COMFY / "input" / uploaded).unlink(missing_ok=True)

    def interrupt(self):
        if self.dry:
            return
        try:
            if self.prompt_id:
                body = json.dumps({"delete": [self.prompt_id]}).encode()
                self.server.call("/queue", body, {"Content-Type": "application/json"})
            self.server.call("/interrupt", b"")
        except SystemExit:
            pass

    def free(self):
        """Lets go of the graphics card's memory (paused: the game may run)."""
        if self.dry:
            return
        try:
            body = json.dumps({"unload_models": True, "free_memory": True}).encode()
            self.server.call("/free", body, {"Content-Type": "application/json"})
        except SystemExit:
            pass


def frames(buffer):
    """The websocket frames complete in buffer: (opcode, payload); what is used is taken off the buffer."""
    found = []
    while len(buffer) >= 2:
        opcode, length, at = buffer[0] & 0x0F, buffer[1] & 0x7F, 2
        masked = buffer[1] & 0x80
        if length == 126:
            if len(buffer) < 4:
                break
            length, at = struct.unpack(">H", bytes(buffer[2:4]))[0], 4
        elif length == 127:
            if len(buffer) < 10:
                break
            length, at = struct.unpack(">Q", bytes(buffer[2:10]))[0], 10
        mask = bytes(buffer[at:at + 4]) if masked else None
        at += 4 if masked else 0
        if len(buffer) < at + length:
            break
        payload = bytes(buffer[at:at + length])
        if mask:
            payload = bytes(b ^ mask[k % 4] for k, b in enumerate(payload))
        found.append((opcode, payload))
        del buffer[:at + length]
    return found


def listen(shared, client):
    """ComfyUI's websocket: the steps of the picture being painted. Without it the bar goes by the time."""
    host, port = ADDRESS.split(":")
    while not shared.stopped:
        try:
            with socket.create_connection((host, int(port)), timeout=5) as conn:
                key = base64.b64encode(os.urandom(16)).decode()
                conn.sendall((f"GET /ws?clientId={client} HTTP/1.1\r\nHost: {ADDRESS}\r\nUpgrade: websocket\r\n"
                              f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
                head = b""
                while b"\r\n\r\n" not in head:
                    chunk = conn.recv(4096)
                    if not chunk:
                        raise OSError("closed")
                    head += chunk
                if b" 101 " not in head.split(b"\r\n", 1)[0]:
                    raise OSError("refused")
                buffer = bytearray(head.split(b"\r\n\r\n", 1)[1])
                conn.settimeout(1)
                while not shared.stopped:
                    for opcode, payload in frames(buffer):
                        if opcode == 1:
                            message = json.loads(payload)
                            if message.get("type") == "progress":
                                data = message.get("data", {})
                                shared.set(step=(data.get("value", 0), data.get("max", 0)))
                        elif opcode == 8:
                            raise OSError("closed")
                    try:
                        chunk = conn.recv(65536)
                    except socket.timeout:
                        continue
                    if not chunk:
                        raise OSError("closed")
                    buffer += chunk
        except (OSError, ValueError):
            time.sleep(2)


def comfy(command):
    """comfyui start / stop, quietly; False when the command is not there."""
    if not shutil.which("comfyui"):
        return False
    subprocess.run(["comfyui", command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


# --- The run -------------------------------------------------------------------------------------

class Shared:
    """What the painting and the screen share."""

    def __init__(self):
        self.lock = threading.Lock()
        self.phase = "starting"
        self.now = None          # the square being painted: continent, i, j, zone, attempt, began
        self.step = (0, 0)
        self.last = None         # the square finished last
        self.done = 0
        self.total = 0
        self.repainted = 0
        self.below = 0
        self.times = collections.deque(maxlen=30)
        self.picture = GUESS     # seconds a picture, for the bar within a picture
        self.pictures = 0        # pictures painted in this run
        self.began = time.time()
        self.pause = False
        self.quit = False
        self.stopped = False
        self.error = None
        self.events = []         # lines for a run without a terminal

    def set(self, **values):
        with self.lock:
            for key, value in values.items():
                setattr(self, key, value)


def load_state(out):
    path = out / "state.json"
    if path.is_file():
        return json.loads(path.read_text())
    return {"paths": {}, "squares": {}}


def save_state(out, state):
    path = out / "state.json"
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(state, indent=1))
    os.replace(temp, path)


def work(shared, painter, game, guides, fixed, briefs, out, state, todo, limit):
    """The painting: square after square, each painted until it passes the check or TRIES are made."""
    words_log = open(out / "words.jsonl", "a")
    temp = out / "work"
    temp.mkdir(parents=True, exist_ok=True)
    try:
        for count, (continent, i, j) in enumerate(todo):
            if limit and count >= limit:
                break
            began = time.time()
            square = game.square(continent, i, j)
            facts = guides.facts(continent, i, j, square)
            picture = square["rgb"]
            prompt = words(fixed, briefs, facts)
            zone = facts["zones"][0]["name"] if facts["zones"] else "the sea"
            tries, best = [], None
            for seed in range(1, TRIES + 1):
                if shared.pause:
                    shared.set(phase="paused", now=None, step=(0, 0))
                    painter.free()
                    while shared.pause and not shared.quit:
                        time.sleep(0.2)
                    if shared.quit:
                        raise Quit
                shared.set(phase="painting", step=(0, 0),
                           now={"continent": continent, "i": i, "j": j, "zone": zone, "seed": seed, "began": time.time()})
                t0 = time.time()
                painting = painter.paint(picture, prompt, f"{continent}-{i}-{j}-{seed}", seed, temp)
                result = check(square, painting)
                tries.append({"seed": seed, **result, "seconds": round(time.time() - t0)})
                with shared.lock:  # the run's own pace: the first picture sets it, later ones move it
                    seconds = time.time() - t0
                    shared.picture = 0.8 * shared.picture + 0.2 * seconds if shared.pictures else seconds
                    shared.pictures += 1
                score = result["added"] + result["lost"]
                if best is None or score < best[0]:
                    best = (score, seed, painting, result)
                if passes(result):
                    break
            _, seed, painting, result = best
            target = out / str(continent) / f"sq-{i}-{j}.png"
            target.parent.mkdir(parents=True, exist_ok=True)
            painting.save(target)
            seconds = round(time.time() - began)
            state["squares"][name_of(continent, i, j)] = {
                "seed": seed, **result, "ok": passes(result), "tries": tries, "zone": zone, "seconds": seconds,
                "when": time.strftime("%Y-%m-%d %H:%M")}
            save_state(out, state)
            words_log.write(json.dumps({"square": name_of(continent, i, j), "facts": facts, "words": prompt}) + "\n")
            words_log.flush()
            with shared.lock:
                shared.done += 1
                shared.times.append(seconds)
                shared.repainted += len(tries) > 1
                shared.below += not passes(result)
                shared.last = {"continent": continent, "i": i, "j": j, "zone": zone, "seconds": seconds, **result,
                               "ok": passes(result), "tries": len(tries)}
                shared.events.append(shared.last)
        shared.set(phase="done", now=None)
    except Quit:
        shared.set(phase="quit", now=None)
    except BaseException as error:  # ComfyUI gone (imagegen's fail exits), a file missing: told, the run stops
        shared.set(phase="error", now=None, error=f"{type(error).__name__}: {error}")
    finally:
        words_log.close()


# --- The screen ----------------------------------------------------------------------------------

def clock(seconds):
    seconds = max(0, int(seconds))
    days, rest = divmod(seconds, 86400)
    hours, rest = divmod(rest, 3600)
    minutes, secs = divmod(rest, 60)
    if days:
        return f"{days} d {hours} h {minutes:02d} min"
    if hours:
        return f"{hours} h {minutes:02d} min"
    return f"{minutes} min {secs:02d} s"


def bar(part, width):
    part = min(1.0, max(0.0, part))
    full = int(part * width)
    return "█" * full + ("▌" if part * width - full >= 0.5 else "") + "░" * (width - full - (part * width - full >= 0.5))


def left(shared, history):
    """Seconds left: the squares to go at the run's own pace (its last 30 squares, repaints included), less what
    the square being painted has done."""
    with shared.lock:
        times = list(shared.times) or history or [GUESS]
        each = sum(times) / len(times)
        rest = (shared.total - shared.done) * each
        if shared.now:
            rest -= min(time.time() - shared.now["began"], shared.picture)
    return max(0, rest)


def screen(shared, history, per_continent):
    width = max(60, min(shutil.get_terminal_size((100, 30)).columns, 110))
    with shared.lock:
        phase, now, step, last = shared.phase, dict(shared.now or {}), shared.step, shared.last
        done, total, repainted, below = shared.done, shared.total, shared.repainted, shared.below
        picture, error, began = shared.picture, shared.error, shared.began
        pausing = shared.pause and phase == "painting"
    part = done / total if total else 1.0
    rest = left(shared, history)
    state = {"painting": "pausing after this picture" if pausing else "painting", "paused": "paused",
             "starting": "starting", "done": "done", "quit": "quitting", "error": "stopped"}.get(phase, phase)
    lines = [f" Atlas · painting the map{state.rjust(width - 26)}", ""]
    lines.append(f" {bar(part, width - 26)} {part * 100:5.1f} %  {done} of {total}")
    finish = time.strftime("%a %d %b %H:%M", time.localtime(time.time() + rest))
    lines.append(f" running {clock(time.time() - began)}   ·   left about {clock(rest)}   ·   done about {finish}")
    lines.append("")
    if now:
        value, most = step
        inside = value / most if most else min(0.99, (time.time() - now["began"]) / max(1, picture))
        steps = f"step {value} of {most}" if most else "starting"
        lines.append(f" now     {CONTINENTS[now['continent']]}, square {now['i']} · {now['j']} ({now['zone']}),"
                     f" painting {now['seed']} of {TRIES}")
        lines.append(f"         {bar(inside, 30)} {steps}   {clock(time.time() - now['began'])}")
    else:
        lines += [" now     " + ({"paused": "paused: the graphics card is free; p goes on, q quits"}.get(phase, "-")), ""]
    if last:
        verdict = "ok" if last["ok"] else "kept the best, below the bar"
        lines.append(f" last    square {last['i']} · {last['j']} ({last['zone']}) {verdict} in {clock(last['seconds'])},"
                     f" water added {last['added'] * 100:.1f} % lost {last['lost'] * 100:.1f} %")
    else:
        lines.append(" last    -")
    lines.append(f" painted again: {repainted}   ·   below the bar: {below}   ·   about {clock(picture)} a picture")
    lines.append(" " + "   ·   ".join(f"{CONTINENTS[c]} {d} of {t}" for c, (d, t) in per_continent(shared).items()))
    if error:
        lines += ["", f" stopped: {error}"]
    lines += ["", " p pause · q quit"]
    return "\x1b[H\x1b[J" + "\n".join(line[:width] for line in lines)


def run_screen(shared, painter, worker, history, per_continent):
    """The terminal: drawn twice a second; p and q read without Enter."""
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sys.stdout.write("\x1b[?1049h\x1b[?25l")   # a screen of its own, no cursor
    try:
        tty.setcbreak(fd)
        while worker.is_alive():
            sys.stdout.write(screen(shared, history, per_continent))
            sys.stdout.flush()
            ready, _, _ = select.select([sys.stdin], [], [], 0.5)
            if ready:
                key = sys.stdin.read(1).lower()
                if key == "p":
                    shared.set(pause=not shared.pause)
                elif key == "q":
                    shared.set(quit=True, pause=False)
                    painter.interrupt()
        sys.stdout.write(screen(shared, history, per_continent))
        sys.stdout.flush()
        time.sleep(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


def run_lines(shared, worker, history):
    """Without a terminal: a line a square."""
    told = 0
    while worker.is_alive() or told < len(shared.events):
        with shared.lock:
            new, told = shared.events[told:], len(shared.events)
        for e in new:
            print(f"{e['continent']}:{e['i']}:{e['j']} {e['zone']}: {'ok' if e['ok'] else 'below the bar'}"
                  f" after {e['tries']}, {e['seconds']} s, water added {e['added'] * 100:.1f} % lost {e['lost'] * 100:.1f} %;"
                  f" {shared.done} of {shared.total}, left about {clock(left(shared, history))}", flush=True)
        time.sleep(1)


# --- Commands ------------------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("paint", "status", "join"))
    parser.add_argument("--near", nargs=5, type=float, metavar=("UIMAP", "X", "Y", "ACROSS", "DOWN"))
    parser.add_argument("--to")
    parser.add_argument("--cut", action="store_true")
    parser.add_argument("--adt")
    parser.add_argument("--tables")
    parser.add_argument("--minimap")
    parser.add_argument("--continent", type=int, choices=sorted(CONTINENTS))
    parser.add_argument("--limit", type=int, default=0)
    parser.add_argument("--out", default=str(OUT))
    parser.add_argument("--keep-comfyui", action="store_true")
    parser.add_argument("--dry", action="store_true")
    args = parser.parse_args()
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    state = load_state(out)
    for key in ("adt", "tables", "minimap"):
        if getattr(args, key):
            state["paths"][key] = str(Path(getattr(args, key)).resolve())
    missing = [key for key in ("adt", "tables", "minimap") if not state["paths"].get(key)]
    if missing:
        ig.fail("The first run needs the game's files: " + ", ".join(f"--{key}" for key in missing) + ". See --help.")
    save_state(out, state)
    continents = [args.continent] if args.continent is not None else sorted(CONTINENTS)
    game = Game(state["paths"])
    guides = Guides(game)
    near = around(guides, int(args.near[0]), args.near[1], args.near[2], int(args.near[3]), int(args.near[4])) if args.near else None
    if near:
        continents = [near[0]]
    squares = plan(guides, continents, near)
    done = state["squares"]
    history = [s["seconds"] for s in list(done.values())[-30:]]

    def per_continent(shared=None):
        counts = {}
        for c in continents:
            mine = [s for s in squares if s[0] == c]
            counts[c] = (sum(name_of(*s) in done for s in mine), len(mine))
        return counts

    if args.command == "join":
        if not args.to:
            ig.fail("join needs --to FILE")
        painted = [s for s in squares if name_of(*s) in done]
        if not painted:
            ig.fail("No square of these is painted yet.")
        continent = painted[0][0]
        mine = [s for s in painted if s[0] == continent]
        block = near[1:] if near else (min(s[1] for s in mine), min(s[2] for s in mine),
                                        max(s[1] for s in mine) + 1, max(s[2] for s in mine) + 1)
        Image.fromarray(join(out, continent, block, args.cut)).save(args.to)
        print(f"{args.to}: {block[2] - block[0]} x {block[3] - block[1]} squares of {CONTINENTS[continent]}")
        return

    if args.command == "status":
        total = len(squares)
        finished = sum(name_of(*s) in done for s in squares)
        each = sum(history) / len(history) if history else GUESS
        print(f"{finished} of {total} squares painted ({finished / max(1, total) * 100:.1f} %), left about "
              f"{clock((total - finished) * each)} at {clock(each)} a square")
        for c, (d, t) in per_continent().items():
            print(f"  {CONTINENTS[c]}: {d} of {t}")
        below = [k for k, s in done.items() if not s["ok"]]
        print(f"  painted again: {sum(len(s['tries']) > 1 for s in done.values())}, below the bar: {len(below)}"
              + (f" ({', '.join(below[:10])}{' ...' if len(below) > 10 else ''})" if below else ""))
        return

    fixed = tomllib.loads(WORDS.read_text())
    briefs = tomllib.loads(BRIEFS.read_text())
    todo = [s for s in squares if name_of(*s) not in done]
    shared = Shared()
    shared.total, shared.done = len(squares), len(squares) - len(todo)
    painter = Painter(shared, args.dry)
    started = False
    if not args.dry and not painter.reachable():
        print("Starting ComfyUI ...", flush=True)
        started = comfy("start")
        if not painter.reachable():
            ig.fail("ComfyUI is not reachable: start it with comfyui start, then run this again.")
    if not args.dry:
        threading.Thread(target=listen, args=(shared, painter.server.client), daemon=True).start()

    def stop(*_):
        shared.set(quit=True, pause=False)
        painter.interrupt()
    signal.signal(signal.SIGTERM, stop)
    worker = threading.Thread(target=work, args=(shared, painter, game, guides, fixed, briefs, out, state, todo, args.limit))
    worker.start()
    try:
        if sys.stdin.isatty() and sys.stdout.isatty():
            run_screen(shared, painter, worker, history, per_continent)
        else:
            run_lines(shared, worker, history)
    except KeyboardInterrupt:
        stop()
    worker.join()
    shared.set(stopped=True)
    if started and not args.keep_comfyui:
        comfy("stop")
    finished = sum(name_of(*s) in done for s in squares)
    print(f"{finished} of {len(squares)} squares painted." + (f" Stopped: {shared.error}" if shared.error else "")
          + ("" if finished == len(squares) else " The next run goes on from here: dev/tools/atlas paint"))


if __name__ == "__main__":
    main()
