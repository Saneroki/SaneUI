# --- What the game has in a square ---------------------------------------------------------------

class Game:
    """The game's files a square is made from, read a tile at a time; the last few tiles are kept, since
    neighbouring squares share them."""

    def __init__(self, paths):
        self.adt, self.minimap = Path(paths["adt"]), Path(paths["minimap"])
        tables = Path(paths["tables"])
        formats = {row["ID"]: int(row["LVF"]) for row in ta.table(tables, "LiquidMaterial")}
        types = ta.table(tables, "LiquidType")

        def kinds(banks):  # the game's sound banks: 0 water, 1 ocean, 2 magma, 3 slime
            return {int(row["ID"]): formats.get(row["MaterialID"], 0) for row in types if row["SoundBank"] in banks}
        self.liquids = {"water": kinds(("0", "1")), "lava": kinds(("2",)), "slime": kinds(("3",))}
        areas = ta.table(tables, "AreaTable")
        self.parent = {int(row["ID"]): int(row["ParentAreaID"]) for row in areas}
        self.seas = {int(row["ID"]) for row in areas if re.search(r"\bSeas?\b", row["AreaName_lang"])}
        self.files = {}
        for line in open(ROOT / "assets" / "data" / "Tiles" / "Tiles.jsonl"):
            row = json.loads(line)
            if row.get("minimap"):
                self.files[row["key"]] = row["minimap"]
        self.kept = collections.OrderedDict()

    def tile(self, key):
        """A tile at PX: its terrain (softened a little first: the textures' fine dot pattern comes back in the
        painting otherwise), its liquids (0 to 255) and its map chunks' areas."""
        if key in self.kept:
            self.kept.move_to_end(key)
            return self.kept[key]
        rgb = np.empty((PX, PX, 3), np.uint8)
        rgb[:] = NAVY
        if key in self.files and (self.minimap / f"{self.files[key]}.blp").is_file():
            texture = Image.open(self.minimap / f"{self.files[key]}.blp").convert("RGB").filter(ImageFilter.GaussianBlur(SOFTEN))
            rgb = np.asarray(texture.resize((PX, PX), Image.Resampling.LANCZOS)).copy()
        masks = {kind: np.zeros((PX, PX), np.uint8) for kind in self.liquids}
        areas = np.zeros((16, 16), np.int64)
        path = self.adt / f"{key}.adt"
        if path.is_file():
            for kind, types in self.liquids.items():
                land, areas = ta.terrain(path, types)
                small = Image.fromarray(((1 - land) * 255).astype(np.uint8))
                masks[kind] = np.asarray(small.resize((PX, PX), Image.Resampling.BILINEAR))
        else:  # no terrain: open sea
            masks["water"][:] = 255
        masks["water"] = open_water(rgb, masks["water"])
        wet = masks["water"][..., None].astype(np.float32) / 255
        rgb = (rgb * (1 - wet) + NAVY * wet).astype(np.uint8)
        self.kept[key] = {"rgb": rgb, **masks, "areas": areas}
        if len(self.kept) > 12:
            self.kept.popitem(last=False)
        return self.kept[key]

    def square(self, continent, i, j):
        """A square's terrain, liquids and map chunks' areas (16 x 16: a square is 16 chunks a side)."""
        x0, y0 = i * STEP, j * STEP
        out = {"rgb": np.zeros((SQ, SQ, 3), np.uint8), "areas": np.zeros((16, 16), np.int64)}
        out["rgb"][:] = NAVY
        for kind in self.liquids:
            out[kind] = np.full((SQ, SQ), 255 if kind == "water" else 0, np.uint8)
        for row in range(y0 // PX, (y0 + SQ - 1) // PX + 1):
            for col in range(x0 // PX, (x0 + SQ - 1) // PX + 1):
                if not (0 <= row < ta.GRID and 0 <= col < ta.GRID):
                    continue
                tile = self.tile(continent * 4096 + row * ta.GRID + col)
                ax, ay = max(x0, col * PX), max(y0, row * PX)
                bx, by = min(x0 + SQ, (col + 1) * PX), min(y0 + SQ, (row + 1) * PX)
                into = (slice(ay - y0, by - y0), slice(ax - x0, bx - x0))
                take = (slice(ay - row * PX, by - row * PX), slice(ax - col * PX, bx - col * PX))
                for name in ("rgb", *self.liquids):
                    out[name][into] = tile[name][take]
                out["areas"][(ay - y0) // CHUNK:(by - y0) // CHUNK, (ax - x0) // CHUNK:(bx - x0) // CHUNK] = \
                    tile["areas"][(ay - row * PX) // CHUNK:(by - row * PX) // CHUNK, (ax - col * PX) // CHUNK:(bx - col * PX) // CHUNK]
        return out


def open_water(rgb, water):
    """The game's water less what stands in it (piers, stilt houses, bridges, domes; ice): the minimap draws water
    cool and dark, wood, roofs and stone warm or bright. Only the open water is made flat, and only it counts as
    water (a flat sheet over Booty Bay's boardwalk erased it from every painting)."""
    r, g, b = (rgb[..., k].astype(np.int16) for k in range(3))
    # clearly warm (wood, roof tiles) or bright (stone, domes, ice); muddy water is a little warm and stays water
    standing = ((r > b + 25) & (r > 70)) | (np.minimum(np.minimum(r, g), b) > 140)
    standing = grow(shrink(standing, 1), 1) & (water > 127)
    return np.where(standing, 0, water).astype(np.uint8)


class Guides:
    """dev/tools/map-meta's guides: the ground cover, the buildings, the zones' areas."""

    def __init__(self, game):
        self.places = json.load(open(META / "places.json"))
        self.texels = self.places["texels"]
        self.colours = {name: np.array(colour) for name, colour in self.places["cover"].items()}
        self.cover = {c: np.asarray(Image.open(META / f"cover-{c}.png").convert("RGB")) for c in CONTINENTS}
        self.built = {c: np.asarray(Image.open(META / f"buildings-{c}.png").convert("L")) for c in CONTINENTS}
        owners, seen = {}, collections.Counter()
        for uimap, zone in self.places["zones"].items():
            for area in zone["areas"]:
                owners.setdefault(area["area"], uimap)
                seen[area["area"]] += 1
        self.owner = {area: uimap for area, uimap in owners.items() if seen[area] == 1}  # a sea is listed by many
        self.game = game

    def box(self, i, j):
        s = PX / self.texels
        return (round(j * STEP / s), round((j * STEP + SQ) / s)), (round(i * STEP / s), round((i * STEP + SQ) / s))

    def land(self, continent, i, j):
        (y0, y1), (x0, x1) = self.box(i, j)
        cover = self.cover[continent][y0:y1, x0:x1].astype(np.int32)
        if cover.size == 0:
            return 0.0
        water = np.abs(cover - self.colours["water"]).sum(-1) < 6
        return float((~water & (cover.sum(-1) > 0)).mean())

    def zone_of(self, area):
        while area:
            if area in self.owner:
                return self.owner[area]
            area = self.game.parent.get(area, 0)
        return None

    def facts(self, continent, i, j, square):
        """What the game has in the square: its liquids, its zones by their land (a sea's area belongs to some
        zone in the game's table: west of Stormwind, Westfall's), its ground cover and its buildings."""
        wet = Image.fromarray(square["water"]).resize((16, 16), Image.Resampling.BOX)
        wet = np.asarray(wet, np.float32) / 255
        counts = collections.Counter()
        for (y, x), area in np.ndenumerate(square["areas"]):
            if wet[y, x] > 0.9 or int(area) in self.game.seas:
                continue
            uimap = self.zone_of(int(area))
            if uimap:
                counts[uimap] += 1
        total = sum(counts.values())
        zones = [{"uimap": u, "name": self.places["zones"][u]["name"], "share": round(n / total, 3)}
                 for u, n in counts.most_common()]
        (y0, y1), (x0, x1) = self.box(i, j)
        cover = self.cover[continent][y0:y1, x0:x1].astype(np.int32)
        shares = {}
        for name, colour in self.colours.items():
            share = float((np.abs(cover - colour).sum(-1) < 6).mean()) if cover.size else 0.0
            if share >= 0.02:
                shares[name] = round(share, 3)
        built = self.built[continent][y0:y1, x0:x1]
        return {"water": round(float(water_of(square).mean()), 4),
                "lava": round(float(square["lava"].mean()) / 255, 4),
                "slime": round(float(square["slime"].mean()) / 255, 4),
                "zones": zones, "cover": dict(sorted(shares.items(), key=lambda kv: -kv[1])),
                "buildings": round(float(built.mean()) / 255, 4) if built.size else 0.0}


# --- The check against the game's water ----------------------------------------------------------

CHECK = 512    # pictures are checked at this size: sheets, not detail
SLACK = 0.02   # of the side: how far a painted shore may stray


def small(array, side=CHECK):
    mode = "RGB" if array.ndim == 3 else "L"
    return np.asarray(Image.fromarray(array, mode).resize((side, side), Image.Resampling.BOX))


def box_mean(a, r):
    """The mean of a over a square of side 2r + 1 around each point."""
    c = np.pad(a, r + 1, mode="edge").cumsum(0).cumsum(1)
    n = 2 * r + 1
    return (c[n:, n:] - c[:-n, n:] - c[n:, :-n] + c[:-n, :-n])[:a.shape[0], :a.shape[1]] / n ** 2


def grow(mask, r):
    return np.asarray(Image.fromarray(mask.astype(np.uint8) * 255).filter(ImageFilter.MaxFilter(2 * r + 1))) > 127


def shrink(mask, r):
    return np.asarray(Image.fromarray(mask.astype(np.uint8) * 255).filter(ImageFilter.MinFilter(2 * r + 1))) > 127


def water_of(square):
    """The game's water in a square, at CHECK: its liquids, and the speckled dark blue-grey the minimap draws for
    the water of buildings (city canals), in sheets (the shadows of blue roofs are small)."""
    terrain = small(square["rgb"]).astype(np.int32)
    drawn = (terrain[..., 2] >= terrain[..., 0] + 8) & (terrain.max(-1) < 90)
    drawn = grow(shrink(box_mean(drawn.astype(np.float32), 2) > 0.5, 2), 2)
    return (small(square["water"]) > 127) | (np.abs(terrain - NAVY).sum(-1) < 30) | drawn


def check(square, painting):
    """How much of the painting is water where the game has none (added), and land where it has water (lost):
    broad sheets only, a shore may stray a little. Painted water is bluish, smooth, in sheets and bluer than the
    painting's own land, so a zone graded blue (Duskwood's dusk) and the blue shadows of snow are not water."""
    out = small(np.asarray(painting))
    game = water_of(square)
    hsv = np.asarray(Image.fromarray(out).convert("HSV"), np.float32)
    h, s, v = hsv[..., 0] * 360 / 255, hsv[..., 1] / 255, hsv[..., 2] / 255
    grey = out.astype(np.float32).mean(-1)
    rough = np.sqrt(np.maximum(box_mean(grey ** 2, 2) - box_mean(grey, 2) ** 2, 0))
    slack = max(1, round(CHECK * SLACK))
    blue = out[..., 2].astype(np.float32) - (out[..., 0].astype(np.float32) + out[..., 1]) / 2
    land = ~grow(game, slack)
    bar = np.percentile(blue[land], 30) + 12 if land.any() else -255.0
    # (from teal-green on: a tropical lagoon is emerald; meadows are yellower, forests rough)
    painted = (h >= 125) & (h <= 250) & (s >= 0.22) & (v >= 0.18) & (rough < 9) & ~((v > 0.65) & (s < 0.6)) & (blue > bar)
    painted = grow(shrink(painted, 3), 3)
    added = grow(shrink(painted & land, 4), 4)
    lost = grow(shrink(game & ~grow(painted, slack) & ~grow(~game, slack), 4), 4)
    return {"added": round(float(added.mean()), 4), "lost": round(float(lost.mean()), 4)}


def passes(result):
    return result["added"] <= ADDED and result["lost"] <= LOST


# --- The words -----------------------------------------------------------------------------------

WET = re.compile(r"coast|shore|sea\b|lake|river|stream|water|shallow|surf|pool|pond|canal|marsh|bog|reed|harbour"
                 r"|beach|spring|falls|wave|steam", re.I)
HOT = re.compile(r"lava|molten|magma|ember|glowing", re.I)
WHERE = re.compile(r"north|south|east|west|centre|middle|edge", re.I)


def only(text, facts):
    """The phrases of a brief's field that fit the square: none about water or lava where the game has none,
    none that say where in the zone (a square is a small part of it)."""
    drop = [WHERE] + [rx for rx, there in ((WET, facts["water"] >= 0.001), (HOT, facts["lava"] >= 0.005)) if not there]
    kept = [p for p in re.split(r"(?<=[,;.:])\s+", text) if not any(rx.search(p) for rx in drop)]
    return re.sub(r"[,;:.]$", "", " ".join(kept).strip())


def joined(names):
    return names[0] if len(names) == 1 else ", ".join(names[:-1]) + " and " + names[-1]


LIGHT_DROP = re.compile(r"colou?r|grade|tint|cast|hue|bleach|drain|wash|haze|mist|steam|smoke|fog|cloud|spray|dust"
                        r"|shimmer|glow", re.I)


def light_of(atmosphere):
    """The light of a zone's atmosphere, its quality only: its first sentence without the clauses about colour or haze."""
    first = atmosphere.split(". ")[0].rstrip(".")
    kept = [clause for clause in first.split(", ") if not LIGHT_DROP.search(clause)]
    return ", ".join(kept) or "soft daylight"


def words(fixed, briefs, facts):
    """A square's words: an edit, never a repaint (what may change: how things look; what never does: where and
    what they are), the liquids the game has, its main zone's colours and the quality of its light, the colours of
    image 1 kept, nothing added or taken away. Never the zone's buildings, plants, places or props, nor the ground
    in words: the model paints whatever the words name into the square."""
    said = fixed["words"]
    water = facts["water"]
    liquids = [said["water"] if water >= 0.01 else said["little"] if water >= 0.001 else said["dry"]]
    if facts["lava"] >= 0.005:
        liquids.append(said["lava"])
    if facts["slime"] >= 0.005:
        liquids.append(said["slime"])
    if not facts["zones"]:
        return " ".join([fixed["sea"], briefs["sea"]["water"], *liquids, said["last"]])
    # the main zone's words only: a border's mountains may belong to a zone whose words do not fit them (north of
    # Stormwind's keep, the volcano's), and image 1 shows where the land changes
    main = briefs[facts["zones"][0]["uimap"]]
    zone = f"Its colours, as image 1 shows them: {only(main['colours'], facts)}. Its light: {light_of(main['atmosphere'])}."
    return " ".join([fixed["edit"], *liquids, zone, said["keep_colours"], said["last"]])


# --- The squares ---------------------------------------------------------------------------------

def plan(guides, continents, near=None):
    """The squares to paint, in order: by continent, in rows from the north-west, those with land; with near
    (continent, i0, j0, i1, j1) only those in that block."""
    count = -(-(ta.GRID * PX - SQ) // STEP) + 1
    found = []
    for continent in continents:
        for j in range(count):
            for i in range(count):
                if near and not (continent == near[0] and near[1] <= i < near[3] and near[2] <= j < near[4]):
                    continue
                if guides.land(continent, i, j) > LAND:
                    found.append((continent, i, j))
    return found


def around(guides, uimap, x, y, across, down):
    """The block of squares around a point of a zone's map: (continent, i0, j0, i1, j1)."""
    zone = guides.places["zones"][str(uimap)]
    north, south, west, east = zone["box"]
    wx, wy = north - y / 100 * (north - south), west - x / 100 * (west - east)
    half = ta.GRID / 2 * ta.TILE
    px, py = (half - wy) / ta.TILE * PX, (half - wx) / ta.TILE * PX
    i0, j0 = round((px - SQ / 2) / STEP - (across - 1) / 2), round((py - SQ / 2) / STEP - (down - 1) / 2)
    return zone["continent"], i0, j0, i0 + across, j0 + down


# --- The colour pass -----------------------------------------------------------------------------
# The model paints each zone in its own light, and with it its own colours: Badlands' orange came out pale tan,
# Teldrassil violet. When the squares are joined, each painting's broad colour (its hue and saturation averaged
# over BROAD pixels) is moved toward the game's by 1 - MOOD; its brightness, its fine detail and light are kept
# (a dark zone stays dark: the game's minimap is drawn without the zone's light). The paintings on disk stay as
# painted, so the mood can be changed without painting again. The same pull evens out neighbours painted a
# little apart.

MOOD = 0.5     # how much of the model's own colour a square keeps (1: all of it; 0: the game's broad colours)
BROAD = 48     # pixels (12 yards): broader than a tree, finer than a hill
SEA = np.array([18, 52, 86])   # the open sea's blue: the water of every square is pulled toward it, whatever the mood
WHITE = np.array([0.95047, 1.0, 1.08883])   # CIE D65, the white of sRGB


def to_lab(rgb):
    c = rgb.astype(np.float32) / 255
    c = np.where(c > 0.04045, ((c + 0.055) / 1.055) ** 2.4, c / 12.92)
    xyz = c @ np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]], np.float32).T / WHITE
    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
    return np.stack([116 * f[..., 1] - 16, 500 * (f[..., 0] - f[..., 1]), 200 * (f[..., 1] - f[..., 2])], -1)


def to_rgb(lab):
    fy = (lab[..., 0] + 16) / 116
    f = np.stack([fy + lab[..., 1] / 500, fy, fy - lab[..., 2] / 200], -1)
    xyz = np.where(f > 0.2069, f ** 3, (f - 16 / 116) / 7.787) * WHITE
    c = xyz @ np.array([[3.2406, -1.5372, -0.4986], [-0.9689, 1.8758, 0.0415], [0.0557, -0.2040, 1.0570]], np.float32).T
    c = np.where(c > 0.0031308, 1.055 * np.clip(c, 0, None) ** (1 / 2.4) - 0.055, 12.92 * c)
    return (c * 255).clip(0, 255).round().astype(np.uint8)


def broad(a, r):
    """Each channel averaged over about r pixels (three box means: close to a Gaussian)."""
    a = a.astype(np.float32)
    for _ in range(3):
        a = np.stack([box_mean(a[..., k], max(1, r // 3)) for k in range(a.shape[-1])], -1)
    return a


def colour_of(painting, square, mood=MOOD):
    """A painting with its broad colours moved toward the square's terrain (land) and the open sea's blue (water,
    over a broader area, so the painted shallows keep their gradient); lava kept as painted. Worked out at a
    quarter of the size, where only broad colour lives, and laid back on at full size."""
    q = 4
    side = painting.shape[0] // q
    shrunk = lambda a: np.asarray(Image.fromarray(a).resize((side, side), Image.Resampling.BOX))  # noqa: E731
    water = shrunk(square["water"]).astype(np.float32)[..., None] / 255
    lava = shrunk(square["lava"]).astype(np.float32)[..., None] / 255
    land = (1 - np.maximum(water, lava)) ** 2
    paint, game = to_lab(shrunk(painting)), to_lab(shrunk(square["rgb"]))

    def toward(target, w, r):
        weight = broad(w, r) + 1e-4
        return broad(target * w, r) / weight - broad(paint * w, r) / weight

    shift = toward(game, land, BROAD // q) * land * (1 - mood)
    shift[..., 0] = 0      # the light, bright or dark, stays the zone's (Duskwood stays dark): only colours move
    sea = toward(to_lab(np.broadcast_to(SEA.astype(np.uint8), paint.shape)), water * (1 - lava), BROAD) * water * 0.85
    sea[..., 0] *= 0.5     # half the sea's brightness: in a dark zone the water stays darker than the land
    shift += sea
    full = np.stack([np.asarray(Image.fromarray(shift[..., k]).resize(painting.shape[1::-1], Image.Resampling.BILINEAR))
                     for k in range(3)], -1)
    return to_rgb(to_lab(painting) + full)


# --- Joining the squares -------------------------------------------------------------------------

FEATHER = 12   # pixels softened to either side of a cut


def seam(a, b):
    """The weight of a where two overlapping strips meet side by side (a on the left): 1 left of the line where they
    differ least (found row by row, moving a pixel at most from one row to the next), 0 right of it, softened
    FEATHER pixels to either side. A cut, not a cross-fade: two paintings of the same trees blended over the
    whole overlap would show both."""
    diff = box_mean(np.abs(a.astype(np.int16) - b.astype(np.int16)).sum(-1).astype(np.float32), 2)
    rows, width = diff.shape
    cum, back = diff.copy(), np.zeros((rows, width), np.int8)
    for y in range(1, rows):
        prev = cum[y - 1]
        options = np.stack([np.r_[np.inf, prev[:-1]], prev, np.r_[prev[1:], np.inf]])
        pick = options.argmin(0)
        back[y] = pick - 1
        cum[y] += options[pick, np.arange(width)]
    line = np.empty(rows, int)
    line[-1] = int(cum[-1].argmin())
    for y in range(rows - 1, 0, -1):
        line[y - 1] = line[y] + back[y, line[y]]
    return np.clip(0.5 - (np.arange(width)[None, :] - line[:, None]) / (2 * FEATHER), 0, 1)[..., None]


def join_two(left, right, cut):
    """Two pictures that overlap by SQ - STEP at the left's right edge, as one."""
    over = SQ - STEP
    a, b = left[:, -over:].astype(np.float32), right[:, :over].astype(np.float32)
    if cut:
        w = (np.arange(over) < over // 2).astype(np.float32)[None, :, None]
    else:
        w = seam(a, b)
    middle = (a * w + b * (1 - w)).clip(0, 255).astype(np.uint8)
    return np.concatenate([left[:, :-over], middle, right[:, over:]], axis=1)


def join(out, continent, block, cut=False, game=None, mood=MOOD):
    """The squares of a block (i0, j0, i1, j1) as one picture, each through the colour pass when the game's files
    are given (game); a square not painted is the flat sea."""
    i0, j0, i1, j1 = block

    def picture(i, j):
        path = out / str(continent) / f"sq-{i}-{j}.png"
        if path.is_file():
            painting = np.asarray(Image.open(path).convert("RGB"))
            return colour_of(painting, game.square(continent, i, j), mood) if game else painting
        filled = np.empty((SQ, SQ, 3), np.uint8)
        filled[:] = NAVY
        return filled

    rows = []
    for j in range(j0, j1):
        row = picture(i0, j)
        for i in range(i0 + 1, i1):
            row = join_two(row, picture(i, j), cut)
        rows.append(row)
    whole = rows[0]
    for row in rows[1:]:  # rows meet top to bottom: the same, turned
        whole = join_two(whole.transpose(1, 0, 2), row.transpose(1, 0, 2), cut).transpose(1, 0, 2)
    return whole


# --- Packing: the blocks the game draws ----------------------------------------------------------
# The Atlas module's art (src/Atlas/Atlas.lua): blocks of BLOCK pixels, level 0 a quarter tile, each level up
# twice the yards, LEVELS levels, the last one block for the whole grid; BLP2 DXT1 with mipmaps, and Index.lua,
# the blocks there are. A continent is joined in strips of squares from the north and handed down the levels as
# it goes, a band of BLOCK rows at a time, so it is never whole in memory (a level-0 band of the whole grid's
# width is 200 MB). Each pixel is painted, open sea (no square of the plan: made by code, the sea's one blue) or
# missing (a square of the plan not painted yet); a block is written when it holds painted ground and nothing is
# missing, so a map painted in part has no holes, and a block of open sea alone is not written.

BLOCK = 512    # a block's side in pixels (Atlas.lua's PIXELS)
LEVELS = 9     # 0 to 8: at level 8 one block spans the grid's 64 tiles
MISSING, OPEN, PAINTED = 0, 1, 2
PACKED = ROOT / "assets" / "optimized" / "Atlas"


def busy(*kinds):
    """The columns (from the first to the last, an even number) where some pixel is not open sea, or None: most of
    the grid is open sea, and there the work is skipped."""
    found = np.zeros(kinds[0].shape[1], bool)
    for kind in kinds:
        found |= (kind != OPEN).any(0)
    found = np.flatnonzero(found)
    return None if not len(found) else (int(found[0]) & ~1, min(kinds[0].shape[1], (int(found[-1]) + 2) & ~1))


def blend_rows(top, bottom, top_kind, bottom_kind):
    """Two strips' overlapping rows (top's last, bottom's first) as one: where both are painted, cut along the
    line where they differ least (seam, turned); painted wins over sea and missing, missing over sea."""
    rgb, kind = bottom.copy(), bottom_kind.copy()
    span = busy(top_kind, bottom_kind)
    if span is None:
        return rgb, kind
    part = slice(*span)
    top, bottom, top_kind, bottom_kind = top[:, part], bottom[:, part], top_kind[:, part], bottom_kind[:, part]
    both = (top_kind == PAINTED) & (bottom_kind == PAINTED)
    w = np.zeros(top.shape[:2] + (1,), np.float32)
    columns = np.flatnonzero(both.any(0))
    if len(columns):
        a, b = columns[0], columns[-1] + 1
        w[:, a:b] = seam(top[:, a:b].transpose(1, 0, 2).astype(np.float32),
                         bottom[:, a:b].transpose(1, 0, 2).astype(np.float32)).transpose(1, 0, 2)
    w[(top_kind == PAINTED) & (bottom_kind != PAINTED)] = 1
    w[(bottom_kind == PAINTED) & (top_kind != PAINTED)] = 0
    rgb[:, part] = (top * w + bottom * (1 - w)).clip(0, 255).astype(np.uint8)
    kind[:, part] = np.where(both | (top_kind == PAINTED) | (bottom_kind == PAINTED),
                             np.where(w[..., 0] >= 0.5, top_kind, bottom_kind), np.minimum(top_kind, bottom_kind))
    return rgb, kind


def halved(rgb, kind):
    """A band at half the size: colours averaged by fours; a pixel is missing when any of its four is, else
    painted when any is."""
    h, w = kind.shape
    out_rgb = np.empty((h // 2, w // 2, 3), np.uint8)
    out_rgb[:] = SEA
    out_kind = np.full((h // 2, w // 2), OPEN, np.uint8)
    span = busy(kind)
    if span is not None:
        a, b = span
        part = rgb[:, a:b].reshape(h // 2, 2, (b - a) // 2, 2, 3).astype(np.uint16).sum((1, 3)) // 4
        quad = kind[:, a:b].reshape(h // 2, 2, (b - a) // 2, 2)
        out_rgb[:, a // 2:b // 2] = part
        out_kind[:, a // 2:b // 2] = np.where((quad == MISSING).any((1, 3)), MISSING,
                                              np.where((quad == PAINTED).any((1, 3)), PAINTED, OPEN))
    return out_rgb, out_kind


class Pyramid:
    """Bands of rows handed down the levels: each full band of `block` rows is cut into blocks (written by
    write(level, row, column, rgb) when they hold painted ground and nothing missing), then halved into the
    next level."""

    def __init__(self, width, write, block=BLOCK, levels=LEVELS):
        self.block, self.levels, self.write = block, levels, write
        self.rgb = [np.empty((block, width >> level, 3), np.uint8) for level in range(levels)]
        self.kind = [np.empty((block, width >> level), np.uint8) for level in range(levels)]
        self.filled = [0] * levels
        self.rows = [0] * levels

    def add(self, rgb, kind, level=0):
        while len(kind):
            take = min(self.block - self.filled[level], len(kind))
            self.rgb[level][self.filled[level]:self.filled[level] + take] = rgb[:take]
            self.kind[level][self.filled[level]:self.filled[level] + take] = kind[:take]
            self.filled[level] += take
            rgb, kind = rgb[take:], kind[take:]
            if self.filled[level] == self.block:
                self.cut(level)

    def cut(self, level):
        band, kinds, b = self.rgb[level], self.kind[level], self.block
        span = busy(kinds) or (0, 0)
        for column in range(span[0] // b, -(-span[1] // b)):
            k = kinds[:, column * b:(column + 1) * b]
            if not (k == MISSING).any() and (k == PAINTED).any():
                self.write(level, self.rows[level], column, band[:, column * b:(column + 1) * b].copy())
        self.rows[level] += 1
        self.filled[level] = 0
        if level + 1 < self.levels:
            self.add(*halved(band, kinds), level + 1)


def dxt1(picture):
    """A picture's DXT1 blocks with every mipmap down to 1 x 1, largest first: ImageMagick writes them as a DDS
    file (header of 128 bytes)."""
    side = picture.shape[0]
    mips = side.bit_length() - 1
    ppm = b"P6\n%d %d\n255\n" % (side, side) + picture.tobytes()
    data = subprocess.run(["magick", "ppm:-", "-define", "dds:compression=dxt1", "-define", f"dds:mipmaps={mips}", "dds:-"],
                          input=ppm, capture_output=True, check=True).stdout
    sizes = [max(1, (side >> k) // 4) ** 2 * 8 for k in range(mips + 1)]
    assert data[:4] == b"DDS " and data[84:88] == b"DXT1" and len(data) == 128 + sum(sizes), "no DXT1 from magick"
    parts, at = [], 128
    for size in sizes:
        parts.append(data[at:at + size])
        at += size
    return parts


def blp_of(parts, side):
    """A BLP2 file of DXT1 mipmaps (encoding 2, no alpha, alpha encoding 0), largest first."""
    offsets, start = [], 148 + 1024   # the header, then a palette DXT does not use
    for part in parts:
        offsets.append(start)
        start += len(part)
    unused = [0] * (16 - len(parts))
    header = b"BLP2" + struct.pack("<I4B2I", 1, 2, 0, 0, 1, side, side)
    header += struct.pack("<16I", *offsets, *unused) + struct.pack("<16I", *(len(p) for p in parts), *unused)
    return header + bytes(1024) + b"".join(parts)


def ranges(columns):
    """Sorted columns as Index.lua's text: single ones and runs ("3,5-9,12")."""
    out, start = [], None
    for k, column in enumerate(columns):
        if start is None:
            start = column
        if k + 1 == len(columns) or columns[k + 1] != column + 1:
            out.append(str(start) if start == column else f"{start}-{column}")
            start = None
    return ",".join(out)


def index_lua(index):
    """Index.lua for Atlas.lua: index[continent][level][row] = sorted columns."""
    lines = ["-- The blocks of the Atlas' art, made by dev/tools/atlas pack (read by Atlas.lua).",
             "local _, ns = ...", "", "ns.INDEX = {", f"    levels = {LEVELS},"]
    for continent in sorted(index):
        lines.append(f"    [{continent}] = {{")
        for level in sorted(index[continent]):
            rows = index[continent][level]
            lines.append(f"        [{level}] = {{")
            lines += [f'            [{row}] = "{ranges(rows[row])}",' for row in sorted(rows)]
            lines.append("        },")
        lines.append("    },")
    return "\n".join(lines + ["}", ""])


def pack(out, game, guides, continent, mood, to, painted_only=False):
    """One continent's squares as blocks in to/Art/<continent>/<level>/<row>_<column>.blp; returns its index
    (level: row: columns) and the number of blocks."""
    width = ta.GRID * PX
    count = -(-(width - SQ) // STEP) + 1
    planned = set(plan(guides, [continent]))
    over = SQ - STEP
    art = to / "Art" / str(continent)
    index, written = {}, set()
    pool = concurrent.futures.ThreadPoolExecutor(max(1, (os.cpu_count() or 2) // 2))
    jobs = collections.deque()

    def write(level, row, column, rgb):
        path = art / str(level) / f"{row}_{column}.blp"
        path.parent.mkdir(parents=True, exist_ok=True)
        jobs.append(pool.submit(lambda: path.write_bytes(blp_of(dxt1(rgb), BLOCK))))
        while len(jobs) > 64:   # the encoders keep up, or the blocks waiting would fill the memory
            jobs.popleft().result()
        index.setdefault(level, {}).setdefault(row, []).append(column)
        written.add(path)

    pyramid = Pyramid(width, write)

    def strip(j):
        rgb = np.empty((SQ, width, 3), np.uint8)
        rgb[:] = SEA
        kind = np.full((SQ, width), OPEN, np.uint8)
        last = None
        for i in range(count):
            x0 = i * STEP
            path = out / str(continent) / f"sq-{i}-{j}.png"
            if path.is_file():
                painting = np.asarray(Image.open(path).convert("RGB"))
                if not painted_only:
                    painting = colour_of(painting, game.square(continent, i, j), mood)
                if last is not None and last == i - 1:   # cut against the painted square on its left
                    w = seam(rgb[:, x0:x0 + over].astype(np.float32), painting[:, :over].astype(np.float32))
                    painting = painting.copy()
                    painting[:, :over] = (rgb[:, x0:x0 + over] * w + painting[:, :over] * (1 - w)).clip(0, 255)
                rgb[:, x0:x0 + SQ] = painting
                kind[:, x0:x0 + SQ] = PAINTED
                last = i
            elif (continent, i, j) in planned:   # land, not painted yet: missing, except where painted
                region = kind[:, x0:x0 + SQ]
                region[region != PAINTED] = MISSING
        return rgb, kind

    before = None
    for j in range(count):
        rgb, kind = strip(j)
        if before is not None:
            rgb[:over], kind[:over] = blend_rows(before[0][STEP:], rgb[:over], before[1][STEP:], kind[:over])
            pyramid.add(before[0][:STEP], before[1][:STEP])
        before = (rgb, kind)
    pyramid.add(*before)
    for job in jobs:
        job.result()
    pool.shutdown()
    for stale in art.glob("*/*.blp"):   # blocks of an earlier pack that this one did not write
        if stale not in written:
            stale.unlink()
    return {level: {row: sorted(cols) for row, cols in rows.items()} for level, rows in index.items()}, len(written)


def name_of(continent, i, j):
    return f"{continent}:{i}:{j}"


