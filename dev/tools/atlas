# --- What the game has in a square ---------------------------------------------------------------

class Game:
    """The game's files a square is made from, read a tile at a time; the last few tiles are kept, since
    neighbouring squares share them."""

    def __init__(self, paths):
        self.adt, self.minimap = Path(paths["adt"]), Path(paths["minimap"])
        tables = Path(paths["tables"])
        formats = {row["ID"]: int(row["LVF"]) for row in ta.table(tables, "LiquidMaterial")}
        types = ta.table(tables, "LiquidType")

        def kinds(banks):  # the game's sound banks: 0 water, 1 ocean, 2 magma, 3 slime
            return {int(row["ID"]): formats.get(row["MaterialID"], 0) for row in types if row["SoundBank"] in banks}
        self.liquids = {"water": kinds(("0", "1")), "lava": kinds(("2",)), "slime": kinds(("3",))}
        areas = ta.table(tables, "AreaTable")
        self.parent = {int(row["ID"]): int(row["ParentAreaID"]) for row in areas}
        self.seas = {int(row["ID"]) for row in areas if re.search(r"\bSeas?\b", row["AreaName_lang"])}
        self.files = {}
        for line in open(ROOT / "assets" / "data" / "Tiles" / "Tiles.jsonl"):
            row = json.loads(line)
            if row.get("minimap"):
                self.files[row["key"]] = row["minimap"]
        self.kept = collections.OrderedDict()

    def tile(self, key):
        """A tile at PX: its terrain (softened a little first: the textures' fine dot pattern comes back in the
        painting otherwise), its liquids (0 to 255) and its map chunks' areas."""
        if key in self.kept:
            self.kept.move_to_end(key)
            return self.kept[key]
        rgb = np.empty((PX, PX, 3), np.uint8)
        rgb[:] = NAVY
        if key in self.files and (self.minimap / f"{self.files[key]}.blp").is_file():
            texture = Image.open(self.minimap / f"{self.files[key]}.blp").convert("RGB").filter(ImageFilter.GaussianBlur(SOFTEN))
            rgb = np.asarray(texture.resize((PX, PX), Image.Resampling.LANCZOS)).copy()
        masks = {kind: np.zeros((PX, PX), np.uint8) for kind in self.liquids}
        areas = np.zeros((16, 16), np.int64)
        path = self.adt / f"{key}.adt"
        if path.is_file():
            for kind, types in self.liquids.items():
                land, areas = ta.terrain(path, types)
                small = Image.fromarray(((1 - land) * 255).astype(np.uint8))
                masks[kind] = np.asarray(small.resize((PX, PX), Image.Resampling.BILINEAR))
        else:  # no terrain: open sea
            masks["water"][:] = 255
        masks["water"] = open_water(rgb, masks["water"])
        wet = masks["water"][..., None].astype(np.float32) / 255
        rgb = (rgb * (1 - wet) + NAVY * wet).astype(np.uint8)
        self.kept[key] = {"rgb": rgb, **masks, "areas": areas}
        if len(self.kept) > 12:
            self.kept.popitem(last=False)
        return self.kept[key]

    def square(self, continent, i, j):
        """A square's terrain, liquids and map chunks' areas (16 x 16: a square is 16 chunks a side)."""
        x0, y0 = i * STEP, j * STEP
        out = {"rgb": np.zeros((SQ, SQ, 3), np.uint8), "areas": np.zeros((16, 16), np.int64)}
        out["rgb"][:] = NAVY
        for kind in self.liquids:
            out[kind] = np.full((SQ, SQ), 255 if kind == "water" else 0, np.uint8)
        for row in range(y0 // PX, (y0 + SQ - 1) // PX + 1):
            for col in range(x0 // PX, (x0 + SQ - 1) // PX + 1):
                if not (0 <= row < ta.GRID and 0 <= col < ta.GRID):
                    continue
                tile = self.tile(continent * 4096 + row * ta.GRID + col)
                ax, ay = max(x0, col * PX), max(y0, row * PX)
                bx, by = min(x0 + SQ, (col + 1) * PX), min(y0 + SQ, (row + 1) * PX)
                into = (slice(ay - y0, by - y0), slice(ax - x0, bx - x0))
                take = (slice(ay - row * PX, by - row * PX), slice(ax - col * PX, bx - col * PX))
                for name in ("rgb", *self.liquids):
                    out[name][into] = tile[name][take]
                out["areas"][(ay - y0) // CHUNK:(by - y0) // CHUNK, (ax - x0) // CHUNK:(bx - x0) // CHUNK] = \
                    tile["areas"][(ay - row * PX) // CHUNK:(by - row * PX) // CHUNK, (ax - col * PX) // CHUNK:(bx - col * PX) // CHUNK]
        return out


def open_water(rgb, water):
    """The game's water less what stands in it (piers, stilt houses, bridges, domes; ice): the minimap draws water
    cool and dark, wood, roofs and stone warm or bright. Only the open water is made flat, and only it counts as
    water (a flat sheet over Booty Bay's boardwalk erased it from every painting)."""
    r, g, b = (rgb[..., k].astype(np.int16) for k in range(3))
    standing = (r > b + 8) | (np.minimum(np.minimum(r, g), b) > 140)
    standing = grow(shrink(standing, 1), 1) & (water > 127)
    return np.where(standing, 0, water).astype(np.uint8)


class Guides:
    """dev/tools/map-meta's guides: the ground cover, the buildings, the zones' areas."""

    def __init__(self, game):
        self.places = json.load(open(META / "places.json"))
        self.texels = self.places["texels"]
        self.colours = {name: np.array(colour) for name, colour in self.places["cover"].items()}
        self.cover = {c: np.asarray(Image.open(META / f"cover-{c}.png").convert("RGB")) for c in CONTINENTS}
        self.built = {c: np.asarray(Image.open(META / f"buildings-{c}.png").convert("L")) for c in CONTINENTS}
        owners, seen = {}, collections.Counter()
        for uimap, zone in self.places["zones"].items():
            for area in zone["areas"]:
                owners.setdefault(area["area"], uimap)
                seen[area["area"]] += 1
        self.owner = {area: uimap for area, uimap in owners.items() if seen[area] == 1}  # a sea is listed by many
        self.game = game

    def box(self, i, j):
        s = PX / self.texels
        return (round(j * STEP / s), round((j * STEP + SQ) / s)), (round(i * STEP / s), round((i * STEP + SQ) / s))

    def land(self, continent, i, j):
        (y0, y1), (x0, x1) = self.box(i, j)
        cover = self.cover[continent][y0:y1, x0:x1].astype(np.int32)
        if cover.size == 0:
            return 0.0
        water = np.abs(cover - self.colours["water"]).sum(-1) < 6
        return float((~water & (cover.sum(-1) > 0)).mean())

    def zone_of(self, area):
        while area:
            if area in self.owner:
                return self.owner[area]
            area = self.game.parent.get(area, 0)
        return None

    def facts(self, continent, i, j, square):
        """What the game has in the square: its liquids, its zones by their land (a sea's area belongs to some
        zone in the game's table: west of Stormwind, Westfall's), its ground cover and its buildings."""
        wet = Image.fromarray(square["water"]).resize((16, 16), Image.Resampling.BOX)
        wet = np.asarray(wet, np.float32) / 255
        counts = collections.Counter()
        for (y, x), area in np.ndenumerate(square["areas"]):
            if wet[y, x] > 0.9 or int(area) in self.game.seas:
                continue
            uimap = self.zone_of(int(area))
            if uimap:
                counts[uimap] += 1
        total = sum(counts.values())
        zones = [{"uimap": u, "name": self.places["zones"][u]["name"], "share": round(n / total, 3)}
                 for u, n in counts.most_common()]
        (y0, y1), (x0, x1) = self.box(i, j)
        cover = self.cover[continent][y0:y1, x0:x1].astype(np.int32)
        shares = {}
        for name, colour in self.colours.items():
            share = float((np.abs(cover - colour).sum(-1) < 6).mean()) if cover.size else 0.0
            if share >= 0.02:
                shares[name] = round(share, 3)
        built = self.built[continent][y0:y1, x0:x1]
        return {"water": round(float(water_of(square).mean()), 4),
                "lava": round(float(square["lava"].mean()) / 255, 4),
                "slime": round(float(square["slime"].mean()) / 255, 4),
                "zones": zones, "cover": dict(sorted(shares.items(), key=lambda kv: -kv[1])),
                "buildings": round(float(built.mean()) / 255, 4) if built.size else 0.0}


# --- The check against the game's water ----------------------------------------------------------

CHECK = 512    # pictures are checked at this size: sheets, not detail
SLACK = 0.02   # of the side: how far a painted shore may stray


def small(array, side=CHECK):
    mode = "RGB" if array.ndim == 3 else "L"
    return np.asarray(Image.fromarray(array, mode).resize((side, side), Image.Resampling.BOX))


def box_mean(a, r):
    """The mean of a over a square of side 2r + 1 around each point."""
    c = np.pad(a, r + 1, mode="edge").cumsum(0).cumsum(1)
    n = 2 * r + 1
    return (c[n:, n:] - c[:-n, n:] - c[n:, :-n] + c[:-n, :-n])[:a.shape[0], :a.shape[1]] / n ** 2


def grow(mask, r):
    return np.asarray(Image.fromarray(mask.astype(np.uint8) * 255).filter(ImageFilter.MaxFilter(2 * r + 1))) > 127


def shrink(mask, r):
    return np.asarray(Image.fromarray(mask.astype(np.uint8) * 255).filter(ImageFilter.MinFilter(2 * r + 1))) > 127


def water_of(square):
    """The game's water in a square, at CHECK: its liquids, and the speckled dark blue-grey the minimap draws for
    the water of buildings (city canals), in sheets (the shadows of blue roofs are small)."""
    terrain = small(square["rgb"]).astype(np.int32)
    drawn = (terrain[..., 2] >= terrain[..., 0] + 8) & (terrain.max(-1) < 90)
    drawn = grow(shrink(box_mean(drawn.astype(np.float32), 2) > 0.5, 2), 2)
    return (small(square["water"]) > 127) | (np.abs(terrain - NAVY).sum(-1) < 30) | drawn


def check(square, painting):
    """How much of the painting is water where the game has none (added), and land where it has water (lost):
    broad sheets only, a shore may stray a little. Painted water is bluish, smooth, in sheets and bluer than the
    painting's own land, so a zone graded blue (Duskwood's dusk) and the blue shadows of snow are not water."""
    out = small(np.asarray(painting))
    game = water_of(square)
    hsv = np.asarray(Image.fromarray(out).convert("HSV"), np.float32)
    h, s, v = hsv[..., 0] * 360 / 255, hsv[..., 1] / 255, hsv[..., 2] / 255
    grey = out.astype(np.float32).mean(-1)
    rough = np.sqrt(np.maximum(box_mean(grey ** 2, 2) - box_mean(grey, 2) ** 2, 0))
    slack = max(1, round(CHECK * SLACK))
    blue = out[..., 2].astype(np.float32) - (out[..., 0].astype(np.float32) + out[..., 1]) / 2
    land = ~grow(game, slack)
    bar = np.percentile(blue[land], 30) + 12 if land.any() else -255.0
    painted = (h >= 150) & (h <= 250) & (s >= 0.22) & (v >= 0.18) & (rough < 9) & ~((v > 0.65) & (s < 0.6)) & (blue > bar)
    painted = grow(shrink(painted, 3), 3)
    added = grow(shrink(painted & land, 4), 4)
    lost = grow(shrink(game & ~grow(painted, slack) & ~grow(~game, slack), 4), 4)
    return {"added": round(float(added.mean()), 4), "lost": round(float(lost.mean()), 4)}


def passes(result):
    return result["added"] <= ADDED and result["lost"] <= LOST


# --- The words -----------------------------------------------------------------------------------

WET = re.compile(r"coast|shore|sea\b|lake|river|stream|water|shallow|surf|pool|pond|canal|marsh|bog|reed|harbour"
                 r"|beach|spring|falls|wave|steam", re.I)
HOT = re.compile(r"lava|molten|magma|ember|glowing", re.I)
WHERE = re.compile(r"north|south|east|west|centre|middle|edge", re.I)


def only(text, facts):
    """The phrases of a brief's field that fit the square: none about water or lava where the game has none,
    none that say where in the zone (a square is a small part of it)."""
    drop = [WHERE] + [rx for rx, there in ((WET, facts["water"] >= 0.001), (HOT, facts["lava"] >= 0.005)) if not there]
    kept = [p for p in re.split(r"(?<=[,;.:])\s+", text) if not any(rx.search(p) for rx in drop)]
    return re.sub(r"[,;:.]$", "", " ".join(kept).strip())


def joined(names):
    return names[0] if len(names) == 1 else ", ".join(names[:-1]) + " and " + names[-1]


LIGHT_DROP = re.compile(r"colou?r|grade|tint|cast|hue|bleach|drain|wash|haze|mist|steam|smoke|fog|cloud|spray|dust"
                        r"|shimmer|glow", re.I)


def light_of(atmosphere):
    """The light of a zone's atmosphere, its quality only: its first sentence without the clauses about colour or haze."""
    first = atmosphere.split(". ")[0].rstrip(".")
    kept = [clause for clause in first.split(", ") if not LIGHT_DROP.search(clause)]
    return ", ".join(kept) or "soft daylight"


def words(fixed, briefs, facts):
    """A square's words: an edit, never a repaint (what may change: how things look; what never does: where and
    what they are), the liquids the game has, its main zone's colours and the quality of its light, the colours of
    image 1 kept, nothing added or taken away. Never the zone's buildings, plants, places or props, nor the ground
    in words: the model paints whatever the words name into the square."""
    said = fixed["words"]
    water = facts["water"]
    liquids = [said["water"] if water >= 0.01 else said["little"] if water >= 0.001 else said["dry"]]
    if facts["lava"] >= 0.005:
        liquids.append(said["lava"])
    if facts["slime"] >= 0.005:
        liquids.append(said["slime"])
    if not facts["zones"]:
        return " ".join([fixed["sea"], briefs["sea"]["water"], *liquids, said["last"]])
    # the main zone's words only: a border's mountains may belong to a zone whose words do not fit them (north of
    # Stormwind's keep, the volcano's), and image 1 shows where the land changes
    main = briefs[facts["zones"][0]["uimap"]]
    zone = f"Its colours, as image 1 shows them: {only(main['colours'], facts)}. Its light: {light_of(main['atmosphere'])}."
    return " ".join([fixed["edit"], *liquids, zone, said["keep_colours"], said["last"]])


# --- The squares ---------------------------------------------------------------------------------

def plan(guides, continents, near=None):
    """The squares to paint, in order: by continent, in rows from the north-west, those with land; with near
    (continent, i0, j0, i1, j1) only those in that block."""
    count = -(-(ta.GRID * PX - SQ) // STEP) + 1
    found = []
    for continent in continents:
        for j in range(count):
            for i in range(count):
                if near and not (continent == near[0] and near[1] <= i < near[3] and near[2] <= j < near[4]):
                    continue
                if guides.land(continent, i, j) > LAND:
                    found.append((continent, i, j))
    return found


def around(guides, uimap, x, y, across, down):
    """The block of squares around a point of a zone's map: (continent, i0, j0, i1, j1)."""
    zone = guides.places["zones"][str(uimap)]
    north, south, west, east = zone["box"]
    wx, wy = north - y / 100 * (north - south), west - x / 100 * (west - east)
    half = ta.GRID / 2 * ta.TILE
    px, py = (half - wy) / ta.TILE * PX, (half - wx) / ta.TILE * PX
    i0, j0 = round((px - SQ / 2) / STEP - (across - 1) / 2), round((py - SQ / 2) / STEP - (down - 1) / 2)
    return zone["continent"], i0, j0, i0 + across, j0 + down


# --- Joining the squares -------------------------------------------------------------------------

FEATHER = 12   # pixels softened to either side of a cut


def seam(a, b):
    """The weight of a where two overlapping strips meet side by side (a on the left): 1 left of the line where they
    differ least (found row by row, moving a pixel at most from one row to the next), 0 right of it, softened
    FEATHER pixels to either side. A cut, not a cross-fade: two paintings of the same trees blended over the
    whole overlap would show both."""
    diff = box_mean(np.abs(a.astype(np.int16) - b.astype(np.int16)).sum(-1).astype(np.float32), 2)
    rows, width = diff.shape
    cum, back = diff.copy(), np.zeros((rows, width), np.int8)
    for y in range(1, rows):
        prev = cum[y - 1]
        options = np.stack([np.r_[np.inf, prev[:-1]], prev, np.r_[prev[1:], np.inf]])
        pick = options.argmin(0)
        back[y] = pick - 1
        cum[y] += options[pick, np.arange(width)]
    line = np.empty(rows, int)
    line[-1] = int(cum[-1].argmin())
    for y in range(rows - 1, 0, -1):
        line[y - 1] = line[y] + back[y, line[y]]
    return np.clip(0.5 - (np.arange(width)[None, :] - line[:, None]) / (2 * FEATHER), 0, 1)[..., None]


def join_two(left, right, cut):
    """Two pictures that overlap by SQ - STEP at the left's right edge, as one."""
    over = SQ - STEP
    a, b = left[:, -over:].astype(np.float32), right[:, :over].astype(np.float32)
    if cut:
        w = (np.arange(over) < over // 2).astype(np.float32)[None, :, None]
    else:
        w = seam(a, b)
    middle = (a * w + b * (1 - w)).clip(0, 255).astype(np.uint8)
    return np.concatenate([left[:, :-over], middle, right[:, over:]], axis=1)


def join(out, continent, block, cut=False):
    """The squares of a block (i0, j0, i1, j1) as one picture; a square not painted is the flat sea."""
    i0, j0, i1, j1 = block

    def picture(i, j):
        path = out / str(continent) / f"sq-{i}-{j}.png"
        if path.is_file():
            return np.asarray(Image.open(path).convert("RGB"))
        filled = np.empty((SQ, SQ, 3), np.uint8)
        filled[:] = NAVY
        return filled

    rows = []
    for j in range(j0, j1):
        row = picture(i0, j)
        for i in range(i0 + 1, i1):
            row = join_two(row, picture(i, j), cut)
        rows.append(row)
    whole = rows[0]
    for row in rows[1:]:  # rows meet top to bottom: the same, turned
        whole = join_two(whole.transpose(1, 0, 2), row.transpose(1, 0, 2), cut).transpose(1, 0, 2)
    return whole


def name_of(continent, i, j):
    return f"{continent}:{i}:{j}"


