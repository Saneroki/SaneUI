def picture(folder, key, rects, links):
    from PIL import Image, ImageDraw
    scale = 3
    image = Image.new("RGB", (SIDE * scale, SIDE * scale), (20, 20, 24))
    draw = ImageDraw.Draw(image)
    for number, (column, row, width, height, z, kind, *_) in enumerate(rects):
        shade = (number * 2654435761) % 0xFFFFFF
        colour = ((shade >> 16) & 0x7F | 0x40, (shade >> 8) & 0x7F | 0x40, shade & 0x7F | 0x40)
        if kind == WATER:
            colour = (30, 60, 150 + (shade & 0x3F))
        draw.rectangle([column * scale, row * scale, (column + width) * scale - 1, (row + height) * scale - 1], fill=colour)
    folder.mkdir(parents=True, exist_ok=True)
    image.save(folder / f"{key}.png")


# -------------------------------------------------------------------------------------------------
def options(args):
    """The command line taken apart: {folder, tables, only, maps, pictures, processes, memory}, or None when it is
    not the usage's."""
    found = {"only": None, "maps": None, "pictures": None, "processes": PROCESSES, "memory": MEMORY}
    args = list(args)
    for name, read in (("only", lambda text: {int(key) for key in text.split(",")}),
                       ("maps", lambda text: {int(map_id) for map_id in text.split(",")}),
                       ("pictures", Path), ("processes", int), ("memory", float)):
        if f"--{name}" in args:
            at = args.index(f"--{name}")
            found[name] = read(args[at + 1])
            del args[at:at + 2]
    if len(args) != 2:
        return None
    found["folder"], found["tables"] = Path(args[0]), Path(args[1])
    return found


def memory_held():
    """The bytes the run holds in its cgroup (memory.current less the file cache the kernel can drop), what the
    kernel judges against the cgroup's cap; None where there is no cgroup to read (another system)."""
    try:
        for line in Path("/proc/self/cgroup").read_text().splitlines():
            _, controllers, path = line.split(":", 2)
            if controllers == "":  # cgroup v2's one line
                group = Path("/sys/fs/cgroup") / path.strip().lstrip("/")
                current = int((group / "memory.current").read_text())
                stats = (dict(stat.split() for stat in (group / "memory.stat").read_text().splitlines())
                         if (group / "memory.stat").is_file() else {})
                return current - int(stats.get("file", 0))
    except (OSError, ValueError):
        pass
    return None


def save(path, lines, maps=None):
    """This run's lines into the staging file: with --maps (maps), the file's lines of the other maps are kept
    beside them (a map run on its own joins the others'), without it the file holds this run alone. Written through
    a temp file beside it and os.replace, so a run killed while writing leaves the old file whole. Returns how many
    lines the file holds."""
    kept = {}
    if maps and path.is_file():
        for text in path.read_text(encoding="utf-8").splitlines():
            if text.strip():
                line = json.loads(text)
                if line.get("fields", {}).get("map") not in maps:
                    kept[line["key"]] = text
    for line in lines:
        kept[line["key"]] = json.dumps(line, separators=(",", ":"))
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(".tmp")
    temp.write_text("".join(kept[key] + "\n" for key in sorted(kept)), encoding="utf-8")
    os.replace(temp, path)
    return len(kept)


def main():
    given = options(sys.argv[1:])
    if not given:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        return 2
    folder, tables, only, maps, pictures = (given[name] for name in ("folder", "tables", "only", "maps", "pictures"))
    waters = ART.waters(tables)
    formats = {row["ID"]: int(row["LVF"]) for row in ART.table(tables, "LiquidMaterial")}
    liquids = {int(row["ID"]): formats.get(row["MaterialID"], 0) for row in ART.table(tables, "LiquidType")}
    places = placements(folder)
    keys = sorted(int(path.stem) for path in (folder / "adt").glob("*.adt"))
    if maps:
        keys = [key for key in keys if key // (GRID * GRID) in maps]
    if only:
        wanted = set(only)
        for key in only:  # their neighbours too, for the openings across their edges
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    wanted.add(key + dr * GRID + dc)
        keys = [key for key in keys if key in wanted]
    jobs = []
    for key in keys:
        continent, rest = divmod(key, GRID * GRID)
        row, column = divmod(rest, GRID)
        north0, south0 = HALF - row * TILE, HALF - (row + 1) * TILE
        west0, east0 = HALF - column * TILE, HALF - (column + 1) * TILE
        near_places = [where for where in places.get(continent, [])
                       if where["box"][1] <= north0 and where["box"][0] >= south0
                       and where["box"][3] <= west0 and where["box"][2] >= east0]
        jobs.append((key, folder, waters, liquids, near_places))
    tiles = {}
    with Pool(given["processes"], maxtasksperchild=TASKS) as pool:
        for done, (key, rects, links, borders, opened, buried) in enumerate(pool.imap_unordered(tile, jobs, chunksize=1), 1):
            if rects:
                tiles[key] = (rects, links, borders, opened, buried)
            if done % 50 == 0 or done == len(jobs):
                print(f"{done} of {len(jobs)} tiles read", file=sys.stderr, flush=True)
            used = memory_held()
            if used is not None and used > given["memory"] * 2 ** 30:  # before the kernel kills the run, and the app
                pool.terminate()
                print(f"The run's cgroup holds {used / 2 ** 30:.1f} GB, past its {given['memory']:g} GB (--memory): stopped, no "
                      f"staging written. Run it one map at a time: --maps <map> --processes {PROCESSES}.", file=sys.stderr)
                return 1
    across(tiles)
    tiles = kept(tiles, regions(tiles, landings(tiles, ends())))
    lines, total, count = [], 0, 0
    for key in sorted(tiles):
        if only and key not in only:
            continue
        rects, links = tiles[key]
        if pictures:
            picture(pictures, key, rects, links)
        if only:
            continue  # no staging of a few tiles: their region numbers cannot agree with the master's (regions)
        text = block(rects, links, key, tiles)
        total += len(text)
        count += len(rects)
        continent, rest = divmod(key, GRID * GRID)
        row, column = divmod(rest, GRID)
        around = [continent * GRID * GRID + (row + dr) * GRID + (column + dc)
                  for dr, dc, _ in NEXT.values() if (continent * GRID * GRID + (row + dr) * GRID + (column + dc)) in tiles]
        lines.append({"set": "Walking", "key": key, "game": "forever", "build": BUILD, "src": "game",
                      "fields": {"map": continent, "links": sorted(around), "block": text}})
    if only:
        print(f"Read {len(only & set(tiles))} of {len(only)} tiles (--only)" + (f", their pictures in {pictures}" if pictures else "")
              + ": no staging written, a few tiles' region numbers cannot agree with the master's.")
        return 0
    held = save(STAGING, lines, maps)
    print(f"Wrote {STAGING.relative_to(ROOT)}: {len(lines)} tiles, {count} rectangles, {total // 1024} KB of blocks"
          + (f"; {held - len(lines)} tiles of other maps kept." if maps else "."))
    return 0


if __name__ == "__main__":
    sys.exit(main())
