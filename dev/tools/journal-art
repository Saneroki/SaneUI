#!/usr/bin/env python3
"""Makes the game's textures of the journal look (Doc/guides/interface-style.md) from the art's final pieces.

The pieces (assets/generated/interface/pieces/, made by dev/imagegen/sets/interface/catalog.py) are drawn for 4K:
one of their pixels is one of a 4K screen's, so they are kept at their size (a few made smaller where the game
draws them small: the patch, the pencil box and rule, the stains and sketches). Each becomes a BLP2 file as
Doc/guides/images.md decides (DXT5, the full chain of mipmaps, sides a power of two; the BLP writer is
dev/tools/art's): the piece at the texture's top left, the rest of the texture

  - for a piece repeated along one way (the edges, the bottom): the piece itself again, so the game's filtering
    finds the next tile's pixels where one tile meets the next;
  - for a piece stretched (the top's middle): its edge pixels, carried on;
  - else clear, its edge colour carried in (no dark seam).

The masks of the bottom corners are made square (128 x 128): a mask is a shape stretched to its box.

The character window (doll.png) is made here for the game:
  1. the hero taken out of his place (the game draws the live model there): assets/interface/doll-empty.png, the
     doll's middle column with the hero repainted as paper by an image model, its paper toned to the column's
     and the stony ground under his feet kept;
  2. its two slot columns bent along the arc (compose.py, doll_bent);
  3. the strips' painted writing covered with paper (compose.py, clean): code writes the items' words there;
  4. the two top slots (head, hands) made as small as the others (Saneroki, 2026-10-23): their large boxes covered
     with paper, a box of the first row's in their middle, the large box's sketch drawn small inside it (TOP);
  5. the hero's column (the model's place) covered with the page's own paper, its frame, wedges and stony ground
     gone (Saneroki, 2026-10-23): the model stands on the page (MIDDLE);
  6. cut to the window (compose.py, DOLL_BOX).

Kalam (assets/fonts/Kalam) goes into Core's Fonts/.

Writes assets/optimized/Core/Art/Journal/<piece>.blp and prints each one's size and texture size for
src/Core/Journal.lua (Journal.PIECES), and the doll's slots and strips (src/Inventory/Sheet/Doll.lua).

Usage:  dev/tools/journal-art [piece ...]
"""
import importlib.machinery
import importlib.util
import shutil
import sys
from pathlib import Path

import numpy as np
from PIL import Image, ImageChops, ImageDraw, ImageFilter

ROOT = Path(__file__).resolve().parents[2]
PIECES = ROOT / "assets/generated/interface/pieces"
OUT = ROOT / "assets/optimized/Core/Art/Journal"
FONTS = ROOT / "assets/fonts/Kalam"
HARNESS = ROOT / "dev/imagegen/sets/interface"
EMPTY = ROOT / "assets/interface/doll-empty.png"
EMPTY_AT = (800, 170)        # where the doll's middle column without the hero stands on the doll, in its pixels
LARGEST = 2048
LARGE = [(309, 94, 397, 184), (625, 101, 713, 185)]  # the top slots' large painted boxes (layout pixels of #3)
TOP = [(321, 120, 385, 184), (637, 120, 701, 184)]   # the top slots at the others' size, under the straps
SKETCH = 12                  # the sketch inside a box: so far in from its edge (layout pixels)
MIDDLE = (392, 84, 626, 758)  # the hero's column and its wedges, covered with paper (layout pixels of #3)
RIVETS = [(305, 94), (712, 94)]  # the frame's rivets by the top slots, kept (layout pixels of #3); radius RIVET
RIVET = 14
PAGE = (360, 160, 392, 700)  # the page's paper between the left slots and the hero's column: its tone (layout pixels of #3)
COVER = 9                    # the paper laid over a large box reaches so far past it (its pencil border)

_loader = importlib.machinery.SourceFileLoader("art", str(ROOT / "dev/tools/art"))
_spec = importlib.util.spec_from_loader("art", _loader)
art = importlib.util.module_from_spec(_spec)
_loader.exec_module(art)

BOX = 116 / 931              # the pencil box drawn 58 layout pixels high: 116 of 4K's pixels, from 931
# piece: (scale, how): "whole", "tile-x" / "tile-y" (repeated along), "stretch-x" (stretched along), "mask"
LIST = {
    "frame-top-left": (1, "whole"),
    "frame-top-middle": (1, "stretch-x"),
    "frame-top-right": (1, "whole"),
    "frame-left": (1, "tile-y"),
    "frame-right": (1, "tile-y"),
    "frame-bottom": (1, "tile-x"),
    "frame-clasp": (1, "whole"),
    "frame-cap-left": (1, "whole"),
    "frame-cap-right": (1, "whole"),
    "frame-mitre-left-edge": (1, "mask"),
    "frame-mitre-left-bottom": (1, "mask"),
    "frame-mitre-right-edge": (1, "mask"),
    "frame-mitre-right-bottom": (1, "mask"),
    "paper": (1, "whole"),
    "patch": (256 / 778, "whole"),
    "pencil-box": (BOX, "whole"),
    "pencil-rule": (BOX, "stretch-x"),
    "pencil-slot": (1, "whole"),
    "stain-1": (0.5, "whole"),
    "stain-2": (0.5, "whole"),
    "sketch-map-1": (0.5, "whole"),
    "sketch-tree-1": (0.5, "whole"),
    "doll": (1, "whole"),
    "icon-mask": (1, "mask"),
    "trash": (0.31, "whole"),
}
TRASH = ROOT / "assets/interface/bags-trash.png"   # the bags' waste bin, chosen (dev/imagegen/sets/bags/trash.txt)
ROUND = 0.2                  # the icon mask's corners: their radius against its side (Saneroki, 2026-10-23: rounder)


def side(n):
    s = 1
    while s < n:
        s *= 2
    return min(s, LARGEST)


def leather(rgb):
    """Where a picture (floats, 0-255) is leather, not paper or pencil: dark and a deeper brown than the pencil."""
    lum = rgb.mean(axis=-1)
    top = rgb.max(axis=-1)
    return (lum < 110) & ((top - rgb.min(axis=-1)) / np.maximum(top, 1) > 0.44)


def small_tops(c, compose, shift):
    """The two top slots made as small as a row's (TOP): each large box covered with paper of the page around it
    (paper.py's grain, brought to that paper's tone and contrast, feathered in, the leather over it kept); then
    pencil multiplied onto that paper: the border of the first row's box, and inside it the large box's sketch drawn
    small (the strap's leather in it left out)."""
    zz = compose.zz
    row = compose.DOLL["left"][0][0]
    row = (row[0] - shift[0], row[1], row[2] - shift[0], row[3])
    border = np.asarray(c.crop(zz(row[0] - 4, row[1] - 4, row[2] + 4, row[3] + 4)).convert("RGB"), dtype=np.float32)
    for i, (large, small) in enumerate(zip(LARGE, TOP)):
        inner = (large[0] + SKETCH + 4, large[1] + SKETCH + 4, large[2] - SKETCH - 4, large[3] - SKETCH - 4)
        sketch = np.asarray(c.crop(zz(*inner)).convert("RGB"), dtype=np.float32)
        # the paper: the page's next to the box (a band right or left of it, inside the frame)
        x0, y0, x1, y1 = zz(large[0] - COVER, large[1] - COVER, large[2] + COVER, large[3] + COVER)
        side = (x1 + 2, y0 + 30, x1 + 14, y1) if i == 0 else (x0 - 14, y0 + 30, x0 - 2, y1)
        near = np.asarray(c.crop(side).convert("RGB"), dtype=np.float32).reshape(-1, 3)
        near = near[~leather(near)]
        mean, std = near.mean(axis=0), near.std(axis=0)
        w, h = x1 - x0, y1 - y0
        grain = np.asarray(compose.paper.page(w, h, f"top{i}", edge=0, stained=False).convert("RGB"), dtype=np.float32)
        g = grain.reshape(-1, 3)
        fill = (grain - g.mean(axis=0)) / (g.std(axis=0) + 1e-6) * std + mean
        here = np.asarray(c.crop((x0, y0, x1, y1)), dtype=np.float32)
        keep = Image.fromarray((leather(here[..., :3]) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(7))
        draw = ImageDraw.Draw(keep)
        for rx, ry in RIVETS:
            cx, cy, r = compose.z(rx) - x0, compose.z(ry) - y0, compose.z(RIVET)
            draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=255)
        mask = ImageChops.invert(keep)
        edge = Image.new("L", (w, h), 0)
        edge.paste(255, (4, 4, w - 4, h - 4))
        mask = ImageChops.multiply(mask, edge.filter(ImageFilter.GaussianBlur(3))).filter(ImageFilter.GaussianBlur(1))
        m = np.asarray(mask, dtype=np.float32)[..., None] / 255
        here[..., :3] = here[..., :3] * (1 - m) + fill * m
        # pencil multiplied on: the row's box border (its inside left blank), the large sketch drawn small inside
        sx0, sy0, sx1, sy1 = zz(small[0] - 4, small[1] - 4, small[2] + 4, small[3] + 4)
        ink = border / np.percentile(border.reshape(-1, 3), 85, axis=0)
        ink = np.where(ink.mean(axis=-1, keepdims=True) < 0.9, ink, 1)        # the box's lines, not its paper
        cut = round(compose.z(4 + SKETCH * 64 // 90))
        ink[cut:-cut, cut:-cut] = 1
        ix0, iy0 = sx0 - x0 + cut, sy0 - y0 + cut
        iw, ih = ink.shape[1] - 2 * cut, ink.shape[0] - 2 * cut
        drawn = sketch / np.percentile(sketch.reshape(-1, 3), 85, axis=0)
        strap = Image.fromarray((leather(sketch) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(15))
        drawn[np.asarray(strap) > 0] = 1
        drawn = np.where(drawn.mean(axis=-1, keepdims=True) < 0.82, drawn, 1)   # the strokes, not the grain
        drawn = np.asarray(Image.fromarray((np.clip(drawn, 0, 1) * 255).astype(np.uint8)).resize((iw, ih), Image.LANCZOS),
                           dtype=np.float32) / 255
        ink[cut:-cut, cut:-cut] = drawn
        part = here[sy0 - y0:sy1 - y0, sx0 - x0:sx1 - x0]
        solid = ~leather(part[..., :3])
        part[..., :3] = np.where(solid[..., None], part[..., :3] * np.clip(ink, 0, 1), part[..., :3])
        c.paste(Image.fromarray(here.clip(0, 255).astype(np.uint8)), (x0, y0))


def paper_over(c, compose, box, seed, keep_boxes=()):
    """The page's paper laid over box (layout pixels of #3): paper.py's grain, brought to the tone and contrast of the
    page's paper in the slot columns, feathered in; the leather over it and keep_boxes (each slot's box) kept."""
    x0, y0, x1, y1 = compose.zz(*box)
    here = np.asarray(c.crop((x0, y0, x1, y1)), dtype=np.float32)
    w, h = x1 - x0, y1 - y0
    sample = np.asarray(c.crop(compose.zz(*PAGE)).convert("RGB"), dtype=np.float32).reshape(-1, 3)
    sample = sample[sample.mean(axis=1) > np.percentile(sample.mean(axis=1), 30)]   # the paper, not its pencil
    mean, std = sample.mean(axis=0), sample.std(axis=0)
    grain = np.asarray(compose.paper.page(w, h, seed, edge=0, stained=False).convert("RGB"), dtype=np.float32)
    g = grain.reshape(-1, 3)
    fill = (grain - g.mean(axis=0)) / (g.std(axis=0) + 1e-6) * std + mean
    keep = Image.fromarray((leather(here[..., :3]) * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(7))
    draw = ImageDraw.Draw(keep)
    for bx in keep_boxes:
        a0, b0, a1, b1 = compose.zz(*bx)
        draw.rectangle((a0 - x0, b0 - y0, a1 - x0, b1 - y0), fill=255)
    mask = ImageChops.invert(keep.filter(ImageFilter.MaxFilter(5)))
    edge = Image.new("L", (w, h), 0)
    edge.paste(255, (6, 6, w - 6, h - 6))
    mask = ImageChops.multiply(mask, edge.filter(ImageFilter.GaussianBlur(4))).filter(ImageFilter.GaussianBlur(2))
    m = np.asarray(mask, dtype=np.float32)[..., None] / 255
    here[..., :3] = here[..., :3] * (1 - m) + fill * m
    c.paste(Image.fromarray(here.clip(0, 255).astype(np.uint8)), (x0, y0))


def doll():
    """The game's doll (see the docstring), as an RGBA picture, and its slots and strips in its pixels."""
    sys.path.insert(0, str(HARNESS))
    import compose
    compose.S = 2
    c = Image.open(PIECES / "doll.png").convert("RGBA")
    empty = Image.open(EMPTY).convert("RGBA")
    over = Image.new("RGBA", c.size)
    over.paste(empty, EMPTY_AT)
    alpha = np.asarray(c)[..., 3].copy()
    c = Image.alpha_composite(c, over)
    a = np.asarray(c).copy()
    a[..., 3] = alpha                          # the doll's own outline; the column only changes its colours
    c, shift = compose.doll_bent(Image.fromarray(a))
    x0, y0 = compose.DOLL_BOX[:2]
    slots = {"top": [], "left": [], "right": [], "weapons": [], "ammo": None}
    for sl in TOP:
        slots["top"].append([v - o for v, o in zip(sl, (x0, y0, x0, y0))])
    for name in ("left", "right"):
        sgn = -1 if name == "left" else 1
        for i, (sl, st) in enumerate(compose.DOLL[name]):
            sl = (sl[0] + sgn * shift[i], sl[1], sl[2] + sgn * shift[i], sl[3])
            st = (st[0] + sgn * shift[i], st[1], st[2] + sgn * shift[i], st[3])
            paper = compose.clean(c, st, f"{name}{i}")
            slots[name].append(([v - o for v, o in zip(sl, (x0, y0, x0, y0))],
                                [round(v - o) for v, o in zip(paper, (x0, y0, x0, y0))]))
    small_tops(c, compose, shift)
    boxes = list(TOP)
    for name in ("left", "right"):
        sgn = -1 if name == "left" else 1
        for i, (sl, _) in enumerate(compose.DOLL[name]):
            boxes.append((sl[0] + sgn * shift[i] - 8, sl[1] - 8, sl[2] + sgn * shift[i] + 8, sl[3] + 8))
    paper_over(c, compose, MIDDLE, "middle", boxes)
    for i, (sl, st) in enumerate(compose.DOLL["weapons"]):
        paper = compose.clean(c, st, f"weapon{i}")
        slots["weapons"].append(([v - o for v, o in zip(sl, (x0, y0, x0, y0))],
                                 [round(v - o) for v, o in zip(paper, (x0, y0, x0, y0))]))
    slots["ammo"] = [v - o for v, o in zip(compose.DOLL["ammo"], (x0, y0, x0, y0))]
    box = compose.zz(*compose.DOLL_BOX)
    return c.crop(box), slots


def icon_mask():
    """The mask of an item's icon (Inventory's cells, the bags' strip, the doll's slots): a square with its corners
    rounded by ROUND of its side, drawn four times larger and brought down, so its edge is smooth."""
    n, k = 128, 4
    big = Image.new("L", (n * k, n * k), 0)
    ImageDraw.Draw(big).rounded_rectangle((0, 0, n * k - 1, n * k - 1), radius=round(ROUND * n * k), fill=255)
    alpha = big.resize((n, n), Image.LANCZOS)
    out = Image.new("RGBA", (n, n), (255, 255, 255, 0))
    out.putalpha(alpha)
    return out


def trash():
    """The bags' waste bin as pencil on the page: its strokes and shading in the journal's graphite, its white
    fill clear (the darker a pixel, the more graphite), so the paper shows through as through any pencil line."""
    picture = Image.open(TRASH).convert("RGBA")
    rgba = np.asarray(picture, dtype=np.float32)
    lum = rgba[..., :3].mean(axis=-1)
    ink = np.clip((235 - lum) / 150, 0, 1) * (rgba[..., 3] / 255)
    out = np.zeros_like(rgba)
    out[..., :3] = (30, 23, 17)                 # Core.Journal.INK
    out[..., 3] = ink * 255
    box = Image.fromarray(out.astype(np.uint8)).getbbox()
    return Image.fromarray(out.astype(np.uint8)).crop(box)


def slot():
    """A square pencil box for an item's slot (116 x 116, the box's height): the box's four corners kept whole
    (30 % of its height), its sides stretched between them."""
    box = Image.open(PIECES / "pencil-box.png").convert("RGBA")
    box = box.resize((round(box.width * BOX), round(box.height * BOX)), Image.LANCZOS)
    w, h = box.size
    c = round(0.3 * h)
    out = Image.new("RGBA", (h, h))
    n = h - 2 * c
    parts = {  # (source box, target box)
        "tl": ((0, 0, c, c), (0, 0)), "tr": ((w - c, 0, w, c), (h - c, 0)),
        "bl": ((0, h - c, c, h), (0, h - c)), "br": ((w - c, h - c, w, h), (h - c, h - c)),
    }
    for src, at in parts.values():
        out.paste(box.crop(src), at)
    out.paste(box.crop((c, 0, w - c, c)).resize((n, c), Image.LANCZOS), (c, 0))
    out.paste(box.crop((c, h - c, w - c, h)).resize((n, c), Image.LANCZOS), (c, h - c))
    out.paste(box.crop((0, c, c, h - c)), (0, c))
    out.paste(box.crop((w - c, c, w, h - c)), (h - c, c))
    return out


def texture(name, picture, scale, how):
    if scale != 1:
        w, h = round(picture.width * scale), round(picture.height * scale)
        # premultiplied, so clear pixels do not darken the edge
        picture = art.resize(art.load_image(picture), w, h)
    else:
        picture = art.load_image(picture)
    h, w = picture.shape[:2]
    if how == "mask":
        tw = th = 128
        picture = art.resize(picture, tw, th)
        h, w = th, tw
    tw, th = side(w), side(h)
    canvas = np.zeros((th, tw, 4))
    canvas[:h, :w] = picture
    if how == "tile-y":
        for y in range(h, th):
            canvas[y, :w] = picture[(y - h) % h]
    elif how == "tile-x":
        for x in range(w, tw):
            canvas[:h, x] = picture[:, (x - w) % w]
    elif how == "stretch-x":
        canvas[:h, w:] = picture[:, w - 1:w]
    levels, first, k = [], None, 0
    while True:
        lw, lh = max(1, tw >> k), max(1, th >> k)
        image = art.straight(canvas if k == 0 else art.resize(canvas, lw, lh))
        if first is None:
            first = image
        levels.append(art.dxt5(image))
        if lw == lh == 1:
            break
        k += 1
    data = art.blp(levels, tw, th)
    target = OUT / f"{name}.blp"
    target.write_bytes(data)
    psnr, off = art.check(target, first)
    print(f"{name}: {w} x {h} in {tw} x {th}, {len(data) // 1024} KB (read back {psnr:.1f} dB)")
    return w, h, tw, th


def load_image(picture):
    """art.load for a picture in memory: floats 0-1, colour premultiplied, not cropped."""
    rgba = np.asarray(picture.convert("RGBA"), dtype=np.float64) / 255
    alpha = np.minimum(1.0, rgba[..., 3] * 255 / art.SOLID)
    rgba[..., :3] *= alpha[..., None]
    rgba[..., 3] = alpha
    return rgba


art.load_image = load_image


def main(names):
    OUT.mkdir(parents=True, exist_ok=True)
    sizes, slots = {}, None
    for name in names or LIST:
        scale, how = LIST[name]
        if name == "doll":
            picture, slots = doll()
        elif name == "pencil-slot":
            picture = slot()
        elif name == "icon-mask":
            picture = icon_mask()
        elif name == "trash":
            picture = trash()
        else:
            picture = Image.open(PIECES / f"{name}.png").convert("RGBA")
        sizes[name] = texture(name, picture, scale, how)
    fonts = ROOT / "assets/optimized/Core/Fonts"
    fonts.mkdir(parents=True, exist_ok=True)
    for f in list(FONTS.glob("Kalam-*.ttf")) + [FONTS / "OFL.txt"]:
        shutil.copy2(f, fonts / f.name)
    print("\nJournal.PIECES (src/Core/Journal.lua): { width, height, texture width, texture height }")
    for name, (w, h, tw, th) in sizes.items():
        print(f'    ["{name}"] = {{ {w}, {h}, {tw}, {th} }},')
    if slots:
        print("\nThe doll's slots and strips, in its pixels { left, top, right, bottom } (src/Inventory/Sheet/Doll.lua):")
        print("    top =", slots["top"])
        for key in ("left", "right", "weapons"):
            print(f"    {key} =", slots[key])
        print("    ammo =", slots["ammo"])


if __name__ == "__main__":
    main(sys.argv[1:])
