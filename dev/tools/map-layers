def load_state(out):
    path = out / "state.json"
    return json.loads(path.read_text()) if path.is_file() else {"paths": {}, "subjects": []}


def save_state(out, state):
    out.mkdir(parents=True, exist_ok=True)
    (out / "state.tmp").write_text(json.dumps(state, indent=1))
    os.replace(out / "state.tmp", out / "state.json")


def inputs(args):
    """Every subject's frame, terrain plan and map art, and its floors."""
    out = Path(args.out)
    state = load_state(out)
    atlas = json.loads((ROOT / "assets" / "generated" / "atlas" / "state.json").read_text())["paths"]
    paths = state["paths"]
    for name, default in (("continents", atlas["adt"]), ("tables", atlas["tables"]), ("minimap", atlas["minimap"]),
                          ("instance_files", None), ("mapart", None)):
        given = getattr(args, name, None)
        if given or name not in paths:
            paths[name] = str(Path(given).resolve()) if given else default
    tables, mapart = Path(paths["tables"]), Path(paths["mapart"])
    zone_briefs, dungeon_briefs = tomllib.loads(ZONES.read_text()), tomllib.loads(DUNGEONS.read_text())
    subjects = []
    if args.zones:
        game = at.Game({"adt": paths["continents"], "minimap": paths["minimap"], "tables": paths["tables"]})
        world = Ground(paths["minimap"], tiles_of(ROOT / "assets" / "data" / "Tiles" / "Tiles.jsonl"),
                       adt=paths["continents"], liquids={t: f for kinds in game.liquids.values() for t, f in kinds.items()})
        walking = Walking()
        found, _ = ta.zones(tables, (0, 1))
        places = json.loads(META.read_text())["zones"]
        for uimap in args.zones:
            continent, box, _ = found[uimap]
            zone = places[str(uimap)]
            main = (zone.get("flights") or [{"x": 50, "y": 50}])[0]   # the close sample: around its flight master
            north, south, west, east = box
            centre = (north - main["y"] / 100 * (north - south), west - main["x"] / 100 * (west - east))
            name = f"zone-{uimap}"
            folder = out / name
            folder.mkdir(parents=True, exist_ok=True)
            framed(world.picture(continent, box, SIDE)).save(folder / "ground.png")
            art = zone_art(uimap, tables, mapart)
            art.resize(Image.open(folder / "ground.png").size, Image.Resampling.LANCZOS).save(folder / "art.png")
            far_inputs(folder, world, walking, continent, box)
            subject = {"name": name, "kind": "zone", "key": uimap, "map": continent, "box": box, "centre": centre,
                       "title": zone_briefs[str(uimap)]["name"]}
            subjects.append(dict(subject, around=around_of(subject, found, zone_briefs)))
            print(f"{name}: {zone_briefs[str(uimap)]['name']}, frame {[round(v) for v in box]}")
    if args.instances:
        folder_files = Path(paths["instance_files"])
        sets = floors_of_set()
        instance_tiles = tiles_of(folder_files / "tiles.jsonl")
        for key in args.instances:
            indoors = Indoors(folder_files, tables, key)
            ground = Ground(folder_files / "minimap", instance_tiles, indoors)
            floors = sets.get(key) or []
            if not floors:   # no map art: one floor, the frame what its indoor maps draw, a little around
                north, south, west, east = indoors.bounds()
                pad = 0.08 * max(north - south, west - east)
                north, south, west, east = north + pad, south - pad, west + pad, east - pad
                wide, high = west - east, north - south   # widened to the game's 3:2 of map art
                if wide < 1.5 * high:
                    grow = (1.5 * high - wide) / 2
                    west, east = west + grow, east - grow
                else:
                    grow = (wide / 1.5 - high) / 2
                    north, south = north + grow, south - grow
                floors = [{"floor": 1, "name": "", "box": (north, south, west, east)}]
            name = f"instance-{key}"
            records = []
            for floor in floors:
                floor_name = f"{name}-{floor['floor']}"
                folder = out / floor_name
                folder.mkdir(parents=True, exist_ok=True)
                box = tuple(floor["box"])
                picture = framed(ground.picture(key, box, SIDE, within=box if len(floors) > 1 else None))
                picture.save(folder / "ground.png")
                if floor.get("tiles"):
                    art, style_only = floor_art(floor, mapart), False
                else:
                    other, number = STYLE_OF[key]
                    art, style_only = floor_art(next(f for f in sets[other] if f["floor"] == number), mapart), True
                art.resize(picture.size, Image.Resampling.LANCZOS).save(folder / "art.png")
                records.append({"name": floor_name, "floor": floor["floor"], "box": box, "style_only": style_only})
            union = (max(f["box"][0] for f in records), min(f["box"][1] for f in records),
                     max(f["box"][2] for f in records), min(f["box"][3] for f in records))
            folder = out / name
            folder.mkdir(parents=True, exist_ok=True)
            framed(ground.picture(key, union, SIDE)).save(folder / "ground.png")
            view = Image.open(folder / "ground.png")
            far_colours(view).save(folder / "far-colours.png")
            edges_of(view).save(folder / "far-edges.png")
            subjects.append({"name": name, "kind": "instance", "key": key, "map": key, "box": union,
                             "floors": records, "title": dungeon_briefs[str(key)]["name"]})
            print(f"{name}: {dungeon_briefs[str(key)]['name']}, {len(records)} floors, {len(indoors.parts)} indoor parts")
    state["subjects"] = [s for s in state["subjects"] if s["name"] not in {n["name"] for n in subjects}] + subjects
    save_state(out, state)


# --- The levels -----------------------------------------------------------------------------------

def checks_of(folder):
    path = folder / "checks.json"
    return json.loads(path.read_text()) if path.is_file() else {}


def save_checks(folder, checks):
    (folder / "checks.json").write_text(json.dumps(checks, indent=1))


def close(server, subject, state, out, whole=False):
    """The close level: the Atlas' squares over the subject's terrain, painted, checked, colour-passed, joined: a
    zone's around its main place, an instance's over it (MOST_SQUARES at most); whole: every square of the frame."""
    paths, folder = state["paths"], out / subject["name"]
    (folder / "close").mkdir(parents=True, exist_ok=True)
    fixed = tomllib.loads(ATLAS.read_text())
    north, south, west, east = subject["box"]
    x0, y0 = pixel(north, west, PER_YARD)
    x1, y1 = pixel(south, east, PER_YARD)
    columns = list(range(int(x0 // at.STEP), int(x1 // at.STEP) + 1))
    rows = list(range(int(y0 // at.STEP), int(y1 // at.STEP) + 1))
    if subject["kind"] == "zone":
        game = at.Game({"adt": paths["continents"], "tables": paths["tables"], "minimap": paths["minimap"]})
        guides = at.Guides(game)
        briefs = tomllib.loads(ZONES.read_text())
        x, y = pixel(*subject["centre"], PER_YARD)
        i0, j0 = round(x / at.STEP) - SQUARES // 2, round(y / at.STEP) - SQUARES // 2
        squares = ([(i, j) for j in rows for i in columns] if whole
                   else [(i, j) for j in range(j0, j0 + SQUARES) for i in range(i0, i0 + SQUARES)])
        indoors = None
    else:
        files = Path(paths["instance_files"])
        game = at.Game({"adt": files / "adt", "tables": paths["tables"], "minimap": files / "minimap"})
        game.files = tiles_of(files / "tiles.jsonl")
        guides, briefs = None, {"instance": tomllib.loads(DUNGEONS.read_text())[str(subject["key"])]}
        indoors = Indoors(files, Path(paths["tables"]), subject["key"])
        while not whole and len(columns) * len(rows) > MOST_SQUARES:   # the middle of a large instance, a rectangle kept
            longer = columns if len(columns) >= len(rows) else rows
            longer.pop(0 if len(longer) % 2 == 0 else -1)
        squares = [(i, j) for j in rows for i in columns]
    checks = checks_of(folder)
    for i, j in squares:
        target = folder / "close" / f"{i}-{j}.png"
        if target.is_file():
            continue
        square = game.square(subject["map"], i, j)
        if indoors:
            canvas = Image.fromarray(square["rgb"]).convert("RGBA")
            indoors.draw(canvas, i * at.STEP, j * at.STEP, PER_YARD)
            square["rgb"] = np.asarray(canvas.convert("RGB")).copy()
            facts = {"water": float(at.water_of(square).mean()), "lava": float(square["lava"].mean()) / 255,
                     "slime": float(square["slime"].mean()) / 255, "zones": [{"uimap": "instance"}]}
        else:
            facts = guides.facts(subject["map"], i, j, square)
        prompt = at.words(fixed, briefs, facts)
        source = folder / "close" / f"{i}-{j}-ground.png"
        Image.fromarray(square["rgb"]).save(source)
        best = None
        for seed in range(1, at.TRIES + 1):
            painting, _ = run_one(server, at.WORKFLOW, [source], prompt, f"close-{subject['name']}-{i}-{j}", seed, at.SETTINGS)
            result = at.check(square, painting)
            score = result["added"] + result["lost"]
            if best is None or score < best[0]:
                best = (score, seed, painting, result)
            if at.passes(result):
                break
        score, seed, painting, result = best
        coloured = at.colour_of(np.asarray(painting), square)
        Image.fromarray(coloured).save(target)
        checks[f"close-{i}-{j}"] = {"seed": seed, "water": result, "passes": at.passes(result), "words": prompt}
        save_checks(folder, checks)
        print(f"{subject['name']} close {i},{j}: seed {seed}, water {result}", flush=True)
    join_close(folder)


def join_close(folder):
    """The close squares as one picture, joined as the Atlas joins its squares: each overlap cut along the line where
    the two paintings differ least (at.join_two), rows first, then the rows."""
    found = {tuple(int(n) for n in p.stem.split("-")): p for p in (folder / "close").glob("*.png")
             if re.fullmatch(r"\d+-\d+", p.stem)}
    columns, rows = sorted({i for i, _ in found}), sorted({j for _, j in found})
    lines = []
    for j in rows:
        line = None
        for i in columns:
            path = found.get((i, j)) or folder / "close" / f"{i}-{j}-ground.png"
            square = np.asarray(Image.open(path).convert("RGB"))
            line = square if line is None else at.join_two(line, square, False)
        lines.append(line)
    whole = lines[0].transpose(1, 0, 2)
    for line in lines[1:]:
        whole = at.join_two(whole, line.transpose(1, 0, 2), False)
    Image.fromarray(whole.transpose(1, 0, 2)).save(folder / "close.png")


def paint_level(server, level, folder, refs, prompt, brief, reference, compare=None, walk=None, workflow=None):
    """A middle or far painting: tries until one passes its checks; the best kept as <level>.png. Its outlines
    are compared with the terrain plan (compare, else image 1); a zone's far painting's water with the walking
    data's (walk)."""
    checks = checks_of(folder)
    ground = Image.open(compare or refs[0])
    best = None
    for seed in range(1, TRIES + 1):
        settings = {"resolution": READ, "denoise": STRENGTH[level][seed - 1], "width": ground.width // 16 * 16,
                    "height": ground.height // 16 * 16}
        target = folder / f"{level}-{seed}.png"
        if target.is_file() and f"{level}-{seed}" in checks:
            painting = Image.open(target).convert("RGB")
        else:
            painting, _ = run_one(server, workflow or LAYERS[level], refs, prompt, f"{level}-{folder.name}", seed, settings)
            painting.save(target)
            match = agreement(painting, ground)
            _, text = run_one(server, LOOK, [target], look_words(level, brief), f"look-{folder.name}", 1, {})
            seen_ok, seen = verdict(level, text)
            bar = MIDDLE * reference if level == "middle" else FAR
            water = water_check(Image.open(walk), painting) if walk else None
            wet_ok = water is None or (water["added"] <= FAR_WATER[0] and water["lost"] <= FAR_WATER[1])
            checks[f"{level}-{seed}"] = {"outlines": round(match, 3), "bar": round(bar, 3), "seen": seen,
                                         **({"water": water} if water else {}), "strength": settings["denoise"],
                                         "passes": bool(seen_ok and match >= bar and wet_ok), "words": prompt}
            save_checks(folder, checks)
            print(f"{folder.name} {level} {seed}: outlines {match:.3f} (bar {bar:.3f}), {seen}"
                  + (f", water {water}" if water else ""), flush=True)
        mark = checks[f"{level}-{seed}"]
        copied = level == "far" and mark["outlines"] > COPY   # its image 1 come back nearly as it is
        rank = (mark["passes"] and not copied, not copied, mark["outlines"])
        if best is None or rank > best[0]:
            best = (rank, seed)
        if mark["passes"] and not copied:
            break
    shutil.copyfile(folder / f"{level}-{best[1]}.png", folder / f"{level}.png")


def paint(args):
    out = Path(args.out)
    state = load_state(out)
    words = tomllib.loads(LEVELS.read_text())
    zone_briefs, dungeon_briefs = tomllib.loads(ZONES.read_text()), tomllib.loads(DUNGEONS.read_text())
    start_comfyui()
    server = ig.Server(ADDRESS)
    for subject in state["subjects"]:
        if args.only and subject["name"] not in args.only:
            continue
        instance = subject["kind"] == "instance"
        brief = dict((dungeon_briefs if instance else zone_briefs)[str(subject["key"])])
        folder = out / subject["name"]
        if "close" in args.levels and (args.whole_close or not (folder / "close.png").is_file()):
            close(server, subject, state, out, args.whole_close)
        frames = subject.get("floors") or [{"name": subject["name"], "style_only": False}]
        if "middle" in args.levels:
            for frame in frames:
                fold = out / frame["name"]
                if (fold / "middle.png").is_file():
                    continue
                here = dict(brief, _style_only=frame["style_only"])
                reference = 0.3 if frame["style_only"] else agreement(Image.open(fold / "art.png"), Image.open(fold / "ground.png"))
                paper = fold / "parchment.png"   # image 3: the paper, a zone's in its land's colour
                tone = (tone_of(Image.open(fold / "art.png")) if instance
                        else land_tone(Image.open(fold / "ground.png"), subject["key"]))
                parchment((PAPER_SIDE, PAPER_SIDE), tone).save(paper)
                refs = ([fold / "ground.png", fold / "art.png", paper] if frame["style_only"]    # image 1 the plan
                        else [fold / "art.png", fold / "ground.png", paper])                     # image 1 the map
                paint_level(server, "middle", fold, refs, words_of("middle", words, here, instance), here,
                            max(reference, 0.15), compare=fold / "ground.png")
        if "far" in args.levels and not (folder / "far.png").is_file():
            close_piece = folder / "far-close.png"   # image 2: a piece of the close level, how the ground looks
            joined_at = folder / "close.png"
            if not joined_at.is_file():   # painted only far and middle: another zone's on its map, or its plan
                joined_at = next((out / other["name"] / "close.png" for other in state["subjects"]
                                  if other["kind"] == "zone" and other["map"] == subject["map"]
                                  and (out / other["name"] / "close.png").is_file()), folder / "ground.png")
            with Image.open(joined_at) as joined:
                w, h = joined.size
                side = min(CLOSE_SIDE, w, h)
                joined.crop(((w - side) // 2, (h - side) // 2, (w + side) // 2, (h + side) // 2)).save(close_piece)
            if instance:   # its plan blurred, image 2 the close level's ground, its edges the control
                paint_level(server, "far", folder, [folder / f"far-{part}.png" for part in ("colours", "close", "edges")],
                            words_of("far", words, brief, True), brief, 1.0, compare=folder / "ground.png",
                            workflow=GUIDED)
            else:          # its terrain blurred, image 2 the close level's ground, its heights and water lines the controls
                around = [(direction, zone_briefs[str(uimap)]["biome"]) for direction, uimap in subject.get("around", [])]
                paint_level(server, "far", folder, [folder / f"far-{part}.png" for part in ("colours", "close", "height", "water")],
                            words_of("far", words, brief, False, around), brief, 1.0, compare=folder / "ground.png",
                            walk=folder / "far-walk.png", workflow=HEIGHTS)


def join(args):
    """Joins every subject's close squares again (after a change to the joining); paints nothing."""
    out = Path(args.out)
    for subject in load_state(out)["subjects"]:
        if (out / subject["name"] / "close").is_dir() and any((out / subject["name"] / "close").glob("*-*.png")):
            join_close(out / subject["name"])
            print(f"{subject['name']}: close.png joined")


def contact(args):
    out = Path(args.out)
    state = load_state(out)
    rows = []
    for subject in state["subjects"]:
        frames = subject.get("floors") or [{"name": subject["name"]}]
        rows.append([out / subject["name"] / "ground.png", out / frames[0]["name"] / "art.png",
                     out / subject["name"] / "close.png", out / frames[0]["name"] / "middle.png",
                     out / subject["name"] / "far.png"])
    w, h = 480, 320
    sheet = Image.new("RGB", (w * 5, h * len(rows)), (30, 30, 30))
    for r, row in enumerate(rows):
        for c, path in enumerate(row):
            if path.is_file():
                with Image.open(path) as picture:
                    tile = picture.convert("RGB")
                    tile.thumbnail((w, h))
                    sheet.paste(tile, (c * w, r * h))
    sheet.save(out / "contact.jpg", quality=88)
    print(f"{out / 'contact.jpg'}: {len(rows)} subjects: terrain plan, the game's map, close, middle, far")


STITCHED = 6000                 # pixels: a stitched map at most so wide (else at its finest zone's own scale)


def stitch(args):
    """Every painted zone's middle and far levels laid where they lie on their continent, as the levels of the
    world are made (Saneroki, 2026-10-22: each zone painted on its own and the zones joined, all three levels in
    the same place): each zone's whole painting first (the sea between them), then each cut by its outline
    (Navigation's zone masks, soft past the border) over it. stitch-<level>-<continent>.jpg over the zones' area."""
    out = Path(args.out)
    zones = [s for s in load_state(out)["subjects"] if s["kind"] == "zone"]
    for level in ("middle", "far"):
        for continent in sorted({s["map"] for s in zones}):
            here = [s for s in zones if s["map"] == continent and (out / s["name"] / f"{level}.png").is_file()]
            if not here:
                continue
            north, south = max(s["box"][0] for s in here), min(s["box"][1] for s in here)
            west, east = max(s["box"][2] for s in here), min(s["box"][3] for s in here)
            k = min(min(SIDE / (s["box"][2] - s["box"][3]) for s in here), STITCHED / (west - east))
            left, top = pixel(north, west, k)
            ground = parchment((16, 16)).resize((8, 8)).getpixel((4, 4)) if level == "middle" else SEA
            sheet = Image.new("RGBA", (round((west - east) * k), round((north - south) * k)), ground + (255,))
            laid = []
            for subject in here:
                n, so, w, e = subject["box"]
                at_x, at_y = (round(c) for c in pixel(n, w, k))
                size = (round((w - e) * k), round((n - so) * k))
                painting = Image.open(out / subject["name"] / f"{level}.png").convert("RGBA").resize(size, Image.Resampling.LANCZOS)
                sheet.alpha_composite(painting, (at_x - round(left), at_y - round(top)))
                laid.append((subject, painting, (at_x - round(left), at_y - round(top))))
            for subject, painting, where in laid:
                outline = OUTLINES / f"{subject['key']}.blp"
                if outline.is_file():
                    with Image.open(outline) as mask:
                        painting.putalpha(mask.getchannel("A").resize(painting.size, Image.Resampling.BILINEAR))
                    sheet.alpha_composite(painting, where)
            path = out / f"stitch-{level}-{continent}.jpg"
            sheet.convert("RGB").save(path, quality=90)
            print(f"{path}: {len(here)} zones, {sheet.width} x {sheet.height}")


def status(args):
    out = Path(args.out)
    state = load_state(out)
    wanted = made = 0
    for subject in state["subjects"]:
        frames = subject.get("floors") or [{"name": subject["name"]}]
        paths = [out / subject["name"] / "close.png", out / subject["name"] / "far.png"]
        paths += [out / f["name"] / "middle.png" for f in frames]
        wanted += len(paths)
        made += sum(1 for p in paths if p.is_file())
    print(f"{made} of {wanted or 1} paintings made ({len(state['subjects'])} subjects)")


def main():
    parser = argparse.ArgumentParser(description="The three levels of Navigation's painted maps.")
    parser.add_argument("command", choices=("inputs", "paint", "join", "contact", "stitch", "status"))
    numbers = lambda text: [int(k) for k in text.split(",") if k]  # noqa: E731
    parser.add_argument("--zones", type=numbers, default=[])
    parser.add_argument("--instances", type=numbers, default=[])
    parser.add_argument("--continents")
    parser.add_argument("--tables")
    parser.add_argument("--minimap")
    parser.add_argument("--instance-files", dest="instance_files")
    parser.add_argument("--mapart")
    parser.add_argument("--levels", type=lambda text: set(text.split(",")), default={"close", "middle", "far"})
    parser.add_argument("--whole-close", dest="whole_close", action="store_true")
    parser.add_argument("--only", type=lambda text: set(text.split(",")))
    parser.add_argument("--out", default=str(OUT))
    args = parser.parse_args()
    {"inputs": inputs, "paint": paint, "join": join, "contact": contact, "stitch": stitch, "status": status}[args.command](args)


if __name__ == "__main__":
    main()
