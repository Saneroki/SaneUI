# --- Frames and the terrain plan ----------------------------------------------------------------

def pixel(x, y, k):
    """Where a world point (x north, y west, yards) lies at k pixels a yard: (column, row) from the map's corner."""
    return (CENTRE - y) * k, (CENTRE - x) * k


def frame_of(box, width):
    """A box (north, south, west, east) drawn width pixels across, north up: its pixels a yard, the map pixel of
    its top left corner and its height in pixels."""
    north, south, west, east = box
    k = width / (west - east)
    left, top = pixel(north, west, k)
    return k, left, top, max(1, round((north - south) * k))


def affine(fn):
    """PIL's AFFINE data for a linear map of output pixels (u, v) to input pixels."""
    c = fn(0, 0)
    a, d = (p - q for p, q in zip(fn(1, 0), c))
    b, e = (p - q for p, q in zip(fn(0, 1), c))
    return (a, b, c[0], d, e, c[1])


def buildings_of(folder, map_id):
    """The buildings a map's object files place (MODF; with flag 0x8 the file's ID), once each: file, place,
    turn and scale, as dev/tools/walk-data reads them (doodads left out)."""
    found = {}
    for path in sorted((folder / "adt-obj0").glob("*.adt")):
        if int(path.stem) // (GRID * GRID) != map_id:
            continue
        data = path.read_bytes()
        for name, at, size in ta.pieces(data, 0, len(data)):
            if name != b"MODF":
                continue
            for start in range(at, at + size, 64):
                (file, unique, px, py, pz, rx, ry, rz, *_, flags, _, _, scale) = struct.unpack_from(
                    "<II3f3f3f3fHHHH", data, start)
                if flags & 0x8:
                    found[unique] = {"file": file, "at": (px, py, pz), "turn": (rx, ry, rz),
                                     "scale": scale / 1024 if scale else 1}
    return list(found.values())


class Indoors:
    """The indoor maps of the buildings an instance's terrain places (its object files), each part as the game's
    indoor minimap draws it (indoor-art's plan, its black taken out), placed as Navigation places them."""

    def __init__(self, folder, tables, map_id):
        textures = ia.textures(tables)
        minimap = folder / "wmo-minimap"
        self.parts = []
        for where in buildings_of(folder, map_id):
            if ia.tilt(where["turn"]) > ia.TILT:
                continue
            root = folder / "wmo" / f"{where['file']}.wmo"
            if not root.is_file():
                continue
            wmo, parts = ia.building(root)
            place = ia.placed(where, map_id)
            for number, (flags, box) in enumerate(parts):
                blocks = textures.get(wmo, {}).get(number)
                if not blocks or not all((minimap / f"{f}.blp").is_file() for f in blocks.values()):
                    continue
                sizes = {f: ia.texture_size(minimap / f"{f}.blp") for f in blocks.values()}
                if not ia.fits(box, blocks, sizes):
                    continue
                rgb, alpha = ia.plan(blocks, minimap)
                if (alpha > 0.5).sum() < ia.SPECK:
                    continue
                rgb = ia.bleed(rgb, (alpha > 0.5).astype(np.float32))
                alpha = ia.softened(rgb, alpha)
                picture = Image.fromarray((np.dstack([rgb, alpha]) * 255).clip(0, 255).astype(np.uint8), "RGBA")
                top = box[1] + (max(row for _, row in blocks) + 1) * ia.BLOCK
                middle = self.world(place, (box[0] + box[3]) / 2, (box[1] + box[4]) / 2)
                self.parts.append({"picture": picture, "box": box, "top": top, "place": place, "middle": middle,
                                   "z": place["z"] + place["scale"] * box[2]})
        self.parts.sort(key=lambda part: part["z"])   # the lower parts first: a part above is drawn over them

    @staticmethod
    def world(place, bx, by):
        turn, s = math.radians(place["yaw"]), place["scale"]
        return (place["x"] - s * (bx * math.cos(turn) - by * math.sin(turn)),
                place["y"] - s * (bx * math.sin(turn) + by * math.cos(turn)))

    def bounds(self):
        """The box (north, south, west, east) of everything the indoor maps draw."""
        xs, ys = [], []
        for part in self.parts:
            b = part["box"]
            for bx, by in ((b[0], b[1]), (b[3], b[1]), (b[0], b[4]), (b[3], b[4])):
                x, y = self.world(part["place"], bx, by)
                xs.append(x)
                ys.append(y)
        return max(xs), min(xs), max(ys), min(ys)

    def draw(self, canvas, left, top, k, within=None):
        """Lays the parts over a picture whose top left lies at pixel (left, top) of the map at k pixels a yard;
        only the parts whose middle lies within a box, if one is given."""
        for part in self.parts:
            if within and not (within[1] <= part["middle"][0] <= within[0] and within[3] <= part["middle"][1] <= within[2]):
                continue
            place, box, ceiling = part["place"], part["box"], part["top"]
            turn, s = math.radians(place["yaw"]), place["scale"]
            cos, sin = math.cos(turn), math.sin(turn)

            def source(u, v):   # a canvas pixel to the part's picture: world, then the building's own x and y
                dx = CENTRE - (top + v) / k - place["x"]
                dy = CENTRE - (left + u) / k - place["y"]
                bx, by = -(cos * dx + sin * dy) / s, -(-sin * dx + cos * dy) / s
                return (bx - box[0]) * ia.TEXELS, (ceiling - by) * ia.TEXELS
            laid = part["picture"].transform(canvas.size, Image.Transform.AFFINE, affine(source), Image.Resampling.BILINEAR)
            canvas.alpha_composite(laid)
        return canvas


class Ground:
    """A map's terrain from above: its minimap textures, with an instance's indoor maps over them, and its heights
    (its terrain files in adt, the liquids' types as atlas.Game has them)."""

    def __init__(self, minimap, tiles, indoors=None, adt=None, liquids=None):
        self.minimap, self.tiles, self.indoors = Path(minimap), tiles, indoors
        self.adt, self.liquids = (Path(adt) if adt else None), liquids or {}

    def picture(self, map_id, box, width, within=None):
        """The terrain of a box (north, south, west, east), width pixels across, north up."""
        k, left, top, height = frame_of(box, width)
        canvas = Image.new("RGBA", (width, height), (0, 0, 0, 255))
        size = TILE * k
        for row in range(int(top // size), int((top + height) // size) + 1):
            for column in range(int(left // size), int((left + width) // size) + 1):
                file = self.tiles.get(map_id * GRID * GRID + row * GRID + column)
                if not file or not (self.minimap / f"{file}.blp").is_file():
                    continue
                x0, y0 = round(column * size - left), round(row * size - top)
                x1, y1 = round((column + 1) * size - left), round((row + 1) * size - top)
                with Image.open(self.minimap / f"{file}.blp") as texture:
                    canvas.paste(texture.convert("RGBA").resize((x1 - x0, y1 - y0), Image.Resampling.LANCZOS), (x0, y0))
        if self.indoors:
            self.indoors.draw(canvas, left, top, k, within)
        return canvas.convert("RGB")

    def heights(self, map_id, box, width):
        """The height in yards of the ground, or of the water over it, where picture draws it; NaN where the game
        has no terrain."""
        k, left, top, height = frame_of(box, width)
        out = np.full((height, width), np.nan, np.float32)
        size = TILE * k
        for row in range(int(top // size), int((top + height) // size) + 1):
            for column in range(int(left // size), int((left + width) // size) + 1):
                path = self.adt / f"{map_id * GRID * GRID + row * GRID + column}.adt" if self.adt else None
                if not path or not path.is_file():
                    continue
                ground, surface, _ = ta.levels(path, self.liquids)
                x0, y0 = round(column * size - left), round(row * size - top)
                x1, y1 = round((column + 1) * size - left), round((row + 1) * size - top)
                level = Image.fromarray(np.maximum(ground, surface)).resize((x1 - x0, y1 - y0), Image.Resampling.BILINEAR)
                ax, ay, bx, by = max(0, x0), max(0, y0), min(width, x1), min(height, y1)
                if ax < bx and ay < by:
                    out[ay:by, ax:bx] = np.asarray(level)[ay - y0:by - y0, ax - x0:bx - x0]
        return out


def framed(picture, resample=Image.Resampling.LANCZOS):
    """A frame's picture at SIDE across, its height on a multiple of 32: all of a frame's pictures the same size."""
    height = max(32, round(picture.height * SIDE / picture.width / 32) * 32)
    return picture.resize((SIDE, height), resample)


SEA, SHALLOWS = (34, 78, 116), (64, 138, 150)   # the far level's water in its image 1, as a sea seen from high above:
                                # the deep blue, lighter towards turquoise where the game's water is lighter (the game's
                                # navy came out nearly black, one flat blue as a flat sheet)
FAR_BLUR = 5                    # pixels at SIDE: a far image 1 blurred so: its textures gone, its roads and towns faint
FAR_COLOUR = 0.65               # and its colours toned down so: the model copied the game's textures and saturation


def sea_of(colours):
    """The game's water (its colours, n x 3) as a sea seen from high above: deep where the game's is darkest, its
    shallows lighter."""
    light = colours.astype(np.float32).mean(-1, keepdims=True)
    low, high = (np.percentile(light, 5), np.percentile(light, 95)) if light.size else (0, 1)
    share = ((light - low) / max(high - low, 1.0)).clip(0, 1)
    return (np.array(SEA) * (1 - share) + np.array(SHALLOWS) * share).astype(np.uint8)


def far_inputs(folder, world, walking, continent, box):
    """A zone's far inputs in its frame, straight from above as its other levels (Saneroki, 2026-10-22: all three
    levels from straight above, every place where it lies in each): far-colours.png (image 1: its terrain, the
    water a sea's blue), far-height.png and far-water.png (the controls: its heights, the lines where the walking
    data's water meets land), far-walk.png (the water check's)."""
    plan, height = np.asarray(world.picture(continent, box, SIDE)).copy(), world.heights(continent, box, SIDE)
    walks, sea = walking.picture(continent, box, SIDE), np.isnan(height)
    water = ~sea & (np.asarray(walks) == SWIM)
    plan[water], plan[sea] = sea_of(plan[water]), SEA   # beyond the terrain the open sea
    framed(far_colours(Image.fromarray(plan))).save(folder / "far-colours.png")
    framed(height_map(height)).save(folder / "far-height.png")
    walk = framed(walks, Image.Resampling.NEAREST)
    walk.save(folder / "far-walk.png")
    guide_of(walk).save(folder / "far-water.png")


def height_map(height):
    """A control's depth seen from straight above: the highest ground white, the lowest dark, no terrain black."""
    known = ~np.isnan(height)
    low, high = (np.percentile(height[known], 1), np.percentile(height[known], 99)) if known.any() else (0, 1)
    shade = np.where(known, 40 + 215 * ((np.nan_to_num(height) - low) / max(high - low, 1.0)).clip(0, 1), 0)
    return Image.fromarray(shade.astype(np.uint8)).convert("RGB")


def far_colours(view):
    """A far image 1: its terrain blurred to where each land, forest, field, mountain, road, town and sea lies and
    its colours toned down; the controls keep the layout, the model paints the detail as a photograph shows it."""
    from PIL import ImageEnhance
    soft = view.convert("RGB").filter(ImageFilter.GaussianBlur(FAR_BLUR * view.width / SIDE))
    return ImageEnhance.Color(soft).enhance(FAR_COLOUR)


def tiles_of(path):
    """{tile key: minimap file ID} of a tiles.jsonl (the instances') or the master's set Tiles."""
    found = {}
    for line in open(path, encoding="utf-8"):
        row = json.loads(line)
        if row.get("minimap"):
            found[row["key"]] = row["minimap"]
    return found


# --- The walking data ----------------------------------------------------------------------------
# A zone's far painting keeps its lakes, rivers and seas roughly where the game has them: the walking data of
# Core's set Walking (dev/tools/walk-data: per terrain tile of the continents, the rectangles of floors a player
# can walk or swim on, from what the game collides with) drawn in the zone's frame. Instances have none.

NOWHERE, BARRED, SWIM, WALKED = 0, 85, 170, 255   # a walking picture's shades: no data, nobody walks, water, floors


def cbor(data, at=0):
    """One item of a walking block (CBOR of whole numbers and arrays only) and where the next begins."""
    major, info = data[at] >> 5, data[at] & 31
    at += 1
    if info >= 24:
        size = 1 << (info - 24)
        info, at = int.from_bytes(data[at:at + size], "big"), at + size
    if major == 4:
        items = []
        for _ in range(info):
            item, at = cbor(data, at)
            items.append(item)
        return items, at
    return (info if major == 0 else -1 - info), at


class Walking:
    """The set Walking's blocks by tile key: [format, surfaces (count, kind, region), rectangles (column, row,
    width, height, z), openings]."""

    def __init__(self, path=WALK):
        self.blocks = {}
        if Path(path).is_file():
            for line in open(path, encoding="utf-8"):
                row = json.loads(line)
                if row.get("block"):
                    self.blocks[row["key"]] = row["block"]

    def picture(self, map_id, box, width):
        """Where a player walks (WALKED), swims (SWIM) or cannot be (BARRED) in a box, width pixels across, as
        Ground.picture draws the terrain; NOWHERE where the data has no tile."""
        from PIL import ImageDraw
        k, left, top, height = frame_of(box, width)
        canvas = Image.new("L", (width, height), NOWHERE)
        draw, size = ImageDraw.Draw(canvas), TILE * k
        for row in range(int(top // size), int((top + canvas.height) // size) + 1):
            for column in range(int(left // size), int((left + width) // size) + 1):
                text = self.blocks.get(map_id * GRID * GRID + row * GRID + column)
                if not text:
                    continue
                _, surfaces, rects, _ = cbor(zlib.decompress(base64.b64decode(text), -15))[0]
                x0, y0, step = column * size - left, row * size - top, size / 256
                draw.rectangle([x0, y0, x0 + size, y0 + size], fill=BARRED)
                n = 0
                for count, kind in zip(surfaces[0::3], surfaces[1::3]):
                    for c, r, w, h, _ in zip(*[iter(rects[n * 5:(n + count) * 5])] * 5):
                        u, v = x0 + c * step, y0 + r * step
                        draw.rectangle([u, v, max(u, u + w * step - 1), max(v, v + h * step - 1)],
                                       fill=SWIM if kind == 2 else WALKED)
                    n += count
        return canvas


def guide_of(walk):
    """The far level's water guide (a control's lines): white lines on black where water meets land (coasts,
    lakes and rivers), as the walking data in the frame has them, nothing along the edge of what the data
    covers. Only the water: drawn around them too, mountains came out as lakes; the heights hold them."""
    shades = np.asarray(walk.convert("L")).astype(int)
    known = at.shrink(shades >= BARRED // 2, 2)
    water = at.grow(at.shrink(np.abs(shades - SWIM) < 20, 1), 1)
    lines = (water ^ at.shrink(water, 1)) & known
    return Image.fromarray((at.grow(lines, 1) * 255).astype(np.uint8)).convert("RGB")


EDGES = 0.96                    # an instance's far guide: the plan's edges stronger than so many of its pixels' (at
                                # 0.92, with the control at 0.8 to 60 %, Zul'Farrak came back as its game terrain; the
                                # control now 0.35 to 30 %)


def edges_of(view):
    """An instance's far guide (a control's lines; it has no walking data): white lines on black along the plan's
    clear edges, its walls, halls, shores and cliffs, the textures' fine edges left out."""
    grey = np.asarray(view.convert("L").filter(ImageFilter.GaussianBlur(3 * view.width / SIDE))).astype(np.float32)
    strength = np.hypot(np.diff(grey, axis=1, append=grey[:, -1:]), np.diff(grey, axis=0, append=grey[-1:]))
    return Image.fromarray(((strength > np.quantile(strength, EDGES)) * 255).astype(np.uint8)).convert("RGB")


def water_check(walk, painting):
    """A far painting's water against the walking data's in the same view: at.check's added and lost."""
    shades = np.asarray(walk.convert("L"))
    sheet = lambda mask: at.small(mask.astype(np.uint8) * 255) > 127
    return at.check(None, painting, game=sheet(np.abs(shades.astype(int) - SWIM) < 20),
                    unknown=sheet(shades < BARRED // 2), stray=FAR_STRAY)


# --- The game's map art ---------------------------------------------------------------------------

def zone_art(uimap, tables, mapart):
    """A zone's full map (with the parts the game reveals once explored), flattened on its own paper."""
    rows = {name: ta.table(tables, name) for name in ("UiMapXMapArt", "UiMapArt", "UiMapArtStyleLayer", "UiMapArtTile",
                                                       "WorldMapOverlay")}
    rows["parts"] = {}
    for row in ta.table(tables, "WorldMapOverlayTile"):
        if row["LayerIndex"] == "0" and int(row["FileDataID"]) > 0:
            rows["parts"].setdefault(row["WorldMapOverlayID"], []).append(row)
    picture = ta.full(uimap, rows, mapart)
    return parchment_around(flat(picture), ZONE_FRAME) if picture else None


def floors_of_set():
    found = {}
    for line in SET.open(encoding="utf-8"):
        entry = json.loads(line)
        tiles = entry.get("tiles", [])
        found[int(entry["key"])] = [
            {"floor": f["floor"], "name": f.get("name") or "", "size": (f["width"], f["height"]), "tile": f["tile"],
             "tiles": [(t["row"], t["column"], t["file"]) for t in tiles if t["floor"] == f["floor"]],
             "box": (f["north"], f["south"], f["west"], f["east"])}
            for f in sorted(entry.get("floors", []), key=lambda f: f["floor"])]
    return found


def floor_art(floor, mapart):
    """An instance floor's map art in its frame, its frame and title banner made parchment."""
    width, height = floor["size"]
    picture = Image.new("RGBA", (width, height))
    for row, column, file in floor["tiles"]:
        with Image.open(mapart / f"{file}.blp") as texture:
            picture.paste(texture.convert("RGBA").resize((floor["tile"], floor["tile"])),
                          (column * floor["tile"], row * floor["tile"]))
    return parchment_around(flat(picture), FLOOR_FRAME)


PARCHMENT = (148, 107, 32)      # the middle level's paper where a place has no map of its own: the yellow-orange of the
                                # game's maps (Saneroki, 2026-10-22; their land's median colour)
DARKEST, LIGHTEST = 0.8, 0.45   # the paper's grain from its tone darkened so to its tone lightened so, so the pencil reads


def tone_of(art):
    """The main colour of a game map's land (Saneroki, 2026-10-22: each zone in its own colours, greenish,
    yellowish, reddish, whitish): the median of its pixels that are neither water's grey-blue nor near black."""
    pixels = np.asarray(art.convert("RGB")).reshape(-1, 3).astype(np.float32)
    land = pixels[(pixels[:, 2] < pixels[:, 0] + 12) & (pixels.max(1) > 50)]
    return tuple(int(c) for c in np.median(land, 0)) if len(land) else PARCHMENT


LAND_TINT = 0.6                 # a zone's parchment: the game maps' yellow-orange blended so far towards its land's colour,
LAND_COLOUR = 1.5               # and that colour made so much stronger


def land_tone(ground, key):
    """A zone's parchment tone (Saneroki, 2026-10-22: the middle level's zones greenish, yellowish, reddish,
    whitish by what they are): the median colour of its terrain inside its outline, its water left out, blended
    into the game maps' yellow-orange; the game's own maps share one ochre (their medians differ by a few shades)."""
    outline = OUTLINES / f"{key}.blp"
    pixels = np.asarray(ground.convert("RGB")).reshape(-1, 3).astype(np.float32)
    inside = np.ones(len(pixels), bool)
    if outline.is_file():
        with Image.open(outline) as mask:
            inside = np.asarray(mask.getchannel("A").resize(ground.size, Image.Resampling.BILINEAR)).reshape(-1) > 127
    land = pixels[inside & (pixels[:, 2] < pixels[:, 0] + 12) & (pixels.max(1) > 30)]
    if not len(land):
        return PARCHMENT
    blend = np.array(PARCHMENT) * (1 - LAND_TINT) + np.median(land, 0) * LAND_TINT
    hue, saturation, value = colorsys.rgb_to_hsv(*(blend / 255))   # its colour stronger, so each zone reads as its own
    return tuple(int(c * 255) for c in colorsys.hsv_to_rgb(hue, min(1.0, saturation * LAND_COLOUR), value))


def parchment(size, tone=PARCHMENT):
    """The house paper's grain in a tone, size large."""
    with Image.open(PAPER) as paper:
        grain = np.asarray(paper.convert("L").resize(size, Image.Resampling.LANCZOS)).astype(np.float32)
    low, high = np.percentile(grain, 2), np.percentile(grain, 98)
    share = ((grain - low) / max(high - low, 1.0)).clip(0, 1)[..., None]
    colour = np.array(tone, np.float32)
    dark, light = colour * DARKEST, colour + (255 - colour) * LIGHTEST
    return Image.fromarray((dark + (light - dark) * share).astype(np.uint8))


def parchment_around(picture, frame):
    """The picture with all outside the map (frame: its part, left, top, right, bottom) made parchment in the
    map's own tone, softly: no frame, banner or ornament reaches the model."""
    sheet = parchment(picture.size, tone_of(picture.crop(tuple(round(f * picture.size[i % 2]) for i, f in enumerate(frame)))))
    inside = Image.new("L", picture.size, 0)
    inside.paste(255, tuple(round(f * picture.size[i % 2]) for i, f in enumerate(frame)))
    return Image.composite(picture, sheet, inside.filter(ImageFilter.GaussianBlur(8)))


def flat(picture):
    under = Image.new("RGBA", picture.size, (180, 160, 120, 255))
    under.alpha_composite(picture.convert("RGBA"))
    return under.convert("RGB")


# --- The words ------------------------------------------------------------------------------------

def light(brief):
    return brief["atmosphere"].split(". ")[0].rstrip(".")


COMPASS = ("east", "north-east", "north", "north-west", "west", "south-west", "south", "south-east")
AROUND = 0.05                   # a neighbouring zone is named in a far painting's words where its box covers so much of
NEIGHBOURS = 4                  # the view, the largest so many: else the model paints the zone's own land all over it


def around_of(subject, found, briefs):
    """The zones around a zone in its frame, the largest first: [(direction from it, uiMapID)]."""
    north, south, west, east = subject["box"]
    middle = ((subject["box"][0] + subject["box"][1]) / 2, (subject["box"][2] + subject["box"][3]) / 2)
    near = []
    for uimap, (continent, box, _) in found.items():
        if continent != subject["map"] or uimap == subject["key"] or str(uimap) not in briefs:
            continue
        share = (max(0, min(north, box[0]) - max(south, box[1])) * max(0, min(west, box[2]) - max(east, box[3]))
                 / ((north - south) * (west - east)))
        if share >= AROUND:
            angle = math.atan2((box[0] + box[1]) / 2 - middle[0], middle[1] - (box[2] + box[3]) / 2)
            near.append((share, COMPASS[round(math.degrees(angle) / 45) % 8], uimap))
    return [(direction, uimap) for _, direction, uimap in sorted(near, reverse=True)[:NEIGHBOURS]]


def words_of(level, words, brief, instance, around=()):
    """A painting's words. The middle level: its pictures, look and last sentence, no brief (its words drew what
    the brief names, a ship on a mine's floor). The far level: its pictures and look, open (instances), the brief,
    the lands around it (around: [(direction, their kind of place)]), its last sentence."""
    said = words[level]
    if level == "middle":
        plan = brief.get("_style_only")
        return " ".join([said["images_plan" if plan else "images"], said["look_plan" if plan else "look"], said["last"]])
    parts = [said["images"], said["look"]] if instance else [said["images_zone"], said["look_zone"]]
    if instance:
        parts.append(said["open"])
    parts.append(f"This place is {brief['biome'][0].lower() + brief['biome'][1:]}.")
    for field in ("land", "plants", "buildings", "roads", "places"):
        if brief.get(field):
            parts.append(brief[field])
    parts += [f"Its colours: {brief['colours']}.", f"Its light: {light(brief)}."]
    if around:
        parts.append(said["around"] + " " + "; ".join(f"to the {d}, {kind[0].lower() + kind[1:]}" for d, kind in around) + ".")
    parts.append(said["last"])
    return " ".join(part.strip() for part in parts)


# --- The checks -----------------------------------------------------------------------------------

def outlines(picture):
    """A picture's edges at OUTLINE pixels across, normalised: what two pictures of one layout share."""
    small = picture.convert("L").resize((OUTLINE, max(1, round(OUTLINE * picture.height / picture.width))),
                                        Image.Resampling.BOX).filter(ImageFilter.GaussianBlur(1))
    grey = np.asarray(small, np.float32)
    gy, gx = np.gradient(grey)
    edges = np.asarray(Image.fromarray(np.hypot(gx, gy).clip(0, 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(2)),
                       np.float32)
    return (edges - edges.mean()) / (edges.std() + 1e-6)


def agreement(a, b):
    """How well two pictures' outlines agree, -1 to 1 (their normalised correlation)."""
    ea, eb = outlines(a), outlines(b.resize(a.size))
    return float((ea * eb).mean())


def look_words(level, brief):
    if level == "middle":
        return ("Look at this picture. Answer with JSON only, no other words: "
                '{"writing": true or false (any letters, words, numbers or labels anywhere in it), '
                '"pencil_map": true or false (a map drawn by hand in pencil and ink on tinted parchment), '
                '"from_above": true or false (seen straight from above, like a map)}')
    return ("Look at this picture. Answer with JSON only, no other words: "
            '{"writing": true or false (any letters, words, numbers or labels anywhere in it), '
            '"map_or_drawing": true or false (a drawn or painted map with map symbols, or a plan or drawing on paper; '
            'an aerial photograph of a real-looking place is not a map), '
            '"panels": true or false (split into separate panels, frames or tiles rather than one picture), '
            '"from_above": true or false (a view straight down from high above, the land laid out below like a map), '
            f'"is_it": true or false (is it the right kind of place: {brief["biome"]}; details may differ)' + "}")


def verdict(level, text):
    found = re.search(r"\{.*\}", text or "", re.S)
    try:
        seen = json.loads(found.group(0)) if found else {}
    except json.JSONDecodeError:
        seen = {}
    if level == "middle":
        ok = seen.get("writing") is False and seen.get("pencil_map") is True and seen.get("from_above") is True
    else:
        ok = (seen.get("writing") is False and seen.get("map_or_drawing") is False and seen.get("panels") is False
              and seen.get("from_above") is True and seen.get("is_it") is True)
    return ok, seen


# --- ComfyUI --------------------------------------------------------------------------------------

def reachable():
    try:
        urllib.request.urlopen(ig.Server(ADDRESS).url + "/queue", timeout=3).close()
        return True
    except OSError:
        return False


def start_comfyui():
    if reachable():
        return
    if shutil.which("comfyui"):
        subprocess.run(["comfyui", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(60):
            if reachable():
                return
            time.sleep(2)
    sys.exit(f"ComfyUI is not reachable at {ADDRESS}: comfyui start")


def run_one(server, workflow, refs, prompt, name, seed, settings):
    """One picture, or one answer, from ComfyUI: (picture or None, text or None)."""
    graph = json.loads(ig.find_workflow(workflow).read_text())
    uploaded = {path: server.upload(path) for path in refs}
    entry = server.wait(server.queue(ig.fill(graph, {"prompt": prompt, "name": name, "refs": refs}, seed, settings,
                                             uploaded)))
    if entry.get("status", {}).get("status_str") == "error":
        raise RuntimeError(f"ComfyUI failed on {name}: {json.dumps(entry.get('status'))[:300]}")
    text = next((t for output in entry.get("outputs", {}).values() for t in output.get("text", [])), None)
    data = next(server.pictures(entry), None)
    for output in entry.get("outputs", {}).values():
        for image in output.get("images", []):
            (COMFY / "output" / image.get("subfolder", "") / image.get("filename", "-")).unlink(missing_ok=True)
    for name_ in uploaded.values():
        (COMFY / "input" / name_).unlink(missing_ok=True)
    return (Image.open(io.BytesIO(data)).convert("RGB") if data else None), text


