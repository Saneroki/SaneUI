        "angry": "[angry]", "menacing": "[menacing]", "grateful": "[warmly]", "proud": "[proudly]",
        "mysterious": "[mysteriously]", "solemn": "[solemnly]", "excited": "[excited]", "humorous": "[amused]",
        "weary": "[tired]", "stern": "[sternly]"}
PACE = {"urgent": "fast", "excited": "brisk", "angry": "brisk", "fearful": "brisk", "menacing": "measured",
        "grieving": "slow", "solemn": "slow", "mysterious": "slow", "weary": "slow"}
STAGE = {  # tone when the words say nothing, base intensity, volume
    "offer": ("earnest", 2, "normal"), "objectives": ("plain", 1, "normal"), "progress": ("expectant", 2, "normal"),
    "complete": ("grateful", 2, "normal"), "greeting": ("friendly", 2, "normal"), "trainer": ("friendly", 2, "normal"),
    "gossip": ("friendly", 2, "normal"), "say": ("plain", 2, "normal"), "yell": ("urgent", 4, "shout"),
    "zone yell": ("urgent", 5, "shout"), "whisper": ("mysterious", 2, "whisper"), "page": ("plain", 1, "normal"),
    "mail": ("warm", 2, "normal"),
}


def analyse(text, stage, speaker):
    scores = collections.Counter({tone: len(rx.findall(text)) for tone, rx in LEX.items()})
    hostile = speaker.get("side") == "hostile"
    if hostile:
        scores["menacing"] += scores["angry"] + (1 if stage in ("yell", "zone yell") else 0)
    if stage == "complete":
        scores["grateful"] += 1
    tone, hits = scores.most_common(1)[0]
    base, intensity, volume = STAGE.get(stage, ("plain", 2, "normal"))
    if hits == 0 or (hits == 1 and tone == "stern") or (hits == 1 and tone == "solemn" and stage == "complete"):
        tone = "menacing" if hostile and stage in ("yell", "zone yell", "say") else base
    bangs = text.count("!")
    intensity += min(2, bangs) + (1 if tone in ("angry", "menacing", "fearful", "urgent", "grieving") else 0)
    intensity += 1 if speaker.get("rank") == "boss" else 0
    intensity = max(1, min(5, intensity))
    words = len(text.split())
    sentences = max(1, len(re.findall(r"[.!?]+", text)))
    pace = PACE.get(tone, "measured")
    if pace == "measured" and words / sentences < 8 and bangs:
        pace = "brisk"
    register = next((name for name, rx in REGISTER if len(rx.findall(text)) >= (1 if name == "archaic" else 2)), "plain")
    if tone == "grieving" and volume == "normal":
        volume = "soft"
    return {"tone": tone, "intensity": intensity, "pace": pace, "register": register, "volume": volume,
            "questions": text.count("?"), "pauses": text.count("...") + text.count("--")}


def direction(a, sp, stage, preset):
    who = " ".join(x for x in (sp.get("name"),) if x) or "The speaker"
    title = f", {sp['title']}" if sp.get("title") else ""
    what = {"offer": "asking the player for help", "progress": "checking how the task goes",
            "complete": "taking the finished task", "greeting": "greeting the player", "trainer": "greeting a student",
            "gossip": "talking to the player", "say": "speaking aloud", "yell": "yelling", "zone yell": "yelling for all to hear",
            "whisper": "whispering", "page": "read from a written text", "mail": "read from a letter",
            "objectives": "summing up the task"}.get(stage, "speaking")
    return (f"{who}{title} ({preset}), {what}: {a['tone']}, {a['pace']}, {a['volume']} voice, "
            f"intensity {a['intensity']} of 5, {a['register']} speech.")


# --- building ------------------------------------------------------------------------------------

def load_staging(paths):
    sets = collections.defaultdict(dict)
    for path in paths:
        for line in open(path, encoding="utf-8"):
            e = json.loads(line)
            sets[e["set"]][e["key"]] = e
    return sets


def load_jsonl(pattern):
    out = {}
    for path in sorted(glob.glob(pattern)):
        for n, line in enumerate(open(path, encoding="utf-8"), 1):
            if line.strip():
                e = json.loads(line)
                out[e["key"]] = e
    return out


def digest(text):
    return hashlib.sha1(text.encode("utf-8")).hexdigest()[:12]


def stage_of(f):
    if f["kind"] == "quest":
        return f["part"]
    if f["kind"] == "broadcast":
        return "gossip" if "gossip" in f.get("uses", []) and f.get("chat") == "say" else f.get("chat", "say")
    return f["kind"]


def build(paths):
    presets, errors = read_cast()
    names, nerrors = read_names()
    if errors or nerrors:
        sys.exit("\n".join(errors + nerrors))
    sets = load_staging(paths)
    speakers = {k: e["fields"] for k, e in sets["VoiceSpeakers"].items()}
    quests = {int(k): e["fields"] for k, e in sets["VoiceQuests"].items()}
    zones = {int(k): e["fields"] for k, e in sets["VoiceZones"].items()}
    fixes = load_jsonl(os.path.join(VOICES, "fixes.jsonl"))
    directed = load_jsonl(os.path.join(VOICES, "analysis", "*.jsonl"))
    lines = []
    for key, e in sorted(sets["VoiceLines"].items(), key=lambda kv: kv[0]):
        f = e["fields"]
        stage = stage_of(f)
        voice, why_not = True, None
        if stage in ("emote", "boss emote", "zone emote"):
            voice, why_not = False, "an emote: told, not said"
        elif f.get("voiced"):
            voice, why_not = False, "the game voices it already"
        elif FILLER.match(f["text"]):
            voice, why_not = False, "a filler text of the game's data"
        elif stage == "objectives":
            voice, why_not = False, "the objectives: shown, not said (a choice)"
        keys = f.get("speakers") or []
        if not keys and f["kind"] in ("page", "mail"):
            keys = ["reader"]
        if not keys and voice:
            voice, why_not = False, "nobody known says it"
        if key in fixes and "voice" in fixes[key]:
            voice, why_not = fixes[key]["voice"], "a hand fix"
        main = keys[0] if keys else None
        sp = speakers.get(main, {}) if main != "reader" else {"name": "The reader", "type": "book"}
        chosen, why, flags = ([], "nobody", [])
        if main == "reader":
            chosen, why = ["reader"], "a written text"
        elif main:
            seen = []
            for k in keys:
                p, w, fl = preset_for(k, speakers.get(k, {}), presets, fixes)
                if k == main:
                    why, flags = w, fl
                seen += [x for x in p if x not in seen]
            chosen = seen
        q = quests.get(f.get("quest"), {})
        zone = zones.get(f.get("zone") or q.get("zone") or 0, {})
        context = {k: v for k, v in {
            "quest": f.get("quest"), "title": q.get("title"), "level": q.get("level"), "quest kind": q.get("kind"),
            "side": q.get("side"), "zone": zone.get("name"), "chain": bool(q.get("prev") or q.get("next")),
            "book": f.get("book"), "page": f.get("page"), "chat": f.get("chat"), "language": f.get("language"),
            "in this client": q.get("forever") if f.get("quest") else None}.items() if v not in (None, False, "")}
        texts = parts_of(f["text"])
        variants = ["male", "female"] if GENDER.search(f["text"]) else [None]
        for n, part in enumerate(texts, 1):
            pkey = f"{key}#{n}" if len(texts) > 1 else key
            words = {}
            review = list(flags)
            actions = []
            for v in variants:
                s, act, rv = speakable(part, v or "male")
                words[v or "any"] = s
                actions = act
                review += [r for r in rv if r not in review]
            text = next(iter(words.values())) or ""
            line_voice, line_why = (voice, why_not) if text else (False, why_not or "nothing left to say")
            a = analyse(text, stage, sp)
            tags = [t for rx, t in ACTION_TAGS for act in actions if rx.search(act)][:1]
            if a["volume"] == "whisper":
                tags.append("[whispers]")
            elif a["volume"] == "shout":
                tags.append("[shouting]")
            if a["tone"] in TAGS and a["intensity"] >= 2:
                tags.insert(0, TAGS[a["tone"]])
            a["tags"] = list(dict.fromkeys(tags))[:2]
            a["source"] = "rules"
            hand = directed.get(pkey)
            if hand and hand.get("hash") == digest(part):
                for k, val in hand.items():
                    if k not in ("key", "hash", "fix"):
                        a[k] = val
                a["source"] = hand.get("source", "llm")
                if hand.get("fix") and len(words) == 1:
                    words = {next(iter(words)): hand["fix"]}
                    review.append("mended by its direction")
            elif hand:
                review.append("its direction was made for an older text")
            base = presets.get(chosen[0], {}) if chosen else {}
            stability = base.get("stability", 0.5) - 0.05 * (a["intensity"] - 2)
            a["stability"] = round(max(0.25, min(0.85, stability)), 2)
            if "direction" not in a or a["source"] == "rules":
                a["direction"] = direction(a, sp, stage, chosen[0] if chosen else "nobody")
            unknown = sorted({w for w in (re.sub(r"'s$", "", c) for c in NAMELIKE.findall(text))
                              if ("'" in w or re.search(r"[a-z][A-Z]", w)) and not CONTRACTION.search(w)
                              and w not in names})
            chars = sum(len(s) + sum(len(t) + 1 for t in a["tags"]) for s in words.values())
            lines.append({
                "key": pkey, "text key": key, "part": n, "parts": len(texts), "kind": f["kind"], "stage": stage,
                "voice": line_voice, "why not": line_why, "text": part, "speech": words, "actions": actions,
                "hash": digest(part), "speaker": main, "speakers": keys,
                "who": {k: v for k, v in sp.items() if k in ("name", "title", "race", "sex", "model", "type", "rank", "side", "roles", "class", "caster", "level")},
                "presets": chosen, "why preset": why, "context": context, "analysis": a,
                "names": [w for w in names if re.search(rf"(?<![A-Za-z']){re.escape(w)}(?![A-Za-z])(?!'(?!s\b))", text)],
                "unknown names": unknown, "review": review,
                "chars": chars * max(1, len(chosen)), "src": e["src"],
            })
    for i, line in enumerate(lines):          # neighbours, for the voice to keep its flow across parts
        if line["part"] > 1:
            line["previous"] = lines[i - 1]["key"]
        if line["part"] < line["parts"]:
            line["next"] = lines[i + 1]["key"]
    os.makedirs(OUT, exist_ok=True)
    with open(os.path.join(OUT, "lines.jsonl"), "w", encoding="utf-8") as fh:
        for line in lines:
            fh.write(json.dumps(line, ensure_ascii=False, sort_keys=True) + "\n")
    write_sqlite(lines, speakers, presets)
    used = collections.Counter(p for l in lines if l["voice"] for p in l["presets"])
    missing = sorted(p for p in used if p not in presets)
    print(f"voicedb: {len(lines)} lines ({sum(l['voice'] for l in lines)} voiced) from {len(sets['VoiceLines'])} texts; "
          f"{len(presets)} presets, {len(used)} in use; {len(names)} names")
    if missing:
        print("voicedb: presets in use that cast.md lacks: " + ", ".join(missing))
    stats(lines)


def write_sqlite(lines, speakers, presets):
    path = os.path.join(OUT, "voices.sqlite")
    if os.path.exists(path):
        os.remove(path)
    db = sqlite3.connect(path)
    db.execute("create table lines (key text primary key, text_key text, kind text, stage text, voice int, "
               "speaker text, preset text, tone text, intensity int, pace text, volume text, register text, "
               "chars int, zone text, quest int, title text, text text, speech text, review text, line text)")
    db.execute("create table speakers (key text primary key, name text, title text, race text, sex text, "
               "model text, rank text, side text, fields text)")
    db.execute("create table presets (id text primary key, race text, sex text, kind text, fields text)")
    db.executemany("insert into lines values (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [(
        l["key"], l["text key"], l["kind"], l["stage"], int(l["voice"]), l["speaker"], ",".join(l["presets"]),
        l["analysis"]["tone"], l["analysis"]["intensity"], l["analysis"]["pace"], l["analysis"]["volume"],
        l["analysis"]["register"], l["chars"], l["context"].get("zone"), l["context"].get("quest"),
        l["context"].get("title"), l["text"], json.dumps(l["speech"], ensure_ascii=False), "; ".join(l["review"]),
        json.dumps(l, ensure_ascii=False)) for l in lines])
    db.executemany("insert into speakers values (?,?,?,?,?,?,?,?,?)", [(
        k, v.get("name"), v.get("title"), v.get("race"), v.get("sex"), v.get("model"), v.get("rank"), v.get("side"),
        json.dumps(v, ensure_ascii=False)) for k, v in speakers.items()])
    db.executemany("insert into presets values (?,?,?,?,?)", [(
        k, v.get("race"), v.get("sex"), v.get("kind"), json.dumps(v, ensure_ascii=False)) for k, v in presets.items()])
    db.commit()
    db.close()


def read_lines():
    path = os.path.join(OUT, "lines.jsonl")
    if not os.path.exists(path):
        sys.exit("voicedb: no database yet: dev/tools/voicedb build")
    return [json.loads(l) for l in open(path, encoding="utf-8")]


def stats(lines=None):
    lines = lines or read_lines()
    voiced = [l for l in lines if l["voice"]]
    chars = sum(l["chars"] for l in voiced)
    print(f"\n{len(voiced)} of {len(lines)} lines voiced, {chars:,} characters with every variant "
          f"(about {chars / 900 / 60:.0f} hours of speech)")
    print("  cost: " + ", ".join(f"{name} model about ${chars / 1000 * rate:,.0f}" for name, rate in PRICE.items()))
    by = collections.Counter()
    for l in voiced:
        by[l["stage"]] += l["chars"]
    print("  by stage: " + ", ".join(f"{s} {c / 1e6:.2f}M" for s, c in by.most_common()))
    why = collections.Counter(l["why not"] for l in lines if not l["voice"])
    print("  not voiced: " + ", ".join(f"{n} {w}" for w, n in why.most_common()))
    tones = collections.Counter(l["analysis"]["tone"] for l in voiced)
    print("  tones: " + ", ".join(f"{t} {n}" for t, n in tones.most_common()))
    presets = collections.Counter(p for l in voiced for p in l["presets"])
    print(f"  presets: {len(presets)} in use; most: " + ", ".join(f"{p} {n}" for p, n in presets.most_common(12)))
    review = collections.Counter(r.split(":")[0] for l in voiced for r in l["review"])
    print("  to look at: " + ", ".join(f"{n} {r}" for r, n in review.most_common(10)))


def show(query):
    lines = read_lines()
    hits = [l for l in lines if l["key"] == query or l["text key"] == query]
    if not hits:
        q = query.lower()
        hits = [l for l in lines if q in l["text"].lower() or q in (l["who"].get("name") or "").lower()][:10]
    for l in hits:
        print(json.dumps(l, ensure_ascii=False, indent=2))
    if not hits:
        print("voicedb: nothing found")


def request(key, model="newest"):
    """The request the voice tool sends for a line (and each variant), without sending anything."""
    lines = {l["key"]: l for l in read_lines()}
    keys = [key] if key in lines else [k for k, l in lines.items() if l["text key"] == key]
    if not keys:
        sys.exit(f"voicedb: no line {key}")
    print(json.dumps(requests(lines, keys, model), ensure_ascii=False, indent=2))


def requests(lines, keys, model="newest"):
    """The requests for these lines, one per variant and preset (dev/tools/voicegen sends them).
    lines: every line by key, for the neighbouring parts."""
    presets, _ = read_cast()
    names, _ = read_names()
    out = []
    for l, preset in ((lines[k], p) for k in keys for p in lines[k]["presets"]):
        key = l["key"]
        p = presets.get(preset, {})
        for variant, speech in l["speech"].items():
            tags = " ".join(l["analysis"]["tags"]) if model == "newest" else ""
            out.append({
                "line": key, "variant": variant, "preset": preset, "model": model,
                "text": (tags + " " + speech).strip(),
                "settings": {"stability": l["analysis"]["stability"], "similarity": p.get("similarity", 0.75),
                             "speed": p.get("speed", 1.0)},
                "previous text": (lines[l["previous"]]["speech"].get(variant) if l.get("previous")
                                  else l["analysis"].get("cue")),
                "next text": lines[l["next"]]["speech"].get(variant) if l.get("next") else None,
                "names": {n: names[n]["alias"] for n in l["names"]},
                "file": f"{key.replace(':', '-').replace('#', '-')}" + (f"-{variant}" if variant != "any" else "")
                        + (f"-{preset}" if len(l["presets"]) > 1 else "") + ".ogg",
                "direction": l["analysis"]["direction"],
            })
    return out


def batch(path, query=None, size=40):
    """Lines for a language model to direct: the line, its speaker and context, and the analysis so far."""
    lines = [l for l in read_lines() if l["voice"]]
    if query:
        q = query.lower()
        lines = [l for l in lines if q in json.dumps(l["context"]).lower() or q in l["key"] or
                 q in (l["who"].get("name") or "").lower()]
    with open(path, "w", encoding="utf-8") as fh:
        for l in lines:
            fh.write(json.dumps({"key": l["key"], "hash": l["hash"], "speaker": l["who"], "preset": l["presets"][:1],
                                 "stage": l["stage"], "context": l["context"], "text": l["speech"].get("any") or l["speech"]["male"],
                                 "actions": l["actions"], "rules": {k: l["analysis"][k] for k in ("tone", "intensity", "pace", "volume", "register")}},
                                ensure_ascii=False) + "\n")
    print(f"voicedb: {len(lines)} lines to {path}, in batches of {size} for the prompt in Doc/guides/voice-generation.md")


def unknown_names(top=60):
    count = collections.Counter(n for l in read_lines() if l["voice"] for n in l["unknown names"])
    for name, n in count.most_common(top):
        print(f"{n:6d}  {name}")


def check():
    presets, errors = read_cast()
    names, nerrors = read_names()
    for msg in errors + nerrors:
        print(msg)
    print(f"voicedb: {len(presets)} presets, {len(names)} names" + (", errors above" if errors + nerrors else ", all read"))
    return 1 if errors + nerrors else 0


if __name__ == "__main__":
    args = sys.argv[1:]
    cmd = args[0] if args else "help"
    if cmd == "build":
        build(args[1:] or sorted(glob.glob(os.path.join(STAGING, "*.jsonl"))) or
              sys.exit(f"voicedb: no staging files in {STAGING}"))
    elif cmd == "stats":
        stats()
    elif cmd == "show" and len(args) > 1:
        show(" ".join(args[1:]))
    elif cmd == "request" and len(args) > 1:
        request(args[1], args[2] if len(args) > 2 else "newest")
    elif cmd == "batch" and len(args) > 1:
        batch(args[1], args[2] if len(args) > 2 else None)
    elif cmd == "names":
        unknown_names(int(args[1]) if len(args) > 1 else 60)
    elif cmd == "check":
        sys.exit(check())
    else:
        sys.exit(__doc__)
