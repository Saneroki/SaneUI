def kind_of(sp):
    words = " ".join(x for x in (sp.get("title"), sp.get("name")) if x)
    if ELDER.search(words):
        return "elder", "the name or title"
    if MARTIAL.search(words):
        return "martial", "the name or title"
    if REFINED.search(words) or "leader" in sp.get("roles", []):
        return "refined", "the name or title"
    if sp.get("class") in CLASS_KIND:
        return CLASS_KIND[sp["class"]], f"its class ({sp['class']})"
    return "common", "the default"


def race_of(sp):
    """Race, sex and kind from the model, where the model says more than the race."""
    model = sp.get("model") or ""
    for rule in MODELS:
        if model == rule[0] or model.startswith(rule[0]):
            sex = next((x for x in rule[2:] if x in ("male", "female")), None)
            kind = next((x for x in rule[2:] if x not in ("male", "female")), None)
            if sp.get("race") in RACES and RACES[sp["race"]] in PLAYABLE:
                return RACES[sp["race"]], None, None
            return rule[1], sex, kind
    return RACES.get(sp.get("race") or ""), None, None


def preset_for(key, sp, presets, fixes):
    """The preset of a speaker, and why."""
    if key in fixes and "preset" in fixes[key]:
        return [fixes[key]["preset"]], "a hand fix", []
    kind_ = key.split(":")[0]
    if kind_ in ("object", "item"):
        name = sp.get("name") or ""
        return (["crier"], "a notice", []) if CRIER.search(name) else (["reader"], "a written text", [])
    race, sex, kind = race_of(sp)
    flags = []
    sexes = [sex] if sex else (["male", "female"] if sp.get("sex") == "mixed" else [sp.get("sex")])
    if sexes == [None]:
        sexes, _ = ["male"], flags.append("sex unknown")
    if not race:
        race = "human"
        flags.append("race unknown: as a human")
    why = f"{race}, {'/'.join(sexes)}"
    if race in PLAYABLE:
        kind, how = (kind, "its model") if kind else kind_of(sp)
        why += f", {kind} by {how}"
    out = []
    for s in sexes:
        for cand in ([f"{race}-{s}-{kind}", f"{race}-{s}-common"] if race in PLAYABLE else
                     [f"{race}-{s}", f"{race}-male", f"{race}-female", f"{race}-none"]):
            if cand in presets:
                out.append(cand)
                break
        else:
            flags.append(f"no preset for {race} {s}: as a human")
            out.append(f"human-{s}-common")
    return out, why, flags


# --- making a text ready to be said --------------------------------------------------------------

GENDER = re.compile(r"\$[Gg]\s*([^:;$]*?)\s*:\s*([^;$]*?)\s*;")
ACTION = re.compile(r"<([^<>]{1,300})>")
ACTION_TAGS = [(re.compile(r"(?i)sigh"), "[sighs]"), (re.compile(r"(?i)laugh|chuckle|giggle|grin"), "[laughs]"),
               (re.compile(r"(?i)whisper"), "[whispers]"), (re.compile(r"(?i)cough"), "[coughs]"),
               (re.compile(r"(?i)sob|weep|cr(?:y|ies)\b"), "[sobs]"), (re.compile(r"(?i)clears? (?:his|her) throat"), "[clears throat]")]
WORD = {"N": None, "C": "adventurer", "R": "traveler"}
FILLER = re.compile(r"(?i)^\s*(?:missing text|text missing|placeholder|test|todo|tbd|\.+|<?unused>?)\s*[.!]?\s*$")


def speakable(text, player_sex):
    """The words to say: placeholders resolved or left out, stage directions taken out. Gives the text,
    the stage directions, and what needs a look by hand."""
    review = []
    text = GENDER.sub(lambda m: m.group(1) if player_sex == "male" else m.group(2), text)
    actions = [a.strip() for a in ACTION.findall(text)]
    text = ACTION.sub(" ", text)
    text = re.sub(r"\$[Bb]", " ", text)
    for letter, word in WORD.items():
        token = rf"\$[{letter}{letter.lower()}]"
        text = re.sub(rf",\s*{token}(?=\s*[.,!?;:])", "", text)                 # "Greetings, $N." -> "Greetings."
        text = re.sub(rf"(^|[.!?]\s+){token},\s*(\w)", lambda m: m.group(1) + m.group(2).upper(), text)
        if re.search(token, text):
            if word:
                text = re.sub(token, word, text)
                review.append(f"${letter} said as \"{word}\"")
            else:
                text = re.sub(token, "friend", text)
                review.append("the name said as \"friend\"")
    text = re.sub(r"\b([Aa]) (adventurer)", lambda m: ("An" if m.group(1) == "A" else "an") + " " + m.group(2), text)
    text = re.sub(r"\s+", " ", text).strip()
    text = re.sub(r"\s+([.,!?;:])", r"\1", text)
    if "$" in text:
        review.append("a placeholder left")
    return text, actions, review


NAMELIKE = re.compile(r"\b[A-Z][a-z]*'[A-Za-z]+\b|\b[A-Z][a-z]+[A-Z][a-z]+\b")   # Kel'Thuzad, VanCleef
CONTRACTION = re.compile(r"(?i)'(?:s|m|d|ll|ve|re|t)$")
SHORT = 60      # characters: a shorter part joins its neighbour, so the voice does not stop and start


def parts_of(text):
    """A text in parts: its paragraphs ($B$B or blank lines). A part that is only a stage direction, or
    very short, joins the next one; a very short last part joins the one before."""
    raw = [p.strip() for p in re.split(r"(?:\$[Bb]\s*){2,}|\n\s*\n", text) if p.strip()]
    out = []
    for p in raw:
        last = out[-1] if out else None
        if last is not None and (len(last) < SHORT or not ACTION.sub("", last).strip()):
            out[-1] = last + " " + p
        else:
            out.append(p)
    if len(out) > 1 and len(ACTION.sub("", out[-1]).strip()) < SHORT:
        out[-2:] = [out[-2] + " " + out[-1]]
    return out or [text]


