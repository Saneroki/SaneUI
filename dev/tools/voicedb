# --- the cast and the names ----------------------------------------------------------------------

FIELD = re.compile(r"^- \*\*(.+?):\*\* ?(.*)$")
NUMBERS = ("Stability", "Similarity", "Speed")


def read_cast(path=os.path.join(VOICES, "cast.md")):
    """The presets: a section `## <id>` with `- **Field:** value` lines; sections without a race are notes."""
    presets, current, errors = {}, None, []
    for n, line in enumerate(open(path, encoding="utf-8"), 1):
        line = line.rstrip("\n")
        if line.startswith("## "):
            current = {"id": line[3:].strip(), "line": n}
            presets[current["id"]] = current
        elif current and FIELD.match(line):
            name, value = FIELD.match(line).groups()
            current[name.lower()] = float(value) if name in NUMBERS else value.strip()
    presets = {k: v for k, v in presets.items() if "race" in v}
    for p in presets.values():
        for need in ("sex", "kind", "design prompt", "design text", "stability", "similarity", "speed"):
            if need not in p:
                errors.append(f"cast.md:{p['line']}: {p['id']} has no {need}")
        if not 20 <= len(p.get("design prompt", "")) <= 1000:
            errors.append(f"cast.md:{p['line']}: {p['id']}: the design prompt must have 20 to 1000 characters")
        if not 100 <= len(p.get("design text", "")) <= 1000:
            errors.append(f"cast.md:{p['line']}: {p['id']}: the design text must have 100 to 1000 characters")
    return presets, errors


def read_names(path=os.path.join(VOICES, "names.md")):
    """Table rows `| Name | Say | IPA | Note |` under any heading."""
    names, errors = {}, []
    if not os.path.exists(path):
        return names, errors
    for n, line in enumerate(open(path, encoding="utf-8"), 1):
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if not line.startswith("|") or len(cells) < 2 or cells[0] in ("Name", "") or set(cells[0]) <= set("-: "):
            continue
        name, say = cells[0], cells[1]
        ipa = cells[2] if len(cells) > 2 else ""
        if not say:
            errors.append(f"names.md:{n}: {name} has no way to say it")
            continue
        alias = say.replace("-", "").lower()
        names[name] = {"alias": alias[:1].upper() + alias[1:], "say": say, "ipa": ipa.strip("/[] ") or None}
    return names, errors


