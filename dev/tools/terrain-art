SHALLOW = 1.0      # yards of water over the ground in which the land fades out: a beach a wader stands on stays
BUILT = 20         # how much brighter or warmer than its water a sample of the minimap is where something stands on it
WATERS = 8         # samples (some 17 yards) each way around a sample its water's colour is taken from
COAST = 128        # a tile's own mask on a coast, texels a side: four times the overview's detail
RIM = 3            # map chunks along a tile's side that faces no tile in which nothing is land: the world's rim, where
                   # the game left the sea floor unsculpted and dry, or its minimap a grey band (Saneroki, 2026-11-15:
                   # "only show like single lines etc that need to be removed"); no real land lies within 4 of one

ZONE, CONTINENT, WORLD = "3", "2", "1"  # the game's kinds of map (UiMap's Type)


def tiles(maps=None):
    """{(continent, row, column): file ID} from the master's newest lines; of those maps only, if given."""
    found = {}
    for line in TILES.read_text(encoding="utf-8").splitlines():
        row = json.loads(line)
        key, file = row["key"], row.get("minimap")
        place = (key // (GRID * GRID), key % (GRID * GRID) // GRID, key % GRID)
        if maps and place[0] not in maps:
            continue
        if row.get("gone"):
            found.pop(place, None)
        elif file:
            found[place] = file
    return found


def table(folder, name):
    return list(csv.DictReader(open(folder / f"{name}.csv", encoding="utf-8")))


def drawn(name, made, maps):
    """Whether a texture left from before goes: one of the maps drawn now (all without --maps) not made again."""
    return name not in made and (maps is None or int(name.split("-")[0]) in maps)


# -------------------------------------------------------------------------------------------------
#  The terrain files: each map chunk's heights, water and area
# -------------------------------------------------------------------------------------------------
def waters(folder):
    """{liquid type: its vertex format} of the liquids that are water (the game's sound bank: 0 water,
    1 ocean; magma and slime are not)."""
    formats = {row["ID"]: int(row["LVF"]) for row in table(folder, "LiquidMaterial")}
    return {int(row["ID"]): formats.get(row["MaterialID"], 0) for row in table(folder, "LiquidType")
            if row["SoundBank"] in ("0", "1")}


def pieces(data, start, end):
    """The file's chunks between start and end: (name, where its data begins, its size)."""
    at = start
    while at + 8 <= end:
        size = struct.unpack_from("<I", data, at + 4)[0]
        yield data[at:at + 4][::-1], at + 8, size
        at += 8 + size


# Where each sample lies in its cell (0 to 1), and which of the cell's four triangles holds it: the game
# draws a cell as four triangles meeting at its inner height.
_f = (np.arange(SAMPLES) + 0.5) / SAMPLES
FX, FY = np.meshgrid(_f, _f)
NORTH = (FY < FX) & (FY < 1 - FX)
SOUTH = (FY > FX) & (FY > 1 - FX)
WEST = ~NORTH & ~SOUTH & (FX < 0.5)


def ground(outer, inner):
    """The ground's height at every sample of a tile, from its outer (129 x 129) and inner (128 x 128)
    heights, rows from the north."""
    side = CHUNKS * CELLS
    a, b = outer[:-1, :-1], outer[:-1, 1:]   # each cell's corners: north west, north east,
    c, d = outer[1:, :-1], outer[1:, 1:]     # south west, south east
    fx, fy = np.tile(FX, (side, side)), np.tile(FY, (side, side))
    north, south, west = np.tile(NORTH, (side, side)), np.tile(SOUTH, (side, side)), np.tile(WEST, (side, side))
    big = lambda grid: np.repeat(np.repeat(grid, SAMPLES, 0), SAMPLES, 1)  # noqa: E731
    a, b, c, d, m = big(a), big(b), big(c), big(d), big(inner)
    height = b * (fx - fy) + d * (fx + fy - 1) + m * 2 * (1 - fx)                       # east
    height = np.where(west, a * (1 - fx - fy) + c * (fy - fx) + m * 2 * fx, height)
    height = np.where(south, c * (fy - fx) + d * (fx + fy - 1) + m * 2 * (1 - fy), height)
    return np.where(north, a * (1 - fx - fy) + b * (fx - fy) + m * 2 * fy, height)


def terrain(path, liquids):
    """A terrain file's land at every sample (a tile's side: CHUNKS * CELLS * SAMPLES; 1 land, 0 water) and
    each map chunk's area (CHUNKS x CHUNKS)."""
    height, surface, areas = levels(path, liquids)
    return (height >= surface).astype(np.float32), areas


def levels(path, liquids):
    """A terrain file's ground and water at every sample (a tile's side: CHUNKS * CELLS * SAMPLES): the ground's
    height, the water's surface (-inf where there is none) and each map chunk's area (CHUNKS x CHUNKS)."""
    data = path.read_bytes()
    chunks, water_at = [], None
    for name, at, size in pieces(data, 0, len(data)):
        if name == b"MCNK":
            chunks.append((at, size))
        elif name == b"MH2O":
            water_at = at
    side = CHUNKS * CELLS
    outer = np.zeros((side + 1, side + 1), np.float32)
    inner = np.zeros((side, side), np.float32)
    areas = np.zeros((CHUNKS, CHUNKS), np.int64)
    for at, size in chunks:
        x, y = struct.unpack_from("<II", data, at + 4)
        areas[y, x] = struct.unpack_from("<I", data, at + 0x34)[0]
        base = struct.unpack_from("<f", data, at + 0x70)[0]
        for name, start, _ in pieces(data, at + 128, at + size):
            if name == b"MCVT":
                heights = np.array(struct.unpack_from("<145f", data, start), np.float32).reshape(-1) + base
                rows = np.pad(heights, (0, 8)).reshape(9, 17)  # each row: 9 outer heights, then 8 inner
                outer[y * CELLS:y * CELLS + 9, x * CELLS:x * CELLS + 9] = rows[:, :9]
                inner[y * CELLS:y * CELLS + 8, x * CELLS:x * CELLS + 8] = rows[:8, 9:]
                break
    height = ground(outer, inner)
    surface = np.full(height.shape, -np.inf, np.float32)
    if water_at is not None:
        n = CELLS * SAMPLES
        for index in range(CHUNKS * CHUNKS):
            first, layers, _ = struct.unpack_from("<III", data, water_at + index * 12)
            cy, cx = divmod(index, CHUNKS)
            for layer in range(layers):
                kind, form, low, _, left, top, wide, high, bits, levels = struct.unpack_from(
                    "<HHffBBBBII", data, water_at + first + layer * 24)
                if kind not in liquids or wide == 0 or high == 0:
                    continue
                form = form if form <= 41 else liquids[kind]  # a small number is the format, else an object
                cells = np.ones((high, wide), bool)
                if bits:
                    flags = np.frombuffer(data, np.uint8, (wide * high + 7) // 8, water_at + bits)
                    cells = np.unpackbits(flags, bitorder="little")[:wide * high].reshape(high, wide).astype(bool)
                if levels and form in (0, 1, 3):  # these begin with a height at each corner of the cells
                    corners = np.array(struct.unpack_from(f"<{(wide + 1) * (high + 1)}f", data, water_at + levels),
                                       np.float32).reshape(high + 1, wide + 1)
                else:
                    corners = np.full((high + 1, wide + 1), low, np.float32)
                big = lambda grid: np.repeat(np.repeat(grid, SAMPLES, 0), SAMPLES, 1)  # noqa: E731
                fx, fy = np.tile(FX, (high, wide)), np.tile(FY, (high, wide))
                level = (big(corners[:-1, :-1]) * (1 - fx) * (1 - fy) + big(corners[:-1, 1:]) * fx * (1 - fy)
                         + big(corners[1:, :-1]) * (1 - fx) * fy + big(corners[1:, 1:]) * fx * fy)
                level = np.where(big(cells), level, -np.inf)
                y0, x0 = cy * n + top * SAMPLES, cx * n + left * SAMPLES
                region = surface[y0:y0 + high * SAMPLES, x0:x0 + wide * SAMPLES]
                np.maximum(region, level, out=region)
    return height, surface, areas


def box(grid, reach):
    """The mean of every sample's square of reach samples each way (the grid's edge repeated), along both sides."""
    for axis in (0, 1):
        pad = [(reach + 1, reach) if a == axis else (0, 0) for a in range(grid.ndim)]
        summed = np.cumsum(np.pad(grid, pad, mode="edge"), axis=axis)
        size = summed.shape[axis]
        grid = (np.take(summed, range(2 * reach + 1, size), axis=axis)
                - np.take(summed, range(0, size - 2 * reach - 1), axis=axis)) / (2 * reach + 1)
    return grid


def tones(colour):
    """Brightness, red over green, and red and green over blue: water is dark and blue or green, wood and stone
    over it brighter or warmer."""
    r, g, b = colour[..., 0], colour[..., 1], colour[..., 2]
    return np.stack([(r + g + b) / 3, 2 * (r - g), (r + g) - 2 * b], -1)


def standing(colour, water):
    """The samples of the water where the minimap shows something standing on it (a dock, a pier, a bridge, a
    ship): brighter or warmer than the water around them. The water's colour is the mean of its samples nearby,
    taken twice, the second time without what the first found standing out."""
    tone, kept = tones(colour), water.astype(np.float32)
    for _ in range(2):
        weight = box(box(kept, WATERS), WATERS)
        around = box(box(tone * kept[..., None], WATERS), WATERS) / np.maximum(weight, 1e-6)[..., None]
        above = np.sqrt((np.maximum(tone - around, 0) ** 2).sum(-1)) > BUILT
        kept = (water & ~above).astype(np.float32)
    found = water & above
    edge = lambda grid: np.pad(grid, 1, mode="edge")  # noqa: E731
    shifted = lambda grid, dy, dx: edge(grid)[1 + dy:1 + dy + grid.shape[0], 1 + dx:1 + dx + grid.shape[1]]  # noqa: E731
    near = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    alone = found.copy()
    for dy, dx in near:  # a lone speck goes, what is a few samples wide stays (and is widened by one again)
        alone &= shifted(found, dy, dx)
    found = alone.copy()
    for dy, dx in near:
        found |= shifted(alone, dy, dx)
    for dy, dx in near:  # and one sample more, so its edge is not cut
        found |= shifted(found, dy, dx)
    return found & water


def coast(height, surface, colour):
    """How much of each sample is land (0 to 1): the ground above the water, fading out in the first SHALLOW yards
    under it, and whatever stands on the water as the minimap shows it."""
    depth = np.where(np.isfinite(surface), surface - height, -1.0)
    land = np.clip(1 - depth / SHALLOW, 0, 1).astype(np.float32)
    return np.where(standing(colour, depth > 0), 1, land)


def blank(texture):
    """A tile's samples its minimap texture leaves pure black (the game draws nothing there), or None."""
    with Image.open(texture) as image:
        shown = (np.asarray(image.convert("RGB")).max(axis=2) > 0).astype(np.uint8) * 255
    per = CHUNKS * CELLS * SAMPLES
    found = np.asarray(Image.fromarray(shown).resize((per, per), Image.Resampling.BOX)) == 0
    return found if found.any() else None


def sky(found, textures):
    """The open sky of every map: {(continent, row, column): its samples that are sky}. A blank sample (blank) is
    sky when blank ones join it to a place of the grid with no tile: the void around an isle that floats, its cliffs
    under the rim too; never a dark place within the land, and none on the continents (no blank at their edges)."""
    per = CHUNKS * CELLS * SAMPLES
    blanks = {}
    for place, file in found.items():
        empty = blank(textures / f"{file}.blp")
        if empty is not None:
            blanks[place] = empty
    open_sky = {}
    for continent in sorted({c for c, _, _ in blanks}):
        places = [(r, k) for c, r, k in blanks if c == continent]
        r0, r1 = min(r for r, _ in places) - 1, max(r for r, _ in places) + 1
        k0, k1 = min(k for _, k in places) - 1, max(k for _, k in places) + 1
        way = np.zeros(((r1 - r0 + 1) * per, (k1 - k0 + 1) * per), bool)  # where the sky may spread
        reached = np.zeros_like(way)
        for r in range(r0, r1 + 1):
            for k in range(k0, k1 + 1):
                y, x = (r - r0) * per, (k - k0) * per
                if (continent, r, k) in blanks:
                    way[y:y + per, x:x + per] = blanks[(continent, r, k)]
                elif (continent, r, k) not in found:  # no tile: outside the map
                    way[y:y + per, x:x + per] = reached[y:y + per, x:x + per] = True
        while True:  # spread through the blank samples, a sample a step
            grown = reached.copy()
            grown[1:, :] |= reached[:-1, :]
            grown[:-1, :] |= reached[1:, :]
            grown[:, 1:] |= reached[:, :-1]
            grown[:, :-1] |= reached[:, 1:]
            grown &= way
            if (grown == reached).all():
                break
            reached = grown
        for r, k in places:
            part = reached[(r - r0) * per:(r - r0 + 1) * per, (k - k0) * per:(k - k0 + 1) * per]
            if part.any():
                open_sky[(continent, r, k)] = part.copy()
    return open_sky


def rim(found, continent, row, column):
    """A tile's samples along each of its sides that faces no tile, the world's rim (RIM map chunks deep), or None:
    nothing there is land. The game leaves the sea floor there unsculpted and dry at the water's level (Kalimdor's
    north-east), or its minimap a grey band (the isle in Kalimdor's corner), which the cut kept as lines in the sea."""
    per, deep = CHUNKS * CELLS * SAMPLES, RIM * CELLS * SAMPLES
    cut = np.zeros((per, per), bool)
    if (continent, row - 1, column) not in found:
        cut[:deep] = True
    if (continent, row + 1, column) not in found:
        cut[-deep:] = True
    if (continent, row, column - 1) not in found:
        cut[:, :deep] = True
    if (continent, row, column + 1) not in found:
        cut[:, -deep:] = True
    return cut if cut.any() else None


# -------------------------------------------------------------------------------------------------
#  BLP files
# -------------------------------------------------------------------------------------------------
def dxt5(image):
    """The DXT5 blocks of an RGBA picture: ImageMagick writes them as a DDS file (header of 128 bytes). Its
    range fit: its cluster fit takes about a minute a texture once the alpha is partly see-through, and gains
    little on a picture made smaller and on the outlines' one colour."""
    png = io.BytesIO()
    image.save(png, "PNG")
    data = subprocess.run(["magick", "png:-", "-define", "dds:compression=dxt5", "-define", "dds:mipmaps=0", "dds:-"],
                          input=png.getvalue(), capture_output=True, check=True).stdout
    blocks = max(1, (image.width + 3) // 4) * max(1, (image.height + 3) // 4)
    assert data[:4] == b"DDS " and data[84:88] == b"DXT5" and len(data) == 128 + 16 * blocks, "no DXT5 from magick"
    return data[128:]


def blp(picture):
    """A BLP2 file of an RGBA picture: DXT5 (encoding 2, alpha depth 8, alpha encoding 7), every mipmap made
    from the full picture down to 1 x 1, largest first."""
    side = picture.width
    levels, size = [], side
    while True:
        level = picture if size == side else picture.resize((size, size), Image.Resampling.BOX)
        levels.append(dxt5(level))
        if size == 1:
            break
        size //= 2
    offsets, sizes, start = [], [], 148 + 1024  # header, then a palette DXT does not use
    for level in levels:
        offsets.append(start + sum(sizes))
        sizes.append(len(level))
    unused = [0] * (16 - len(levels))
    header = b"BLP2" + struct.pack("<I4B2I", 1, 2, 8, 7, 1, side, side)
    header += struct.pack("<16I", *offsets, *unused) + struct.pack("<16I", *sizes, *unused)
    return header + bytes(1024) + b"".join(levels)


def write(path, picture):
    data = blp(picture)
    path.write_bytes(data)
    with Image.open(path) as back:  # read back by Pillow's own BLP reader
        assert back.size == picture.size, f"{path.name} reads back as {back.size}"
    return len(data)


def bleed(rgb, alpha):
    """Colour where there is no land: the nearest land's, spread outwards ring by ring."""
    rgb, have = rgb.copy(), alpha > 0
    for _ in range(64):
        if have.all():
            break
        total, count = np.zeros_like(rgb), np.zeros(alpha.shape, np.float32)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                moved = np.roll(np.roll(have, dy, 0), dx, 1)
                total += np.roll(np.roll(rgb * have[..., None], dy, 0), dx, 1)
                count += moved
        fill = ~have & (count > 0)
        rgb[fill] = total[fill] / count[fill][:, None]
        have = have | fill
    return rgb


# -------------------------------------------------------------------------------------------------
#  The overview and the outlines
# -------------------------------------------------------------------------------------------------
def overview(found, textures, files, liquids, maps):
    """Every block's overview texture; returns {continent: (the area of each map chunk of its grid, whether
    each map chunk holds land)}."""
    blocks = sorted({(c, r // BLOCK, k // BLOCK) for c, r, k in found})
    void = sky(found, textures)
    grids = {c: np.zeros((GRID * CHUNKS, GRID * CHUNKS), np.int64) for c, _, _ in blocks}
    lands = {c: np.zeros((GRID * CHUNKS, GRID * CHUNKS), bool) for c, _, _ in blocks}
    TERRAIN.mkdir(parents=True, exist_ok=True)
    COASTS.mkdir(parents=True, exist_ok=True)
    made, total, side, per = set(), 0, BLOCK * TEXELS, CHUNKS * CELLS * SAMPLES
    coasts, total_coast = {}, 0
    for continent, block_row, block_column in blocks:
        rgb = np.zeros((side, side, 3), np.float32)
        alpha = np.zeros((side, side), np.float32)
        for r in range(BLOCK):
            for k in range(BLOCK):
                row, column = block_row * BLOCK + r, block_column * BLOCK + k
                file = found.get((continent, row, column))
                if not file:
                    continue
                key = continent * GRID * GRID + row * GRID + column
                with Image.open(textures / f"{file}.blp") as image:
                    colour = np.asarray(image.convert("RGB").resize((per, per), Image.Resampling.LANCZOS),
                                        np.float32)
                place = files / f"{key}.adt"
                if place.exists():
                    height, surface, areas = levels(place, liquids)
                    grids[continent][row * CHUNKS:(row + 1) * CHUNKS, column * CHUNKS:(column + 1) * CHUNKS] = areas
                    ground, land = height >= surface, coast(height, surface, colour)
                else:
                    ground, land = np.ones((per, per), bool), np.ones((per, per), np.float32)
                if (continent, row, column) in void:
                    ground = ground & ~void[(continent, row, column)]
                    land = np.where(void[(continent, row, column)], 0, land)
                edge = rim(found, continent, row, column)
                if edge is not None:
                    ground = ground & ~edge
                    land = np.where(edge, 0, land)
                step = per // CHUNKS
                lands[continent][row * CHUNKS:(row + 1) * CHUNKS, column * CHUNKS:(column + 1) * CHUNKS] = \
                    ground.reshape(CHUNKS, step, CHUNKS, step).max(axis=(1, 3))
                if land.min() < 1 and land.max() > 0:  # on a coast: a mask of its own for the game's tile
                    step = per // COAST
                    cut = land.reshape(COAST, step, COAST, step).mean(axis=(1, 3))
                    white = np.full((COAST, COAST, 3), 255, np.uint8)
                    mask = Image.fromarray(np.dstack([white, (cut * 255).round().astype(np.uint8)]), "RGBA")
                    total_coast += write(COASTS / f"{key}.blp", mask)
                    coasts.setdefault(continent, []).append(key)
                # Each texel: how much of it is land, and the colour of its land alone.
                step = per // TEXELS
                share = land.reshape(TEXELS, step, TEXELS, step).mean(axis=(1, 3))
                weighed = (colour * land[..., None]).reshape(TEXELS, step, TEXELS, step, 3).sum(axis=(1, 3))
                count = land.reshape(TEXELS, step, TEXELS, step).sum(axis=(1, 3))
                own = np.where(count[..., None] > 0, weighed / np.maximum(count, 1)[..., None], 0)
                y, x = r * TEXELS, k * TEXELS
                rgb[y:y + TEXELS, x:x + TEXELS] = own
                alpha[y:y + TEXELS, x:x + TEXELS] = share
        rgb = bleed(rgb, alpha)  # a block of open sea is written too: the map asks for every block with tiles
        picture = Image.fromarray(np.dstack([np.clip(rgb, 0, 255), alpha * 255]).round().astype(np.uint8), "RGBA")
        name = f"{continent}-{block_row}-{block_column}.blp"
        total += write(TERRAIN / name, picture)
        made.add(name)
    for old in TERRAIN.glob("*.blp"):
        if drawn(old.name, made, maps):
            old.unlink()
    print(f"Terrain overview: {len(made)} textures of {side} x {side} in {TERRAIN.relative_to(ROOT)}, {total / 1e6:.1f} MB.")
    write_coasts(coasts, maps)
    print(f"Coasts: {sum(map(len, coasts.values()))} masks of {COAST} x {COAST} in {COASTS.relative_to(ROOT)}, "
          f"{total_coast / 1e6:.1f} MB.")
    return grids, lands


def write_coasts(coasts, maps):
    """Coasts.lua: the tiles with a coast's mask of their own, by continent; with --maps the other maps' lines and
    masks stay as they were."""
    listed = {}
    if COASTLIST.exists():
        for line in COASTLIST.read_text(encoding="utf-8").splitlines():
            found = re.match(r"    \[(\d+)\] = \{(.*)\},$", line)
            if found:
                listed[int(found.group(1))] = [int(key) for key in re.findall(r"\[(\d+)\]", found.group(2))]
    for continent in list(listed):
        if maps is None or continent in maps:
            del listed[continent]
    listed.update(coasts)
    keep = {key for keys in listed.values() for key in keys}
    for old in COASTS.glob("*.blp"):
        if int(old.stem) not in keep:
            old.unlink()
    lines = ["local _, ns = ...", "",
             "-- Made by dev/tools/terrain-art, not by hand: the tiles on a coast, whose own mask (Art/Coasts/<key>.blp)",
             "-- cuts the game's minimap texture up close, by the continent's instance. Run the tool again when the",
             "-- game's build changes.", "ns.COASTS = {"]
    for continent in sorted(listed):
        keys = ", ".join(f"[{key}] = true" for key in sorted(listed[continent]))
        lines.append(f"    [{continent}] = {{ {keys} }},")
    lines.append("}")
    COASTLIST.write_text("\n".join(lines) + "\n", encoding="utf-8")


def shore(land):
    """The map chunks a zone's map may cover: all but the open sea, past SHORE chunks from its land. The open
    sea is the water (chunks without land) that reaches the grid's edge; a lake or a river stays its zone's."""
    sea = ~land
    open_sea = np.zeros_like(sea)
    edge = np.zeros_like(sea)
    edge[0, :] = edge[-1, :] = edge[:, 0] = edge[:, -1] = True
    open_sea[edge & sea] = True
    while True:  # grown from the edge through the water, a chunk a step
        grown = open_sea.copy()
        grown[1:, :] |= open_sea[:-1, :]
        grown[:-1, :] |= open_sea[1:, :]
        grown[:, 1:] |= open_sea[:, :-1]
        grown[:, :-1] |= open_sea[:, 1:]
        grown &= sea
        if (grown == open_sea).all():
            break
        open_sea = grown
    kept = ~open_sea
    for _ in range(SHORE):
        wider = kept.copy()
        wider[1:, :] |= kept[:-1, :]
        wider[:-1, :] |= kept[1:, :]
        wider[:, 1:] |= kept[:, :-1]
        wider[:, :-1] |= kept[:, 1:]
        kept = wider
    return kept


def zones(tables, continents):
    """{uiMapID: (continent, its box: north, south, west, east in yards, its area IDs)} of every zone map on
    the continents, and of every zone straight on the world map that lies on one of their grids (the isle),
    from the game's tables: a zone's areas are its own area and those under it."""
    maps = {row["ID"]: row for row in table(tables, "UiMap")}
    parent = {int(row["ID"]): int(row["ParentAreaID"]) for row in table(tables, "AreaTable")}
    found = {}
    for row in table(tables, "UiMapAssignment"):
        info = maps.get(row["UiMapID"])
        mother = info and maps.get(info["ParentUiMapID"])
        if not info or info["Type"] != ZONE or not mother or mother["Type"] not in (CONTINENT, WORLD):
            continue
        if (row["UiMin[0]"], row["UiMin[1]"], row["UiMax[0]"], row["UiMax[1]"]) != ("0", "0", "1", "1"):
            continue
        continent = int(row["MapID"])
        if continent not in continents:
            continue
        box = (float(row["Region[3]"]), float(row["Region[0]"]), float(row["Region[4]"]), float(row["Region[1]"]))
        found[int(row["UiMapID"])] = (continent, box, int(row["AreaID"]))
    top = {}  # every area's zone area: the last of its parents
    for area in parent:
        at, seen = area, 0
        while parent.get(at, 0) and seen < 10:
            at, seen = parent[at], seen + 1
        top[area] = at
    return found, top


def smoothstep(low, high, value):
    t = np.clip((value - low) / (high - low), 0, 1)
    return t * t * (3 - 2 * t)


def frame(side):
    """A map box's frame faded off: along one side of side texels, 0 at its edges, whole within."""
    t = (np.arange(side) + 0.5) / side
    return smoothstep(FRAME[0], FRAME[1], np.minimum(t, 1 - t))


def listed_before():
    """{continent: [uiMapID]} of Outlines.lua as it is: the zones of the maps not drawn now are kept."""
    found = {}
    if OUTLINES.exists():
        for continent, ids in re.findall(r"^\s*\[(\d+)\] = \{(.*)\},\s*$", OUTLINES.read_text(encoding="utf-8"), re.M):
            found[int(continent)] = [int(uimap) for uimap in re.findall(r"\[(\d+)\] = true", ids)]
    return found


def outlines(grids, lands, tables, maps):
    """Every zone's outline, and Outlines.lua. Returns {uiMapID: (continent, its box, its outline's alpha)}."""
    found, top = zones(tables, set(grids))
    kept = {continent: shore(land) for continent, land in lands.items()}
    ZONES.mkdir(parents=True, exist_ok=True)
    chunk = TILE / CHUNKS
    made, total, listed, shapes = set(), 0, {}, {}
    blurred = {}
    for uimap, (continent, box, area) in sorted(found.items()):
        grid = grids[continent]
        inside = (np.isin(grid, [a for a, t in top.items() if t == area] + [area]) & kept[continent]).astype(np.float32)
        if not inside.any():
            continue
        # Softened on the whole grid, so two zones that meet see the same border.
        if continent not in blurred:
            blurred[continent] = gauss(SOFT)
        soft = blurred[continent](inside)
        north, south, west, east = box
        # Each texel's middle in yards, then on the grid of map chunks (rows from the north, columns from the west).
        t = (np.arange(OUTLINE) + 0.5) / OUTLINE
        x_north = north + t * (south - north)      # X of each row of texels
        y_west = west + t * (east - west)          # Y of each column of texels
        rows = (GRID / 2 * TILE - x_north) / chunk - 0.5
        columns = (GRID / 2 * TILE - y_west) / chunk - 0.5
        value = sample(soft, rows, columns)
        edges = frame(OUTLINE)
        alpha = smoothstep(FADED, 0.5, value) * edges[:, None] * edges[None, :]
        if not (alpha > 0).any():
            continue
        shapes[uimap] = (continent, box, alpha)
        white = np.full((OUTLINE, OUTLINE), 255, np.uint8)
        picture = Image.fromarray(np.dstack([white, white, white, (alpha * 255).round().astype(np.uint8)]), "RGBA")
        name = f"{uimap}.blp"
        total += write(ZONES / name, picture)
        made.add(name)
        listed.setdefault(continent, []).append(uimap)
    if maps is not None:  # the other maps' outlines as they were
        for continent, ids in listed_before().items():
            if continent not in maps:
                listed[continent] = ids
                made.update(f"{uimap}.blp" for uimap in ids)
    for old in ZONES.glob("*.blp"):
        if old.name not in made:
            old.unlink()
    lines = ["local _, ns = ...", "",
             "-- Made by dev/tools/terrain-art, not by hand: the zones whose outline it drew (Art/Zones/<uiMapID>.blp),",
             "-- by the continent's instance. Run the tool again when the game's build changes.",
             "ns.OUTLINES = {"]
    for continent in sorted(listed):
        ids = ", ".join(f"[{uimap}] = true" for uimap in sorted(listed[continent]))
        lines.append(f"    [{continent}] = {{ {ids} }},")
    lines.append("}")
    OUTLINES.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Zone outlines: {len(made)} of {OUTLINE} x {OUTLINE} in {ZONES.relative_to(ROOT)}, {total / 1e6:.1f} MB; "
          f"{OUTLINES.relative_to(ROOT)}.")
    return shapes


def full(uimap, tables, art):
    """A map's full art (its tiles and every part the game reveals once explored), as one RGBA picture of its
    layer's size; None when the game has none."""
    picks = [row["UiMapArtID"] for row in tables["UiMapXMapArt"] if row["UiMapID"] == str(uimap) and row["PhaseID"] == "0"]
    if not picks:
        return None
    pick = picks[0]
    style = next(row["UiMapArtStyleID"] for row in tables["UiMapArt"] if row["ID"] == pick)
    layer = next(row for row in tables["UiMapArtStyleLayer"] if row["UiMapArtStyleID"] == style and row["LayerIndex"] == "0")
    width, height = int(layer["LayerWidth"]), int(layer["LayerHeight"])
    tile_width, tile_height = int(layer["TileWidth"]), int(layer["TileHeight"])
    picture = Image.new("RGBA", (width + tile_width, height + tile_height))
    for row in tables["UiMapArtTile"]:
        if row["UiMapArtID"] == pick and row["LayerIndex"] == "0":
            with Image.open(art / f"{row['FileDataID']}.blp") as tile:
                picture.alpha_composite(tile.convert("RGBA"), (int(row["ColIndex"]) * tile_width, int(row["RowIndex"]) * tile_height))
    for part in tables["WorldMapOverlay"]:
        if part["UiMapArtID"] != pick:
            continue
        for row in tables["parts"].get(part["ID"], []):
            with Image.open(art / f"{row['FileDataID']}.blp") as tile:
                picture.alpha_composite(tile.convert("RGBA"), (int(part["OffsetX"]) + int(row["ColIndex"]) * tile_width,
                                                               int(part["OffsetY"]) + int(row["RowIndex"]) * tile_height))
    return picture.crop((0, 0, width, height))


def sketches(found, shapes, folder, art, maps):
    """The stitched map's blocks: every zone's full map cut by its outline, on its continent's grid."""
    tables = {name: table(folder, name) for name in ("UiMapXMapArt", "UiMapArt", "UiMapArtStyleLayer", "UiMapArtTile", "WorldMapOverlay")}
    tables["parts"] = {}
    for row in table(folder, "WorldMapOverlayTile"):
        if row["LayerIndex"] == "0" and int(row["FileDataID"]) > 0:
            tables["parts"].setdefault(row["WorldMapOverlayID"], []).append(row)
    side = GRID * TEXELS
    canvases = {}
    per_yard = TEXELS / TILE
    for uimap, (continent, box, alpha) in sorted(shapes.items()):
        picture = full(uimap, tables, art)
        if picture is None:
            continue
        cut = np.asarray(Image.fromarray((alpha * 255).round().astype(np.uint8)).resize(picture.size, Image.Resampling.BILINEAR),
                         np.float32) / 255
        pixels = np.asarray(picture, np.float32)
        pixels[..., 3] *= cut
        north, south, west, east = box
        left, top = (GRID / 2 * TILE - west) * per_yard, (GRID / 2 * TILE - north) * per_yard
        wide, high = (west - east) * per_yard, (north - south) * per_yard
        size = (max(1, round(wide)), max(1, round(high)))
        placed = Image.fromarray(pixels.round().astype(np.uint8), "RGBA").resize(size, Image.Resampling.LANCZOS)
        canvas = canvases.setdefault(continent, Image.new("RGBA", (side, side)))
        x, y = round(left), round(top)
        # The part on the grid only.
        cx, cy = max(0, -x), max(0, -y)
        part = placed.crop((cx, cy, min(size[0], side - x), min(size[1], side - y)))
        if part.width > 0 and part.height > 0:
            canvas.alpha_composite(part, (x + cx, y + cy))
    SKETCHES.mkdir(parents=True, exist_ok=True)
    blocks = sorted({(c, r // BLOCK, k // BLOCK) for c, r, k in found})
    made, total, step = set(), 0, BLOCK * TEXELS
    for continent, block_row, block_column in blocks:
        canvas = canvases.get(continent) or Image.new("RGBA", (side, side))
        piece = np.asarray(canvas.crop((block_column * step, block_row * step, (block_column + 1) * step, (block_row + 1) * step)),
                           np.float32)
        rgb = bleed(piece[..., :3], piece[..., 3] / 255)
        picture = Image.fromarray(np.dstack([np.clip(rgb, 0, 255), piece[..., 3]]).round().astype(np.uint8), "RGBA")
        name = f"{continent}-{block_row}-{block_column}.blp"
        total += write(SKETCHES / name, picture)
        made.add(name)
    for old in SKETCHES.glob("*.blp"):
        if drawn(old.name, made, maps):
            old.unlink()
    print(f"Stitched map: {len(made)} textures of {step} x {step} in {SKETCHES.relative_to(ROOT)}, {total / 1e6:.1f} MB.")
    edges = frame(OUTLINE)
    white = np.full((OUTLINE, OUTLINE), 255, np.uint8)
    edge = (edges[:, None] * edges[None, :] * 255).round().astype(np.uint8)
    write(EDGE, Image.fromarray(np.dstack([white, white, white, edge]), "RGBA"))
    print(f"The frame's mask: {EDGE.relative_to(ROOT)}.")


def gauss(sigma):
    """A blur by a Gaussian of sigma map chunks, along both sides in turn."""
    reach = int(np.ceil(sigma * 3))
    kernel = np.exp(-0.5 * (np.arange(-reach, reach + 1) / sigma) ** 2)
    kernel /= kernel.sum()

    def blur(grid):
        out = np.apply_along_axis(lambda line: np.convolve(line, kernel, mode="same"), 0, grid)
        return np.apply_along_axis(lambda line: np.convolve(line, kernel, mode="same"), 1, out)
    return blur


def sample(grid, rows, columns):
    """The grid between its points (bilinear), at every row and column asked; 0 outside it."""
    r = np.clip(rows, 0, grid.shape[0] - 1.001)[:, None]
    c = np.clip(columns, 0, grid.shape[1] - 1.001)[None, :]
    r0, c0 = np.floor(r).astype(int), np.floor(c).astype(int)
    fr, fc = r - r0, c - c0
    return (grid[r0, c0] * (1 - fr) * (1 - fc) + grid[r0, c0 + 1] * (1 - fr) * fc
            + grid[r0 + 1, c0] * fr * (1 - fc) + grid[r0 + 1, c0 + 1] * fr * fc)


def sea(texture):
    """The sea's waves: the alpha of the game's ocean texture, in white (the code gives it its colour), SEA_SIDE on a
    side, softened by SEA_BLUR. Made smaller and softened with its neighbours around it (three by three copies, the
    middle one kept), so the filters read across its edges as across the rest and the copies still meet without a
    seam."""
    with Image.open(texture) as image:
        waves = image.convert("RGBA").getchannel("A")
    if waves.size != (WAVES, WAVES):
        sys.exit(f"{texture} is {waves.width} x {waves.height}, not the ocean texture's {WAVES} x {WAVES}")
    plane = Image.new("L", (3 * WAVES, 3 * WAVES))
    for x in range(3):
        for y in range(3):
            plane.paste(waves, (x * WAVES, y * WAVES))
    plane = plane.resize((3 * SEA_SIDE, 3 * SEA_SIDE), Image.Resampling.LANCZOS)
    plane = plane.filter(ImageFilter.GaussianBlur(SEA_BLUR))  # softened across the copies' edges too: still seamless
    waves = plane.crop((SEA_SIDE, SEA_SIDE, 2 * SEA_SIDE, 2 * SEA_SIDE))
    white = Image.new("L", waves.size, 255)
    size = write(SEA, Image.merge("RGBA", (white, white, white, waves)))
    print(f"The sea's waves: {SEA.relative_to(ROOT)}, {size / 1e6:.1f} MB.")
    write(SHADE, shade())
    print(f"The sea's shade: {SHADE.relative_to(ROOT)}.")


def shade():
    """The sea's shade: white noise softened by 1 / f ** (SHADE_SLOPE / 2) through the Fourier transform (whose waves
    repeat across the square, so the noise tiles seamlessly), scaled to 0 to 1; its alpha nothing under SHADE_FROM,
    then growing to whole."""
    rng = np.random.default_rng(SHADE_SEED)
    f = np.fft.fftfreq(SHADE_SIDE)
    fx, fy = np.meshgrid(f, f)
    amp = 1 / np.maximum(np.hypot(fx, fy), 1 / SHADE_SIDE) ** (SHADE_SLOPE / 2)
    amp[0, 0] = 0
    field = np.real(np.fft.ifft2(np.fft.fft2(rng.standard_normal((SHADE_SIDE, SHADE_SIDE))) * amp))
    field = (field - field.min()) / (field.max() - field.min())
    alpha = (np.clip((field - SHADE_FROM) / (1 - SHADE_FROM), 0, 1) * 255).round().astype(np.uint8)
    white = np.full(alpha.shape, 255, np.uint8)
    return Image.fromarray(np.dstack([white, white, white, alpha]), "RGBA")


def whirlpool(folder, art):
    """The Maelstrom's whirlpool from the world map's art (WORLD_MAP): the square WHIRL_REACH each way round its
    spiral's middle (WHIRL_AT); its ink, how much darker and redder each pixel is than the parchment under it (a
    median WHIRL_GROUND across, which the thin lines drop out of), and the parchment's light at the middle, faded out
    round a circle (WHIRL_FADE); WHIRL_SIDE on a side, softened by WHIRL_BLUR, as alpha in white. Prints the numbers
    Canvas.WHIRLPOOL places it by: its middle and its size on the world map (0 to 1)."""
    tables = {name: table(folder, name) for name in ("UiMapXMapArt", "UiMapArt", "UiMapArtStyleLayer", "UiMapArtTile")}
    tables["WorldMapOverlay"], tables["parts"] = [], {}  # the world map reveals no parts
    world = full(WORLD_MAP, tables, art)
    if world is None:
        sys.exit(f"The client tables in {folder} give the world map {WORLD_MAP} no art")
    (x, y), reach = WHIRL_AT, WHIRL_REACH
    square = world.convert("RGB").crop((x - reach, y - reach, x + reach, y + reach))
    pixels = np.asarray(square, np.float32)
    ground = np.asarray(square.filter(ImageFilter.MedianFilter(WHIRL_GROUND)), np.float32)
    luma = lambda p: 0.3 * p[..., 0] + 0.59 * p[..., 1] + 0.11 * p[..., 2]  # noqa: E731
    red = lambda p: p[..., 0] - (p[..., 1] + p[..., 2]) / 2  # noqa: E731
    ink = (np.clip((luma(ground) - luma(pixels)) / 30, 0, 1) + np.clip((red(pixels) - red(ground)) / 25, 0, 1)) / 2
    ink = np.clip((ink - WHIRL_INK[0]) / WHIRL_INK[1], 0, 1)
    rows, columns = np.mgrid[0:2 * reach, 0:2 * reach] + 0.5
    far = np.hypot(columns - reach, rows - reach) / reach  # 1 at the square's side
    fade = np.clip((WHIRL_FADE[1] - far) / (WHIRL_FADE[1] - WHIRL_FADE[0]), 0, 1)
    fade = fade * fade * (3 - 2 * fade)
    light = np.asarray(Image.fromarray(luma(ground).round().astype(np.uint8)).filter(ImageFilter.GaussianBlur(8)),
                       np.float32)
    ring = light[(far > 0.8) & (far < 0.95)].mean()
    light = np.clip((light - ring) / 40, 0, 1) * np.clip((0.6 - far) / 0.6, 0, 1) * WHIRL_LIGHT
    alpha = np.maximum(ink * fade, light)
    alpha = Image.fromarray((alpha * 255).round().astype(np.uint8)).resize((WHIRL_SIDE, WHIRL_SIDE),
                                                                          Image.Resampling.LANCZOS)
    alpha = alpha.filter(ImageFilter.GaussianBlur(WHIRL_BLUR))
    white = Image.new("L", alpha.size, 255)
    size = write(WHIRLPOOL, Image.merge("RGBA", (white, white, white, alpha)))
    print(f"The whirlpool: {WHIRLPOOL.relative_to(ROOT)}, {size / 1e6:.2f} MB. Canvas.WHIRLPOOL: "
          f"x = {x / world.width:.4f}, y = {y / world.height:.4f}, wide = {2 * reach / world.width:.4f}, "
          f"high = {2 * reach / world.height:.4f}")


def main():
    args, maps = sys.argv[1:], None
    if args[:1] == ["--sea"]:
        if len(args) != 2:
            sys.exit(__doc__)
        return sea(Path(args[1]))
    if args[:1] == ["--whirlpool"]:
        if len(args) != 3:
            sys.exit(__doc__)
        return whirlpool(Path(args[1]), Path(args[2]))
    if "--maps" in args:
        at = args.index("--maps")
        maps = {int(map_id) for map_id in args[at + 1].split(",")}
        del args[at:at + 2]
    if len(args) != 4:
        sys.exit(__doc__)
    textures, files, tables, art = (Path(arg) for arg in args)
    found = tiles(maps)
    if not found:
        sys.exit("The set Tiles has no tile of " + (", ".join(map(str, sorted(maps))) if maps else "any map"))
    missing = [file for file in found.values() if not (textures / f"{file}.blp").exists()]
    if missing:
        sys.exit(f"{len(missing)} of the set's textures are not in {textures} (the first: {missing[0]}.blp)")
    lacking = [key for key in ((c * GRID + r) * GRID + k for c, r, k in found) if not (files / f"{key}.adt").exists()]
    if lacking:
        print(f"{len(lacking)} of the set's tiles have no terrain file in {files}: drawn without water cut away.")
    grids, lands = overview(found, textures, files, waters(tables), maps)
    shapes = outlines(grids, lands, tables, maps)
    sketches(found, shapes, tables, art, maps)


if __name__ == "__main__":
    main()
