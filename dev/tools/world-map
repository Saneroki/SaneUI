#!/usr/bin/env python3
"""The world map offline (Saneroki, 2026-10-22: compare and refine the world map outside the game): every layer of
the world, the game's and ours, laid where the game lays it and stacked in a web page, a slider each, zoomed from a
whole continent down to the finest blocks. The Atlas' art is read as the game reads it: its index by the Atlas
module itself (world-map-index.lua, src/Atlas/Atlas.lua under Lua 5.1), its blocks as the pack wrote them; the
painted tiles of a run are packed by the Atlas' own pack into the same blocks.

Layers, per continent (0 the Eastern Kingdoms, 1 Kalimdor), as the game places them (Atlas.lua: blocks of PIXELS a
side, a block TILE / 4 * 2^level yards, row and column from the grid's north-west corner):
  terrain     the game's own minimap tiles (Core's set Tiles): blocks from level 3 (256 pixels a terrain tile, as
              the game has them) up
  gamemaps    the game's own zone maps, each cut by its outline (Navigation's Art/Zones) and laid on its box
  far, middle the zones' paintings of dev/tools/map-layers, each cut by its outline
  tiles       the painted squares of a run (<run>/<continent>/sq-<i>-<j>.png, as dev/tools/atlas paints them),
              packed into blocks by dev/tools/atlas' pack
  atlas       the Atlas' pack (assets/optimized/Atlas): what the game draws
And per instance of dev/tools/map-layers: its terrain, the game's maps of its floors, its far painting.

Usage:
  dev/tools/world-map build [--layers terrain,gamemaps,far,middle,tiles,atlas,instances] [--continents 0,1]
                            [--tiles RUN] [--out DIR]
  dev/tools/world-map serve [--port 8773] [--only world|instances] [--out DIR]

  build   what is missing of the layers (a layer's pictures made again only when its source is newer);
          world.json lists them all; the page (dev/tools/world-map-page/) copied in
  serve   the page on this computer, 127.0.0.1 port 8773 (saneui showworldmap; a preview server's PORT); --only
          instances: the instance maps alone, on 127.0.0.1 port 8772 (saneui showinstancemaps); --only world: the
          continents alone

Writes (default assets/generated/world-map, never committed): world.json, index.html, viewer.js, <layer>/<continent>/
<level>/<row>_<column>.jpg for the block layers, <layer>/<continent>/<uiMapID>.webp for the zone layers, instances/.
"""
import argparse
import functools
import os
import http.server
import importlib.machinery
import importlib.util
import json
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

import numpy as np
from PIL import Image

ROOT = Path(__file__).resolve().parents[2]


def module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    found = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(found)
    return found


ml = module("map_layers", ROOT / "dev" / "tools" / "map-layers")   # zones, their paintings and frames
at, ta = ml.at, ml.ta                                               # the Atlas' grid and pack; the game's tables
OUT = ROOT / "assets" / "generated" / "world-map"
PAGE = ROOT / "dev" / "tools" / "world-map-page"
ATLAS = ROOT / "assets" / "optimized" / "Atlas"
RUN = ROOT / "assets" / "generated" / "world-tiles"   # the painted tiles' run (dev/tools/atlas' layout)
INDEX_LUA = ROOT / "dev" / "tools" / "world-map-index.lua"
LUA = "lua5.1"
PORT = 8773
PORTS = {"world": 8773, "instances": 8772}   # --only's own port, so both can be open at once
PIXELS = 512                    # a block's side (Atlas.lua's PIXELS)
LEVELS = 9                      # the pack's levels: from the ninth on a block holds the whole grid
TERRAIN_LEVEL = 3               # the game's minimap: 256 pixels a terrain tile, two tiles a block
QUALITY = 86
NAMES = {0: "Eastern Kingdoms", 1: "Kalimdor"}
LAYERS = {   # id: (name, order from the bottom)
    "terrain": ("Game terrain", 0), "gamemaps": ("Game maps", 1), "atlas": ("Atlas pack (as the game draws it)", 2),
    "tiles": ("Our tiles", 3), "far": ("Our zone renders", 4), "middle": ("Our zone maps", 5)}


def span(level):
    return ml.TILE / 4 * 2 ** level


def newer(target, *sources):
    """Whether a picture is to be made (again): missing, or older than what it is made from."""
    return not target.is_file() or any(s.is_file() and s.stat().st_mtime > target.stat().st_mtime for s in sources)


# --- Block layers ---------------------------------------------------------------------------------

def halve(blocks, folder, level, make):
    """A level's blocks from the four below each: made where any of the four is; returns the blocks."""
    above = {}
    for row, column in blocks:
        above.setdefault((row // 2, column // 2), []).append((row, column))
    for (row, column), children in above.items():
        target = folder / str(level) / f"{row}_{column}.jpg"
        sources = [folder / str(level - 1) / f"{r}_{c}.jpg" for r, c in children]
        if make or newer(target, *sources):
            sheet = Image.new("RGB", (2 * PIXELS, 2 * PIXELS), tuple(int(c) for c in at.NAVY))
            for r, c in children:
                with Image.open(folder / str(level - 1) / f"{r}_{c}.jpg") as child:
                    sheet.paste(child, ((c - 2 * column) * PIXELS, (r - 2 * row) * PIXELS))
            target.parent.mkdir(parents=True, exist_ok=True)
            sheet.resize((PIXELS, PIXELS), Image.Resampling.BOX).save(target, quality=QUALITY)
    return sorted(above)


def pyramid(folder, finest, blocks):
    """Every level above the finest made from the one below; {level: [[row, column], ...]}."""
    levels = {finest: [list(b) for b in sorted(blocks)]}
    for level in range(finest + 1, LEVELS):
        blocks = halve(blocks, folder, level, False)
        levels[level] = [list(b) for b in blocks]
    return levels


def terrain(game, continent, out):
    """The game's minimap tiles as blocks: two by two tiles a block at TERRAIN_LEVEL, the sea where none."""
    folder = out / "terrain" / str(continent)
    blocks = set()
    for key, file in game.files.items():
        if key // 4096 != continent:
            continue
        row, column = (key % 4096) // 64, key % 64
        blocks.add((row // 2, column // 2))
    for row, column in sorted(blocks):
        target = folder / str(TERRAIN_LEVEL) / f"{row}_{column}.jpg"
        tiles = [(r, c) for r in (2 * row, 2 * row + 1) for c in (2 * column, 2 * column + 1)]
        files = [game.minimap / f"{game.files[continent * 4096 + r * 64 + c]}.blp" for r, c in tiles
                 if continent * 4096 + r * 64 + c in game.files]
        if not newer(target, *files):
            continue
        sheet = Image.new("RGB", (PIXELS, PIXELS), tuple(int(c) for c in at.NAVY))
        for r, c in tiles:
            file = game.files.get(continent * 4096 + r * 64 + c)
            if file and (game.minimap / f"{file}.blp").is_file():
                with Image.open(game.minimap / f"{file}.blp") as tile:
                    sheet.paste(tile.convert("RGB").resize((PIXELS // 2, PIXELS // 2)),
                                ((c - 2 * column) * PIXELS // 2, (r - 2 * row) * PIXELS // 2))
        target.parent.mkdir(parents=True, exist_ok=True)
        sheet.save(target, quality=QUALITY)
    return pyramid(folder, TERRAIN_LEVEL, blocks)


def atlas_pack(continent, out):
    """The Atlas' pack: its blocks as the Atlas module lists them from its index, as pictures."""
    index = ATLAS / "Index.lua"
    if not index.is_file():
        return {}
    lines = subprocess.run([LUA, str(INDEX_LUA), str(ROOT), str(index)], capture_output=True, text=True,
                           check=True).stdout.split("\n")
    levels = {}
    for line in lines:
        if not line.strip():
            continue
        c, level, row, column = (int(n) for n in line.split())
        if c != continent:
            continue
        source = ATLAS / "Art" / str(c) / str(level) / f"{row}_{column}.blp"
        target = out / "atlas" / str(c) / str(level) / f"{row}_{column}.jpg"
        if newer(target, source):
            target.parent.mkdir(parents=True, exist_ok=True)
            with Image.open(source) as block:
                block.convert("RGB").save(target, quality=QUALITY)
        levels.setdefault(level, []).append([row, column])
    return levels


def tiles(game, continent, out, run):
    """A run's painted squares packed by the Atlas' own pack into the game's blocks, as pictures."""
    squares = list((run / str(continent)).glob("sq-*.png"))
    folder = out / "tiles" / str(continent)
    stamp = folder / "packed"
    if not squares:
        return {}
    if stamp.is_file() and not newer(stamp, *squares):
        return json.loads(stamp.read_text())

    def block(level, row, column, rgb):
        target = folder / str(level) / f"{row}_{column}.jpg"
        target.parent.mkdir(parents=True, exist_ok=True)
        Image.fromarray(rgb).save(target, quality=QUALITY)

    index, _ = at.pack(run, game, at.Guides(game), continent, at.MOOD, out, painted_only=True, block=block)
    levels = {level: [[row, column] for row, columns in rows.items() for column in columns]
              for level, rows in index.items()}
    stamp.parent.mkdir(parents=True, exist_ok=True)
    stamp.write_text(json.dumps(levels))
    return levels


# --- Zone layers ----------------------------------------------------------------------------------

def outlined(picture, uimap):
    """A zone's picture cut by its outline (Navigation's zone mask over the zone's box), soft past the border."""
    picture = picture.convert("RGBA")
    mask = ml.OUTLINES / f"{uimap}.blp"
    if mask.is_file():
        with Image.open(mask) as outline:
            picture.putalpha(outline.getchannel("A").resize(picture.size, Image.Resampling.BILINEAR))
    return picture


def zone_layer(layer, continent, zones, out, picture_of):
    """Each zone's picture of a layer, cut by its outline: [{file, box, zone}]."""
    images = []
    for uimap, box in zones:
        source, make = picture_of(uimap)
        if source is None:
            continue
        target = out / layer / str(continent) / f"{uimap}.webp"
        if newer(target, *([source] if isinstance(source, Path) else [])):
            target.parent.mkdir(parents=True, exist_ok=True)
            outlined(make(), uimap).save(target, quality=QUALITY)
        images.append({"file": f"{layer}/{continent}/{uimap}.webp", "box": list(box), "zone": uimap})
    return images


# --- Instances ------------------------------------------------------------------------------------

def instances(out):
    """Each instance of map-layers' run: its terrain, the game's maps of its floors, its far painting."""
    state = json.loads((ml.OUT / "state.json").read_text())
    found = []
    for subject in state["subjects"]:
        if subject["kind"] != "instance":
            continue
        folder, layers = ml.OUT / subject["name"], []
        for name, path, box in ([("Game terrain", folder / "ground.png", subject["box"])]
                                + [(f"Game map, floor {f['floor']}", ml.OUT / f["name"] / "art.png", f["box"])
                                   for f in subject["floors"] if not f["style_only"]]
                                + [(f"Our zone map, floor {f['floor']}", ml.OUT / f["name"] / "middle.png", f["box"])
                                   for f in subject["floors"]]
                                + [("Our render", folder / "far.png", subject["box"])]):
            if not path.is_file():
                continue
            target = out / "instances" / subject["name"] / f"{path.parent.name}-{path.stem}.jpg"
            if newer(target, path):
                target.parent.mkdir(parents=True, exist_ok=True)
                Image.open(path).convert("RGB").save(target, quality=QUALITY)
            layers.append({"name": name, "file": f"instances/{subject['name']}/{target.name}", "box": list(box)})
        found.append({"name": subject["name"], "title": subject["title"], "box": subject["box"], "layers": layers})
    return found


# --- The commands ---------------------------------------------------------------------------------

def build(args):
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    state = json.loads((ml.OUT / "state.json").read_text())
    paths = state["paths"]
    game = at.Game({"adt": paths["continents"], "tables": paths["tables"], "minimap": paths["minimap"]})
    tables, mapart = Path(paths["tables"]), Path(paths["mapart"])
    found, _ = ta.zones(tables, (0, 1))
    briefs = tomllib.loads(ml.ZONES.read_text())
    rows = {name: ta.table(tables, name) for name in ("UiMapXMapArt", "UiMapArt", "UiMapArtStyleLayer", "UiMapArtTile",
                                                       "WorldMapOverlay")}
    rows["parts"] = {}
    for row in ta.table(tables, "WorldMapOverlayTile"):
        if row["LayerIndex"] == "0" and int(row["FileDataID"]) > 0:
            rows["parts"].setdefault(row["WorldMapOverlayID"], []).append(row)
    names = {int(r["ID"]): r["Name_lang"] for r in ta.table(tables, "UiMap")}
    painted = {s["key"]: s["name"] for s in state["subjects"] if s["kind"] == "zone"}
    world = {"pixels": PIXELS, "tile": ml.TILE, "half": ml.CENTRE, "levels": LEVELS, "continents": [], "instances": []}
    for continent in args.continents:
        zones = sorted(((u, box) for u, (c, box, _) in found.items() if c == continent),
                       key=lambda z: -(z[1][2] - z[1][3]) * (z[1][0] - z[1][1]))   # the large first, cities over them
        layers = []
        if "terrain" in args.layers:
            layers.append({"id": "terrain", "kind": "blocks", "levels": terrain(game, continent, out), "finest": TERRAIN_LEVEL})
        if "gamemaps" in args.layers:
            def game_map(uimap):   # the game's art, read only when its picture is to be made
                has = any(row["UiMapID"] == str(uimap) and row["PhaseID"] == "0" for row in rows["UiMapXMapArt"])
                return ("art", lambda: ml.flat(ta.full(uimap, rows, mapart))) if has else (None, None)
            layers.append({"id": "gamemaps", "kind": "images", "images": zone_layer("gamemaps", continent, zones, out, game_map)})
        if "atlas" in args.layers:
            levels = atlas_pack(continent, out)
            if levels:
                layers.append({"id": "atlas", "kind": "blocks", "levels": levels, "finest": 0})
        if "tiles" in args.layers:
            levels = tiles(game, continent, out, Path(args.tiles))
            if levels:
                layers.append({"id": "tiles", "kind": "blocks", "levels": levels, "finest": 0})
        for level in ("far", "middle"):
            if level in args.layers:
                def picture_of(uimap, level=level):
                    path = ml.OUT / painted.get(uimap, "-") / f"{level}.png"
                    return (path, lambda: Image.open(path)) if path.is_file() else (None, None)
                layers.append({"id": level, "kind": "images", "images": zone_layer(level, continent, zones, out, picture_of)})
        for layer in layers:
            layer["name"], layer["order"] = LAYERS[layer["id"]]
        world["continents"].append({
            "id": continent, "name": NAMES.get(continent, str(continent)), "layers": sorted(layers, key=lambda l: l["order"]),
            "zones": [{"id": u, "name": briefs.get(str(u), {}).get("name") or names.get(u, str(u)), "box": list(box)}
                      for u, box in zones]})
        print(f"{NAMES.get(continent, continent)}: {', '.join(l['id'] for l in layers)}", flush=True)
    if "instances" in args.layers:
        world["instances"] = instances(out)
        print(f"instances: {len(world['instances'])}")
    (out / "world.json").write_text(json.dumps(world))
    for page in PAGE.iterdir():
        shutil.copyfile(page, out / page.name)
    print(f"written {out}; saneui showworldmap serves it on 127.0.0.1 port {PORT}")


def web_nav():
    """The pages' menu with every tool page in it (dev/tools/web-pages nav), sent as /web-nav.js."""
    return subprocess.run([str(ROOT / "dev" / "tools" / "web-pages"), "nav"], capture_output=True).stdout


def serve(args):
    out = Path(args.out)
    if not (out / "world.json").is_file():
        sys.exit("No world map built yet: saneui makeworldmap")
    for page in PAGE.iterdir():   # the page as it is now, not as the last build copied it
        shutil.copyfile(page, out / page.name)
    port = args.port or PORTS.get(args.only, PORT)
    only = {"world": "continent", "instances": "instance"}.get(args.only)

    class Handler(http.server.SimpleHTTPRequestHandler):
        def do_GET(self):
            if self.path == "/web-nav.js":   # the menu of every tool page
                body = web_nav()
                self.send_response(200)
                self.send_header("Content-Type", "text/javascript; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            if only and self.path == "/":   # the page with one kind of map only (viewer.js reads ?only=)
                self.send_response(302)
                self.send_header("Location", f"/?only={only}")
                self.end_headers()
                return
            super().do_GET()

    handler = functools.partial(Handler, directory=str(out))
    what = {"world": "The world map", "instances": "The instance maps"}.get(args.only, "The world map")
    print(f"{what} on 127.0.0.1 port {port}, in a browser (Ctrl+C stops it)")
    http.server.ThreadingHTTPServer(("127.0.0.1", port), handler).serve_forever()


def main():
    parser = argparse.ArgumentParser(description="The world map offline, every layer stacked.")
    parser.add_argument("command", choices=("build", "serve"))
    parser.add_argument("--layers", type=lambda t: set(t.split(",")),
                        default={"terrain", "gamemaps", "far", "middle", "tiles", "atlas", "instances"})
    parser.add_argument("--continents", type=lambda t: [int(c) for c in t.split(",")], default=[0, 1])
    parser.add_argument("--tiles", default=str(RUN))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PORT", 0)))   # a preview server's PORT; else --only's
    parser.add_argument("--only", choices=("world", "instances"))
    parser.add_argument("--out", default=str(OUT))
    args = parser.parse_args()
    {"build": build, "serve": serve}[args.command](args)


if __name__ == "__main__":
    main()
