def run(argv):
    program = argv[0]
    path = ROOT / program
    argv = [str(path)] + argv[1:] if path.exists() else argv
    if not path.exists() and not shutil.which(program):
        sys.exit(f"saneui: {program} is not there")
    return subprocess.run(argv, cwd=ROOT).returncode


def installed():
    """The build in the game: Core's TOC in each game folder (WOW_FOREVER's alone, else live's and the beta's)."""
    folders = [GAME] if os.environ.get("WOW_FOREVER") else sorted(GAME.parent.glob("_*_"))
    found = False
    for folder in folders:
        toc = folder / "Interface" / "AddOns" / "SaneUI" / "SaneUI.toc"
        if not toc.is_file():
            continue
        fields = {}
        for line in toc.read_text(errors="replace").splitlines():
            if line.startswith("## ") and ":" in line:
                key, value = line[3:].split(":", 1)
                fields[key.strip()] = value.strip()
        build = fields.get("X-SaneUI-Build", "dev (built before builds were marked)")
        print(f"In the game ({folder.name}): Sane UI {fields.get('Version', '?')}, {build}.")
        found = True
    if not found:
        print(f"No Sane UI in the game ({GAME / 'Interface' / 'AddOns'}).")
        return 1
    return 0


def overview():
    print("saneui <command> [args]  ·  saneui start|pause|resume|stop|status <command>  ·  saneui help <command>\n")
    width = max(map(len, COMMANDS)) + 2
    for group, entries in GROUPS.items():
        print(group)
        for name, (_, what, _) in entries.items():
            verbs = " · " + " ".join(BACKGROUND[name]) if name in BACKGROUND else ""
            print(f"  {name:<{width}}{what}{verbs}")
        print()


def card():
    """The Konsole greeting's Sane UI block (fish_greeting.fish draws it): a line each, side (L or R), kind (h a
    group's name, r a command and its words, b a gap), text. The first group stands left, the others right."""
    lines = [("L", "h", "Commands"), ("L", "r", "saneui\tevery command, by group"),
             ("L", "r", "start/stop <name>\tpause · resume · status"), ("L", "b", "")]
    for at, (group, entries) in enumerate(GROUPS.items()):
        shown = [(name, words) for name, (_, _, words) in entries.items() if words]
        side = "L" if at == 0 else "R"
        if shown:
            if side == "R" and any(s == "R" for s, _, _ in lines):
                lines.append(("R", "b", ""))
            lines.append((side, "h", group))
            lines += [(side, "r", f"{name}\t{words}") for name, words in shown]
    for line in lines:
        print("\t".join(line))


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        overview()
        return 0
    first, rest = args[0], args[1:]
    if first == "--card":
        card()
        return 0
    if first == "--names":   # the shell's completion, given the words so far: what may come next
        names = ([*COMMANDS, *VERBS, "help"] if not rest else BACKGROUND if rest[0] in VERBS and len(rest) == 1
                 else COMMANDS if rest == ["help"] else [])
        if names:
            print("\n".join(names))
        return 0
    if first == "--link":
        LINK.parent.mkdir(parents=True, exist_ok=True)
        if LINK.is_symlink() or not LINK.exists():
            LINK.unlink(missing_ok=True)
            LINK.symlink_to(Path(__file__).resolve())
            print(f"{LINK} -> {Path(__file__).resolve()}")
            return 0
        sys.exit(f"saneui: {LINK} is a file of its own, not a link: left as it is")
    if first == "help":
        if not rest or rest[0] not in COMMANDS:
            overview()
            return 0
        argv = COMMANDS[rest[0]][0]
        if argv[0] == "@installed":
            print(COMMANDS[rest[0]][1])
            return 0
        return run(argv + ["--help"])
    if first in VERBS:
        if not rest or rest[0] not in BACKGROUND:
            sys.exit(f"saneui: {first} what? One of: {', '.join(BACKGROUND)}")
        verb = BACKGROUND[rest[0]].get(first)
        if not verb:
            sys.exit(f"saneui: {rest[0]} cannot {first}; it can: {', '.join(BACKGROUND[rest[0]])}")
        return run(COMMANDS[rest[0]][0] + verb + rest[1:])
    if first not in COMMANDS:
        sys.exit(f"saneui: no command {first}; saneui alone lists them")
    argv = COMMANDS[first][0]
    if argv[0] == "@installed":
        return installed()
    return run(argv + rest)


if __name__ == "__main__":
    sys.exit(main())
