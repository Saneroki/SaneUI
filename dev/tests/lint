#!/usr/bin/env python3
"""Checks of the addons' files that need no game and no test: the mistakes the game only shows at login.

Sane UI is one addon per folder in src: SaneUI (Core) and one for each module.

  1. Each folder has one TOC. Every file it lists is there (spelled the same, capitals too), and
     every Lua and XML file in the folder is listed, or the game would silently not load it. The Atlas'
     index is made with its art into assets/optimized/Atlas, which dev/build puts in: it is checked there,
     and may be missing while the art is not made (the Atlas is then not built).
  2. The TOCs agree: same game version and addon version, and every module depends on SaneUI and
     is grouped under it, or the game would read it before Core or list it apart.
  3. Every Lua file parses (the game's Lua is 5.1).
  4. No file writes a global that is not Sane UI's own: all addons share one set of globals,
     and a stray one (a forgotten "local") can break another addon or the game's own code.
  5. The data packs (Doc/guides/data.md), compiled from the master for every game version into a scratch
     folder: their TOCs (load on demand, under Sane UI, the X-SaneUI lines, the saved variable, Core's
     Interface and Version), their files, and their Lua, which parses and writes no global.
  6. Every function Sane UI gives the game to call later, in Core and in every module, is behind a guard
     (Doc/guides/addon-standards.md, section 10): a frame's script, a hook, a timer; a menu's function (its
     lines, a dropdown's menu, its words for the choice, whether it is at its default and its reset, a line's
     tooltip); a list's rows (made, measured, drawn); a row of the game's options (shown, usable) and a
     setting's getter and setter; a chat filter; a tooltip's every filling; and the function fields the game
     calls (a dialog's callback, the colour picker's functions, a canvas page's OnRefresh, OnDefault and
     OnCommit, a slash command). What passes:
       - ns.Guard(fn) (Core.Guard(label, fn) in Core), or a name the file set to one (also one made once and
         kept: tips[key] = tips[key] or ns.Guard(...));
       - a function whose one step is ns.Safe(...), ns.Guarded(...) or Core.Safe(...) (or a local name the
         file gave one of them), given there or by the name of a local function; one that must answer a
         value may give a fallback: function(...) return ns.Safe(...) or <a literal or a constant> end, the
         same with a guarded name (return Height(...) or 1);
       - a function that runs nothing of ours: it does nothing, or only answers a literal;
       - nil, words or a number where a door also takes them, the game's own GameTooltip_Hide, a frame's
         own method (frame.StartMoving).
     An intended exception says why on the call's line: -- unguarded: <why>. A guard the lint cannot follow
     (a function that hands one out: filter:SetupMenu(ns.Feed.Menu(view))) says how there: -- guarded: <how>.

Usage:  dev/tests/lint
"""
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
SRC = Path(__file__).resolve().parents[2] / "src"
sys.path.insert(0, str(SRC.parent / "dev" / "data"))
MAIN = "SaneUI"  # the addon every module depends on; a module's addon is SaneUI_<Module>
# dev/build puts each module together from src/<folder> and assets/optimized/<folder> (its art, and the Atlas'
# index a tool makes with it): a file its TOC lists may be in either. src itself holds no pictures or sounds.
ASSETS = SRC.parent / "assets" / "optimized"
MEDIA = {".blp", ".tga", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ogg", ".mp3", ".wav", ".flac",
         ".mp4", ".webm"}

# Globals the addons may write: the table they share, their saved settings and functions,
# the slash command, key bindings.
OWN = re.compile(r"^(SaneUI\w*|SLASH_SANEUI\d|BINDING_(HEADER|NAME)_SANEUI\w*)$")

problems = []


def read_toc(toc):
    """The TOC's fields, and the files the game loads: its lines, and what a listed XML file includes."""
    fields, files = {}, set()
    for line in toc.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        field = re.match(r"##\s*([^:]+?)\s*:\s*(.*)$", line)
        if field:
            fields[field.group(1)] = field.group(2)
        if not line or line.startswith("#"):
            continue
        path = toc.parent / line.replace("\\", "/")
        files.add(path)
        if path.suffix == ".xml" and path.exists():
            for included in re.findall(r'<(?:Script|Include)\s+file="([^"]+)"', path.read_text(encoding="utf-8")):
                files.add(path.parent / included.replace("\\", "/"))
    return fields, files


def check_addon(folder):
    """One folder of src. Returns its TOC's fields and how many files it lists."""
    tocs = sorted(folder.glob("*.toc"))
    if len(tocs) != 1:
        problems.append(f"{folder.name}: needs exactly one TOC, has {len(tocs)}")
        return None, 0
    toc = tocs[0]
    name = toc.relative_to(SRC)
    fields, listed = read_toc(toc)
    for path in sorted(listed):
        named = path.relative_to(folder)
        if not path.exists():
            path = ASSETS / folder.name / named
            if not path.exists() and folder.name == "Atlas":
                continue  # its art is not made yet: dev/build does not build it
        # A name that only differs in capitals loads on Windows and nowhere else; ask for the exact one.
        if not path.exists() or path.name not in {p.name for p in path.parent.iterdir()}:
            problems.append(f"{name} lists a file that is not there: {named}")
    for path in sorted(folder.rglob("*")):
        if path.suffix.lower() in MEDIA:
            problems.append(f"a picture or sound in src, its place is assets/optimized/{folder.name}: "
                            f"{path.relative_to(SRC)}")
        if path.suffix in (".lua", ".xml") and path not in listed and path.name != "Bindings.xml":
            problems.append(f"not listed in {name}, so the game will not load it: {path.relative_to(folder)}")

    if toc.stem != MAIN:
        if not toc.stem.startswith(MAIN + "_"):
            problems.append(f"{name}: a module's TOC is called {MAIN}_<Module>.toc")
        if MAIN not in re.split(r"\s*,\s*", fields.get("Dependencies", "")):
            problems.append(f"{name}: no '## Dependencies: {MAIN}', so the game may read it before Core")
        if fields.get("Group") != MAIN:
            problems.append(f"{name}: no '## Group: {MAIN}', so the addon list may not show it under Sane UI")
    return fields, len(listed)


def check_tocs():
    counts, seen = [], {}
    for folder in sorted(p for p in SRC.iterdir() if p.is_dir()):
        fields, count = check_addon(folder)
        if fields is None:
            continue
        counts.append(count)
        for field in ("Interface", "Version"):
            seen.setdefault(field, set()).add(fields.get(field))
    for field, values in seen.items():
        if len(values) > 1:
            problems.append(f"the TOCs disagree on '## {field}': {', '.join(sorted(map(str, values)))}")
    if not (SRC / "Core" / f"{MAIN}.toc").exists():
        problems.append(f"Core/{MAIN}.toc is not there: every module depends on that addon")
    return counts


def check_lua(paths, base, allowed=OWN):
    for path in paths:
        result = subprocess.run(["luac5.1", "-l", "-p", str(path)], capture_output=True, text=True)
        if result.returncode != 0:
            problems.append(f"does not parse: {result.stderr.strip()}")
            continue
        for line, name in re.findall(r"\[(\d+)\]\s+SETGLOBAL\s+\S+\s+\S+\s*;\s*(\S+)", result.stdout):
            if not allowed.match(name):
                problems.append(f"{path.relative_to(base)}:{line}: writes the global '{name}' (forgotten 'local'?)")


def check_packs(core):
    """Compiles the master's packs for every game version and checks each pack. Returns how many."""
    import check as checks
    import compile as compiler
    import master as masters
    data = masters.Master().load()
    checks.check(data)
    if data.errors:
        problems.append("the data packs are not checked: the master has problems (dev/tools/data check)")
        return 0
    count, folder = 0, Path(tempfile.mkdtemp(prefix="saneui-lint-"))
    try:
        for game in data.games:
            made = compiler.compile_packs(data, folder / game, game)
            for pack, sets, _ in made:
                name = compiler.PREFIX + pack
                where = f"data pack {name} ({game})"
                toc = folder / game / name / f"{name}.toc"
                fields, listed = read_toc(toc)
                want = {"Interface": core.get("Interface"), "Version": core.get("Version"), "Dependencies": MAIN,
                        "Group": MAIN, "LoadOnDemand": "1", "SavedVariables": f"SaneUIData_{pack}",
                        "X-SaneUI-Sets": ", ".join(sets) or None, "X-SaneUI-Format": str(compiler.FORMAT), "X-SaneUI-Game": game,
                        "X-SaneUI-Saved": "1" if data.packs[pack].get("saved") else None}
                for field, value in want.items():
                    if fields.get(field) != value:
                        problems.append(f"{where}: '## {field}: {fields.get(field)}', wants '{value}'")
                for field in ("Title", "Notes", "Author"):
                    if not fields.get(field):
                        problems.append(f"{where}: no '## {field}'")
                files = sorted(p for p in (folder / game / name).iterdir() if p.suffix == ".lua")
                if sorted(listed) != files:
                    problems.append(f"{where}: its TOC and its Lua files differ")
                check_lua(files, folder, re.compile(r"^$"))
                count += 1
    finally:
        shutil.rmtree(folder)
    return count


# The doors a module's functions come in by, later, from the game: [call] = which arguments are functions.
# ":Name" is a method of any object, ".Name" a function of any table (ChatFrameUtil.AddMessageEventFilter, a
# local name for TooltipDataProcessor), anything else that name itself; a local name a file gives one of
# them (local AddFilter = ChatFrameUtil.AddMessageEventFilter or ...) is that door too. hooksecurefunc's
# function is its second argument after a global's name, its third after a table; a door called through
# pcall (pcall(hooksecurefunc, ...), pcall(frame.SetScript, frame, ...)) has one more.
DOORS = {
    ":SetScript": (2,), ":HookScript": (2,), "hooksecurefunc": (2,),
    "C_Timer.After": (2,), "C_Timer.NewTimer": (2,), "C_Timer.NewTicker": (2,),
    ":RegisterCallback": (2,), "Menu.ModifyMenu": (2,), "MenuUtil.CreateContextMenu": (2,),
    "MenuUtil.HookTooltipScripts": (2,), ":CreateButton": (2,), ":CreateCheckbox": (2, 3),
    ":CreateRadio": (2, 3), ":AddInitializer": (1,), "pcall": (),
    # A dropdown's menu, its words for the choice, whether it is at its default and its reset; a list's rows,
    # made, measured and drawn; a menu line's tooltip; a row of the game's options shown and usable (also under
    # its parent row); a setting's getter and setter; a chat filter; a tooltip's every filling.
    ":SetupMenu": (1,), ":SetSelectionTranslator": (1,), ":SetIsDefaultCallback": (1,), ":SetDefaultCallback": (1,),
    ":SetElementFactory": (1,), ":SetElementExtentCalculator": (1,), ":SetElementInitializer": (2,),
    ":SetTooltip": (1,), ":AddShownPredicate": (1,), ":AddModifyPredicate": (1,), ":SetParentInitializer": (2,),
    "Settings.RegisterProxySetting": (6, 7), ".AddMessageEventFilter": (2,), "ChatFrame_AddMessageEventFilter": (2,),
    ".AddTooltipPostCall": (2,), ".AddLinePostCall": (2,),
}
DOOR = re.compile("(" + "|".join(re.escape(d) if d[0] in ":." else r"(?<![\w.:])" + re.escape(d)
                             for d in sorted(DOORS, key=len, reverse=True)) + r")\s*\(")
# Function fields the game calls later: a dialog's data (StaticPopup_Show's callback, cancelCallback), the
# colour picker's (swatchFunc, cancelFunc, opacityFunc), a canvas page of the game's options (OnRefresh,
# OnDefault, OnCommit), each as a table's field or set on one; a slash command (SlashCmdList.X).
FIELD = re.compile(r"\b(callback|cancelCallback|swatchFunc|cancelFunc|opacityFunc|OnRefresh|OnDefault|OnCommit)\s*=(?!=)"
                   r"|\bSlashCmdList\s*(?:\.\s*\w+|\[[^\]\n]*\])\s*=(?!=)")
GAMES = {"GameTooltip_Hide"}  # the game's own functions, which run none of our code
FRAME_OWN = re.compile(r"[\w.]+\.(StartMoving|StopMovingOrSizing)")  # a frame's own methods, the game's too
GUARD = re.compile(r"(ns|Core)\.Guard\(")
STEPS = r"ns\.(?:Safe|Guarded)|Core\.Safe"  # a step whose error is caught
# A value written out (a string's insides are blanks here): what a door takes instead of a function, or what
# a function that runs nothing of ours answers. A guard's fallback may also be a constant by its name (List.ROW).
LITERAL = r"""(?:-?\d[\d.]*|true|false|nil|"[^"\n]*"|'[^'\n]*'|\{\s*\})"""
FALLBACK = r"(?:" + LITERAL + r"|[A-Za-z_][\w.]*)"
BARE_OK = re.compile(r"--\s*unguarded:\s*\S")  # the mark of an intended exception, with its reason
SEEN_OK = re.compile(r"--\s*guarded:\s*\S")  # the mark of a guard the lint cannot follow, and how it is one
WORD = re.compile(r"[A-Za-z_]\w*")
OPENS, CLOSES = {"function", "if", "do", "repeat"}, {"end", "until"}


def blanked(text):
    """The Lua text with its comments and the insides of its strings turned to spaces: places and
    lines stay where they were, and nothing in a string or a comment looks like code."""
    out, i, n = list(text), 0, len(text)
    def blank(a, b):
        for k in range(a, b):
            if out[k] != "\n":
                out[k] = " "
    while i < n:
        long = re.match(r"(--)?\[(=*)\[", text[i:i + 64])
        if text.startswith("--", i) and not long:
            end = text.find("\n", i)
            end = n if end < 0 else end
            blank(i, end)
            i = end
        elif long and (long.group(1) or text[i] == "["):
            close = "]" + long.group(2) + "]"
            end = text.find(close, i + len(long.group(0)))
            end = n if end < 0 else end + len(close)
            blank(i + (0 if long.group(1) else 1), end - (0 if long.group(1) else 1))
            i = end
        elif text[i] in "\"'":
            j = i + 1
            while j < n and text[j] != text[i] and text[j] != "\n":
                j += 2 if text[j] == "\\" else 1
            blank(i + 1, min(j, n))
            i = j + 1
        else:
            i += 1
    return "".join(out)


def arguments(code, start):
    """The arguments of the call whose '(' is at start: (begin, end) of each, in code."""
    spans, depth, blocks, begin, i = [], 0, 0, start + 1, start + 1
    while i < len(code):
        c = code[i]
        word = WORD.match(code, i) if (c.isalpha() or c == "_") and not (code[i - 1].isalnum() or code[i - 1] in "_.:") else None
        if word:
            blocks += (word.group() in OPENS) - (word.group() in CLOSES)
            i = word.end()
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            if depth == 0 and blocks == 0:
                spans.append((begin, i))
                return spans
            depth -= 1
        elif c == "," and depth == 0 and blocks == 0:
            spans.append((begin, i))
            begin = i + 1
        i += 1
    return spans


def value(code, start):
    """The value given to a field at start (after its '='): a function to its end, anything else to the next
    ',', ';', closing bracket or line end outside brackets."""
    i, depth, blocks = start, 0, 0
    while i < len(code):
        c = code[i]
        word = WORD.match(code, i) if (c.isalpha() or c == "_") and not (code[i - 1].isalnum() or code[i - 1] in "_.:") else None
        if word:
            blocks += (word.group() in OPENS) - (word.group() in CLOSES)
            i = word.end()
            if blocks == 0 and depth == 0 and word.group() in CLOSES:
                return code[start:i]
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            if depth == 0 and blocks == 0:
                return code[start:i]
            depth -= 1
        elif depth == 0 and blocks == 0 and (c in ",;" or (c == "\n" and code[start:i].strip())):
            return code[start:i]
        i += 1
    return code[start:]


def aliases(code):
    """The local names a file gives a door that is a function (local AddFilter = ChatFrameUtil and
    ChatFrameUtil.AddMessageEventFilter or ...): [name] = that door."""
    found = {}
    for name, given in re.findall(r"\blocal\s+(\w+)\s*=\s*([^\n]*)", code):
        for door in DOORS:
            if door[0] != ":" and door != "pcall" and re.search(r"(?<!\w)" + re.escape(door.lstrip(".")) + r"\b(?!\s*\()", given):
                found[name] = door
    return found


def guarded(arg, names, steps=STEPS):
    """Whether a function argument is guarded: ns.Guard(fn) or Core.Guard(label, fn), a name the file set to one or
    to a function of one such step (names), nil or a literal (no function at all), one of the game's own (GAMES,
    a frame's own method), a function that runs nothing of ours (it does nothing or only answers a literal), or
    a function that does one step through ns.Safe, ns.Guarded or Core.Safe (steps: also the file's own names for
    them) and nothing else, answering what the step answers or else a literal (return ns.Safe(...) or 1)."""
    arg = arg.strip()
    if arg in ("", "nil") or arg in names or arg in GAMES or GUARD.match(arg) or FRAME_OWN.fullmatch(arg):
        return True
    if re.fullmatch(LITERAL, arg) or re.fullmatch(r"function\s*\([^)]*\)\s*(return\s+" + LITERAL + r"\s*)?end", arg):
        return True
    step = re.match(r"function\s*\([^)]*\)\s*(return\s+)?(" + steps + r")\s*\(", arg)
    if not step:
        return False
    rest = arg[step.end() - 1:]
    call = arguments(rest, 0)
    tail = r"\)\s*(or\s+" + FALLBACK + r"\s*)?end" if step.group(1) else r"\)\s*end"
    return bool(call) and re.fullmatch(tail, rest[call[-1][1]:].strip()) is not None


def check_guards(folders):
    """Every function Sane UI gives the game to call later is behind a guard (addon-standards, section 10).
    Returns how many are marked: as intended exceptions (bare), as guarded where the lint cannot follow."""
    marks = {"bare": 0, "guarded": 0}
    for path in sorted(p for folder in folders for p in folder.rglob("*.lua")):
        text = path.read_text(encoding="utf-8")
        code, lines = blanked(text), text.splitlines()
        # Names set to a guard, also one made once and kept (tips[key] = tips[key] or ns.Guard(...)).
        names = set(re.findall(r"([A-Za-z_][\w.]*(?:\[[\w.]+\])?)\s*=\s*(?:\1\s+or\s+)?(?:ns|Core)\.Guard\(", code))
        # The file's own names for a step (local Guarded = ns.Guarded) are steps too.
        own = re.findall(r"\blocal\s+(\w+)\s*=\s*(?:" + STEPS + r")\s*(?:$|--|;)", code, re.M)
        steps = "|".join([STEPS] + [re.escape(name) for name in own])
        # A local function whose one step is Safe or Guarded counts as one by its name too.
        for local in re.finditer(r"^\s*local (function \w+)\(", code, re.M):
            whole = value(code, local.start(1))
            if guarded(re.sub(r"^function \w+", "function", whole), (), steps):
                names.add(local.group(1)[len("function "):])
        # A guarded function called as the one step, with a fallback (return Height(...) or 1), is one too.
        steps = "|".join([steps] + [re.escape(name) for name in sorted(names, key=len, reverse=True)])
        given = aliases(code)
        doors = [(door, door.group(1)) for door in DOOR.finditer(code)]
        if given:
            called = re.compile(r"(?<![\w.:])(" + "|".join(map(re.escape, given)) + r")\s*\(")
            doors += [(door, given[door.group(1)]) for door in called.finditer(code)]
        for door, name in doors:
            spans = arguments(code, door.end() - 1)
            wanted, first = DOORS[name], 0  # first: the argument before which the door's own begin
            if name == "pcall" and spans:
                called = code[spans[0][0]:spans[0][1]].strip()
                if called == "hooksecurefunc":
                    name, first = called, 1
                elif re.fullmatch(r"[\w.]+\.(SetScript|HookScript)", called):
                    wanted = (4,)
            if name == "hooksecurefunc" and len(spans) > first:
                named = text[spans[first][0]:spans[first][1]].strip()[:1] in "\"'"
                wanted = (first + (2 if named else 3),)
            line = code.count("\n", 0, door.start()) + 1
            for index in wanted:
                if index > len(spans) or guarded(code[spans[index - 1][0]:spans[index - 1][1]], names, steps):
                    continue
                flagged(path, lines, line, f"{name.lstrip(':.')} gets a function", marks)
        # A function field the game calls: set on a table (data.callback = ...) or one of its fields ({ callback = ... }).
        for field in FIELD.finditer(code):
            before = code[:field.start()].rstrip()
            if field.group(1) and not before.endswith(("{", ",", ".")):
                continue  # a local or a field of a name of ours, not given to the game
            if not guarded(value(code, field.end()), names, steps):
                flagged(path, lines, code.count("\n", 0, field.start()) + 1, f"{field.group(1) or 'SlashCmdList'} is a function", marks)
    return marks


def flagged(path, lines, line, what, marks):
    """A function without a guard the lint sees: a problem, unless its line says why it is bare (-- unguarded:
    <why>) or how it is guarded where the lint cannot follow (-- guarded: <how>); those are counted."""
    for mark, pattern in (("bare", BARE_OK), ("guarded", SEEN_OK)):
        if pattern.search(lines[line - 1]):
            marks[mark] += 1
            return
    problems.append(f"{path.relative_to(SRC)}:{line}: {what} without a guard: ns.Guard(fn) (Core.Guard(label, fn) in Core), "
                    f"or mark it '-- unguarded: <why>' (or '-- guarded: <how>')")


counts = check_tocs()
check_lua(sorted(SRC.rglob("*.lua")), SRC)
check_lua(sorted(ASSETS.glob("*/*.lua")), SRC.parent)
core_fields, _ = read_toc(SRC / "Core" / f"{MAIN}.toc")
packs = check_packs(core_fields)
doors = check_guards(p for p in SRC.iterdir() if p.is_dir())
for problem in problems:
    print(problem, file=sys.stderr)
if problems:
    sys.exit(1)
print(f"Lint: {len(counts)} addons, {sum(counts)} files in their TOCs, all there, all parse, no stray globals, "
      f"every door guarded ({doors['bare']} marked bare, {doors['guarded']} marked guarded); {packs} data packs fit.")
