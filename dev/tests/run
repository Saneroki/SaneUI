#!/usr/bin/env bash
# Runs every check and test of Sane UI. The first failure stops the run.
#
#   lint            the TOCs, the syntax and stray globals of all files, the modules' guards (no game needed)
#   core.lua        Core, with its options (Settings)
#   abilities.lua   the Abilities module
#   tooltips.lua    the Tooltips module
#   social.lua      the Social module
#   navigation.lua  the Navigation module: the map's spaces, its camera, the map drawn three ways, the full map's search
#   inventory.lua   the Inventory module: its window in the corner, its full screen, the character sheet's paper doll and stats
#   sheet.lua       the Inventory module's character sheet: its side tabs and the tabs behind them
#   bags.lua        the Inventory module's bags: what they hold, the views, the game's item buttons, the bank, the foot
#   combat.lua      the Combat module: the quest marks, the unit frames, the party and raid frames; with Abilities beside it, its window at the bottom middle, its board, your keys, the talent planner, the action bars
#   book.lua        the Abilities module's own spellbook on its full screen: its pages, tabs, entries, the casts out of a fight
#   talents.lua     the Abilities module's own talents: the game's shared talent frame, its class layer, changes
#   meter.lua       the Combat module's threat and damage meter: its place, the list, the bars, pages, saved fights, threat,
#                   and a fight with the numbers hidden by the game
#   reminders.lua   the Combat module's reminders: the right click on auras, the bars, what shows when, a fight with hidden auras
#   auralists.lua   the Combat module's aura lists: one list with a tick per mark, the search over every class's, the enemies' and the items' auras
#   aurahistory.lua Core's aura log and Abilities' aura history: the auras seen on enemies, a fight with hidden auras, the window
#   nameplates.lua  the Nameplates module: our dress on the game's plates, the bar, auras, marks, combo points
#   onboarding.lua  Core's setups, step by step, and the addon Onboarding: its window read on demand, steps, controls
#   loot.lua        the Loot module: its window and rules, the master looter's menu, full bags, roll cards, the feed
#   economy.lua     the Economy module: what to buy and sell right now, the server asked item by item, a purchase and a post
#                   from a click only, the tab on the game's window, the gold on sale; the tab Banker on the mail window
#   speedleveling.lua  the Speed Leveling key: what is wanted around you, Find's macro chain, the key's action in each
#                      state, the hearth and quest items, the quest givers, the game's settings
#   classquests.lua Speed Leveling's class quests over the guide, by class, race, side and level
#   classquests.py  the set ClassQuests against the master: every chain can be followed, every Forever character has chains
#   encoding.lua    the tests' stand-ins for the bit library and C_EncodingUtil against the game's definitions
#   speedguide.lua  Speed Leveling's guide: a guide read from text and run by our own engine, bought guides opened for
#                   the account, the steps at hand, the view over the world, the arrow and the icons
#   lore.lua        the Lore module: talks as a scene, the game's talk windows held, the rewards read for you,
#                   the interface faded out with its tooltips kept, Space going on
#   macros.lua      Abilities' Sane Macros: macros and steps, a macro written out, the checks, the press and its snippet, keys and
#                   bar buttons, its panel and window, standing down
#   guild.lua       Core's wire and the guild's records, and the Guild module: its window on Social's board, its page, views, key
#   sync.lua        Core's Sync: the game's own settings kept with Sane UI's
#   window.lua      what Core gives every window: moving, sizing, docking, opening under the mouse; what rests out of sight
#   data.lua        Core's data framework in the game: the scheduler, the packs as the game loads them
#   voices.py       the voice database's rules: the cast, the names, words, parts, tone, presets
#   imagegen.py     the image pipeline's lists, recipes and sets, and the flipbook's grid and loops
#   uilab.py        the interface lab: every scene runs, anchors, events and scripts as the game's
#   map_squares.py  the instance maps' close level: its words, its check against the game's water, the colours, the seams
#   map_layers.py   the instance maps' three levels: frames, the buildings' indoor maps placed, the words, the checks
#   dungeon_ground.py  the dungeon maps' ground: the terrain from the WDTs, the floors matched, the parts' heights,
#                   a floor's ground holding its bosses and enemies
#   gpu_runner.py   the GPU runner: its jobs in order, the claims, what counts as the card wanted elsewhere
#   auctions.py     dev/tools/auction-database: the addon of links to every account's auction data
#   fresh_install.py  dev/tools/fresh-install: a new player's first Sane UI, the real WTF and Interface set aside and back
#   release.py      dev/tools/release: the modules' stages, a channel's package, its upload to CurseForge
#   saneui.py       dev/saneui: every command's script is there, its names, the greeting card, the completion
#   board.py        the task board: cards made, moved, edited, deleted; Backlog.md; a ranked list read in
#   webpages.py     the tools' pages: one server on one port, folders and tools by their place
#   walk.py         the walking data's tools: floors, surfaces, rectangles, openings, blocks, regions, the coarse layer; flights' paths
#   map_data.py     dev/tools/map-data: world positions on zone maps (terrain, buildings, boxes), Places' keys, zones
#   data check      the master of Core's data framework (assets/data) fits its rules
#   data/tools.py   the data framework's tools: the check's rules, the import, on a sample master
#   blizzard.py     dev/tools/blizzard: two Blizzard exports compared, and what reaches a small module
#   patchday.py     dev/tools/patchday: two builds' terrain and tables compared, the patch notes, the map's repaint
#
# Usage:  dev/tests/run
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then   # saneui help test
    sed -n '2,/^# Usage/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$here/../.."

for tool in lua5.1 luac5.1; do
    command -v "$tool" >/dev/null || { echo "$tool is not installed: the tests cannot run." >&2; exit 1; }
done
# Every Lua test under a memory cap: a test that loops must fail fast, not take the computer down (2 GB of address space).
lua() { (ulimit -v 2000000; lua5.1 "$@"); }

dev/tests/lint
lua dev/tests/core.lua
lua dev/tests/abilities.lua
lua dev/tests/tooltips.lua
lua dev/tests/social.lua
lua dev/tests/navigation.lua
lua dev/tests/inventory.lua
lua dev/tests/sheet.lua
lua dev/tests/bags.lua
lua dev/tests/combat.lua
lua dev/tests/book.lua
lua dev/tests/meter.lua
lua dev/tests/talents.lua
lua dev/tests/reminders.lua
lua dev/tests/auralists.lua
lua dev/tests/aurahistory.lua
lua dev/tests/nameplates.lua
lua dev/tests/onboarding.lua
lua dev/tests/loot.lua
lua dev/tests/economy.lua
lua dev/tests/speedleveling.lua
lua dev/tests/speedguide.lua
lua dev/tests/classquests.lua
lua dev/tests/encoding.lua
lua dev/tests/lore.lua
lua dev/tests/macros.lua
lua dev/tests/guild.lua
lua dev/tests/sync.lua
lua dev/tests/window.lua
lua dev/tests/data.lua
python3 -I dev/tests/voices.py
python3 -I dev/tests/imagegen.py
python3 -I dev/tests/uilab.py
python3 -I dev/tests/map_squares.py
python3 -I dev/tests/map_layers.py
python3 -I dev/tests/dungeon_ground.py
python3 -I dev/tests/gpu_runner.py
python3 -I dev/tests/auctions.py
python3 -I dev/tests/fresh_install.py
python3 -I dev/tests/release.py
python3 -I dev/tests/saneui.py
python3 -I dev/tests/board.py
python3 -I dev/tests/classquests.py
python3 -I dev/tests/webpages.py
python3 -I dev/tests/walk.py
python3 -I dev/tests/map_data.py
dev/tools/data check
python3 -I dev/tests/data/tools.py
python3 -I dev/tests/blizzard.py
python3 -I dev/tests/patchday.py
