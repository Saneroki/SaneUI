<Bindings>
	<!-- Inventory's key, in the game's key bindings under SaneUI (BINDING_HEADER_SANEUI, Core's Bindings.lua; its
	     words in Keys.lua); the game reads this file from the addon's folder by itself. Keys.lua also puts it on
	     the keys of the game's own bag keys (override bindings). -->
	<Binding name="SANEUI_INVENTORY_BAGS" category="BINDING_HEADER_SANEUI">
		SaneUI.Inventory.Safe("keys", SaneUI.Inventory.Keys.Press)
	</Binding>
</Bindings>
