<Bindings>
	<!-- Nameplates' key, in the game's key bindings under Sane UI (BINDING_HEADER_SANEUI, Core's Bindings.lua; its
	     words in Nameplates.lua); the game reads this file from the addon's folder by itself. -->
	<Binding name="SANEUI_NAMEPLATES_STRANGERS" category="BINDING_HEADER_SANEUI">
		SaneUI.Nameplates.Safe("keys", SaneUI.Nameplates.ToggleStrangers)
	</Binding>
</Bindings>
